<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    x:Class="LisAeroGest.Mobile.Views.OperationsPassengersPage"
    Title="Passageiros"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ===================================== -->
        <!-- CABEÇALHO / PESQUISA                  -->
        <!-- ===================================== -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,28,20,16"
            Spacing="14">

            <VerticalStackLayout Spacing="3">

                <Label
                    Text="BALCÃO DE PASSAGEIROS"
                    FontFamily="OpenSansSemibold"
                    FontSize="12"
                    TextColor="{StaticResource AccentDark}" />

                <Label
                    Text="Check-in manual"
                    Style="{StaticResource TitleStyle}" />

                <Label
                    Text="Localiza um passageiro e confirma o check-in sem utilizar QR Code."
                    Style="{StaticResource CaptionStyle}" />

            </VerticalStackLayout>


            <!-- Pesquisa -->

            <Border
                Style="{StaticResource CardStyle}"
                Padding="16">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Pesquisar passageiro"
                        FontFamily="OpenSansSemibold"
                        FontSize="15" />

                    <Label
                        Text="Pesquisa por nome, email, documento ou número do voo."
                        Style="{StaticResource FootnoteStyle}" />

                    <Border Style="{StaticResource InputCardStyle}">

                        <Entry
                            x:Name="SearchEntry"
                            Placeholder="Nome, email, documento ou voo"
                            ReturnType="Search"
                            Completed="OnSearchReturn" />

                    </Border>

                    <Button
                        Text="Pesquisar passageiro"
                        Clicked="OnSearchClicked" />

                </VerticalStackLayout>

            </Border>


            <!-- Loading -->

            <ActivityIndicator
                x:Name="BusyIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="{StaticResource AccentDark}"
                HorizontalOptions="Center" />


            <!-- Estado -->

            <Label
                x:Name="StatusLabel"
                Text="Introduz os dados do passageiro para começar."
                Style="{StaticResource FootnoteStyle}" />

        </VerticalStackLayout>


        <!-- ===================================== -->
        <!-- RESULTADOS                            -->
        <!-- ===================================== -->

        <CollectionView
            Grid.Row="1"
            x:Name="ResultsView"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30,50"
                    Spacing="8">

                    <Label
                        Text="👤"
                        FontSize="36"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Nenhum passageiro encontrado"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Experimenta pesquisar por outro nome, documento, email ou voo."
                        Style="{StaticResource CaptionStyle}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:EmployeeCheckInDto">

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="20,6"
                        Padding="18">

                        <VerticalStackLayout Spacing="14">

                            <!-- Passageiro + estado -->

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="2">

                                    <Label
                                        Text="{Binding PassengerName}"
                                        Style="{StaticResource Title2Style}" />

                                    <Label
                                        Text="{Binding Email}"
                                        Style="{StaticResource FootnoteStyle}" />

                                </VerticalStackLayout>


                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource StatusBadgeStyle}"
                                    Padding="9,5"
                                    VerticalOptions="Start">

                                    <Label
                                        Text="{Binding Status}"
                                        FontSize="10"
                                        TextColor="{StaticResource AccentDark}" />

                                </Border>

                            </Grid>


                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="{AppThemeBinding
                                    Light={StaticResource Border},
                                    Dark={StaticResource BorderDark}}" />


                            <!-- Dados do voo -->

                            <Grid
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="10">

                                <VerticalStackLayout Spacing="3">

                                    <Label
                                        Text="VOO"
                                        Style="{StaticResource FootnoteStyle}" />

                                    <Label
                                        Text="{Binding FlightNumber}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="17" />

                                </VerticalStackLayout>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        Text="PARTIDA"
                                        Style="{StaticResource FootnoteStyle}" />

                                    <Label
                                        Text="{Binding DepartureTime,
                                            StringFormat='{0:HH:mm}'}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="17" />

                                </VerticalStackLayout>


                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="3">

                                    <Label
                                        Text="PORTA"
                                        Style="{StaticResource FootnoteStyle}" />

                                    <Label
                                        Text="{Binding Gate}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="17"
                                        TextColor="{StaticResource AccentDark}" />

                                </VerticalStackLayout>

                            </Grid>


                            <!-- Lugar -->

                            <Border
                                Style="{StaticResource InputCardStyle}"
                                Padding="12,9">

                                <Grid ColumnDefinitions="Auto,*">

                                    <Label
                                        Text="💺"
                                        FontSize="18"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Spacing="1">

                                        <Label
                                            Text="Lugar atribuído"
                                            Style="{StaticResource FootnoteStyle}" />

                                        <Label
                                            Text="{Binding Seat}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="15" />

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>


                            <!-- Check-in -->

                            <Button
                                Text="Confirmar check-in"
                                Clicked="OnCheckInClicked"
                                IsVisible="{Binding CanCheckIn}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>