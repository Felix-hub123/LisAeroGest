<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
             x:Class="LisAeroGest.Mobile.Views.OperationsPassengersPage"
             Title="Passageiros"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="24,32,24,18" Spacing="14">
            <VerticalStackLayout Spacing="3">
                <Label Text="PASSENGER DESK" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Text="Check-in manual" Style="{StaticResource TitleStyle}" />
            </VerticalStackLayout>
            <Label Text="Pesquisa pelo nome do passageiro. O voo é usado para confirmar a pessoa certa — sem QR Code." Style="{StaticResource CaptionStyle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Style="{StaticResource InputCardStyle}">
                    <Entry x:Name="SearchEntry" Placeholder="Ex.: Maria Silva" ReturnType="Search" Completed="OnSearchReturn" />
                </Border>
                <Button Grid.Column="1" Text="Pesquisar" Clicked="OnSearchClicked" Padding="15,10" />
            </Grid>
            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" Color="{StaticResource AccentDark}" HorizontalOptions="Center" />
            <Label x:Name="StatusLabel" Text="Introduz um dado do passageiro para começar." Style="{StaticResource FootnoteStyle}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" x:Name="ResultsView" SelectionMode="None" EmptyView="Sem resultados para esta pesquisa.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EmployeeCheckInDto">
                    <Border Style="{StaticResource CardStyle}" Margin="24,6" Padding="18">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding PassengerName}" Style="{StaticResource Title2Style}" />
                                    <Label Text="{Binding Email}" Style="{StaticResource FootnoteStyle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" Padding="9,5">
                                    <Label Text="{Binding Status}" FontSize="10" TextColor="{StaticResource AccentDark}" />
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*">
                                <VerticalStackLayout>
                                    <Label Text="VOO" Style="{StaticResource FootnoteStyle}" />
                                    <Label Text="{Binding FlightNumber}" FontFamily="OpenSansSemibold" FontSize="18" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="PARTIDA" Style="{StaticResource FootnoteStyle}" />
                                    <Label Text="{Binding DepartureTime, StringFormat='{0:HH:mm}'}" FontFamily="OpenSansSemibold" FontSize="18" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="PORTA" Style="{StaticResource FootnoteStyle}" />
                                    <Label Text="{Binding Gate}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource AccentDark}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Seat, StringFormat='Lugar: {0}'}" Style="{StaticResource CaptionStyle}" />
                                <Button Grid.Column="1" Text="Fazer check-in" Clicked="OnCheckInClicked" IsVisible="{Binding CanCheckIn}" Padding="12,8" FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>