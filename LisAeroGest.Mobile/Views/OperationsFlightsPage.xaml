<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:Class="LisAeroGest.Mobile.Views.OperationsFlightsPage"
    x:DataType="vm:OperationsFlightsViewModel"
    x:Name="Root"
    Title="Voos"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <RefreshView
        x:Name="Refresh"
        Refreshing="OnRefreshing">

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- CABEÇALHO -->

            <VerticalStackLayout
                Grid.Row="0"
                Padding="20,28,20,14"
                Spacing="5">

                <Label
                    Text="CENTRO DE OPERAÇÕES"
                    FontFamily="OpenSansSemibold"
                    FontSize="12"
                    TextColor="{StaticResource AccentDark}" />

                <Label
                    Text="Voos em operação"
                    Style="{StaticResource TitleStyle}" />

                <Label
                    Text="Acompanha os voos e respetivo estado operacional."
                    Style="{StaticResource CaptionStyle}" />

                <Label
                    Text="{Binding StatusLabel}"
                    Style="{StaticResource FootnoteStyle}"
                    Margin="0,5,0,0" />

            </VerticalStackLayout>


            <!-- FILTROS -->

            <ScrollView
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout
                    Padding="20,4,20,12"
                    Spacing="8">

                    <Button
                        Text="Todos"
                        Command="{Binding FilterCommand}"
                        CommandParameter="All"
                        Padding="15,8"
                        FontSize="12" />

                    <Button
                        Text="Próximos"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Upcoming"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="15,8"
                        FontSize="12" />

                    <Button
                        Text="Embarque"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Boarding"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="15,8"
                        FontSize="12" />

                    <Button
                        Text="Atrasados"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Delayed"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="15,8"
                        FontSize="12" />

                </HorizontalStackLayout>

            </ScrollView>


            <!-- VOOS -->

            <Grid Grid.Row="2">

                <ActivityIndicator
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    Color="{StaticResource AccentDark}"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,10" />

                <CollectionView
                    ItemsSource="{Binding Flights}"
                    SelectionMode="None"
                    Margin="20,4,20,24">

                    <CollectionView.EmptyView>

                        <VerticalStackLayout
                            Padding="20,60"
                            Spacing="10">

                            <Label
                                Text="✈"
                                FontSize="36"
                                HorizontalOptions="Center" />

                            <Label
                                Text="Sem voos"
                                Style="{StaticResource Title2Style}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Não existem voos para este filtro."
                                Style="{StaticResource CaptionStyle}"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </CollectionView.EmptyView>


                    <CollectionView.ItemTemplate>

                        <DataTemplate x:DataType="models:FlightDto">

                            <Border
                                Style="{StaticResource CardStyle}"
                                Margin="0,6"
                                Padding="17">

                                <VerticalStackLayout Spacing="13">

                                    <!-- VOO / ESTADO -->

                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            Text="{Binding FlightNumber}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="21" />

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource StatusBadgeStyle}"
                                            Padding="9,5">

                                            <Label
                                                Text="{Binding Status}"
                                                FontSize="10"
                                                TextColor="{StaticResource AccentDark}" />

                                        </Border>

                                    </Grid>


                                    <!-- ROTA -->

                                    <Label Style="{StaticResource CaptionStyle}">

                                        <Label.FormattedText>
                                            <FormattedString>

                                                <Span Text="{Binding Origin}" />

                                                <Span Text="  →  " />

                                                <Span Text="{Binding Destination}" />

                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>


                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding
                                            Light={StaticResource Border},
                                            Dark={StaticResource BorderDark}}" />


                                    <!-- INFORMAÇÃO OPERACIONAL -->

                                    <Grid
                                        ColumnDefinitions="*,*,*"
                                        ColumnSpacing="8">

                                        <VerticalStackLayout Spacing="2">

                                            <Label
                                                Text="PARTIDA"
                                                Style="{StaticResource FootnoteStyle}" />

                                            <Label
                                                Text="{Binding DepartureTime,
                                                    StringFormat='{0:HH:mm}'}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="17" />

                                        </VerticalStackLayout>


                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2">

                                            <Label
                                                Text="PORTA"
                                                Style="{StaticResource FootnoteStyle}" />

                                            <Label
                                                Text="{Binding Gate}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="17"
                                                TextColor="{StaticResource AccentDark}" />

                                        </VerticalStackLayout>


                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Spacing="2">

                                            <Label
                                                Text="ESTADO"
                                                Style="{StaticResource FootnoteStyle}" />

                                            <Label
                                                Text="{Binding Status}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13" />

                                        </VerticalStackLayout>

                                    </Grid>


                                    <!-- AÇÃO -->

                                    <Button
                                        Text="Ver operação"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding
                                            Source={x:Reference Root},
                                            Path=BindingContext.ViewOperationCommand}"
                                        CommandParameter="{Binding .}" />

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Grid>

    </RefreshView>

</ContentPage>