<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:Class="LisAeroGest.Mobile.Views.OperationsCommunicationsPage"
    x:DataType="vm:OperationsCommunicationsViewModel"
    Title="Comunicações"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,28,24,35"
            Spacing="18">


            <!-- =====================================================
                 CABEÇALHO
            ====================================================== -->

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="CENTRO DE OPERAÇÕES"
                    FontFamily="OpenSansSemibold"
                    FontSize="12"
                    TextColor="{StaticResource AccentDark}" />

                <Label
                    Text="Comunicações"
                    Style="{StaticResource TitleStyle}" />

                <Label
                    Text="Envia avisos operacionais aos passageiros de um voo."
                    Style="{StaticResource CaptionStyle}" />

            </VerticalStackLayout>


            <!-- =====================================================
                 CARREGAMENTO
            ====================================================== -->

            <HorizontalStackLayout
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Spacing="8">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    Color="{StaticResource AccentDark}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="A processar..."
                    FontSize="12"
                    Opacity="0.7"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>


            <!-- =====================================================
                 SUCESSO
            ====================================================== -->

            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="14"
                BackgroundColor="#1A22C55E"
                Stroke="#22C55E"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Text="✓"
                        FontSize="20"
                        FontFamily="OpenSansSemibold"
                        TextColor="#22C55E"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2">

                        <Label
                            Text="Comunicação enviada"
                            FontSize="13"
                            FontFamily="OpenSansSemibold"
                            TextColor="#22C55E" />

                        <Label
                            Text="{Binding SuccessMessage}"
                            FontSize="12"
                            TextColor="#22C55E"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- =====================================================
                 ERRO
            ====================================================== -->

            <Border
                IsVisible="{Binding HasError}"
                Padding="14"
                BackgroundColor="#1AEF4444"
                Stroke="#EF4444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Text="!"
                        FontSize="20"
                        FontFamily="OpenSansSemibold"
                        TextColor="#EF4444"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2">

                        <Label
                            Text="Não foi possível concluir"
                            FontSize="13"
                            FontFamily="OpenSansSemibold"
                            TextColor="#EF4444" />

                        <Label
                            Text="{Binding ErrorMessage}"
                            FontSize="12"
                            TextColor="#EF4444"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- =====================================================
                 SELECIONAR VOO
            ====================================================== -->

            <Border Style="{StaticResource CardElevatedStyle}">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="VOO"
                        Style="{StaticResource FootnoteStyle}" />

                    <Picker
                        Title="Selecionar voo"
                        ItemsSource="{Binding Flights}"
                        SelectedItem="{Binding SelectedFlight}"
                        ItemDisplayBinding="{Binding FlightNumber}" />

                    <Label
                        Text="{Binding SelectedFlightTitle}"
                        FontFamily="OpenSansSemibold"
                        FontSize="17" />

                </VerticalStackLayout>

            </Border>


            <!-- =====================================================
                 COMUNICAÇÃO
            ====================================================== -->

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Nova comunicação"
                        Style="{StaticResource Title2Style}" />


                    <!-- =================================================
                         TIPO
                    ================================================== -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Tipo"
                            Style="{StaticResource FootnoteStyle}" />

                        <Picker
                            Title="Tipo de comunicação"
                            ItemsSource="{Binding CommunicationTypes}"
                            SelectedItem="{Binding SelectedType}" />

                    </VerticalStackLayout>


                    <!-- =================================================
                         MENSAGEM
                    ================================================== -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Mensagem"
                            Style="{StaticResource FootnoteStyle}" />

                        <Border
                            Style="{StaticResource InputCardStyle}"
                            Padding="8">

                            <Editor
                                Text="{Binding Message}"
                                Placeholder="Escreva o aviso para os passageiros..."
                                AutoSize="TextChanges"
                                MinimumHeightRequest="120"
                                MaxLength="500"
                                BackgroundColor="Transparent" />

                        </Border>

                        <Label
                            Text="Máximo de 500 caracteres."
                            Style="{StaticResource CaptionStyle}" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- =====================================================
                 ESTADO
            ====================================================== -->

            <Label
                Text="{Binding StatusLabel}"
                FontFamily="OpenSansSemibold"
                FontSize="13"
                TextColor="{StaticResource AccentDark}"
                HorizontalTextAlignment="Center" />


            <!-- =====================================================
                 INFORMAÇÃO
            ====================================================== -->

            <Border
                IsVisible="{Binding HasSelectedFlight}"
                Style="{StaticResource CardStyle}"
                Padding="13">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Text="📢"
                        FontSize="20"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="A comunicação será enviada aos passageiros associados ao voo selecionado."
                        Style="{StaticResource CaptionStyle}"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center" />

                </Grid>

            </Border>


            <!-- =====================================================
                 ENVIAR
            ====================================================== -->

            <Button
                Text="📢  Enviar aos passageiros"
                Command="{Binding SendCommand}"
                IsEnabled="{Binding HasSelectedFlight}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>