<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LisAeroGest.Mobile.Views.OperationsCommunicationsPage"
             Title="Comunicações"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <ScrollView><VerticalStackLayout Padding="24,32,24,28" Spacing="18"><Label Text="COMUNICAÇÕES" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" /><Label Text="Avisos da equipa" Style="{StaticResource TitleStyle}" /><Border Style="{StaticResource CardElevatedStyle}"><VerticalStackLayout Spacing="12"><Border Style="{StaticResource GlassIconBadgeStyle}"><Label Text="!" FontSize="24" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" /></Border><Label Text="Canal operacional" Style="{StaticResource Title2Style}" HorizontalTextAlignment="Center" /><Label Text="As comunicações e alertas do turno aparecem aqui, alinhados com as notificações do portal web." Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border><Button Text="Ver alertas do turno" Clicked="OnAlertsClicked" /></VerticalStackLayout></ScrollView>
</ContentPage>
