<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:Class="LisAeroGest.Mobile.Views.LoginPage"
    x:DataType="vm:LoginViewModel"
    Title="LisAeroGest"
    Shell.NavBarIsVisible="False"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <ScrollView>

        <VerticalStackLayout
            Padding="28,64,28,32"
            Spacing="20">

            <!-- =====================================================
                 LOGÓTIPO / TÍTULO
            ====================================================== -->

            <VerticalStackLayout
                Spacing="3"
                Margin="0,0,0,14">

                <Label
                    Text="LisAeroGest"
                    FontFamily="OpenSansSemibold"
                    FontSize="36"
                    TextColor="{StaticResource AccentDark}" />

                <Label
                    Text="Lisbon Airport Portal"
                    Style="{StaticResource CaptionStyle}" />

            </VerticalStackLayout>


            <!-- =====================================================
                 LOGIN
            ====================================================== -->

            <Border Style="{StaticResource CardElevatedStyle}">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Bem-vindo de volta"
                        Style="{StaticResource TitleStyle}" />

                    <Label
                        Text="Entra para veres os teus voos, bilhetes e alertas."
                        Style="{StaticResource CaptionStyle}" />


                    <!-- ERRO -->

                    <Border
                        IsVisible="{Binding HasError}"
                        Style="{StaticResource StatusBadgeStyle}"
                        Stroke="{AppThemeBinding
                            Light={StaticResource Error},
                            Dark={StaticResource ErrorDark}}">

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="{AppThemeBinding
                                Light={StaticResource Error},
                                Dark={StaticResource ErrorDark}}"
                            FontSize="14" />

                    </Border>


                    <!-- =================================================
                         EMAIL
                    ================================================== -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Email"
                            Style="{StaticResource BodyEmphasisStyle}" />

                        <Border Style="{StaticResource InputCardStyle}">

                            <Entry
                                Placeholder="email@exemplo.com"
                                Text="{Binding Email}"
                                Keyboard="Email"
                                ReturnType="Next" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- =================================================
                         PASSWORD
                    ================================================== -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Password"
                            Style="{StaticResource BodyEmphasisStyle}" />

                        <Border Style="{StaticResource InputCardStyle}">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="5">

                                <Entry
                                    Grid.Column="0"
                                    Placeholder="Password"
                                    Text="{Binding Password}"
                                    IsPassword="{Binding IsPasswordHidden}"
                                    ReturnType="Done"
                                    ReturnCommand="{Binding LoginCommand}"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="1"
                                    Text="{Binding PasswordVisibilityIcon}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="18"
                                    WidthRequest="45"
                                    HeightRequest="42"
                                    Padding="5"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="Mostrar ou ocultar password" />

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- =================================================
                         GUARDAR CREDENCIAIS
                    ================================================== -->

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{Binding RememberCredentials}"
                            Color="{StaticResource AccentDark}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="Guardar credenciais"
                            Style="{StaticResource BodyEmphasisStyle}"
                            VerticalOptions="Center">

                            <Label.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding ToggleRememberCredentialsCommand}" />

                            </Label.GestureRecognizers>

                        </Label>

                    </Grid>


                    <!-- =================================================
                         ENTRAR
                    ================================================== -->

                    <Button
                        Text="Entrar"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy,
                            Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource AccentDark}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Border>


            <!-- =====================================================
                 PORTAL WEB
            ====================================================== -->

            <VerticalStackLayout Spacing="4">

                <Label
                    Text="A criação de conta é feita no portal web."
                    Style="{StaticResource CaptionStyle}"
                    HorizontalTextAlignment="Center" />

                <Button
                    Text="Abrir portal web"
                    Clicked="OnPortalClicked"
                    Style="{StaticResource TextButtonStyle}" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>