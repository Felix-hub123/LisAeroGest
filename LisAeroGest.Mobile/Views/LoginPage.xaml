<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:Class="LisAeroGest.Mobile.Views.LoginPage"
    x:DataType="vm:LoginViewModel"
    Title="LisAeroGest"
    Shell.NavBarIsVisible="False"
    Background="{StaticResource AppBackgroundGradientBrush}">

    <ScrollView>

        <VerticalStackLayout
            Padding="28,64,28,32"
            Spacing="20">

            <!-- LOGÓTIPO / TÍTULO -->

            <VerticalStackLayout
                Spacing="3"
                Margin="0,0,0,14">

                <Label
                    Text="LisAeroGest"
                    FontFamily="OpenSansSemibold"
                    FontSize="36"
                    TextColor="{StaticResource AccentDark}" />

                <Label
                    Text="Aeroporto de Lisboa"
                    Style="{StaticResource CaptionStyle}" />

            </VerticalStackLayout>


            <!-- LOGIN -->

            <Border Style="{StaticResource CardElevatedStyle}">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Bem-vindo de volta"
                        Style="{StaticResource TitleStyle}" />

                    <Label
                        Text="Entre para consultar voos, bilhetes, viagens e alertas."
                        Style="{StaticResource CaptionStyle}" />


                    <!-- ERRO -->

                    <Border
                        IsVisible="{Binding HasError}"
                        Style="{StaticResource StatusBadgeStyle}"
                        Stroke="{StaticResource ErrorDark}">

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="{StaticResource ErrorDark}"
                            FontSize="14" />

                    </Border>


                    <!-- EMAIL -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Email"
                            Style="{StaticResource BodyEmphasisStyle}" />

                        <Border Style="{StaticResource InputCardStyle}">

                            <Entry
                                Placeholder="email@exemplo.com"
                                Text="{Binding Email}"
                                Keyboard="Email"
                                ReturnType="Next" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Password"
                            Style="{StaticResource BodyEmphasisStyle}" />

                        <Border Style="{StaticResource InputCardStyle}">

                            <Entry
                                Placeholder="Password"
                                Text="{Binding Password}"
                                IsPassword="True"
                                ReturnType="Done"
                                ReturnCommand="{Binding LoginCommand}" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- BOTÃO LOGIN -->

                    <Button
                        Text="Entrar"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />


                    <!-- LOADING -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource AccentDark}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Border>


            <!-- CRIAR CONTA -->

            <Border Style="{StaticResource CardElevatedStyle}">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Ainda não tem conta?"
                        FontFamily="OpenSansSemibold"
                        FontSize="17"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Crie o seu perfil de passageiro diretamente na aplicação."
                        Style="{StaticResource CaptionStyle}"
                        HorizontalTextAlignment="Center" />

                    <Button
                        Text="Criar conta"
                        Clicked="OnRegisterClicked"
                        Style="{StaticResource TextButtonStyle}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>