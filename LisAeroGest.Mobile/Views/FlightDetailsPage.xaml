<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:Class="LisAeroGest.Mobile.Views.FlightDetailsPage"
    x:DataType="vm:FlightDetailsViewModel"
    Title="Detalhes do voo"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="16">


            <!-- =====================================================
                 CARREGAMENTO
            ====================================================== -->

            <HorizontalStackLayout
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Spacing="8">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    Color="{StaticResource AccentDark}" />

                <Label
                    Text="A carregar voo..."
                    Style="{StaticResource CaptionStyle}"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>


            <!-- =====================================================
                 ERRO
            ====================================================== -->

            <Border
                IsVisible="{Binding HasError}"
                Padding="14"
                BackgroundColor="#1AEF4444"
                Stroke="#EF4444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF4444"
                    FontSize="13"
                    LineBreakMode="WordWrap" />

            </Border>


            <!-- =====================================================
                 SUCESSO
            ====================================================== -->

            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="14"
                BackgroundColor="#1A22C55E"
                Stroke="#22C55E"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="{Binding SuccessMessage}"
                    TextColor="#22C55E"
                    FontSize="13"
                    LineBreakMode="WordWrap" />

            </Border>


            <!-- =====================================================
                 DETALHES DO VOO
            ====================================================== -->

            <VerticalStackLayout
                IsVisible="{Binding HasFlight}"
                Spacing="16">


                <!-- VOO -->

                <VerticalStackLayout
                    Spacing="4">

                    <Label
                        Text="{Binding Flight.FlightNumber}"
                        FontSize="28"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="{StaticResource AccentDark}" />

                    <Label
                        Text="{Binding Flight.Status}"
                        FontSize="16"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>


                <!-- =================================================
                     ROTA
                ================================================== -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Padding="18">

                    <Grid
                        ColumnDefinitions="*,Auto,*"
                        ColumnSpacing="12">

                        <!-- ORIGEM -->

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="ORIGEM"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.OriginCode}"
                                FontSize="24"
                                FontFamily="OpenSansSemibold" />

                            <Label
                                Text="{Binding Flight.Origin}"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>


                        <!-- SETA -->

                        <Label
                            Grid.Column="1"
                            Text="→"
                            FontSize="26"
                            VerticalOptions="Center"
                            TextColor="{StaticResource AccentDark}" />


                        <!-- DESTINO -->

                        <VerticalStackLayout
                            Grid.Column="2"
                            Spacing="3">

                            <Label
                                Text="DESTINO"
                                Style="{StaticResource FootnoteStyle}"
                                HorizontalTextAlignment="End" />

                            <Label
                                Text="{Binding Flight.DestinationCode}"
                                FontSize="24"
                                FontFamily="OpenSansSemibold"
                                HorizontalTextAlignment="End" />

                            <Label
                                Text="{Binding Flight.Destination}"
                                Style="{StaticResource CaptionStyle}"
                                HorizontalTextAlignment="End" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- =================================================
                     INFORMAÇÕES
                ================================================== -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Padding="18">

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="18"
                        RowSpacing="16">


                        <!-- PARTIDA -->

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="PARTIDA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.DepartureTime,
                                    StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>


                        <!-- CHEGADA -->

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="CHEGADA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.ArrivalTime,
                                    StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>


                        <!-- COMPANHIA -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="COMPANHIA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.AirlineName}"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>


                        <!-- PORTA -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="PORTA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.Gate}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AccentDark}" />

                        </VerticalStackLayout>


                        <!-- AERONAVE -->

                        <VerticalStackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="AERONAVE"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.AircraftModel}"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>


                        <!-- DURAÇÃO -->

                        <VerticalStackLayout
                            Grid.Row="2"
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="DURAÇÃO"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.DurationLabel}"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>


                        <!-- PREÇO -->

                        <VerticalStackLayout
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Spacing="3">

                            <Label
                                Text="PREÇO BASE"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Flight.PriceLabel}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AccentDark}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- =================================================
                     AÇÕES
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                    <!-- FAVORITO -->

                    <Button
                        Text="{Binding FavoriteButtonText}"
                        Command="{Binding ToggleFavoriteCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />


                    <!-- RESERVAR -->

                    <Button
                        Grid.Column="1"
                        Text="Escolher lugar"
                        Command="{Binding SelectSeatCommand}" />

                </Grid>

            </VerticalStackLayout>


            <!-- =====================================================
                 ATUALIZAR
            ====================================================== -->

            <Button
                Text="Atualizar"
                Command="{Binding LoadCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                IsEnabled="{Binding IsBusy,
                    Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>