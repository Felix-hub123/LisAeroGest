<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    x:Class="LisAeroGest.Mobile.Views.HistoryPage"
    x:DataType="vm:HistoryViewModel"
    x:Name="Root"
    Title="Histórico"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <Grid
        RowDefinitions="Auto,*">


        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <VerticalStackLayout
            Padding="24,30,24,16"
            Spacing="4">

            <Label
                Text="HISTÓRICO"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                TextColor="{AppThemeBinding
                    Light={StaticResource TextSecondary},
                    Dark={StaticResource TextSecondaryDark}}" />

            <Label
                Text="As tuas viagens anteriores"
                Style="{StaticResource TitleStyle}" />

            <Label
                Text="Consulta os voos que já realizaste."
                Style="{StaticResource CaptionStyle}" />

        </VerticalStackLayout>


        <!-- =====================================================
             LISTA
        ====================================================== -->

        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Tickets}">


                <!-- =============================================
                     CABEÇALHO DA LISTA
                ============================================== -->

                <CollectionView.Header>

                    <VerticalStackLayout
                        Padding="24,0,24,8">


                        <!-- ERRO -->

                        <Border
                            IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.HasError}"
                            Padding="14"
                            BackgroundColor="#1AEF4444"
                            Stroke="#EF4444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">

                            <Label
                                Text="{Binding Source={x:Reference Root}, Path=BindingContext.ErrorMessage}"
                                FontSize="13"
                                TextColor="#EF4444"
                                LineBreakMode="WordWrap" />

                        </Border>

                    </VerticalStackLayout>

                </CollectionView.Header>


                <!-- =============================================
                     SEM HISTÓRICO
                ============================================== -->

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="36,55"
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Label
                            Text="✈"
                            FontSize="44"
                            TextColor="{StaticResource AccentDark}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Ainda não existem viagens concluídas"
                            Style="{StaticResource Title2Style}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Os teus voos anteriores irão aparecer aqui depois da data de partida."
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <!-- =============================================
                     VIAGEM
                ============================================== -->

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:TicketDto">

                        <Border
                            Style="{StaticResource CardStyle}"
                            Margin="24,6"
                            Padding="16">

                            <VerticalStackLayout
                                Spacing="12">


                                <!-- VOO / ESTADO -->

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">

                                    <VerticalStackLayout
                                        Spacing="2">

                                        <Label
                                            Text="VOO"
                                            Style="{StaticResource FootnoteStyle}" />

                                        <Label
                                            Text="{Binding FlightNumber}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="21" />

                                    </VerticalStackLayout>


                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource StatusBadgeStyle}"
                                        Padding="10,5"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Status}"
                                            Style="{StaticResource FootnoteStyle}"
                                            TextColor="{StaticResource AccentDark}" />

                                    </Border>

                                </Grid>


                                <!-- ROTA -->

                                <Grid
                                    ColumnDefinitions="*,Auto,*"
                                    ColumnSpacing="10">

                                    <Label
                                        Text="{Binding Origin}"
                                        FontSize="18"
                                        FontFamily="OpenSansSemibold"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        Text="→"
                                        FontSize="20"
                                        TextColor="{StaticResource AccentDark}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Destination}"
                                        FontSize="18"
                                        FontFamily="OpenSansSemibold"
                                        HorizontalTextAlignment="End"
                                        VerticalOptions="Center" />

                                </Grid>


                                <!-- SEPARADOR -->

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="{AppThemeBinding
                                        Light={StaticResource Border},
                                        Dark={StaticResource BorderDark}}" />


                                <!-- INFORMAÇÕES -->

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="PARTIDA"
                                            Style="{StaticResource FootnoteStyle}" />

                                        <Label
                                            Text="{Binding DepartureTime,
                                                StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                            Style="{StaticResource CaptionStyle}" />

                                    </VerticalStackLayout>


                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="LUGAR"
                                            Style="{StaticResource FootnoteStyle}" />

                                        <Label
                                            Text="{Binding SeatCode}"
                                            Style="{StaticResource CaptionStyle}" />

                                    </VerticalStackLayout>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>