<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:Class="LisAeroGest.Mobile.Views.MyTripPage"
    x:DataType="vm:MyTripViewModel"
    Title="A minha viagem"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <RefreshView
        Command="{Binding LoadCommand}"
        IsRefreshing="{Binding IsBusy}">

        <ScrollView>

            <VerticalStackLayout
                Padding="24,34,24,34"
                Spacing="20">


                <!-- =================================================
                     CABEÇALHO
                ================================================== -->

                <VerticalStackLayout
                    Spacing="3">

                    <Label
                        Text="A MINHA VIAGEM"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextSecondary},
                            Dark={StaticResource TextSecondaryDark}}" />

                    <Label
                        Text="Tudo pronto para partir?"
                        Style="{StaticResource TitleStyle}" />

                    <Label
                        Text="Acompanha aqui a tua próxima viagem."
                        Style="{StaticResource CaptionStyle}" />

                </VerticalStackLayout>


                <!-- =================================================
                     ERRO
                ================================================== -->

                <Border
                    IsVisible="{Binding HasError}"
                    Padding="14"
                    BackgroundColor="#1AEF4444"
                    Stroke="#EF4444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">

                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="#EF4444"
                        LineBreakMode="WordWrap" />

                </Border>


                <!-- =================================================
                     VIAGEM
                ================================================== -->

                <Border
                    IsVisible="{Binding TripCardIsVisible}"
                    Style="{StaticResource CardElevatedStyle}"
                    Stroke="{StaticResource AccentDark}"
                    StrokeThickness="1.2">

                    <VerticalStackLayout
                        Spacing="16">


                        <!-- VOO / ESTADO -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Spacing="3">

                                <Label
                                    Text="PRÓXIMO VOO"
                                    Style="{StaticResource FootnoteStyle}" />

                                <Label
                                    Text="{Binding TripFlightNumber}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="25" />

                                <Label
                                    Text="{Binding TripRoute}"
                                    Style="{StaticResource CaptionStyle}" />

                            </VerticalStackLayout>


                            <Border
                                Grid.Column="1"
                                Style="{StaticResource StatusBadgeStyle}"
                                Stroke="{StaticResource AccentDark}"
                                Padding="10,5"
                                VerticalOptions="Start">

                                <Label
                                    Text="{Binding TripStatus}"
                                    FontSize="10"
                                    TextColor="{StaticResource AccentDark}"
                                    FontFamily="OpenSansSemibold" />

                            </Border>

                        </Grid>


                        <!-- SEPARADOR -->

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding
                                Light={StaticResource Border},
                                Dark={StaticResource BorderDark}}" />


                        <!-- PARTIDA / LUGAR -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="18">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="PARTIDA"
                                    Style="{StaticResource FootnoteStyle}" />

                                <Label
                                    Text="{Binding TripDeparture}"
                                    FontSize="18"
                                    FontFamily="OpenSansSemibold" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3">

                                <Label
                                    Text="LUGAR"
                                    Style="{StaticResource FootnoteStyle}" />

                                <Label
                                    Text="{Binding TripSeat}"
                                    FontSize="21"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{StaticResource AccentDark}" />

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     PROGRESSO
                ================================================== -->

                <VerticalStackLayout
                    IsVisible="{Binding TimelineSectionIsVisible}"
                    Spacing="14">

                    <Label
                        Text="ESTADO DA VIAGEM"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextSecondary},
                            Dark={StaticResource TextSecondaryDark}}" />


                    <Border
                        Style="{StaticResource CardStyle}"
                        Padding="18">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="18">


                            <!-- RESERVA -->

                            <Border
                                Grid.Row="0"
                                Style="{StaticResource GlassIconBadgeStyle}">

                                <Label
                                    Text="✓"
                                    FontSize="20"
                                    TextColor="{StaticResource AccentDark}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>


                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                Spacing="3">

                                <Label
                                    Text="Reserva confirmada"
                                    Style="{StaticResource BodyEmphasisStyle}" />

                                <Label
                                    Text="{Binding TripSeatDetail}"
                                    Style="{StaticResource CaptionStyle}" />

                            </VerticalStackLayout>


                            <!-- CHECK-IN -->

                            <Border
                                Grid.Row="1"
                                Style="{StaticResource GlassIconBadgeStyle}">

                                <Label
                                    Text="{Binding CheckInIconLabel}"
                                    FontSize="20"
                                    TextColor="{StaticResource AccentDark}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>


                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="1"
                                Spacing="3">

                                <Label
                                    Text="{Binding CheckInTitle}"
                                    Style="{StaticResource BodyEmphasisStyle}" />

                                <Label
                                    Text="{Binding CheckInSubtitle}"
                                    Style="{StaticResource CaptionStyle}"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- =================================================
                     CHECK-IN
                ================================================== -->

                <Button
                    Text="Fazer check-in"
                    IsVisible="{Binding CheckInButtonIsVisible}"
                    Clicked="OnCheckInClicked" />


                <!-- =================================================
                     SEM VIAGEM
                ================================================== -->

                <Border
                    IsVisible="{Binding EmptyCardIsVisible}"
                    Style="{StaticResource CardStyle}"
                    Padding="24">

                    <VerticalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Border
                            Style="{StaticResource GlassIconBadgeStyle}">

                            <Label
                                Text="✈"
                                FontSize="22"
                                TextColor="{StaticResource AccentDark}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <Label
                            Text="Ainda não tens uma viagem agendada"
                            Style="{StaticResource Title2Style}"
                            HorizontalTextAlignment="Center" />


                        <Label
                            Text="Quando tiveres um bilhete para um voo futuro, a tua próxima viagem aparecerá aqui."
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     CARTEIRA
                ================================================== -->

                <Button
                    Text="Abrir carteira"
                    Clicked="OnVerBilhetesClicked"
                    Style="{StaticResource SecondaryButtonStyle}" />

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>