<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LisAeroGest.Mobile.Views.MyTripPage"
             Title="Viagem"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="24,34,24,34" Spacing="20">

                <VerticalStackLayout Spacing="3">
                    <Label Text="MY TRIP" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="Tudo pronto para partir?" Style="{StaticResource TitleStyle}" />
                </VerticalStackLayout>

                <Label x:Name="StatusLabel" Text="A carregar a tua viagem…" Style="{StaticResource FootnoteStyle}" />

                <!-- Tem viagem: dados reais do bilhete com partida mais próxima -->
                <Border x:Name="TripCard" Style="{StaticResource CardElevatedStyle}" Stroke="{StaticResource AccentDark}" StrokeThickness="1.2" IsVisible="False">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label x:Name="TripFlightNumber" Text="—" FontFamily="OpenSansSemibold" FontSize="25" />
                                <Label x:Name="TripRoute" Text="—" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" Stroke="{StaticResource AccentDark}" Padding="10,5">
                                <Label x:Name="TripStatus" Text="—" FontSize="10" TextColor="{StaticResource AccentDark}" FontFamily="OpenSansSemibold" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}" />
                        <Grid ColumnDefinitions="*,*">
                            <VerticalStackLayout>
                                <Label Text="PARTIDA" Style="{StaticResource FootnoteStyle}" />
                                <Label x:Name="TripDeparture" Text="—" FontSize="21" FontFamily="OpenSansSemibold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="LUGAR" Style="{StaticResource FootnoteStyle}" />
                                <Label x:Name="TripSeat" Text="—" FontSize="21" FontFamily="OpenSansSemibold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="TimelineSection" Spacing="14" IsVisible="False">
                    <Label Text="JOURNEY STATUS" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                            <Border Style="{StaticResource GlassIconBadgeStyle}">
                                <Label Text="✓" FontSize="20" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Reserva confirmada" Style="{StaticResource BodyEmphasisStyle}" />
                                <Label x:Name="TripSeatDetail" Text="—" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>

                            <Border Grid.Row="1" x:Name="CheckInIcon" Style="{StaticResource GlassIconBadgeStyle}">
                                <Label x:Name="CheckInIconLabel" Text="→" FontSize="20" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label x:Name="CheckInTitle" Text="Check-in disponível" Style="{StaticResource BodyEmphasisStyle}" />
                                <Label x:Name="CheckInSubtitle" Text="Gera o teu cartão de embarque antes da partida" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button x:Name="CheckInButton" Text="Fazer check-in" Clicked="OnCheckInClicked" IsVisible="False" />

                <!-- Sem viagem: estado vazio honesto -->
                <Border x:Name="EmptyCard" Style="{StaticResource CardStyle}" IsVisible="False">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border Style="{StaticResource GlassIconBadgeStyle}">
                            <Label Text="🧭" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Ainda não tens nenhuma viagem em curso" Style="{StaticResource Title2Style}" HorizontalTextAlignment="Center" />
                        <Label Text="Quando comprares um bilhete, o progresso da tua viagem aparece aqui." Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Abrir carteira" Clicked="OnVerBilhetesClicked" Style="{StaticResource SecondaryButtonStyle}" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
