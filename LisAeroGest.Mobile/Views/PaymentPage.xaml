<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:Class="LisAeroGest.Mobile.Views.PaymentPage"
    x:DataType="vm:PaymentViewModel"
    Title="Pagamento"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,30"
            Spacing="18">


            <!-- =====================================================
                 CABEÇALHO
            ====================================================== -->

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="PAGAMENTO"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    TextColor="{AppThemeBinding
                        Light={StaticResource TextSecondary},
                        Dark={StaticResource TextSecondaryDark}}" />

                <Label
                    Text="Confirma a tua viagem"
                    Style="{StaticResource TitleStyle}" />

                <Label
                    Text="Finaliza a reserva através da simulação MB WAY."
                    Style="{StaticResource CaptionStyle}" />

            </VerticalStackLayout>


            <!-- =====================================================
                 LOADING
            ====================================================== -->

            <HorizontalStackLayout
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Spacing="8">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    Color="{StaticResource AccentDark}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="{Binding StatusMessage}"
                    Style="{StaticResource CaptionStyle}"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>


            <!-- =====================================================
                 ERRO
            ====================================================== -->

            <Border
                IsVisible="{Binding HasError}"
                Padding="14"
                BackgroundColor="#1AEF4444"
                Stroke="#EF4444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Text="!"
                        FontSize="20"
                        FontFamily="OpenSansSemibold"
                        TextColor="#EF4444"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2">

                        <Label
                            Text="Não foi possível concluir"
                            FontSize="13"
                            FontFamily="OpenSansSemibold"
                            TextColor="#EF4444" />

                        <Label
                            Text="{Binding ErrorMessage}"
                            FontSize="12"
                            TextColor="#EF4444"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- =====================================================
                 SUCESSO
            ====================================================== -->

            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="14"
                BackgroundColor="#1A22C55E"
                Stroke="#22C55E"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Text="✓"
                        FontSize="20"
                        FontFamily="OpenSansSemibold"
                        TextColor="#22C55E"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2">

                        <Label
                            Text="Operação concluída"
                            FontSize="13"
                            FontFamily="OpenSansSemibold"
                            TextColor="#22C55E" />

                        <Label
                            Text="{Binding SuccessMessage}"
                            FontSize="12"
                            TextColor="#22C55E"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- =====================================================
                 RESUMO DA VIAGEM
            ====================================================== -->

            <Border
                Style="{StaticResource CardElevatedStyle}"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="RESUMO DA VIAGEM"
                        Style="{StaticResource FootnoteStyle}" />

                    <Label
                        Text="{Binding FlightNumber}"
                        FontFamily="OpenSansSemibold"
                        FontSize="25"
                        TextColor="{StaticResource AccentDark}" />

                    <Label
                        Text="{Binding SeatCode,
                            StringFormat='Lugar {0}'}"
                        Style="{StaticResource BodyEmphasisStyle}" />

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource Border},
                            Dark={StaticResource BorderDark}}" />

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Total"
                            Style="{StaticResource CaptionStyle}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding Price}"
                            FontSize="24"
                            FontFamily="OpenSansSemibold" />

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- =====================================================
                 MB WAY
            ====================================================== -->

            <Border
                Style="{StaticResource CardStyle}"
                Padding="20">

                <VerticalStackLayout Spacing="14">


                    <!-- =================================================
                         CABEÇALHO MB WAY
                    ================================================== -->

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12">

                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource AccentDark}">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                Text="MB"
                                TextColor="White"
                                FontSize="15"
                                FontFamily="OpenSansSemibold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="2">

                            <Label
                                Text="MB WAY"
                                FontSize="19"
                                FontFamily="OpenSansSemibold" />

                            <Label
                                Text="Simulação de pagamento"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource Border},
                            Dark={StaticResource BorderDark}}" />


                    <!-- =================================================
                         TELEFONE
                    ================================================== -->

                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Número de telemóvel"
                            Style="{StaticResource BodyEmphasisStyle}" />

                        <Border
                            Style="{StaticResource InputCardStyle}"
                            Padding="6">

                            <Entry
                                Text="{Binding PhoneNumber}"
                                Placeholder="9XX XXX XXX"
                                Keyboard="Telephone"
                                MaxLength="16"
                                ReturnType="Done"
                                BackgroundColor="Transparent" />

                        </Border>

                        <Label
                            Text="Será enviado um pedido de pagamento simulado para este número."
                            Style="{StaticResource CaptionStyle}" />

                    </VerticalStackLayout>


                    <!-- =================================================
                         ENVIAR PEDIDO
                    ================================================== -->

                    <Button
                        Text="Enviar pedido MB WAY"
                        Command="{Binding StartPaymentCommand}"
                        IsVisible="{Binding PaymentRequestSent,
                            Converter={StaticResource InvertedBoolConverter}}"
                        IsEnabled="{Binding IsBusy,
                            Converter={StaticResource InvertedBoolConverter}}" />

                </VerticalStackLayout>

            </Border>


            <!-- =====================================================
                 PEDIDO MB WAY ENVIADO
            ====================================================== -->

            <Border
                Style="{StaticResource CardElevatedStyle}"
                Padding="20"
                IsVisible="{Binding PaymentRequestSent}">

                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Fill">

                    <Label
                        Text="✓"
                        FontSize="34"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource AccentDark}" />

                    <Label
                        Text="Pedido enviado"
                        FontSize="20"
                        FontFamily="OpenSansSemibold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Simula a autorização do pagamento MB WAY para concluir a compra."
                        Style="{StaticResource CaptionStyle}"
                        HorizontalTextAlignment="Center" />


                    <Grid
                        Margin="0,6,0,0"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Valor"
                            Style="{StaticResource CaptionStyle}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding Price}"
                            FontSize="21"
                            FontFamily="OpenSansSemibold" />

                    </Grid>


                    <Button
                        Margin="0,8,0,0"
                        Text="Autorizar pagamento"
                        Command="{Binding ConfirmPaymentCommand}"
                        IsEnabled="{Binding IsBusy,
                            Converter={StaticResource InvertedBoolConverter}}" />

                </VerticalStackLayout>

            </Border>


            <!-- =====================================================
                 AMBIENTE DE DEMONSTRAÇÃO
            ====================================================== -->

            <Border
                Style="{StaticResource CardStyle}"
                Padding="16">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Text="ⓘ"
                        FontSize="20"
                        VerticalOptions="Start"
                        TextColor="{StaticResource AccentDark}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="5">

                        <Label
                            Text="Ambiente de demonstração"
                            Style="{StaticResource BodyEmphasisStyle}" />

                        <Label
                            Text="Este é um simulador académico. Nenhuma transação MB WAY real será efetuada e não são recolhidos dados bancários."
                            Style="{StaticResource CaptionStyle}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>