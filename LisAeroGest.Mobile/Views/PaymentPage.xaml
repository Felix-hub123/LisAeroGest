<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             x:Class="LisAeroGest.Mobile.Views.PaymentPage"
             x:DataType="vm:PaymentViewModel"
             Title="Pagamento"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <ScrollView>
        <VerticalStackLayout Padding="24,30" Spacing="18">
            <Label Text="PAGAMENTO" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
            <Label Text="Confirma a tua viagem" Style="{StaticResource TitleStyle}" />

            <Border Style="{StaticResource CardElevatedStyle}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding FlightNumber}" FontFamily="OpenSansSemibold" FontSize="25" TextColor="{StaticResource AccentDark}" />
                    <Label Text="{Binding SeatCode, StringFormat='Lugar {0}'}" Style="{StaticResource BodyEmphasisStyle}" />
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Total" Style="{StaticResource CaptionStyle}" />
                        <Label Grid.Column="1" Text="{Binding Price}" FontSize="24" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pagamento seguro" Style="{StaticResource BodyEmphasisStyle}" />
                    <Label Text="O pagamento é processado pelo PayPal Sandbox. Não guardamos dados do cartão na aplicação." Style="{StaticResource CaptionStyle}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />

            <Button Text="Pagar com PayPal" Command="{Binding StartPaymentCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <Button Text="Já concluí o pagamento" Command="{Binding ConfirmPaymentCommand}" Style="{StaticResource SecondaryButtonStyle}" IsVisible="{Binding PaymentStarted}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
