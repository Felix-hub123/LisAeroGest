<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LisAeroGest.Mobile.Views.TicketsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
             x:DataType="vm:TicketsViewModel"
             x:Name="TicketsPageRoot"
             Title="Bilhetes"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="24,28,24,14" ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="BILHETES" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Text="As tuas viagens" Style="{StaticResource TitleStyle}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentDark}" />
        </Grid>
        <RefreshView Grid.Row="1" Command="{Binding LoadTicketsCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Tickets}" SelectionMode="None" EmptyView="Ainda não tens bilhetes.">
                <CollectionView.EmptyViewTemplate>
                    <DataTemplate><VerticalStackLayout Padding="24,60" Spacing="12"><Border Style="{StaticResource GlassIconBadgeStyle}"><Label Text="✈" FontSize="23" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" /></Border><Label Text="Ainda não tens bilhetes" Style="{StaticResource Title2Style}" HorizontalTextAlignment="Center" /><Label Text="Pesquisa um voo para começares a tua próxima viagem." Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" /></VerticalStackLayout></DataTemplate>
                </CollectionView.EmptyViewTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TicketDto">
                        <Border Style="{StaticResource CardStyle}" Margin="24,7" Padding="18">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference TicketsPageRoot}, Path=BindingContext.OpenTicketCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding FlightNumber}" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" /><Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource FootnoteStyle}" TextColor="{StaticResource AccentDark}" /></Grid>
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8"><VerticalStackLayout><Label Text="DE" Style="{StaticResource FootnoteStyle}" /><Label Text="{Binding Origin}" FontSize="20" FontFamily="OpenSansSemibold" /></VerticalStackLayout><Label Grid.Column="1" Text="→" FontSize="22" TextColor="{StaticResource AccentDark}" VerticalOptions="Center" /><VerticalStackLayout Grid.Column="2"><Label Text="PARA" Style="{StaticResource FootnoteStyle}" /><Label Text="{Binding Destination}" FontSize="20" FontFamily="OpenSansSemibold" /></VerticalStackLayout></Grid>
                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}" />
                                <Grid ColumnDefinitions="*,*"><Label Text="{Binding DepartureTime, StringFormat='Partida: {0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource CaptionStyle}" /><Label Grid.Column="1" Text="{Binding SeatCode, StringFormat='Lugar: {0}'}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="End" /></Grid>
                                <Button Text="Fazer check-in" Clicked="OnCheckInClicked" IsVisible="{Binding Status, Converter={StaticResource StatusIsPaidConverter}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
