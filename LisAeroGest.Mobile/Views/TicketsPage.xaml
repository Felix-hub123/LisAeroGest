<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LisAeroGest.Mobile.Views.TicketsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    x:DataType="vm:TicketsViewModel"
    x:Name="TicketsPageRoot"
    Title="Bilhetes"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <Grid
        RowDefinitions="Auto,*">


        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <Grid
            Grid.Row="0"
            Padding="24,28,24,14"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout
                Spacing="3">

                <Label
                    Text="CARTEIRA"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    TextColor="{AppThemeBinding
                        Light={StaticResource TextSecondary},
                        Dark={StaticResource TextSecondaryDark}}" />

                <Label
                    Text="Os teus bilhetes"
                    Style="{StaticResource TitleStyle}" />

                <Label
                    Text="Consulta as tuas viagens e dados de embarque."
                    Style="{StaticResource CaptionStyle}" />

            </VerticalStackLayout>


            <ActivityIndicator
                Grid.Column="1"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource AccentDark}"
                VerticalOptions="Center" />

        </Grid>


        <!-- =====================================================
             CONTEÚDO
        ====================================================== -->

        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadTicketsCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Tickets}"
                SelectionMode="None">


                <!-- =================================================
                     CABEÇALHO DA LISTA
                ================================================== -->

                <CollectionView.Header>

                    <VerticalStackLayout
                        Padding="24,0,24,8">


                        <!-- ERRO -->

                        <Border
                            IsVisible="{Binding Source={x:Reference TicketsPageRoot}, Path=BindingContext.HasError}"
                            Padding="14"
                            BackgroundColor="#1AEF4444"
                            Stroke="#EF4444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">

                            <Label
                                Text="{Binding Source={x:Reference TicketsPageRoot}, Path=BindingContext.ErrorMessage}"
                                FontSize="13"
                                TextColor="#EF4444"
                                LineBreakMode="WordWrap" />

                        </Border>

                    </VerticalStackLayout>

                </CollectionView.Header>


                <!-- =================================================
                     SEM BILHETES
                ================================================== -->

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="30,60"
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Border
                            Style="{StaticResource GlassIconBadgeStyle}">

                            <Label
                                Text="✈"
                                FontSize="23"
                                TextColor="{StaticResource AccentDark}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <Label
                            Text="Ainda não tens bilhetes"
                            Style="{StaticResource Title2Style}"
                            HorizontalTextAlignment="Center" />


                        <Label
                            Text="Pesquisa um voo e escolhe um lugar para começares a tua próxima viagem."
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <!-- =================================================
                     BILHETE
                ================================================== -->

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:TicketDto">

                        <Border
                            Style="{StaticResource CardStyle}"
                            Margin="24,7"
                            Padding="18">


                            <!-- ABRIR BILHETE -->

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference TicketsPageRoot}, Path=BindingContext.OpenTicketCommand}"
                                    CommandParameter="{Binding .}" />

                            </Border.GestureRecognizers>


                            <VerticalStackLayout
                                Spacing="12">


                                <!-- VOO / ESTADO -->

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">

                                    <VerticalStackLayout
                                        Spacing="2">

                                        <Label
                                            Text="VOO"
                                            Style="{StaticResource FootnoteStyle}" />

                                        <Label
                                            Text="{Binding FlightNumber}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="22"
                                            TextColor="{AppThemeBinding
                                                Light={StaticResource TextPrimary},
                                                Dark={StaticResource TextPrimaryDark}}" />

                                    </VerticalStackLayout>


                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource StatusBadgeStyle}"
                                        Padding="10,5"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Status}"
                                            Style="{StaticResource FootnoteStyle}"
                                            TextColor="{StaticResource AccentDark}" />

                                    </Border>

                                </Grid>


                                <!-- ROTA -->

                                <Grid
                                    ColumnDefinitions="*,Auto,*"
                                    ColumnSpacing="10">

                                    <!-- ORIGEM -->

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="2">

                                        <Label
                                            Text="DE"
                                            Style="{StaticResource FootnoteStyle}" />

                                        <Label
                                            Text="{Binding Origin}"
                                            FontSize="20"
                                            FontFamily="OpenSansSemibold" />

                                    </VerticalStackLayout>


                                    <!-- SETA -->

                                    <Label
                                        Grid.Column="1"
                                        Text="→"
                                        FontSize="22"
                                        TextColor="{StaticResource AccentDark}"
                                        VerticalOptions="Center" />


                                    <!-- DESTINO -->

                                    <VerticalStackLayout
                                        Grid.Column="2"
                                        Spacing="2">

                                        <Label
                                            Text="PARA"
                                            Style="{StaticResource FootnoteStyle}"
                                            HorizontalTextAlignment="End" />

                                        <Label
                                            Text="{Binding Destination}"
                                            FontSize="20"
                                            FontFamily="OpenSansSemibold"
                                            HorizontalTextAlignment="End" />

                                    </VerticalStackLayout>

                                </Grid>


                                <!-- SEPARADOR -->

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="{AppThemeBinding
                                        Light={StaticResource Border},
                                        Dark={StaticResource BorderDark}}" />


                                <!-- DATA / LUGAR -->

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="2">

                                        <Label
                                            Text="PARTIDA"
                                            Style="{StaticResource FootnoteStyle}" />

                                        <Label
                                            Text="{Binding DepartureTime,
                                                StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                            Style="{StaticResource CaptionStyle}" />

                                    </VerticalStackLayout>


                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="2">

                                        <Label
                                            Text="LUGAR"
                                            Style="{StaticResource FootnoteStyle}"
                                            HorizontalTextAlignment="End" />

                                        <Label
                                            Text="{Binding SeatCode}"
                                            Style="{StaticResource CaptionStyle}"
                                            HorizontalTextAlignment="End" />

                                    </VerticalStackLayout>

                                </Grid>


                                <!-- CHECK-IN -->

                                <Button
                                    Text="Fazer check-in"
                                    Clicked="OnCheckInClicked"
                                    IsVisible="{Binding Status,
                                        Converter={StaticResource StatusIsPaidConverter}}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>