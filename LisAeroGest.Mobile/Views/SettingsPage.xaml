<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             x:Class="LisAeroGest.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Preferências"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <ScrollView>
        <VerticalStackLayout Padding="24,30,24,30" Spacing="18">
            <Label Text="PREFERÊNCIAS" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
            <Label Text="Personaliza a tua experiência" Style="{StaticResource TitleStyle}" />

            <Border Style="{StaticResource CardElevatedStyle}" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Aparência" Style="{StaticResource BodyEmphasisStyle}" />
                            <Label Text="Tema atual" Style="{StaticResource CaptionStyle}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ThemeLabel}" TextColor="{StaticResource AccentDark}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="Sistema" Command="{Binding SetThemeCommand}" CommandParameter="system" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="1" Text="Claro" Command="{Binding SetThemeCommand}" CommandParameter="light" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Text="Escuro" Command="{Binding SetThemeCommand}" CommandParameter="dark" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Notificações" Style="{StaticResource BodyEmphasisStyle}" />
                        <Label Text="Permitir alertas e atualizações da viagem." Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="✓" FontSize="22" TextColor="{StaticResource AccentDark}" />
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="As preferências são guardadas neste dispositivo." Style="{StaticResource BodyEmphasisStyle}" />
                        <Label Text="Funcionam tanto no Android Emulator como no Windows Machine." Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
