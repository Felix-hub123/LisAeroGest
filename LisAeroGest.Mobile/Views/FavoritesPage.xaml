<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
             x:Class="LisAeroGest.Mobile.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             x:Name="Root"
             Title="Favoritos"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="24,30,24,16" Spacing="3">
            <Label Text="FAVORITOS" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
            <Label Text="Voos guardados" Style="{StaticResource TitleStyle}" />
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Flights}" EmptyView="Ainda não tens voos favoritos.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FlightDetailDto">
                        <Border Style="{StaticResource CardStyle}" Margin="24,6" Padding="16">
                            <VerticalStackLayout Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding FlightNumber}" FontFamily="OpenSansSemibold" FontSize="22" />
                                    <Button Grid.Column="1" Text="★" Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveCommand}" CommandParameter="{Binding .}" Style="{StaticResource TextButtonStyle}" Padding="6" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <Label Text="{Binding OriginCode}" FontSize="18" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="1" Text="→" FontSize="20" TextColor="{StaticResource AccentDark}" />
                                    <Label Grid.Column="2" Text="{Binding DestinationCode}" FontSize="18" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" />
                                </Grid>
                                <Label Text="{Binding DepartureTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource CaptionStyle}" />
                                <Button Text="Ver voo" Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenFlightCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButtonStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
