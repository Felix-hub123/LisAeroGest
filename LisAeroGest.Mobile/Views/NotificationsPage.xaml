<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    x:Class="LisAeroGest.Mobile.Views.NotificationsPage"
    Title="Alertas"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,34,24,18"
            Spacing="3">

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout>

                    <Label
                        Text="ALERTAS"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextSecondary},
                            Dark={StaticResource TextSecondaryDark}}" />

                    <Label
                        Text="Atualizações da tua viagem"
                        Style="{StaticResource TitleStyle}" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource StatusBadgeStyle}"
                    Stroke="{StaticResource AccentDark}"
                    Padding="10,5">

                    <Label
                        Text="{Binding UnreadLabel}"
                        FontSize="11"
                        TextColor="{StaticResource AccentDark}" />

                </Border>

            </Grid>

            <Label
                Text="{Binding StatusLabel}"
                Style="{StaticResource FootnoteStyle}" />

        </VerticalStackLayout>


        <!-- NOTIFICAÇÕES -->

        <RefreshView
            Grid.Row="1"
            x:Name="Refresh"
            Refreshing="OnRefreshing">

            <CollectionView
                ItemsSource="{Binding Notifications}"
                SelectionMode="Single"
                SelectionChanged="OnNotificationSelected"
                EmptyView="Ainda não existem alertas para a tua conta.">

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:NotificationDto">

                        <Border
                            Style="{StaticResource CardStyle}"
                            Margin="24,6"
                            Padding="16">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <!-- ÍCONE -->

                                <Border
                                    Style="{StaticResource GlassIconBadgeStyle}">

                                    <Label
                                        Text="!"
                                        FontSize="20"
                                        TextColor="{StaticResource AccentDark}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>


                                <!-- CONTEÚDO -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            Text="{Binding Title}"
                                            Style="{StaticResource Title2Style}" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding CreatedAt,
                                                StringFormat='{0:dd/MM HH:mm}'}"
                                            Style="{StaticResource FootnoteStyle}" />

                                    </Grid>


                                    <Label
                                        Text="{Binding Message}"
                                        Style="{StaticResource CaptionStyle}" />


                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            Text="{Binding Type}"
                                            Style="{StaticResource FootnoteStyle}"
                                            TextColor="{StaticResource AccentDark}" />

                                        <!-- INDICADOR NÃO LIDA -->

                                        <Label
                                            Grid.Column="1"
                                            Text="●"
                                            FontSize="14"
                                            TextColor="{StaticResource AccentDark}"
                                            IsVisible="{Binding IsUnread}" />

                                    </Grid>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>