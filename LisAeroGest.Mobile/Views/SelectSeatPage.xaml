<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    x:Class="LisAeroGest.Mobile.Views.SelectSeatPage"
    x:DataType="vm:SelectSeatViewModel"
    Title="Selecionar lugar"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Padding="16"
        RowSpacing="12">


        <!-- ================================================= -->
        <!-- CABEÇALHO -->
        <!-- ================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="12">

            <Label
                Text="Escolhe o teu lugar"
                FontSize="22"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center" />

            <Label
                Text="Seleciona um dos lugares disponíveis"
                FontSize="12"
                Opacity="0.7"
                HorizontalOptions="Center" />


            <!-- ============================================= -->
            <!-- LEGENDA -->
            <!-- ============================================= -->

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="14">


                <!-- DISPONÍVEL -->

                <HorizontalStackLayout Spacing="5">

                    <Border
                        WidthRequest="15"
                        HeightRequest="15"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource AccentDark}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 4" />

                    <Label
                        Text="Disponível"
                        FontSize="10"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>


                <!-- SELECIONADO -->

                <HorizontalStackLayout Spacing="5">

                    <Border
                        WidthRequest="15"
                        HeightRequest="15"
                        BackgroundColor="{StaticResource AccentDark}"
                        Stroke="{StaticResource AccentDark}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 4" />

                    <Label
                        Text="Selecionado"
                        FontSize="10"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>


                <!-- OCUPADO -->

                <HorizontalStackLayout Spacing="5">

                    <Border
                        WidthRequest="15"
                        HeightRequest="15"
                        BackgroundColor="#7F1D1D"
                        Stroke="#EF4444"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 4" />

                    <Label
                        Text="Ocupado"
                        FontSize="10"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </HorizontalStackLayout>

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource AccentDark}"
            HorizontalOptions="Center" />


        <!-- ================================================= -->
        <!-- LUGARES -->
        <!-- ================================================= -->

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Seats}"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20,50"
                    Spacing="8">

                    <Label
                        Text="✈"
                        FontSize="35"
                        HorizontalOptions="Center"
                        TextColor="{StaticResource AccentDark}" />

                    <Label
                        Text="Não existem lugares disponíveis para apresentar."
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center"
                        FontFamily="OpenSansSemibold" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <!-- ============================================= -->
            <!-- GRELHA -->
            <!-- ============================================= -->

            <CollectionView.ItemsLayout>

                <GridItemsLayout
                    Orientation="Vertical"
                    Span="3"
                    HorizontalItemSpacing="8"
                    VerticalItemSpacing="8" />

            </CollectionView.ItemsLayout>


            <!-- ============================================= -->
            <!-- LUGAR -->
            <!-- ============================================= -->

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:SeatDto">

                    <Border
                        Padding="8"
                        MinimumHeightRequest="88"
                        Stroke="{StaticResource AccentDark}"
                        BackgroundColor="Transparent"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 10">

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding
                                    Source={RelativeSource
                                    AncestorType={x:Type vm:SelectSeatViewModel}},
                                    Path=SelectSeatCommand}"
                                CommandParameter="{Binding .}" />

                        </Border.GestureRecognizers>


                        <!-- ================================= -->
                        <!-- ESTADOS VISUAIS -->
                        <!-- ================================= -->

                        <Border.Triggers>


                            <!-- OCUPADO -->

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding IsAvailable}"
                                Value="False">

                                <Setter
                                    Property="Stroke"
                                    Value="#EF4444" />

                                <Setter
                                    Property="BackgroundColor"
                                    Value="#7F1D1D" />

                                <Setter
                                    Property="Opacity"
                                    Value="0.75" />

                            </DataTrigger>


                            <!-- SELECIONADO -->

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding IsSelected}"
                                Value="True">

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource AccentDark}" />

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource AccentDark}" />

                                <Setter
                                    Property="Opacity"
                                    Value="1" />

                            </DataTrigger>

                        </Border.Triggers>


                        <!-- ================================= -->
                        <!-- INFORMAÇÃO -->
                        <!-- ================================= -->

                        <VerticalStackLayout
                            Spacing="2"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Code}"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                HorizontalOptions="Center">

                                <Label.Triggers>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsAvailable}"
                                        Value="False">

                                        <Setter
                                            Property="TextColor"
                                            Value="White" />

                                    </DataTrigger>

                                </Label.Triggers>

                            </Label>


                            <Label
                                Text="{Binding SeatClass}"
                                FontSize="10"
                                HorizontalOptions="Center">

                                <Label.Triggers>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsAvailable}"
                                        Value="False">

                                        <Setter
                                            Property="TextColor"
                                            Value="White" />

                                    </DataTrigger>

                                </Label.Triggers>

                            </Label>


                            <Label
                                Text="{Binding DisplayPrice}"
                                FontSize="10"
                                HorizontalOptions="Center">

                                <Label.Triggers>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsAvailable}"
                                        Value="False">

                                        <Setter
                                            Property="TextColor"
                                            Value="White" />

                                    </DataTrigger>

                                </Label.Triggers>

                            </Label>


                            <!-- ESTADO -->

                            <Label
                                Text="{Binding StatusText}"
                                FontSize="9"
                                FontFamily="OpenSansSemibold"
                                HorizontalOptions="Center">

                                <Label.Triggers>

                                    <!-- OCUPADO -->

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsAvailable}"
                                        Value="False">

                                        <Setter
                                            Property="TextColor"
                                            Value="White" />

                                    </DataTrigger>


                                    <!-- SELECIONADO -->

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsSelected}"
                                        Value="True">

                                        <Setter
                                            Property="TextColor"
                                            Value="White" />

                                    </DataTrigger>

                                </Label.Triggers>

                            </Label>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- ================================================= -->
        <!-- RODAPÉ -->
        <!-- ================================================= -->

        <Border
            Grid.Row="3"
            Style="{StaticResource CardElevatedStyle}"
            Padding="14">

            <VerticalStackLayout Spacing="9">


                <!-- MENSAGEM -->

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{AppThemeBinding
                        Light={StaticResource Error},
                        Dark={StaticResource ErrorDark}}"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />


                <!-- LUGAR SELECIONADO -->

                <Label
                    Text="{Binding SelectedSeat.Code,
                        StringFormat='Lugar selecionado: {0}'}"
                    HorizontalOptions="Center"
                    FontFamily="OpenSansSemibold" />


                <!-- CONFIRMAR -->

                <Button
                    Text="Confirmar lugar"
                    Command="{Binding ConfirmSeatCommand}" />

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>