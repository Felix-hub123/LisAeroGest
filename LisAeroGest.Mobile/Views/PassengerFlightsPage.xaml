<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
             x:Class="LisAeroGest.Mobile.Views.PassengerFlightsPage"
             x:DataType="vm:FlightBoardViewModel"
             x:Name="Root"
             Title="Comprar voo"
             Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush}, Dark={StaticResource AppBackgroundGradientBrush}}">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="18,24,18,10" Padding="16">
            <VerticalStackLayout Spacing="12">
                <Label Text="ESCOLHER VIAGEM" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Text="Encontra o próximo voo" Style="{StaticResource Title2Style}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource InputCardStyle}"><SearchBar Placeholder="Origem" Text="{Binding FilterOrigin}" /></Border>
                    <Border Grid.Column="1" Style="{StaticResource InputCardStyle}"><SearchBar Placeholder="Destino" Text="{Binding FilterDestination}" /></Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <Button Text="‹" Command="{Binding PreviousDayCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Grid.Column="1" Text="Hoje" Command="{Binding GoToTodayCommand}" />
                    <Button Grid.Column="2" Text="›" Command="{Binding NextDayCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentDark}" />
        <RefreshView Grid.Row="2" Command="{Binding LoadDeparturesCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Departures}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,60" Spacing="10">
                        <Label Text="✈" FontSize="40" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" />
                        <Label Text="Nenhum voo encontrado" Style="{StaticResource Title2Style}" HorizontalTextAlignment="Center" />
                        <Label Text="Altera a data ou os aeroportos de origem/destino." Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FlightDto">
                        <Border Style="{StaticResource CardStyle}" Margin="18,6" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectFlightCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Text="{Binding FlightNumber}" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource FootnoteStyle}" TextColor="{StaticResource AccentDark}" />
                                <Label Grid.Row="1" Text="{Binding Origin}" Style="{StaticResource CaptionStyle}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="→" FontSize="20" TextColor="{StaticResource AccentDark}" />
                                <Label Grid.Row="2" Text="{Binding DepartureTime, StringFormat='Partida {0:HH:mm}'}" Style="{StaticResource FootnoteStyle}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Destination}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
