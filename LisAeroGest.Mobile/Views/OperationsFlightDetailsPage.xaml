<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    x:Class="LisAeroGest.Mobile.Views.OperationsFlightDetailsPage"
    x:DataType="vm:OperationsFlightDetailsViewModel"
    Title="Operação do voo"
    Background="{AppThemeBinding Light={StaticResource AppBackgroundLightBrush},
                                 Dark={StaticResource AppBackgroundGradientBrush}}">
    <ScrollView>

        <VerticalStackLayout
            Padding="22,25,22,30"
            Spacing="18">

            <!-- LOADING -->

            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="{StaticResource AccentDark}" />


            <!-- ERRO -->

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="Red"
                HorizontalTextAlignment="Center" />


            <!-- CONTEÚDO -->

            <VerticalStackLayout
                IsVisible="{Binding HasOperation}"
                Spacing="18">

                <!-- CABEÇALHO -->

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="OPERAÇÃO DO VOO"
                        FontSize="12"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource AccentDark}" />

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="{Binding Operation.FlightNumber}"
                            FontSize="30"
                            FontFamily="OpenSansSemibold" />

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource StatusBadgeStyle}"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Operation.Status}"
                                FontSize="11"
                                TextColor="{StaticResource AccentDark}" />

                        </Border>

                    </Grid>

                </VerticalStackLayout>


                <!-- ROTA -->

                <Border Style="{StaticResource CardElevatedStyle}">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="ROTA"
                            Style="{StaticResource FootnoteStyle}" />

                        <Grid ColumnDefinitions="*,Auto,*">

                            <Label
                                Text="{Binding Operation.Origin}"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="→"
                                FontSize="22"
                                Margin="15,0"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="{Binding Operation.Destination}"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                HorizontalTextAlignment="End"
                                VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- PARTIDA / PORTA -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <Border Style="{StaticResource CardStyle}">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="PARTIDA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.DepartureTime,
                                               StringFormat='{0:HH:mm}'}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold" />

                            <Label
                                Text="{Binding Operation.DepartureTime,
                                               StringFormat='{0:dd MMM yyyy}'}"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>

                    </Border>


                    <Border
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="PORTA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.Gate}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource AccentDark}" />

                            <Label
                                Text="Embarque"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- RESUMO -->

                <Label
                    Text="Resumo de passageiros"
                    Style="{StaticResource Title2Style}" />

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="8">

                    <!-- TOTAL -->

                    <Border Style="{StaticResource CardStyle}">

                        <VerticalStackLayout>

                            <Label
                                Text="TOTAL"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.TotalPassengers}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- CHECK-IN -->

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">

                        <VerticalStackLayout>

                            <Label
                                Text="CHECK-IN"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.CheckedIn}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource AccentDark}" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- PENDENTES -->

                    <Border
                        Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                        <VerticalStackLayout>

                            <Label
                                Text="PENDENTES"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.PendingCheckIns}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- PASSAGEIROS -->

                <Grid
                    Margin="0,8,0,0"
                    ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="2">

                        <Label
                            Text="Passageiros do voo"
                            Style="{StaticResource Title2Style}" />

                        <Label
                            Text="Estado de check-in e lugar atribuído"
                            Style="{StaticResource CaptionStyle}" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="{Binding Operation.TotalPassengers}"
                        FontSize="18"
                        FontFamily="OpenSansSemibold"
                        VerticalOptions="Center" />

                </Grid>


                <!-- SEM PASSAGEIROS -->

                <Label
                    Text="Não existem passageiros neste voo."
                    IsVisible="{Binding HasNoPassengers}"
                    Style="{StaticResource CaptionStyle}"
                    HorizontalTextAlignment="Center"
                    Margin="0,15" />


                <!-- LISTA -->

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Passengers}"
                    Spacing="10">

                    <BindableLayout.ItemTemplate>

                        <DataTemplate x:DataType="models:EmployeeFlightPassengerDto">

                            <Border Style="{StaticResource CardStyle}">

                                <VerticalStackLayout Spacing="8">

                                    <!-- NOME / LUGAR -->

                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                        Text="{Binding PassengerName}"
                        FontSize="16"
                        FontFamily="OpenSansSemibold" />

                                        <Border
                        Grid.Column="1"
                        Padding="10,5">

                                            <Label
                            Text="{Binding Seat}"
                            FontSize="13"
                            FontFamily="OpenSansSemibold" />

                                        </Border>

                                    </Grid>

                                    <!-- DOCUMENTO -->

                                    <Label
                    Text="{Binding DocumentNumber,
                                   StringFormat='Documento: {0}'}"
                    Style="{StaticResource CaptionStyle}" />

                                    <!-- ESTADO / CHECK-IN -->

                                    <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                                        <Label
                        Text="{Binding Status}"
                        FontSize="12"
                        TextColor="{StaticResource AccentDark}"
                        VerticalOptions="Center" />

                                        <Button
                        Grid.Column="1"
                        Text="{Binding CheckInButtonText}"
                        IsEnabled="{Binding CanCheckIn}"
                        FontSize="12"
                        Padding="12,7"
                        VerticalOptions="Center"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                          Path=BindingContext.CheckInPassengerCommand}"
                        CommandParameter="{Binding .}" />

                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>


                <!-- PORTA -->

                <Button
                    Text="🚪  Gerir porta"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenGatesCommand}" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>