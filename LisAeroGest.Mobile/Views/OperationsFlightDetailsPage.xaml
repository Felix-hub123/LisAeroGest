<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
    x:Class="LisAeroGest.Mobile.Views.OperationsFlightDetailsPage"
    x:DataType="vm:OperationsFlightDetailsViewModel"
    Title="Operação do voo"
    Background="{AppThemeBinding
        Light={StaticResource AppBackgroundLightBrush},
        Dark={StaticResource AppBackgroundGradientBrush}}">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,25,22,30"
            Spacing="18">

            <!-- =====================================================
                 LOADING
            ====================================================== -->

            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="{StaticResource AccentDark}" />


            <!-- =====================================================
                 ERRO
            ====================================================== -->

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="Red"
                HorizontalTextAlignment="Center" />


            <!-- =====================================================
                 CONTEÚDO
            ====================================================== -->

            <VerticalStackLayout
                IsVisible="{Binding HasOperation}"
                Spacing="18">


                <!-- =================================================
                     CABEÇALHO
                ================================================== -->

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="OPERAÇÃO DO VOO"
                        FontSize="12"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource AccentDark}" />

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="{Binding Operation.FlightNumber}"
                            FontSize="30"
                            FontFamily="OpenSansSemibold" />

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource StatusBadgeStyle}"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Operation.Status}"
                                FontSize="11"
                                TextColor="{StaticResource AccentDark}" />

                        </Border>

                    </Grid>

                </VerticalStackLayout>


                <!-- =================================================
                     ROTA
                ================================================== -->

                <Border Style="{StaticResource CardElevatedStyle}">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="ROTA"
                            Style="{StaticResource FootnoteStyle}" />

                        <Grid ColumnDefinitions="*,Auto,*">

                            <Label
                                Text="{Binding Operation.Origin}"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="→"
                                FontSize="22"
                                Margin="15,0"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="{Binding Operation.Destination}"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                HorizontalTextAlignment="End"
                                VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     METEOROLOGIA
                ================================================== -->

                <VerticalStackLayout
                    IsVisible="{Binding HasWeather}"
                    Spacing="10">

                    <!-- TÍTULO -->

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="2">

                            <Label
                                Text="Meteorologia do voo"
                                Style="{StaticResource Title2Style}" />

                            <Label
                                Text="Condições na origem e no destino"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="☁️"
                            FontSize="26"
                            VerticalOptions="Center" />

                    </Grid>


                    <!-- ORIGEM E DESTINO -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">


                        <!-- =========================
                             ORIGEM
                        ========================== -->

                        <Border
                            IsVisible="{Binding HasOriginWeather}"
                            Style="{StaticResource CardStyle}">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="ORIGEM"
                                    Style="{StaticResource FootnoteStyle}" />

                                <Label
                                    Text="{Binding OriginWeather.City}"
                                    FontSize="15"
                                    FontFamily="OpenSansSemibold"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding OriginWeather.Temperature,
                                        StringFormat='{0:F1} °C'}"
                                    FontSize="25"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{StaticResource AccentDark}" />

                                <Label
                                    Text="{Binding OriginWeather.Description}"
                                    Style="{StaticResource CaptionStyle}"
                                    LineBreakMode="WordWrap" />


                                <!-- VENTO -->

                                <HorizontalStackLayout Spacing="5">

                                    <Label
                                        Text="💨"
                                        FontSize="12"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding OriginWeather.WindSpeed,
                                            StringFormat='{0:F1} km/h'}"
                                        Style="{StaticResource FootnoteStyle}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>


                                <!-- VISIBILIDADE -->

                                <HorizontalStackLayout Spacing="5">

                                    <Label
                                        Text="👁"
                                        FontSize="12"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding OriginWeather.Visibility,
                                            StringFormat='{0:F1} km'}"
                                        Style="{StaticResource FootnoteStyle}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>


                                <!-- HUMIDADE -->

                                <HorizontalStackLayout Spacing="5">

                                    <Label
                                        Text="💧"
                                        FontSize="12"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding OriginWeather.Humidity,
                                            StringFormat='{0}% humidade'}"
                                        Style="{StaticResource FootnoteStyle}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Border>


                        <!-- =========================
                             DESTINO
                        ========================== -->

                        <Border
                            Grid.Column="1"
                            IsVisible="{Binding HasDestinationWeather}"
                            Style="{StaticResource CardStyle}">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="DESTINO"
                                    Style="{StaticResource FootnoteStyle}" />

                                <Label
                                    Text="{Binding DestinationWeather.City}"
                                    FontSize="15"
                                    FontFamily="OpenSansSemibold"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding DestinationWeather.Temperature,
                                        StringFormat='{0:F1} °C'}"
                                    FontSize="25"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{StaticResource AccentDark}" />

                                <Label
                                    Text="{Binding DestinationWeather.Description}"
                                    Style="{StaticResource CaptionStyle}"
                                    LineBreakMode="WordWrap" />


                                <!-- VENTO -->

                                <HorizontalStackLayout Spacing="5">

                                    <Label
                                        Text="💨"
                                        FontSize="12"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding DestinationWeather.WindSpeed,
                                            StringFormat='{0:F1} km/h'}"
                                        Style="{StaticResource FootnoteStyle}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>


                                <!-- VISIBILIDADE -->

                                <HorizontalStackLayout Spacing="5">

                                    <Label
                                        Text="👁"
                                        FontSize="12"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding DestinationWeather.Visibility,
                                            StringFormat='{0:F1} km'}"
                                        Style="{StaticResource FootnoteStyle}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>


                                <!-- HUMIDADE -->

                                <HorizontalStackLayout Spacing="5">

                                    <Label
                                        Text="💧"
                                        FontSize="12"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding DestinationWeather.Humidity,
                                            StringFormat='{0}% humidade'}"
                                        Style="{StaticResource FootnoteStyle}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>


                    <!-- =============================
                         ALERTA METEOROLÓGICO
                    ============================== -->

                    <Border
                        IsVisible="{Binding HasWeatherAlert}"
                        Padding="14"
                        BackgroundColor="#33FFC107"
                        Stroke="#FFC107"
                        StrokeThickness="1">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <Label
                                Text="⚠️"
                                FontSize="20"
                                VerticalOptions="Center" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Atenção meteorológica"
                                    FontSize="13"
                                    FontFamily="OpenSansSemibold" />

                                <Label
                                    Text="{Binding WeatherAlertMessage}"
                                    FontSize="12"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>


                    <!-- NOTA -->

                    <Label
                        Text="Informação meteorológica para apoio à operação. Não altera automaticamente o estado do voo."
                        FontSize="10"
                        Opacity="0.6"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>


                <!-- =================================================
                     PARTIDA / PORTA
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <!-- PARTIDA -->

                    <Border Style="{StaticResource CardStyle}">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="PARTIDA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.DepartureTime,
                                    StringFormat='{0:HH:mm}'}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold" />

                            <Label
                                Text="{Binding Operation.DepartureTime,
                                    StringFormat='{0:dd MMM yyyy}'}"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- PORTA -->

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="PORTA"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.Gate}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource AccentDark}" />

                            <Label
                                Text="Embarque"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- =================================================
                     RESUMO DE PASSAGEIROS
                ================================================== -->

                <Label
                    Text="Resumo de passageiros"
                    Style="{StaticResource Title2Style}" />

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="8">

                    <!-- TOTAL -->

                    <Border Style="{StaticResource CardStyle}">

                        <VerticalStackLayout>

                            <Label
                                Text="TOTAL"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.TotalPassengers}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- CHECK-IN -->

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">

                        <VerticalStackLayout>

                            <Label
                                Text="CHECK-IN"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.CheckedIn}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource AccentDark}" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- PENDENTES -->

                    <Border
                        Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                        <VerticalStackLayout>

                            <Label
                                Text="PENDENTES"
                                Style="{StaticResource FootnoteStyle}" />

                            <Label
                                Text="{Binding Operation.PendingCheckIns}"
                                FontSize="25"
                                FontFamily="OpenSansSemibold" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- =================================================
                     PASSAGEIROS DO VOO
                ================================================== -->

                <VerticalStackLayout
                    Margin="0,8,0,0"
                    Spacing="12">

                    <!-- TÍTULO -->

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="2">

                            <Label
                                Text="Passageiros do voo"
                                Style="{StaticResource Title2Style}" />

                            <Label
                                Text="Pesquisa e acompanha os passageiros deste voo"
                                Style="{StaticResource CaptionStyle}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="{Binding Operation.TotalPassengers}"
                            FontSize="18"
                            FontFamily="OpenSansSemibold"
                            VerticalOptions="Center" />

                    </Grid>


                    <!-- PESQUISA -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Padding="14,5">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <Label
                                Text="⌕"
                                FontSize="22"
                                VerticalOptions="Center"
                                TextColor="{StaticResource AccentDark}" />

                            <Entry
                                Grid.Column="1"
                                Text="{Binding SearchText}"
                                Placeholder="Nome, documento ou nº do bilhete"
                                ClearButtonVisibility="WhileEditing"
                                ReturnType="Search"
                                FontSize="14"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- =================================================
                     SEM PASSAGEIROS / SEM RESULTADOS
                ================================================== -->

                <Label
                    Text="Nenhum passageiro encontrado."
                    IsVisible="{Binding HasNoPassengers}"
                    Style="{StaticResource CaptionStyle}"
                    HorizontalTextAlignment="Center"
                    Margin="0,15" />


                <!-- =================================================
                     LISTA DE PASSAGEIROS
                ================================================== -->

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Passengers}"
                    Spacing="10">

                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:EmployeeFlightPassengerDto">

                            <Border Style="{StaticResource CardStyle}">

                                <VerticalStackLayout Spacing="8">

                                    <!-- NOME / LUGAR -->

                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            Text="{Binding PassengerName}"
                                            FontSize="16"
                                            FontFamily="OpenSansSemibold" />

                                        <Border
                                            Grid.Column="1"
                                            Padding="10,5">

                                            <Label
                                                Text="{Binding Seat}"
                                                FontSize="13"
                                                FontFamily="OpenSansSemibold" />

                                        </Border>

                                    </Grid>


                                    <!-- DOCUMENTO -->

                                    <Label
                                        Text="{Binding DocumentNumber,
                                            StringFormat='Documento: {0}'}"
                                        Style="{StaticResource CaptionStyle}" />


                                    <!-- NÚMERO DO BILHETE -->

                                    <Label
                                        Text="{Binding TicketId,
                                            StringFormat='Bilhete: #{0}'}"
                                        Style="{StaticResource FootnoteStyle}" />


                                    <!-- ESTADO / CHECK-IN -->

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="10">

                                        <Label
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            TextColor="{StaticResource AccentDark}"
                                            VerticalOptions="Center" />

                                        <Button
                                            Grid.Column="1"
                                            Text="{Binding CheckInButtonText}"
                                            IsEnabled="{Binding CanCheckIn}"
                                            FontSize="12"
                                            Padding="12,7"
                                            VerticalOptions="Center"
                                            Command="{Binding
                                                Source={RelativeSource
                                                    AncestorType={x:Type ContentPage}},
                                                Path=BindingContext.CheckInPassengerCommand}"
                                            CommandParameter="{Binding .}" />

                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>


                <!-- =================================================
                     AÇÕES DO VOO
                ================================================== -->

                <VerticalStackLayout
                    Margin="0,8,0,0"
                    Spacing="10">

                    <Label
                        Text="Ações do voo"
                        Style="{StaticResource Title2Style}" />

                    <Label
                        Text="Ferramentas operacionais para este voo."
                        Style="{StaticResource CaptionStyle}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <!-- GERIR PORTA -->

                        <Button
                            Grid.Column="0"
                            Text="🚪  Gerir porta"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenGatesCommand}" />


                        <!-- COMUNICAR -->

                        <Button
                            Grid.Column="1"
                            Text="📢  Comunicar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenCommunicationsCommand}" />

                    </Grid>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>