<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LisAeroGest.Mobile.Views.HomePage"
             Title="Início"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AppBackgroundGradientBrush}">
    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="24,34,24,34" Spacing="20">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><VerticalStackLayout Grid.RowSpan="2" Spacing="2"><Label Text="LisAeroGest" FontFamily="OpenSansSemibold" FontSize="30" TextColor="{StaticResource AccentDark}" /><Label Text="Lisbon Airport Portal" Style="{StaticResource CaptionStyle}" /></VerticalStackLayout><Label Text="Lisbon time" Style="{StaticResource FootnoteStyle}" HorizontalTextAlignment="End" /><Label x:Name="DateLabel" Grid.Column="1" Grid.Row="1" Text="—" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextPrimaryDark}" HorizontalTextAlignment="End" /></Grid>
                <Label x:Name="StatusLabel" Text="A carregar dados da tua conta…" Style="{StaticResource FootnoteStyle}" />
                <Border Style="{StaticResource CardElevatedStyle}" Padding="20,18"><VerticalStackLayout Spacing="14"><Grid ColumnDefinitions="*,Auto"><Label Text="DEPARTURES" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextPrimaryDark}" /><Label Text="✈" FontSize="25" TextColor="{StaticResource AccentDark}" /></Grid><Grid ColumnDefinitions="0.8*,1.8*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"><Label Text="Flight" Style="{StaticResource FootnoteStyle}" /><Label x:Name="FlightOneDestination" Grid.Column="1" Text="—" Style="{StaticResource FootnoteStyle}" /><Label Text="Gate" Grid.Column="2" Style="{StaticResource FootnoteStyle}" HorizontalTextAlignment="End" /><Label x:Name="FlightOneNumber" Grid.Row="1" Text="—" FontFamily="OpenSansSemibold" FontSize="23" /><Label x:Name="FlightOneTime" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="OpenSansSemibold" FontSize="15" /><Label x:Name="FlightOneGate" Grid.Row="1" Grid.Column="2" Text="—" FontFamily="OpenSansSemibold" FontSize="23" TextColor="{StaticResource AccentDark}" HorizontalTextAlignment="End" /></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderDark}" /><Grid ColumnDefinitions="0.8*,1.8*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"><Label Text="Flight" Style="{StaticResource FootnoteStyle}" /><Label x:Name="FlightTwoDestination" Grid.Column="1" Text="—" Style="{StaticResource FootnoteStyle}" /><Label Text="Gate" Grid.Column="2" Style="{StaticResource FootnoteStyle}" HorizontalTextAlignment="End" /><Label x:Name="FlightTwoNumber" Grid.Row="1" Text="—" FontFamily="OpenSansSemibold" FontSize="23" /><Label x:Name="FlightTwoTime" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="OpenSansSemibold" FontSize="15" /><Label x:Name="FlightTwoGate" Grid.Row="1" Grid.Column="2" Text="—" FontFamily="OpenSansSemibold" FontSize="23" TextColor="{StaticResource AccentDark}" HorizontalTextAlignment="End" /></Grid></VerticalStackLayout></Border>
                <Grid ColumnDefinitions="1.65*,1*" ColumnSpacing="14"><VerticalStackLayout Grid.Column="0" Spacing="10"><Label Text="LIVE TERMINAL MAP" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextPrimaryDark}" /><Border Style="{StaticResource CardStyle}" Padding="0" HeightRequest="170"><Grid ColumnDefinitions="*,66"><Grid Grid.Column="0" BackgroundColor="#101923"><Label Text="Terminal A" FontSize="15" TextColor="{StaticResource TextPrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" /><Label Text="●" FontSize="30" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,48,0,0" /><Label Text="Terminal information" Style="{StaticResource FootnoteStyle}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,95,0,0" /></Grid><Border Grid.Column="1" BackgroundColor="#234C17" Stroke="{StaticResource AccentDark}" StrokeThickness="1" Padding="8"><VerticalStackLayout VerticalOptions="Center"><Label Text="A" FontSize="20" TextColor="{StaticResource TextPrimaryDark}" HorizontalTextAlignment="Center" /><Label Text="Gates" Style="{StaticResource FootnoteStyle}" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border></Grid></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="10"><Label Text="AIRPORT INFO" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextPrimaryDark}" /><Border Style="{StaticResource CardStyle}" Padding="16,14" HeightRequest="170"><VerticalStackLayout Spacing="7"><Label Text="✦" FontSize="34" TextColor="{StaticResource AccentDark}" /><Label Text="Estado do aeroporto" Style="{StaticResource CaptionStyle}" /><Label Text="Online" FontSize="22" TextColor="{StaticResource TextPrimaryDark}" /><Label Text="Consulta os detalhes no portal." Style="{StaticResource FootnoteStyle}" /></VerticalStackLayout></Border></VerticalStackLayout></Grid>
                <Grid ColumnDefinitions="*,Auto"><Label Text="BOARDING PASS" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextPrimaryDark}" VerticalOptions="Center" /><Button Grid.Column="1" Text="VER CARTEIRA" Style="{StaticResource TextButtonStyle}" Clicked="OnVerBilhetesClicked" FontSize="12" Padding="4,2" /></Grid>
                <Border x:Name="BoardingSummary" Style="{StaticResource CardElevatedStyle}" Stroke="{StaticResource AccentDark}" StrokeThickness="1.5" Padding="18" IsVisible="False"><VerticalStackLayout Spacing="12"><Label Text="CARTÃO DE EMBARQUE DISPONÍVEL" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource AccentDark}" /><Grid ColumnDefinitions="*,*,*"><VerticalStackLayout><Label Text="FLIGHT" Style="{StaticResource FootnoteStyle}" /><Label x:Name="BoardingFlight" Text="—" FontFamily="OpenSansSemibold" FontSize="21" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="STATUS" Style="{StaticResource FootnoteStyle}" /><Label Text="CHECKED-IN" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource AccentDark}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="SEAT" Style="{StaticResource FootnoteStyle}" /><Label x:Name="BoardingSeat" Text="—" FontFamily="OpenSansSemibold" FontSize="21" /></VerticalStackLayout></Grid><Label Text="Abre a carteira para consultar o cartão e o QR Code emitido pelo servidor." Style="{StaticResource CaptionStyle}" /></VerticalStackLayout></Border>
                <Label x:Name="NoBoardingLabel" Text="O cartão de embarque ficará disponível depois do check-in." Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
