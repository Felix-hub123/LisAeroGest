<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             x:Class="LisAeroGest.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Perfil"
             Background="{StaticResource AppBackgroundGradientBrush}">
    <ScrollView>
        <VerticalStackLayout Padding="24,34,24,28" Spacing="18">
            <Label Text="PERFIL" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextSecondaryDark}" />
            <Border Style="{StaticResource CardElevatedStyle}">
                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource GlassIconBadgeStyle}"><Label Text="◉" FontSize="24" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                    <Label Text="{Binding Email}" Style="{StaticResource Title2Style}" HorizontalTextAlignment="Center" />
                    <Border Style="{StaticResource StatusBadgeStyle}" HorizontalOptions="Center" Padding="12,5"><Label Text="{Binding RoleLabel}" Style="{StaticResource FootnoteStyle}" TextColor="{StaticResource AccentDark}" /></Border>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="✓" FontSize="22" TextColor="{StaticResource AccentDark}" />
                    <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0">
                        <Label Text="Conta protegida" Style="{StaticResource BodyEmphasisStyle}" />
                        <Label Text="Mantém os teus dados de passageiro e reservas num só lugar." Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Button Text="Terminar sessão" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LogoutCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
