<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LisAeroGest.Mobile.Views.CheckInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
    x:DataType="vm:CheckInViewModel"
    Title="Check-in">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Indicador de Carregamento -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="{StaticResource Primary}" 
                               HorizontalOptions="Center" />

            <!-- Mensagem de Erro -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold" />

            <!-- Estado: Pendente de Check-in -->
            <VerticalStackLayout IsVisible="{Binding NotCheckedIn}" Spacing="20" Margin="0,30,0,0">
                <Label Text="Confirmar Check-in" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />

                <Label Text="Clique no botão abaixo para confirmar a sua presença e gerar o cartão de embarque." 
                       FontSize="14" 
                       TextColor="Gray" 
                       HorizontalTextAlignment="Center" />

                <Button Text="Fazer Check-in" 
                        Command="{Binding ConfirmCheckInCommand}" 
                        HeightRequest="50"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        Margin="0,10,0,0" />
            </VerticalStackLayout>

            <!-- Estado: Check-in Concluído (Cartão de Embarque) -->
            <Border IsVisible="{Binding CheckInDone}" 
                    StrokeShape="RoundRectangle 16"
                    Stroke="#E0E0E0"
                    Background="White"
                    Padding="20"
                    Margin="0,10,0,0">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Cartão de Embarque" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="{StaticResource Primary}" />

                    <BoxView HeightRequest="1" Color="#EEEEEE" HorizontalOptions="Fill" />

                    <!-- Informações do Voo em Grelha -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Text="VOO" FontSize="11" TextColor="Gray" Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" />
                        <Label Text="{Binding FlightNumber}" FontSize="16" FontAttributes="Bold" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" />

                        <Label Text="GATE" FontSize="11" TextColor="Gray" Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" />
                        <Label Text="{Binding Gate}" FontSize="16" FontAttributes="Bold" Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" />

                        <Label Text="SEQ." FontSize="11" TextColor="Gray" Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" />
                        <Label Text="{Binding SequenceNumber}" FontSize="16" FontAttributes="Bold" Grid.Row="1" Grid.Column="2" HorizontalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EEEEEE" HorizontalOptions="Fill" Margin="0,8,0,0" />

                    <!-- QR Code do Cartão de Embarque -->
                    <Image Source="{Binding QrImageUrl}"
                           HeightRequest="200"
                           WidthRequest="200"
                           HorizontalOptions="Center"
                           Aspect="AspectFit" />

                    <Label Text="Apresente este código no portão de embarque." 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>