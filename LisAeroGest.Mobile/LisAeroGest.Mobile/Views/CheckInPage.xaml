<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LisAeroGest.Mobile.Views.CheckInPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             x:DataType="vm:CheckInViewModel"
             Title="Boarding pass"
             Background="{StaticResource AppBackgroundGradientBrush}">
    <ScrollView>
        <VerticalStackLayout Padding="24,34,24,34" Spacing="20">
            <VerticalStackLayout Spacing="3"><Label Text="BOARDING PASS" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource TextSecondaryDark}" /><Label Text="A tua viagem" Style="{StaticResource TitleStyle}" /></VerticalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentDark}" HorizontalOptions="Center" />
            <Border IsVisible="{Binding HasError}" Style="{StaticResource StatusBadgeStyle}" Stroke="{StaticResource ErrorDark}"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorDark}" FontSize="14" HorizontalTextAlignment="Center" /></Border>
            <VerticalStackLayout IsVisible="{Binding NotCheckedIn}" Spacing="16" Margin="0,28,0,0"><Border Style="{StaticResource CardElevatedStyle}"><VerticalStackLayout Spacing="14"><Label Text="Ainda não tens check-in" Style="{StaticResource Title2Style}" HorizontalTextAlignment="Center" /><Label Text="Confirma a tua presença para gerar o cartão de embarque." Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" /><Button Text="Fazer check-in" Command="{Binding ConfirmCheckInCommand}" /></VerticalStackLayout></Border></VerticalStackLayout>
            <Border IsVisible="{Binding CheckInDone}" Style="{StaticResource CardElevatedStyle}" Stroke="{StaticResource AccentDark}" StrokeThickness="1.5" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="CARTÃO DE EMBARQUE" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource AccentDark}" /><Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" Stroke="{StaticResource AccentDark}" Padding="10,5"><Label Text="CONFIRMADO" FontSize="10" TextColor="{StaticResource AccentDark}" FontFamily="OpenSansSemibold" /></Border></Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderDark}" />
                    <Grid ColumnDefinitions="1.2*,*,*"><VerticalStackLayout><Label Text="FLIGHT" Style="{StaticResource FootnoteStyle}" /><Label Text="{Binding FlightNumber}" FontFamily="OpenSansSemibold" FontSize="23" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="GATE" Style="{StaticResource FootnoteStyle}" /><Label Text="{Binding Gate}" FontFamily="OpenSansSemibold" FontSize="23" TextColor="{StaticResource AccentDark}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="SEQ." Style="{StaticResource FootnoteStyle}" /><Label Text="{Binding SequenceNumber}" FontFamily="OpenSansSemibold" FontSize="23" /></VerticalStackLayout></Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderDark}" />
                    <Image Source="{Binding QrImageUrl}" HeightRequest="210" WidthRequest="210" HorizontalOptions="Center" Aspect="AspectFit" />
                    <Label Text="Apresente este código no portão de embarque" Style="{StaticResource FootnoteStyle}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
