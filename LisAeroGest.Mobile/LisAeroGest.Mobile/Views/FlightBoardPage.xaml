<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
             x:Class="LisAeroGest.Mobile.Views.FlightBoardPage"
             x:DataType="vm:FlightBoardViewModel"
             Title="Painel de Partidas">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SELETOR DE DIA (CALENDÁRIO HORIZONTAL)                  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Margin="10,10,10,0"
                Padding="12"
                StrokeShape="RoundRectangle 12"
                Stroke="#1F5C99"
                StrokeThickness="1"
                BackgroundColor="#F0F6FC">

            <VerticalStackLayout Spacing="10">

                <!-- Label do dia selecionado -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="📅"
                           FontSize="20"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="{Binding SelectedDateLabel}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#1F5C99"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Label Grid.Column="2"
                           Text="{Binding SelectedDate, StringFormat='{0:dd/MM/yyyy}'}"
                           FontSize="12"
                           TextColor="Gray"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Navegação de dias -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                    <Button Grid.Column="0"
                            Text="← Anterior"
                            Command="{Binding PreviousDayCommand}"
                            BackgroundColor="White"
                            TextColor="#1F5C99"
                            BorderColor="#1F5C99"
                            BorderWidth="1"
                            FontSize="12"
                            CornerRadius="8"
                            HeightRequest="40"
                            Padding="10,0" />

                    <Button Grid.Column="1"
                            Text="Hoje"
                            Command="{Binding GoToTodayCommand}"
                            BackgroundColor="#1F5C99"
                            TextColor="White"
                            FontSize="12"
                            CornerRadius="8"
                            HeightRequest="40"
                            Padding="10,0" />

                    <Button Grid.Column="2"
                            Text="Seguinte →"
                            Command="{Binding NextDayCommand}"
                            BackgroundColor="White"
                            TextColor="#1F5C99"
                            BorderColor="#1F5C99"
                            BorderWidth="1"
                            FontSize="12"
                            CornerRadius="8"
                            HeightRequest="40"
                            Padding="10,0" />
                </Grid>

                <!-- Barra de datas (calendário compacto) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="CalendarStrip" Spacing="6" Padding="0,4" />
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- Indicador de Carregamento -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           Margin="10" />

        <!-- Lista de Voos do dia selecionado -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadDeparturesCommand}">

            <CollectionView ItemsSource="{Binding Departures}"
                SelectionMode="None"
                EmptyView="Nenhum voo agendado para este dia.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FlightDto">
                        <Frame Margin="10,5"
                   Padding="15"
                   CornerRadius="8"
                   HasShadow="True"
                   BackgroundColor="White">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFlightTapped"
                                          CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*,Auto"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="5">
                                <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding FlightNumber}"
                           FontAttributes="Bold"
                           FontSize="16" />
                                <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding Origin}"
                           HorizontalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="2"
                           Text="{Binding Status}"
                           FontAttributes="Bold"
                           TextColor="#1F5C99" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding DepartureTime, StringFormat='Partida {0:HH:mm}'}"
                           FontSize="12"
                           TextColor="Gray" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>