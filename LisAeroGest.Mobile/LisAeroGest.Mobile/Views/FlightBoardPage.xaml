<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
             x:Class="LisAeroGest.Mobile.Views.FlightBoardPage"
             x:DataType="vm:FlightBoardViewModel"
             Title="Painel de Partidas">

    <Grid RowDefinitions="Auto,*">

        <!-- Indicador de Carregamento Superior -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           Margin="10" />

        <!-- Lista de Partidas com Pull-to-Refresh -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadDeparturesCommand}">

            <CollectionView ItemsSource="{Binding Departures}"
                            EmptyView="Nenhuma partida encontrada ou a carregar dados...">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FlightDto">
                        <Frame Margin="10,5" Padding="15" CornerRadius="8" HasShadow="True">
                            <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5">

                                <!-- Número do Voo -->
                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding FlightNumber}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" />

                                <!-- Origem ou Destino -->
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Origin}" 
                                       HorizontalOptions="Center" />

                                <!-- Estado do Voo -->
                                <Label Grid.Row="0" Grid.Column="2" 
                                       Text="{Binding Status}" 
                                       FontAttributes="Bold" />

                                <!-- Data e Hora Prevista -->
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="{Binding DepartureTime, StringFormat='{0:HH:mm}'}"
                                       FontSize="12" 
                                       TextColor="Gray" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>