<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             xmlns:models="clr-namespace:LisAeroGest.Mobile.Models"
             x:Class="LisAeroGest.Mobile.Views.FlightBoardPage"
             x:DataType="vm:FlightBoardViewModel"
             Title="Painel de Partidas">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- SELETOR DE DIA + FILTROS -->
        <Border Grid.Row="0"
                Margin="10,10,10,0"
                Padding="12"
                StrokeShape="RoundRectangle 12"
                Stroke="#1F5C99"
                StrokeThickness="1"
                BackgroundColor="#F0F6FC">

            <VerticalStackLayout Spacing="10">

                <!-- Título do dia selecionado -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Label Grid.Column="0"
                           Text="📅"
                           FontSize="20"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="{Binding SelectedDateLabel}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#1F5C99"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Label Grid.Column="2"
                           Text="{Binding SelectedDate, StringFormat='{0:dd/MM/yyyy}'}"
                           FontSize="12"
                           TextColor="Gray"
                           VerticalOptions="Center" />

                </Grid>

                <!-- Filtros de rota -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8">

                    <Border Grid.Column="0"
                            Stroke="#CCCCCC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="White">

                        <SearchBar Placeholder="Origem (ex.: LIS)"
                                   Text="{Binding FilterOrigin}"
                                   BackgroundColor="Transparent"
                                   TextColor="Black"
                                   PlaceholderColor="Gray"
                                   CancelButtonColor="#1F5C99"
                                   HeightRequest="40" />

                    </Border>

                    <Border Grid.Column="1"
                            Stroke="#CCCCCC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="White">

                        <SearchBar Placeholder="Destino (ex.: CDG)"
                                   Text="{Binding FilterDestination}"
                                   BackgroundColor="Transparent"
                                   TextColor="Black"
                                   PlaceholderColor="Gray"
                                   CancelButtonColor="#1F5C99"
                                   HeightRequest="40" />

                    </Border>

                </Grid>

                <!-- Botões de navegação -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">

                    <Button Grid.Column="0"
                            Text="← Anterior"
                            Command="{Binding PreviousDayCommand}"
                            BackgroundColor="White"
                            TextColor="#1F5C99"
                            BorderColor="#1F5C99"
                            BorderWidth="1"
                            FontSize="12"
                            CornerRadius="8"
                            HeightRequest="40"
                            Padding="10,0" />

                    <Button Grid.Column="1"
                            Text="Hoje"
                            Command="{Binding GoToTodayCommand}"
                            BackgroundColor="#1F5C99"
                            TextColor="White"
                            FontSize="12"
                            CornerRadius="8"
                            HeightRequest="40"
                            Padding="10,0" />

                    <Button Grid.Column="2"
                            Text="Seguinte →"
                            Command="{Binding NextDayCommand}"
                            BackgroundColor="White"
                            TextColor="#1F5C99"
                            BorderColor="#1F5C99"
                            BorderWidth="1"
                            FontSize="12"
                            CornerRadius="8"
                            HeightRequest="40"
                            Padding="10,0" />

                </Grid>

            </VerticalStackLayout>

        </Border>

        <!-- Indicador de carregamento -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           Margin="10" />

        <!-- Mensagem de erro -->
        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="Red"
               HorizontalOptions="Center"
               Margin="10,0" />

        <!-- Lista de voos -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadDeparturesCommand}">

            <CollectionView ItemsSource="{Binding Departures}"
                            SelectionMode="None">

                <CollectionView.EmptyView>

                    <VerticalStackLayout Padding="20"
                                         Spacing="8"
                                         HorizontalOptions="Center">

                        <Label Text="✈️"
                               FontSize="40"
                               HorizontalOptions="Center" />

                        <Label Text="Nenhum voo encontrado"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />

                        <Label Text="Tente alterar a data ou limpar os filtros."
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:FlightDto">

                        <Frame Margin="10,5"
                               Padding="15"
                               CornerRadius="8"
                               HasShadow="True"
                               BackgroundColor="White">

                            <Frame.GestureRecognizers>

                                <TapGestureRecognizer Tapped="OnFlightTapped"
                                                      CommandParameter="{Binding .}" />

                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="*,*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="5">

                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding FlightNumber}"
                                       FontAttributes="Bold"
                                       FontSize="16" />

                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Origin}"
                                       HorizontalOptions="Center" />

                                <Label Grid.Row="0"
                                       Grid.Column="2"
                                       Text="{Binding Status}"
                                       FontAttributes="Bold"
                                       TextColor="#1F5C99" />

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding DepartureTime, StringFormat='Partida {0:HH:mm}'}"
                                       FontSize="12"
                                       TextColor="Gray" />

                            </Grid>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>