<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LisAeroGest.Mobile.ViewModels"
             x:Class="LisAeroGest.Mobile.Views.PaymentPage"
             x:DataType="vm:PaymentViewModel"
             Title="Pagamento">
    <VerticalStackLayout Padding="24" Spacing="20">
        <Label Text="Resumo da reserva" FontSize="22" FontAttributes="Bold" />
        <Label Text="{Binding FlightNumber}" FontSize="20" TextColor="#1565C0" />
        <Label Text="{Binding SeatCode, StringFormat='Lugar {0}'}" FontSize="18" />
        <Label Text="{Binding Price}" FontSize="24" FontAttributes="Bold" />

        <Button Text="Pagar"
                Command="{Binding PayCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#1565C0"
                TextColor="White"
                HeightRequest="48"
                CornerRadius="10" />
    </VerticalStackLayout>
</ContentPage>