<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LisAeroGest.Mobile.Views.MyTripPage"
             Title="Viagem"
             Background="{StaticResource AppBackgroundGradientBrush}">
    <ScrollView>
        <VerticalStackLayout Padding="24,34,24,34" Spacing="20">
            <VerticalStackLayout Spacing="3"><Label Text="MY TRIP" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource TextSecondaryDark}" /><Label Text="Tudo pronto para partir?" Style="{StaticResource TitleStyle}" /></VerticalStackLayout>
            <Border Style="{StaticResource CardElevatedStyle}" Stroke="{StaticResource AccentDark}" StrokeThickness="1.2"><VerticalStackLayout Spacing="16"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="TP 123" FontFamily="OpenSansSemibold" FontSize="25" /><Label Text="Lisboa LIS → Londres LHR" Style="{StaticResource CaptionStyle}" /></VerticalStackLayout><Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" Stroke="{StaticResource AccentDark}" Padding="10,5"><Label Text="A HORAS" FontSize="10" TextColor="{StaticResource AccentDark}" FontFamily="OpenSansSemibold" /></Border></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderDark}" /><Grid ColumnDefinitions="*,*,*"><VerticalStackLayout><Label Text="PARTIDA" Style="{StaticResource FootnoteStyle}" /><Label Text="15:30" FontSize="21" FontFamily="OpenSansSemibold" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="PORTA" Style="{StaticResource FootnoteStyle}" /><Label Text="A14" FontSize="21" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentDark}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="LUGAR" Style="{StaticResource FootnoteStyle}" /><Label Text="14A" FontSize="21" FontFamily="OpenSansSemibold" /></VerticalStackLayout></Grid></VerticalStackLayout></Border>
            <Label Text="JOURNEY STATUS" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource TextSecondaryDark}" />
            <Border Style="{StaticResource CardStyle}"><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="12"><Border Style="{StaticResource GlassIconBadgeStyle}"><Label Text="✓" FontSize="20" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" /></Border><VerticalStackLayout Grid.Column="1"><Label Text="Reserva confirmada" Style="{StaticResource BodyEmphasisStyle}" /><Label Text="Lugar 14A atribuído" Style="{StaticResource CaptionStyle}" /></VerticalStackLayout><BoxView Grid.Row="1" Grid.Column="0" WidthRequest="2" HeightRequest="28" BackgroundColor="{StaticResource AccentDark}" HorizontalOptions="Center" /><VerticalStackLayout Grid.Row="1" Grid.Column="1"><Label Text="Check-in disponível" Style="{StaticResource BodyEmphasisStyle}" /><Label Text="Gera o teu cartão de embarque antes da partida" Style="{StaticResource CaptionStyle}" /></VerticalStackLayout><Border Grid.Row="2" Style="{StaticResource GlassIconBadgeStyle}"><Label Text="→" FontSize="20" TextColor="{StaticResource AccentDark}" HorizontalOptions="Center" VerticalOptions="Center" /></Border><VerticalStackLayout Grid.Row="2" Grid.Column="1"><Label Text="Embarque" Style="{StaticResource BodyEmphasisStyle}" /><Label Text="Apresenta o QR na porta A14" Style="{StaticResource CaptionStyle}" /></VerticalStackLayout></Grid></Border>
            <Button Text="Abrir carteira e fazer check-in" Clicked="OnVerBilhetesClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
