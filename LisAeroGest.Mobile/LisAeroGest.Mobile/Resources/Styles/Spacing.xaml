<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================================================================
         LISAEROGEST DESIGN SYSTEM — ESPAÇAMENTO
         Usar estes valores em vez de números "à mão" em Padding,
         Margin e Spacing, para manter consistência entre páginas.
         ================================================================ -->

    <x:Double x:Key="SpaceXS">8</x:Double>
    <x:Double x:Key="SpaceS">16</x:Double>
    <x:Double x:Key="SpaceM">20</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>
    <x:Double x:Key="SpaceXL">32</x:Double>

    <x:Double x:Key="RadiusButton">16</x:Double>
    <x:Double x:Key="RadiusCard">20</x:Double>
    <x:Double x:Key="RadiusBadge">10</x:Double>
    <x:Double x:Key="RadiusIconBadge">22</x:Double>

</ResourceDictionary>
