<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================================================================
         LISAEROGEST DESIGN SYSTEM — CORES
         Tema principal: escuro / glassmorphism (aviação premium).
         O tema claro fica definido para possível uso futuro, mas a app
         arranca sempre em Dark (ver App.xaml.cs, UserAppTheme).
         ================================================================ -->

    <!-- Primary — mantido para compatibilidade com {StaticResource Primary}
         usado diretamente nalgumas Views; no tema escuro fica igual ao Accent. -->
    <Color x:Key="Primary">#B9F227</Color>
    <Color x:Key="PrimaryDark">#B9F227</Color>
    <Color x:Key="PrimaryDarkText">#0A1208</Color>

    <!-- Accent — verde/turquesa vibrante (glow), o tom de identidade da app -->
    <Color x:Key="Accent">#B9F227</Color>
    <Color x:Key="AccentDark">#B9F227</Color>
    <Color x:Key="AccentDarkText">#0A1208</Color>

    <!-- Superfícies -->
    <Color x:Key="Background">#F4F5F7</Color>
    <Color x:Key="BackgroundDark">#080B10</Color>
    <Color x:Key="BackgroundDarkGradientEnd">#0C1A1C</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#12171D</Color>
    <Color x:Key="SurfaceElevatedDark">#1A2229</Color>

    <!-- Glass — superfícies translúcidas para o efeito glassmorphism -->
    <Color x:Key="GlassSurfaceDark">#1CFFFFFF</Color>
    <Color x:Key="GlassSurfaceElevatedDark">#26FFFFFF</Color>
    <Color x:Key="GlassStrokeDark">#33FFFFFF</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimary">#0B2545</Color>
    <Color x:Key="TextPrimaryDark">#F5F7FA</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextSecondaryDark">#9FB0C0</Color>

    <!-- Estado -->
    <Color x:Key="Success">#2FAE60</Color>
    <Color x:Key="SuccessDark">#3DDC97</Color>
    <Color x:Key="Warning">#E08A00</Color>
    <Color x:Key="WarningDark">#FFC24B</Color>
    <Color x:Key="Error">#D64545</Color>
    <Color x:Key="ErrorDark">#FF6B6B</Color>

    <!-- Linhas / separadores -->
    <Color x:Key="Border">#E4E7EC</Color>
    <Color x:Key="BorderDark">#26FFFFFF</Color>

    <!-- Retrocompatibilidade (mantidos: usados por código/estilos existentes) -->
    <Color x:Key="Secondary">#DFE8F7</Color>
    <Color x:Key="SecondaryDarkText">#2EE6B8</Color>
    <Color x:Key="Tertiary">#0B2545</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0B2545</Color>
    <Color x:Key="OffBlack">#080B10</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Gradiente de fundo subtil (navy → verde-escuro), para ecrãs de destaque
         (ex.: Cartão de Embarque). Usar via Background="{StaticResource AppBackgroundGradientBrush}" -->
    <LinearGradientBrush x:Key="AppBackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BackgroundDark}" Offset="0.0" />
        <GradientStop Color="{StaticResource BackgroundDarkGradientEnd}" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
