@{
    ViewData["Title"] = "Password Alterada — LisAeroGest";
}

<div class="auth-bg" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-7 col-xl-5">
                <div class="card success-card">
                    <div class="success-header">
                        <div class="success-checkmark pulse-success">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <h1>Password Alterada</h1>
                        <p>Operação concluída com sucesso</p>
                        <div class="auth-wave">
                            <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
                                <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z" fill="white" />
                            </svg>
                        </div>
                    </div>

                    <div class="card-body success-body">
                        <i class="bi bi-shield-check success-icon-big bounce-in"></i>

                        <h4 class="mt-3 mb-2">Tudo certo!</h4>

                        <p class="success-message">
                            A sua password foi alterada com sucesso.
                        </p>

                        <p class="success-detail">
                            <i class="bi bi-info-circle me-1"></i>
                            Utilize a nova password no próximo início de sessão.
                            Se não a recordar, pode recuperá-la através da opção
                            "Esqueceu a password?".
                        </p>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                            <a asp-controller="Home" asp-action="Index"
                               class="btn btn-primary-grad btn-action">
                                <i class="bi bi-house-fill me-2"></i>Voltar ao Início
                            </a>
                            <a asp-controller="Account" asp-action="Login"
                               class="btn btn-outline-success btn-action">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sessão
                            </a>
                        </div>

                        <hr class="my-4" />

                        <div class="text-start small">
                            <p class="mb-1 text-muted">
                                <i class="bi bi-clock me-1"></i>
                                @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            </p>
                            <p class="mb-0 text-success">
                                <i class="bi bi-check2-circle me-1"></i>
                                Sessão mantida com a password antiga até novo login
                            </p>
                        </div>
                    </div>

                    <div class="card-footer bg-white text-center py-3 border-0">
                        <span class="text-muted small">&copy; @DateTime.Now.Year LisAeroGest · CINEL</span>
                    </div>
                </div>

                <p class="text-center text-muted small mt-3 mb-0">
                    <i class="bi bi-lock me-1"></i>
                    A sua conta está mais segura agora.
                </p>
            </div>
        </div>
    </div>
</div>