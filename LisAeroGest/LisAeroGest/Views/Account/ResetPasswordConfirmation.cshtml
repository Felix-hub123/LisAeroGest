@{
    ViewData["Title"] = "Password Redefinida — LisAeroGest";
}

<div class="auth-bg" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-7 col-xl-5">
                <div class="card success-card">
                    <div class="success-header">
                        <div class="success-checkmark pulse-success">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h1>Password Redefinida</h1>
                        <p>A sua conta está segura novamente</p>
                        <div class="auth-wave">
                            <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
                                <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z" fill="white" />
                            </svg>
                        </div>
                    </div>

                    <div class="card-body success-body">
                        <i class="bi bi-shield-lock-fill success-icon-big bounce-in"></i>

                        <h4 class="mt-3 mb-2">Password alterada com sucesso!</h4>

                        <p class="success-message">
                            A sua password foi redefinida.
                            Já pode iniciar sessão com as novas credenciais.
                        </p>

                        <p class="success-detail">
                            <i class="bi bi-info-circle me-1"></i>
                            Se não foi você que pediu esta alteração,
                            contacte imediatamente o administrador do sistema.
                        </p>

                        @* ---- Dicas de segurança pós-reset ---- *@
                        <div class="security-tips text-start my-4">
                            <h6 class="security-tips-title">
                                <i class="bi bi-shield-shaded me-1"></i>Dicas de Segurança
                            </h6>
                            <ul class="mb-0">
                                <li>
                                    <i class="bi bi-check2-circle"></i>
                                    Não partilhe a sua password com ninguém
                                </li>
                                <li>
                                    <i class="bi bi-check2-circle"></i>
                                    Use uma password única para cada plataforma
                                </li>
                                <li>
                                    <i class="bi bi-check2-circle"></i>
                                    Active a autenticação de dois factores quando disponível
                                </li>
                                <li>
                                    <i class="bi bi-check2-circle"></i>
                                    Saia sempre da conta em dispositivos partilhados
                                </li>
                            </ul>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary-grad btn-action">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Ir para o Login
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success btn-action">
                                <i class="bi bi-house me-2"></i>Voltar ao Início
                            </a>
                        </div>

                        <hr class="my-4" />

                        <div class="text-start small">
                            <p class="mb-1 text-muted">
                                <i class="bi bi-clock me-1"></i>
                                @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            </p>
                            <p class="mb-0 text-success">
                                <i class="bi bi-check2-circle me-1"></i>
                                Sessões anteriores foram terminadas por segurança
                            </p>
                        </div>
                    </div>

                    <div class="card-footer bg-white text-center py-3 border-0">
                        <span class="text-muted small">&copy; @DateTime.Now.Year LisAeroGest · CINEL</span>
                    </div>
                </div>

                <p class="text-center text-muted small mt-3 mb-0">
                    <i class="bi bi-heart-fill text-danger me-1"></i>
                    Obrigado por manter a sua conta segura.
                </p>
            </div>
        </div>
    </div>
</div>