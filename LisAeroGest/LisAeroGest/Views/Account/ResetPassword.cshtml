@model LisAeroGest.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Redefinir Password — LisAeroGest";
}

<div class="auth-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-7 col-xl-5">
                <div class="card auth-card">
                    <div class="auth-header">
                        <i class="bi bi-shield-check floating-plane"></i>
                        <div class="auth-logo">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <h1>Redefinir Password</h1>
                        <p>Crie uma nova password para a sua conta</p>
                        <div class="auth-wave">
                            <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
                                <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z" fill="white" />
                            </svg>
                        </div>
                    </div>

                    <div class="card-body auth-body">

                        @* ---- Banner com email do user ---- *@
                        <div class="reset-email-banner">
                            <i class="bi bi-envelope-fill"></i>
                            <div>
                                <small class="text-muted d-block">A redefinir password para:</small>
                                <strong class="text-break">@Model.Email</strong>
                            </div>
                        </div>

                        <h5 class="text-center mb-1">Escolha uma nova password</h5>
                        <p class="text-center text-muted small mb-4">
                            <i class="bi bi-clock me-1"></i>
                            Este link expira em <strong>1 hora</strong> por segurança.
                        </p>

                        <form asp-action="ResetPassword" method="post" class="auth-form" id="resetForm">
                            @Html.AntiForgeryToken()

                            @* Campos hidden do Token e Email *@
                            <input type="hidden" asp-for="Token" />
                            <input type="hidden" asp-for="Email" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Nova password</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control" type="password"
                                           placeholder="Mínimo 6 caracteres" autocomplete="new-password" id="newPass" />
                                    <span class="input-group-text password-toggle" data-target="newPass">
                                        <i class="bi bi-eye"></i>
                                    </span>
                                </div>

                                <!-- Barra de força -->
                                <div class="password-strength mt-2" id="strengthWrap" style="display: none;">
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar" id="strengthBar" style="width: 0%; transition: width .2s;"></div>
                                    </div>
                                    <small id="strengthText" class="text-muted"></small>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">Confirmar nova password</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control" type="password"
                                           placeholder="Repita a nova password" autocomplete="new-password" id="confirmPass" />
                                    <span class="input-group-text password-toggle" data-target="confirmPass">
                                        <i class="bi bi-eye"></i>
                                    </span>
                                </div>
                                <small id="matchStatus" class="text-muted"></small>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <!-- Regras de password -->
                            <div class="password-rules small text-muted mb-4">
                                <p class="mb-1"><i class="bi bi-info-circle me-1"></i>A password deve ter:</p>
                                <ul class="mb-0 ps-3" id="rulesList">
                                    <li id="rule-len">No mínimo 6 caracteres</li>
                                    <li id="rule-upper">Pelo menos 1 letra maiúscula</li>
                                    <li id="rule-digit">Pelo menos 1 número</li>
                                </ul>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-auth" id="submitBtn">
                                    <span class="btn-text">
                                        <i class="bi bi-check-lg me-2"></i>Redefinir Password
                                    </span>
                                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                </button>
                            </div>

                            <div class="text-center">
                                <small class="text-muted">
                                    <i class="bi bi-shield-check me-1"></i>
                                    A sua password é encriptada antes de ser guardada.
                                </small>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer bg-white text-center py-3 border-0">
                        <a asp-controller="Account" asp-action="Login" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
                        </a>
                    </div>
                </div>

                <p class="text-center text-muted small mt-3 mb-0">
                    &copy; @DateTime.Now.Year LisAeroGest · CINEL
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ---- Toggle show/hide password ----
        document.querySelectorAll('.password-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function () {
                var input = document.getElementById(this.getAttribute('data-target'));
                if (!input) return;
                var isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                this.querySelector('i').className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });

        // ---- Força da password + regras + match (mesma lógica do ChangePassword) ----
        (function () {
            var newPass = document.getElementById('newPass');
            var confirmPass = document.getElementById('confirmPass');
            var wrap = document.getElementById('strengthWrap');
            var bar = document.getElementById('strengthBar');
            var text = document.getElementById('strengthText');
            var matchStatus = document.getElementById('matchStatus');
            if (!newPass) return;

            function scorePassword(p) {
                var s = 0;
                if (p.length >= 6) s++;
                if (p.length >= 10) s++;
                if (/[A-Z]/.test(p)) s++;
                if (/[0-9]/.test(p)) s++;
                if (/[^A-Za-z0-9]/.test(p)) s++;
                return s;
            }
            function colorFor(s) {
                if (s <= 1) return { bg: 'bg-danger',  label: 'Muito fraca' };
                if (s === 2) return { bg: 'bg-warning', label: 'Fraca' };
                if (s === 3) return { bg: 'bg-info',    label: 'Razoável' };
                if (s === 4) return { bg: 'bg-primary', label: 'Forte' };
                return       { bg: 'bg-success', label: 'Muito forte' };
            }
            function updateRules(p) {
                var rules = {
                    'rule-len':   p.length >= 6,
                    'rule-upper': /[A-Z]/.test(p),
                    'rule-digit': /[0-9]/.test(p)
                };
                Object.keys(rules).forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) {
                        var txt = el.textContent.trim();
                        el.style.color = rules[id] ? '#198754' : '#dc3545';
                        el.innerHTML = (rules[id] ? '<i class="bi bi-check-circle-fill"></i> ' : '<i class="bi bi-x-circle-fill"></i> ') + txt;
                    }
                });
            }
            function updateMatch() {
                if (!confirmPass) return;
                if (confirmPass.value.length === 0) {
                    matchStatus.textContent = '';
                    return;
                }
                if (newPass.value === confirmPass.value) {
                    matchStatus.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> As passwords coincidem';
                } else {
                    matchStatus.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i> As passwords não coincidem';
                }
            }
            newPass.addEventListener('input', function () {
                var p = newPass.value;
                wrap.style.display = p.length === 0 ? 'none' : 'block';
                var s = scorePassword(p);
                var pct = (s / 5) * 100;
                var c = colorFor(s);
                bar.className = 'progress-bar ' + c.bg;
                bar.style.width = pct + '%';
                text.textContent = 'Força: ' + c.label;
                text.className = c.bg === 'bg-danger'  ? 'text-danger' :
                                 c.bg === 'bg-warning' ? 'text-warning' :
                                 c.bg === 'bg-info'    ? 'text-info' :
                                 c.bg === 'bg-primary' ? 'text-primary' : 'text-success';
                updateRules(p);
                updateMatch();
            });
            if (confirmPass) confirmPass.addEventListener('input', updateMatch);
        })();

        // ---- Loading state no botão ----
        (function () {
            var form = document.getElementById('resetForm');
            var btn = document.getElementById('submitBtn');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.querySelector('.btn-text').classList.add('d-none');
                    btn.querySelector('.spinner-border').classList.remove('d-none');
                });
            }
        })();
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}