@model LisAeroGest.Models.RecoverPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Password — LisAeroGest";

    // Detectar se o form foi submetido com sucesso
    var mensagem = ViewBag.Message as string;
    var enviado = !string.IsNullOrEmpty(mensagem) &&
                  (mensagem.Contains("enviado", StringComparison.OrdinalIgnoreCase)
                || mensagem.Contains("sucesso", StringComparison.OrdinalIgnoreCase)
                || mensagem.Contains("verifique", StringComparison.OrdinalIgnoreCase));
}

<div class="auth-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-7 col-xl-5">

                @if (enviado)
                {
                    @* ---- ESTADO: Email enviado (tema verde) ---- *@
                    <div class="card success-card">
                        <div class="success-header">
                            <div class="success-checkmark pulse-success">
                                <i class="bi bi-envelope-paper-fill"></i>
                            </div>
                            <h1>Verifique o seu Email</h1>
                            <p>Enviámos um link de recuperação</p>
                            <div class="auth-wave">
                                <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
                                    <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z" fill="white" />
                                </svg>
                            </div>
                        </div>

                        <div class="card-body success-body">
                            <i class="bi bi-envelope-check success-icon-big bounce-in"></i>

                            <h4 class="mt-3 mb-2">Email enviado!</h4>

                            <p class="success-message">
                                Se existe uma conta com o email
                                <strong class="text-break">@(Model?.Email ?? "fornecido")</strong>,
                                recebeu um link para redefinir a password.
                            </p>

                            <p class="success-detail">
                                <i class="bi bi-info-circle me-1"></i>
                                O link expira em <strong>1 hora</strong>.
                                Verifique também a pasta de spam.
                            </p>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-primary-grad btn-action">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Voltar ao Login
                                </a>
                                <button type="button" class="btn btn-outline-success btn-action" onclick="location.reload()">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Reenviar
                                </button>
                            </div>

                            <hr class="my-4" />

                            <div class="text-start small">
                                <p class="mb-1 text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                                </p>
                                <p class="mb-0 text-muted">
                                    <i class="bi bi-question-circle me-1"></i>
                                    Não recebeu? Aguarde 1-2 min e verifique o spam.
                                </p>
                            </div>
                        </div>

                        <div class="card-footer bg-white text-center py-3 border-0">
                            <a asp-controller="Account" asp-action="Login" class="text-muted small text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    @* ---- ESTADO: Pedir email (tema azul) ---- *@
                    <div class="card auth-card">
                        <div class="auth-header">
                            <i class="bi bi-envelope-paper floating-plane"></i>
                            <div class="auth-logo">
                                <i class="bi bi-key-fill"></i>
                            </div>
                            <h1>Recuperar Password</h1>
                            <p>Vamos ajudá-lo a voltar à sua conta</p>
                            <div class="auth-wave">
                                <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
                                    <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z" fill="white" />
                                </svg>
                            </div>
                        </div>

                        <div class="card-body auth-body">
                            <h4 class="text-center mb-1">Esqueceu a sua password?</h4>
                            <p class="text-center text-muted mb-4">
                                Sem problema. Introduza o seu email e enviaremos um link
                                para criar uma nova password.
                            </p>

                            <form asp-action="RecoverPassword" method="post" class="auth-form" id="recoverForm">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                                @if (!string.IsNullOrEmpty(mensagem))
                                {
                                    <div class="alert alert-danger small">@mensagem</div>
                                }

                                <div class="mb-4">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" class="form-control" type="email"
                                               placeholder="email@exemplo.com" autocomplete="email" id="emailInput" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="d-grid mb-3">
                                    <button type="submit" class="btn btn-primary btn-auth" id="submitBtn">
                                        <span class="btn-text">
                                            <i class="bi bi-send me-2"></i>Enviar Link de Recuperação
                                        </span>
                                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                    </button>
                                </div>

                                <div class="text-center">
                                    <small class="text-muted">
                                        <i class="bi bi-shield-check me-1"></i>
                                        Por segurança, o link expira em 1 hora.
                                    </small>
                                </div>
                            </form>
                        </div>

                        <div class="card-footer bg-white text-center py-3 border-0">
                            <a asp-action="Login" class="text-muted small text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
                            </a>
                        </div>
                    </div>
                }

                <p class="text-center text-muted small mt-3 mb-0">
                    &copy; @DateTime.Now.Year LisAeroGest · CINEL
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ---- Loading state no botão ----
        (function () {
            var form = document.getElementById('recoverForm');
            var btn = document.getElementById('submitBtn');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.querySelector('.btn-text').classList.add('d-none');
                    btn.querySelector('.spinner-border').classList.remove('d-none');
                });
            }
        })();
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}