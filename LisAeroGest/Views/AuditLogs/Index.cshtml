@model LisAeroGest.Models.AuditLogHistoryViewModel

@{
    ViewData["Title"] = "Auditoria do Sistema";
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- CABEÇALHO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-center
                gap-3 mb-4">

        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">
                Administração
            </div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-shield-check me-2"></i>
                Auditoria do Sistema
            </h2>

            <p class="text-muted mb-0">
                Consulte as principais atividades registadas no LisAeroGest.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar ao Dashboard

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- ESTATÍSTICAS -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <div class="col-6 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        Total de registos
                    </div>

                    <div class="fs-3 fw-bold mt-1">
                        @Model.TotalLogs
                    </div>

                </div>
            </div>
        </div>


        <div class="col-6 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        Hoje
                    </div>

                    <div class="fs-3 fw-bold text-primary mt-1">
                        @Model.LogsToday
                    </div>

                </div>
            </div>
        </div>


        <div class="col-6 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        Check-ins
                    </div>

                    <div class="fs-3 fw-bold text-success mt-1">
                        @Model.CheckIns
                    </div>

                </div>
            </div>
        </div>


        <div class="col-6 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        Portas
                    </div>

                    <div class="fs-3 fw-bold text-warning mt-1">
                        @Model.GateChanges
                    </div>

                </div>
            </div>
        </div>


        <div class="col-6 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        Comunicações
                    </div>

                    <div class="fs-3 fw-bold text-info mt-1">
                        @Model.Communications
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FILTROS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form method="get"
                  asp-controller="AuditLogs"
                  asp-action="Index">

                <div class="row g-3 align-items-end">


                    <!-- PESQUISA -->

                    <div class="col-12 col-lg-5">

                        <label class="form-label fw-semibold">
                            Pesquisar
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-transparent">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@Model.Search"
                                   class="form-control"
                                   placeholder="Utilizador, voo ou descrição..." />

                        </div>

                    </div>


                    <!-- AÇÃO -->

                    <div class="col-12 col-md-6 col-lg-2">

                        <label class="form-label fw-semibold">
                            Ação
                        </label>

                        <select name="auditAction"
                                class="form-select">

                            <option value="">Todas</option>

                            <option value="Login">
                                Login
                            </option>

                            <option value="Payment">
                                Pagamento
                            </option>

                            <option value="Update">
                                Alteração
                            </option>

                            <option value="Delete">
                                Eliminação
                            </option>

                            <option value="CheckIn">
                                Check-in
                            </option>

                            <option value="GateChanged">
                                Alteração de porta
                            </option>

                            <option value="CommunicationSent">
                                Comunicação
                            </option>

                        </select>

                    </div>


                    <!-- CATEGORIA -->

                    <div class="col-12 col-md-6 col-lg-3">

                        <label class="form-label fw-semibold">
                            Categoria
                        </label>

                        <select name="category"
                                class="form-select">

                            <option value="">Todas</option>

                            <option value="User">
                                Utilizador
                            </option>

                            <option value="Flight">
                                Voo
                            </option>

                            <option value="Ticket">
                                Bilhete
                            </option>

                            <option value="Passenger">
                                Passageiro
                            </option>

                            <option value="Gate">
                                Porta
                            </option>

                            <option value="Aircraft">
                                Aeronave
                            </option>

                            <option value="Airline">
                                Companhia aérea
                            </option>

                            <option value="Airport">
                                Aeroporto
                            </option>

                        </select>

                    </div>


                    <!-- BOTÕES -->

                    <div class="col-12 col-lg-2">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-fill">

                                <i class="bi bi-funnel me-1"></i>
                                Filtrar

                            </button>


                            <a asp-controller="AuditLogs"
                               asp-action="Index"
                               class="btn btn-outline-secondary"
                               title="Limpar filtros">

                                <i class="bi bi-x-lg"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- HISTÓRICO -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-transparent border-0 py-3">

            <div class="d-flex flex-column flex-md-row
                        justify-content-between
                        align-items-md-center
                        gap-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Histórico de atividades
                    </h5>


                    @if (Model.FilteredCount > 0)
                    {
                        <small class="text-muted">

                            A mostrar

                            <strong>@Model.FirstItem</strong>

                            –

                            <strong>@Model.LastItem</strong>

                            de

                            <strong>@Model.FilteredCount</strong>

                            registos

                        </small>
                    }

                </div>


                @if (Model.FilteredCount > 0)
                {
                    <span class="badge bg-transparent border">

                        Página @Model.Page de @Model.TotalPages

                    </span>
                }

            </div>

        </div>


        @if (Model.Logs.Count == 0)
        {
            <div class="card-body text-center py-5">

                <div class="fs-1 text-muted mb-3">
                    <i class="bi bi-journal-x"></i>
                </div>

                <h5 class="fw-semibold">
                    Nenhum registo encontrado
                </h5>

                <p class="text-muted mb-0">
                    Não existem atividades para os critérios selecionados.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Data</th>
                            <th>Utilizador</th>
                            <th>Ação</th>
                            <th>Categoria</th>
                            <th>Voo</th>
                            <th>Descrição</th>
                            <th class="text-center">Detalhes</th>
                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var item in Model.Logs)
                        {
                            <tr>

                                <!-- DATA -->

                                <td class="ps-4 text-nowrap">

                                    <div class="fw-semibold">

                                        @(item.CreatedAt
                                                                        .ToLocalTime()
                                                                        .ToString("dd/MM/yyyy"))

                                    </div>

                                    <small class="text-muted">

                                        @(item.CreatedAt
                                                                        .ToLocalTime()
                                                                        .ToString("HH:mm"))

                            </small>

                                </td>


                                <!-- UTILIZADOR -->

                                <td>

                                    <div class="fw-semibold">
                                        @item.UserName
                                    </div>

                            @if (!string.IsNullOrWhiteSpace(
                                                        item.UserEmail))
                                    {
                                        <small class="text-muted">
                                            @item.UserEmail
                                        </small>
                                    }

                                </td>


                                <!-- AÇÃO -->

                                <td>

                                    @switch (item.Action)
                                    {
                                        case "Login":

                                            <span class="badge bg-primary-subtle text-primary">

                                                <i class="bi bi-box-arrow-in-right me-1"></i>

                                                Login

                                            </span>

                                            break;


                                        case "Payment":

                                            <span class="badge bg-success-subtle text-success">

                                                <i class="bi bi-credit-card me-1"></i>

                                                Pagamento

                                            </span>

                                            break;


                                        case "Update":

                                            <span class="badge bg-warning-subtle text-warning-emphasis">

                                                <i class="bi bi-pencil me-1"></i>

                                                Alteração

                                            </span>

                                            break;


                                        case "Delete":

                                            <span class="badge bg-danger-subtle text-danger">

                                                <i class="bi bi-trash me-1"></i>

                                                Eliminação

                                            </span>

                                            break;


                                        case "CheckIn":

                                            <span class="badge bg-success-subtle text-success">

                                                <i class="bi bi-person-check me-1"></i>

                                                Check-in

                                            </span>

                                            break;


                                        case "GateChanged":

                                            <span class="badge bg-warning-subtle text-warning-emphasis">

                                                <i class="bi bi-signpost me-1"></i>

                                                Porta

                                            </span>

                                            break;


                                        case "CommunicationSent":

                                            <span class="badge bg-info-subtle text-info-emphasis">

                                                <i class="bi bi-megaphone me-1"></i>

                                                Comunicação

                                            </span>

                                            break;


                                        default:

                                            <span class="badge bg-secondary-subtle text-secondary">

                                                @item.Action

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- CATEGORIA -->

                                <td>

                                    @switch (item.Category)
                                    {
                                        case "User":
                                            <span>Utilizador</span>
                                            break;

                                        case "Flight":
                                            <span>Voo</span>
                                            break;

                                        case "Ticket":
                                            <span>Bilhete</span>
                                            break;

                                        case "Passenger":
                                            <span>Passageiro</span>
                                            break;

                                        case "Gate":
                                            <span>Porta</span>
                                            break;

                                        case "Aircraft":
                                            <span>Aeronave</span>
                                            break;

                                        case "Airline":
                                            <span>Companhia aérea</span>
                                            break;

                                        case "Airport":
                                            <span>Aeroporto</span>
                                            break;

                                        default:
                                            <span>@item.Category</span>
                                            break;
                                    }

                                </td>


                                <!-- VOO -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                item.FlightNumber))
                                    {
                                        <span class="fw-semibold">
                                            @item.FlightNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- DESCRIÇÃO -->

                                <td style="min-width:260px; max-width:420px;">

                                    <div class="text-truncate"
                                         style="max-width:420px;"
                                         title="@item.Description">

                                        @item.Description

                                    </div>

                                </td>


                                <!-- DETALHES -->

                                <td class="text-center">

                                    <a asp-controller="AuditLogs"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ver detalhes">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


        <!-- ===================================================== -->
        <!-- PAGINAÇÃO -->
        <!-- ===================================================== -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent border-0 py-3">

                <div class="d-flex
                                flex-column
                                flex-md-row
                                justify-content-between
                                align-items-md-center
                                gap-3">


                    <small class="text-muted">

                        Página

                        <strong>@Model.Page</strong>

                        de

                        <strong>@Model.TotalPages</strong>

                    </small>


                    <nav>

                        <ul class="pagination pagination-sm mb-0">


                            <li class="page-item
                                    @(!Model.HasPreviousPage ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.Page - 1)"
                                   asp-route-search="@Model.Search"
                                   asp-route-auditAction="@Model.Action"
                                   asp-route-category="@Model.Category">

                                    <i class="bi bi-chevron-left"></i>

                                    Anterior

                                </a>

                            </li>


                            @for (
                                                    var i = Math.Max(1, Model.Page - 2);
                                                    i <= Math.Min(Model.TotalPages, Model.Page + 2);
                                                    i++)
                            {
                                <li class="page-item
                                            @(i == Model.Page ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-search="@Model.Search"
                                       asp-route-auditAction="@Model.Action"
                                       asp-route-category="@Model.Category">

                                        @i

                                    </a>

                                </li>
                            }


                            <li class="page-item
                                    @(!Model.HasNextPage ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.Page + 1)"
                                   asp-route-search="@Model.Search"
                                   asp-route-auditAction="@Model.Action"
                                   asp-route-category="@Model.Category">

                                    Seguinte

                                    <i class="bi bi-chevron-right"></i>

                                </a>

                            </li>

                        </ul>

                    </nav>

                </div>

            </div>
        }

    </div>

</div>