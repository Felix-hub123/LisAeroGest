@model LisAeroGest.Models.ShopIndexViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Pesquisar Voos";
    var culture = new CultureInfo("pt-PT");
}

@section Styles {
    <link rel="stylesheet" href="~/css/shopIndex.css" asp-append-version="true" />
}

<div class="container my-4 mb-5">

    <!-- ═══ CABEÇALHO ═══ -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Início</a>
                    </li>
                    <li class="breadcrumb-item active">Pesquisar voos</li>
                </ol>
            </nav>
            <h1 class="shop-title mb-1">
                <i class="bi bi-search text-lime me-2"></i>Voos disponíveis
            </h1>

            @if (Model.HasFilters)
            {
                <p class="shop-filters mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.Origin))
                    {
                        <strong>@Model.Origin</strong>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Origin) && !string.IsNullOrWhiteSpace(Model.Destination))
                    {
                        <i class="bi bi-arrow-right mx-1 text-lime"></i>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Destination))
                    {
                        <strong>@Model.Destination</strong>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Date))
                    {
                        <span class="mx-1">·</span>
                        <span>@DateTime.Parse(Model.Date).ToString("dd MMM yyyy", culture)</span>
                    }
                    <span class="mx-1">·</span>
                    <span>@Model.PassengersLabel</span>
                    <span class="mx-1">·</span>
                    <span>@Model.CabinClassLabel</span>
                </p>
            }
            else
            {
                <p class="text-muted mb-0">Indique origem, destino e data para pesquisar.</p>
            }
        </div>
        <div>
            <span class="shop-count-badge">
                <i class="bi bi-airplane me-1"></i>
                @Model.ResultCount @(Model.ResultCount == 1 ? "voo encontrado" : "voos encontrados")
            </span>
        </div>
    </div>

    <!-- ═══ FORMULÁRIO DE PESQUISA ═══ -->
    <div class="shop-search-card card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form asp-action="Index" method="get" id="shopSearchForm" class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label for="origin" class="form-label fw-semibold">De</label>
                    <select id="origin" name="origin" class="form-select">
                        <option value="">Qualquer origem</option>
                        @foreach (var item in Model.Airports)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.Origin)">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-3 position-relative">
                    <label for="destination" class="form-label fw-semibold">Para</label>
                    <input type="text"
                           id="destination"
                           name="destination"
                           class="form-control"
                           placeholder="Cidade ou código IATA"
                           autocomplete="off"
                           value="@Model.Destination" />
                    <div id="airportSuggestions"
                         class="shop-autocomplete list-group position-absolute w-100 shadow"
                         style="z-index: 20; display: none;">
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label for="date" class="form-label fw-semibold">Ida</label>
                    <input type="date" id="date" name="date" value="@Model.Date" class="form-control"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-6 col-md-2">
                    <label for="returnDate" class="form-label fw-semibold">Volta</label>
                    <input type="date" id="returnDate" name="returnDate" value="@Model.ReturnDate" class="form-control"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-6 col-md-1">
                    <label for="passengers" class="form-label fw-semibold">Pax</label>
                    <select id="passengers" name="passengers" class="form-select">
                        @for (var i = 1; i <= 8; i++)
                        {
                            <option value="@i" selected="@(i == Model.Passengers)">@i</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-1">
                    <button type="submit" class="btn btn-lime w-100" id="btnSearch" title="Pesquisar">
                        <i class="bi bi-search"></i>
                    </button>
                </div>

                <input type="hidden" name="tripType" value="@Model.TripType" />
                <input type="hidden" name="cabinClass" value="@Model.CabinClass" />
            </form>
        </div>
    </div>

    <!-- ═══ LOADING ═══ -->
    <div id="searchLoading" class="shop-loading text-center py-5 d-none">
        <div class="spinner-border text-lime mb-3" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
        <p class="text-muted mb-0">A procurar voos disponíveis...</p>
    </div>

    <div id="searchResults">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }

        @if (Model.ResultCount > 0)
        {
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                <div class="btn-group btn-group-sm shop-sort-group" role="group" aria-label="Ordenar">
                    <button type="button" class="btn sort-btn active" data-sort="time">
                        <i class="bi bi-clock me-1"></i>Horário
                    </button>
                    <button type="button" class="btn sort-btn" data-sort="price">
                        <i class="bi bi-currency-euro me-1"></i>Preço
                    </button>
                    <button type="button" class="btn sort-btn" data-sort="duration">
                        <i class="bi bi-hourglass-split me-1"></i>Duração
                    </button>
                </div>
                <small class="text-muted d-none d-md-inline">
                    <i class="bi bi-info-circle me-1"></i>
                    Clique num voo para escolher lugar e reservar
                </small>
            </div>
        }

        @if (Model.ResultCount == 0)
        {
            <div class="shop-empty card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5">
                    <i class="bi bi-airplane display-4 text-muted d-block mb-3"></i>
                    <h4 class="fw-bold text-white">Não encontrámos voos para esta pesquisa</h4>
                    <p class="text-muted mb-4">
                        Tente alterar as datas, o destino ou remover filtros.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-lime rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i>Alterar pesquisa
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">
                        Ver todos os voos
                    </a>
                </div>
            </div>
        }
        else
        {
            <div id="flightsList" class="d-flex flex-column gap-3">
                @foreach (var flight in Model.Flights)
                {
                    <div class="shop-flight-card card border-0 shadow-sm rounded-4 flight-result-card"
                         data-price="@flight.BasePrice.ToString(CultureInfo.InvariantCulture)"
                         data-time="@flight.DepartureTime.ToString("yyyy-MM-ddTHH:mm:ss")"
                         data-duration="@flight.DurationMinutes">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-3">

                                <!-- Voo + Companhia -->
                                <div class="col-lg-2">
                                    <span class="shop-flight-number">
                                        <i class="bi bi-airplane-fill me-1"></i>@flight.FlightNumber
                                    </span>
                                    <div class="small text-muted mt-2">
                                        @(string.IsNullOrWhiteSpace(flight.AirlineName) ? flight.AircraftModel : flight.AirlineName)
                                    </div>
                                </div>

                                <!-- Rota -->
                                <div class="col-lg-5">
                                    <div class="row text-center align-items-center shop-route">
                                        <div class="col-4">
                                            <div class="shop-airport-code">@flight.OriginCode</div>
                                            <div class="small text-muted">@flight.DepartureTime.ToString("HH:mm")</div>
                                            <div class="small text-muted">@flight.OriginCity</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="small text-muted">@flight.DurationLabel</div>
                                            <div class="shop-route-line"></div>
                                            <div class="small text-lime">Direto</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="shop-airport-code">@flight.DestinationCode</div>
                                            <div class="small text-muted">@flight.ArrivalTime.ToString("HH:mm")</div>
                                            <div class="small text-muted">@flight.DestinationCity</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Preço -->
                                <div class="col-lg-2 text-lg-center">
                                    <div class="shop-price">
                                        @flight.BasePrice.ToString("C", culture)
                                    </div>
                                    <small class="text-muted">por adulto</small>
                                </div>

                                <!-- Ação -->
                                <div class="col-lg-3 text-lg-end">
                                    <a asp-action="SelectSeat"
                                       asp-route-flightId="@flight.Id"
                                       class="btn btn-lime rounded-pill px-4 fw-semibold">
                                        Selecionar
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                    <div class="small text-muted mt-2">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @flight.DepartureTime.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ---------- Loading ao pesquisar ----------
            const form = document.getElementById("shopSearchForm");
            const loading = document.getElementById("searchLoading");
            const results = document.getElementById("searchResults");

            if (form) {
                form.addEventListener("submit", function () {
                    if (loading) loading.classList.remove("d-none");
                    if (results) results.classList.add("d-none");
                });
            }

            // ---------- Ordenação ----------
            const list = document.getElementById("flightsList");
            if (list) {
                document.querySelectorAll(".sort-btn").forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        document.querySelectorAll(".sort-btn").forEach(b => b.classList.remove("active"));
                        btn.classList.add("active");

                        const sort = btn.getAttribute("data-sort");
                        const cards = Array.from(list.querySelectorAll(".flight-result-card"));

                        cards.sort(function (a, b) {
                            if (sort === "price") {
                                return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                            }
                            if (sort === "duration") {
                                return parseInt(a.dataset.duration) - parseInt(b.dataset.duration);
                            }
                            return a.dataset.time.localeCompare(b.dataset.time);
                        });

                        cards.forEach(c => list.appendChild(c));
                    });
                });
            }

            // ---------- Autocomplete de aeroportos ----------
            const input = document.getElementById("destination");
            const box = document.getElementById("airportSuggestions");
            if (!input || !box) return;

            let timer = null;

            input.addEventListener("input", function () {
                const term = input.value.trim();
                clearTimeout(timer);

                if (term.length < 2) {
                    box.style.display = "none";
                    box.innerHTML = "";
                    return;
                }

                timer = setTimeout(async function () {
                    const response = await fetch("/Shop/SearchAirports?term=" + encodeURIComponent(term));
                    if (!response.ok) return;

                    const items = await response.json();
                    box.innerHTML = "";

                    if (!items.length) {
                        box.style.display = "none";
                        return;
                    }

                    items.forEach(function (item) {
                        const label = item.label || item.Label || "";
                        const name = item.name || item.Name || "";
                        const country = item.country || item.Country || "";

                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "list-group-item list-group-item-action";
                        btn.innerHTML =
                            "<strong>" + label + "</strong>" +
                            "<br><small class='text-muted'>" + name + " · " + country + "</small>";
                        btn.addEventListener("click", function () {
                            input.value = label;
                            box.style.display = "none";
                        });
                        box.appendChild(btn);
                    });

                    box.style.display = "block";
                }, 250);
            });

            document.addEventListener("click", function (e) {
                if (!box.contains(e.target) && e.target !== input) {
                    box.style.display = "none";
                }
            });
        });
    </script>
}