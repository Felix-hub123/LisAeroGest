@model IEnumerable<LisAeroGest.Data.Entities.Flight>

@{
    ViewData["Title"] = "Pesquisar e Reservar Voos";
    var origin = ViewBag.Origin as string;
    var destination = ViewBag.Destination as string;
    var date = ViewBag.Date as string;
}

<div class="container my-5">
    <!-- Cabeçalho Principal -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">
            <i class="bi bi-airplane-engines me-2"></i>Encontre o seu Próximo Destino
        </h1>
        <p class="lead text-muted">Pesquise voos disponíveis com as melhores tarifas e reserve em poucos cliques.</p>
    </div>

    <!-- Painel de Pesquisa / Filtros -->
    <div class="card shadow-lg border-0 rounded-4 mb-5">
        <div class="card-body p-4 p-md-5 bg-light rounded-4">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="origin" class="form-label fw-bold text-dark">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Origem (IATA / Cidade)
                    </label>
                    <input type="text"
                           id="origin"
                           name="origin"
                           value="@origin"
                           class="form-control form-control-lg text-uppercase"
                           placeholder="Ex: LIS ou Lisboa" />
                </div>

                <div class="col-md-3">
                    <label for="destination" class="form-label fw-bold text-dark">
                        <i class="bi bi-pin-map-fill text-success me-1"></i> Destino (IATA / Cidade)
                    </label>
                    <input type="text"
                           id="destination"
                           name="destination"
                           value="@destination"
                           class="form-control form-control-lg text-uppercase"
                           placeholder="Ex: OPO ou Porto" />
                </div>

                <div class="col-md-3">
                    <label for="date" class="form-label fw-bold text-dark">
                        <i class="bi bi-calendar-event me-1"></i> Data de Partida
                    </label>
                    <input type="date"
                           id="date"
                           name="date"
                           value="@date"
                           class="form-control form-control-lg" />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
                        <i class="bi bi-search me-1"></i> Pesquisar
                    </button>
                    @if (!string.IsNullOrEmpty(origin) || !string.IsNullOrEmpty(destination) || !string.IsNullOrEmpty(date))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg" title="Limpar Filtros">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Mensagens de Notificação -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Lista de Voos Encontrados -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Voos Disponíveis</h4>
        <span class="badge bg-secondary fs-6">@Model.Count() voo(s) encontrado(s)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center p-5 shadow-sm border-0 rounded-4">
            <div class="card-body">
                <i class="bi bi-search text-muted display-1 mb-3"></i>
                <h4>Nenhum voo localizado</h4>
                <p class="text-muted">Não encontramos voos disponíveis para os critérios selecionados.</p>
                <a asp-action="Index" class="btn btn-outline-primary mt-2">Ver Todos os Voos</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var flight in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-4 overflow-hidden card-hover">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-3">
                                <!-- Informações do Voo -->
                                <div class="col-md-3 border-end-md text-center text-md-start">
                                    <span class="badge bg-primary px-3 py-2 fs-6 mb-2">
                                        Voo @flight.FlightNumber
                                    </span>
                                    <div class="text-muted small">
                                        Aeronave: <strong>@(flight.Aircraft?.Model ?? "N/A")</strong>
                                    </div>
                                </div>

                                <!-- Rota e Horários -->
                                <div class="col-md-5">
                                    <div class="d-flex align-items-center justify-content-between text-center">
                                        <div>
                                            <h3 class="fw-bold mb-0">@flight.OriginAirport?.IATACode</h3>
                                            <small class="text-muted d-block">@flight.OriginAirport?.City</small>
                                            <strong class="text-dark">@flight.DepartureTime.ToString("HH:mm")</strong>
                                        </div>

                                        <div class="flex-grow-1 px-3">
                                            <div class="text-muted small mb-1">
                                                @{
                                                    var duration = flight.ArrivalTime - flight.DepartureTime;
                                                }
                                                @($"{duration.Hours}h {duration.Minutes}m")
                                            </div>
                                            <div class="position-relative d-flex align-items-center justify-content-center">
                                                <hr class="w-100 my-0 border-2" />
                                                <i class="bi bi-airplane-fill position-absolute text-primary bg-white px-2"></i>
                                            </div>
                                            <small class="text-success fw-semibold d-block mt-1">Direto</small>
                                        </div>

                                        <div>
                                            <h3 class="fw-bold mb-0">@flight.DestinationAirport?.IATACode</h3>
                                            <small class="text-muted d-block">@flight.DestinationAirport?.City</small>
                                            <strong class="text-dark">@flight.ArrivalTime.ToString("HH:mm")</strong>
                                        </div>
                                    </div>
                                    <div class="text-center text-muted small mt-2">
                                        <i class="bi bi-calendar3 me-1"></i> Data: @flight.DepartureTime.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <!-- Preço e Seleção -->
                                <div class="col-md-4 text-center text-md-end border-start-md">
                                    <small class="text-muted d-block fs-7">A partir de</small>
                                    <div class="fs-2 fw-bold text-success mb-2">
                                        @flight.BasePrice.ToString("C2")
                                    </div>
                                    <a asp-action="SelectSeat" asp-route-flightId="@flight.Id" class="btn btn-primary btn-lg fw-bold w-100 shadow-sm">
                                        <i class="bi bi-journal-check me-1"></i> Selecionar Lugar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>