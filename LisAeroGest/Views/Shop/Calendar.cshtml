@model LisAeroGest.Models.FlightCalendarViewModel
@{
    ViewData["Title"] = "Voos a partir de Lisboa";
    var prev = new DateTime(Model.Year, Model.Month, 1).AddMonths(-1);
    var next = new DateTime(Model.Year, Model.Month, 1).AddMonths(1);
    var pt = new System.Globalization.CultureInfo("pt-PT");
}



<div class="container py-4">

    <!-- ═══ HEADER ═══ -->
    <div class="cal-header mb-4">
        <div>
            <div class="lis-section-label">A partir de Lisboa (LIS)</div>
            <h1 class="cal-title text-capitalize mb-0">@Model.MonthName @Model.Year</h1>
        </div>

        <div class="cal-nav">
            <a class="cal-nav-btn"
               asp-action="Calendar"
               asp-route-year="@prev.Year"
               asp-route-month="@prev.Month"
               aria-label="Mês anterior">
                <i class="bi bi-chevron-left"></i>
            </a>
            <a class="cal-nav-btn"
               asp-action="Calendar"
               asp-route-year="@next.Year"
               asp-route-month="@next.Month"
               aria-label="Mês seguinte">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>

    <!-- ═══ LEGENDA ═══ -->
    <div class="cal-legend mb-3">
        <span class="cal-legend-item"><span class="cal-dot cal-dot-flights"></span>Com voos</span>
        <span class="cal-legend-item"><span class="cal-dot cal-dot-today"></span>Hoje</span>
        <span class="cal-legend-item"><span class="cal-dot cal-dot-selected"></span>Selecionado</span>
    </div>

    <!-- ═══ GRELHA DO CALENDÁRIO ═══ -->
    <div class="cal-grid cal-grid-head">
        <div>Seg</div><div>Ter</div><div>Qua</div><div>Qui</div><div>Sex</div><div>Sáb</div><div>Dom</div>
    </div>

    <div class="cal-grid cal-grid-body">
        @foreach (var d in Model.Days)
        {
            var classes = "cal-day";
            if (!d.IsCurrentMonth)
                classes += " muted";
            if (d.IsToday)
                classes += " today";
            if (Model.SelectedDate == d.Date)
                classes += " selected";
            if (d.FlightCount > 0 && d.IsCurrentMonth)
                classes += " has-flights";

            if (d.FlightCount > 0 && d.IsCurrentMonth)
            {
                <a class="@classes"
                   asp-action="Calendar"
                   asp-route-year="@Model.Year"
                   asp-route-month="@Model.Month"
                   asp-route-day="@d.Date.ToString("yyyy-MM-dd")"
                   aria-label="@d.Date.ToString("dd 'de' MMMM", pt) — @d.FlightCount voos">
                    <span class="cal-day-num">@d.Date.Day</span>
                    <span class="cal-day-badge">@d.FlightCount</span>
                </a>
            }
            else
            {
                <div class="@classes" aria-label="@d.Date.ToString("dd 'de' MMMM", pt)">
                    <span class="cal-day-num">@d.Date.Day</span>
                </div>
            }
        }
    </div>

    <!-- ═══ VOOS DO DIA SELECIONADO ═══ -->
    @if (Model.SelectedDate != null)
    {
        <section class="cal-flights-section mt-5">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h2 class="cal-flights-title mb-0">
                    <i class="bi bi-calendar-check text-lime me-2"></i>
                    @Model.SelectedDate.Value.ToString("dddd, dd MMMM", pt)
                </h2>
                <span class="text-muted small">
                    @Model.FlightsOfDay.Count() voo(s) disponível(is)
                </span>
            </div>

            @if (!Model.FlightsOfDay.Any())
            {
                <div class="cal-empty">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                    <p class="mb-0">Não há voos neste dia.</p>
                </div>
            }
            else
            {
                <div class="cal-flights-list">
                    @foreach (var f in Model.FlightsOfDay)
                    {
                        <article class="cal-flight-card">
                            <div class="cal-flight-main">
                                <div class="cal-flight-route">
                                    <span class="cal-flight-code">LIS</span>
                                    <i class="bi bi-arrow-right cal-flight-arrow"></i>
                                    <span class="cal-flight-code">@f.DestinationCode</span>
                                </div>
                                <div class="cal-flight-dest">
                                    Lisboa → <strong>@f.DestinationCity</strong>
                                </div>
                            </div>

                            <div class="cal-flight-meta">
                                <div class="cal-flight-meta-item">
                                    <i class="bi bi-airplane"></i>
                                    <span>@f.FlightNumber · @f.AirlineName</span>
                                </div>
                                <div class="cal-flight-meta-item">
                                    <i class="bi bi-clock"></i>
                                    <span>@f.DepartureTime.ToString("HH:mm") · @f.DurationLabel</span>
                                </div>
                                @if (f.Temperature.HasValue)
                                {
                                    <div class="cal-flight-meta-item">
                                        <i class="bi bi-cloud-sun"></i>
                                        <span>@Math.Round(f.Temperature.Value)°C @f.WeatherDescription</span>
                                    </div>
                                }
                                @if (f.IsAdverseWeather)
                                {
                                    <span class="cal-flight-warn">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Tempo adverso
                                    </span>
                                }
                            </div>

                            <div class="cal-flight-action">
                                <div class="cal-flight-price">@f.BasePrice.ToString("C")</div>
                                <a class="cal-flight-btn"
                                   asp-action="SelectSeat"
                                   asp-route-flightId="@f.Id">
                                    <i class="bi bi-check2-circle me-1"></i>Escolher lugar
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else
    {
        <div class="cal-empty mt-5">
            <i class="bi bi-hand-index-thumb fs-1 d-block mb-2 opacity-50"></i>
            <p class="mb-0">Clique num dia com badge verde para ver os voos.</p>
        </div>
    }
</div>