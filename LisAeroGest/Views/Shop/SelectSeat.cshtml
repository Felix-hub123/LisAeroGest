@model LisAeroGest.Models.SelectSeatViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Escolha os seus lugares";
    var culture = new CultureInfo("pt-PT");
}

@section Styles {
    <link rel="stylesheet" href="~/css/select-seat.css" asp-append-version="true" />
}

<div class="container py-4 mb-5">

    <!-- ═══ BREADCRUMB ═══ -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Início</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index">Pesquisar voos</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Escolher lugares</li>
        </ol>
    </nav>

    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i>Voltar aos resultados
    </a>

    <!-- ═══ CABEÇALHO ═══ -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <span class="seat-flight-badge">
                <i class="bi bi-airplane-fill me-1"></i>@Model.Flight.FlightNumber
            </span>
            <h1 class="seat-title mb-1">Escolha os seus lugares</h1>
            <p class="text-muted mb-0">
                Selecione <strong class="text-lime">@Model.PassengerCount</strong> lugar(es) no mapa abaixo.
            </p>
        </div>
        <div class="text-end">
            <small class="text-muted d-block">Preço base</small>
            <strong class="seat-base-price">@Model.Flight.BasePrice.ToString("C2", culture)</strong>
            <small class="text-muted d-block">por adulto</small>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ═══ INFO DO VOO ═══ -->
    <div class="seat-info-card card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <small class="text-muted d-block">Companhia</small>
                    <strong class="text-white">@(Model.Flight.Airline?.Name ?? "—")</strong>
                    <div class="small text-muted">@(Model.Flight.Aircraft?.Model ?? "")</div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Partida</small>
                    <div class="seat-airport-code">@(Model.Flight.OriginAirport?.IATACode ?? "—")</div>
                    <div class="text-muted small">@(Model.Flight.OriginAirport?.City ?? "")</div>
                    <div class="fw-semibold text-white">@Model.Flight.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="col-md-3 text-md-center">
                    <small class="text-muted d-block">Duração</small>
                    <div class="fw-semibold text-white">
                        @((int)(Model.Flight.ArrivalTime - Model.Flight.DepartureTime).TotalHours)h
                        @((Model.Flight.ArrivalTime - Model.Flight.DepartureTime).Minutes.ToString("00"))m
                    </div>
                    <i class="bi bi-arrow-right text-lime"></i>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Chegada</small>
                    <div class="seat-airport-code">@(Model.Flight.DestinationAirport?.IATACode ?? "—")</div>
                    <div class="text-muted small">@(Model.Flight.DestinationAirport?.City ?? "")</div>
                    <div class="fw-semibold text-white">@Model.Flight.ArrivalTime.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="AddToCart" method="post" id="seatForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="flightId" value="@Model.Flight.Id" />

        <div id="selectedSeatsContainer"></div>
        <input type="hidden" id="passengerCount" value="@Model.PassengerCount" />

        <div class="row g-4">

            <!-- ═══ MAPA DA CABINE ═══ -->
            <div class="col-lg-7">
                <div class="seat-map-card card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="seat-section-title mb-3">
                            <i class="bi bi-grid-3x3-gap text-lime me-2"></i>Mapa da cabine
                        </h5>

                        @if (!Model.SeatRows.Any())
                        {
                            <div class="alert alert-warning text-center mb-0">
                                <i class="bi bi-exclamation-circle me-2"></i>
                                Não existem lugares disponíveis para este voo.
                            </div>
                        }
                        else
                        {
                            <div class="cabin-viewport">
                                <div class="airplane-topdown">
                                    <div class="plane-nose">
                                        <div class="cockpit-glass"></div>
                                        <span>Frente</span>
                                    </div>

                                    <div class="plane-body">
                                        <div class="wing wing-left"></div>
                                        <div class="wing wing-right"></div>

                                        <div class="cabin-legend d-flex justify-content-center gap-3 flex-wrap mb-3">
                                            <div class="legend-item">
                                                <span class="legend-box legend-available"></span>
                                                <small>Livre</small>
                                            </div>
                                            <div class="legend-item">
                                                <span class="legend-box legend-selected"></span>
                                                <small>Selecionado</small>
                                            </div>
                                            <div class="legend-item">
                                                <span class="legend-box legend-occupied"></span>
                                                <small>Ocupado</small>
                                            </div>
                                            <div class="legend-item">
                                                <span class="legend-box legend-business"></span>
                                                <small>Executiva</small>
                                            </div>
                                        </div>

                                        @foreach (var row in Model.SeatRows)
                                        {
                                            <div class="seat-row @(row.IsBusinessRow ? "row-business" : "")">
                                                <span class="row-number">@row.RowNumber</span>

                                                <div class="seat-side">
                                                    @foreach (var cell in row.LeftSeats)
                                                    {
                                                        if (!cell.Exists)
                                                        {
                                                            <span class="seat-empty"></span>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="seat-button @cell.CssClass"
                                                                    data-seat-id="@cell.SeatId"
                                                                    data-seat-code="@cell.Code"
                                                                    data-seat-class="@cell.SeatClass"
                                                                    data-seat-price="@cell.Price.ToString(CultureInfo.InvariantCulture)"
                                                                    disabled="@(cell.IsOccupied ? "disabled" : null)"
                                                                    onclick="selectSeat(this)">
                                                                @cell.Letter
                                                            </button>
                                                        }
                                                    }
                                                </div>

                                                <div class="aisle"></div>

                                                <div class="seat-side">
                                                    @foreach (var cell in row.RightSeats)
                                                    {
                                                        if (!cell.Exists)
                                                        {
                                                            <span class="seat-empty"></span>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="seat-button @cell.CssClass"
                                                                    data-seat-id="@cell.SeatId"
                                                                    data-seat-code="@cell.Code"
                                                                    data-seat-class="@cell.SeatClass"
                                                                    data-seat-price="@cell.Price.ToString(CultureInfo.InvariantCulture)"
                                                                    disabled="@(cell.IsOccupied ? "disabled" : null)"
                                                                    onclick="selectSeat(this)">
                                                                @cell.Letter
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="plane-tail">
                                        <span>Cauda</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ═══ RESUMO ═══ -->
            <div class="col-lg-5">
                <div class="seat-summary-card card border-0 shadow-sm rounded-4 sticky-lg-top" style="top: 20px;">
                    <div class="seat-summary-header card-header rounded-top-4 p-4">
                        <h5 class="mb-0 fw-bold text-white">
                            <i class="bi bi-cart-check me-2 text-lime"></i>Resumo da viagem
                        </h5>
                    </div>
                    <div class="card-body p-4">

                        <!-- Contador -->
                        <div class="seat-counter mb-3">
                            <div>
                                <i class="bi bi-people-fill me-2"></i>
                                <strong>Passageiros:</strong> @Model.PassengerCount
                            </div>
                            <div>
                                <strong>Lugares:</strong>
                                <span id="selectedCount" class="seat-counter-badge">0</span>
                                <span class="text-muted"> / @Model.PassengerCount</span>
                            </div>
                        </div>

                        <div class="seat-selection-box mb-4">
                            <small class="text-muted d-block">Lugares escolhidos</small>
                            <div id="seatDisplay" class="seat-selection-value">Nenhum</div>
                            <div id="seatClassDisplay" class="seat-selection-hint">Selecione os lugares no mapa</div>
                        </div>

                        <div class="seat-price-line">
                            <span>Voo (@Model.PassengerCount x @Model.Flight.BasePrice.ToString("C2", culture))</span>
                            <strong id="flightPrice">@((Model.Flight.BasePrice * Model.PassengerCount).ToString("C2", culture))</strong>
                        </div>
                        <div class="seat-price-line">
                            <span>Lugar</span>
                            <strong id="seatPrice">0,00 €</strong>
                        </div>

                        <hr class="border-secondary" />

                        <h6 class="seat-section-subtitle mb-3">
                            <i class="bi bi-plus-circle me-1"></i>Serviços adicionais
                        </h6>

                        <div class="seat-extra-option mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="extraLuggage"
                                       name="extraLuggage" value="true" onchange="updateTotal()" />
                                <label class="form-check-label" for="extraLuggage">
                                    <strong class="text-white">Bagagem extra</strong>
                                    <small class="d-block text-muted">Bagagem de porão adicional</small>
                                </label>
                            </div>
                            <strong class="text-lime">+@Model.ExtraLuggagePrice.ToString("C2", culture)</strong>
                        </div>

                        <div class="seat-extra-option mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="mealIncluded"
                                       name="mealIncluded" value="true" onchange="updateTotal()" />
                                <label class="form-check-label" for="mealIncluded">
                                    <strong class="text-white">Refeição a bordo</strong>
                                    <small class="d-block text-muted">Refeição quente</small>
                                </label>
                            </div>
                            <strong class="text-lime">+@Model.MealIncludedPrice.ToString("C2", culture)</strong>
                        </div>

                        <hr class="border-secondary" />

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold text-white">Total</span>
                            <span id="totalPriceDisplay" class="seat-total-price">
                                @((Model.Flight.BasePrice * Model.PassengerCount).ToString("C2", culture))
                            </span>
                        </div>

                        <button type="submit" id="btnSubmit" class="seat-submit-btn" disabled>
                            <i class="bi bi-cart-plus me-2"></i>Continuar para reserva
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/select-seat.js" asp-append-version="true"></script>
    <script>
        initSeatSelection(
            @Model.Flight.BasePrice.ToString(CultureInfo.InvariantCulture),
            @Model.ExtraLuggagePrice.ToString(CultureInfo.InvariantCulture),
            @Model.MealIncludedPrice.ToString(CultureInfo.InvariantCulture)
        );
    </script>
}