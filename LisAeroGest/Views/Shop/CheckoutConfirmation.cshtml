@model LisAeroGest.Models.CheckoutConfirmationViewModel
@{
    ViewData["Title"] = "Reserva Confirmada!";
    var isGuest = ViewBag.IsGuest ?? false;
    var isPaid = Model.Ticket?.Status == "Paid";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-success text-white text-center py-4">
                    <div class="display-1">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-0">
                        @if (isPaid)
                        {
                            <span>Pagamento Confirmado!</span>
                        }
                        else
                        {
                            <span>Reserva Confirmada!</span>
                        }
                    </h2>
                    <p class="mb-0 opacity-75">
                        @if (isPaid)
                        {
                            <span>O pagamento foi aceite</span>
                        }
                        else
                        {
                            <span>O lugar ficou reservado durante 30 minutos</span>
                        }
                    </p>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <small class="text-muted d-block">Número da reserva</small>
                        <div class="display-6 fw-bold text-primary">@ViewBag.TicketDisplayId</div>
                        <span class="badge @(isPaid ? "bg-success" : "bg-warning text-dark") mt-1">
                            @Model.Ticket?.Status
                        </span>
                        @if (!isPaid)
                        {
                            <br />
                            <small class="text-muted">
                                A reserva expira em 30 minutos.
                                <span class="fw-bold" id="countdownTimer">29:59</span>
                            </small>
                        }
                        else if (isGuest)
                        {
                            <br />
                            <small class="text-muted">
                                O PDF do bilhete fica disponível depois de criar conta.
                            </small>
                        }
                        else
                        {
                            <br />
                            <small class="text-success">Pagamento confirmado. O bilhete está na sua conta.</small>
                        }
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted d-block">Voo</small>
                                <strong>@Model.Flight?.FlightNumber</strong>
                                <br />
                                <small>@Model.Flight?.OriginAirport?.IATACode → @Model.Flight?.DestinationAirport?.IATACode</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted d-block">Lugar</small>
                                <strong>@Model.Seat?.Code</strong>
                                <br />
                                <small>@Model.Seat?.SeatClass</small>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted d-block">Partida</small>
                                <strong>@Model.Flight?.DepartureTime.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted d-block">Chegada</small>
                                <strong>@Model.Flight?.ArrivalTime.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="d-flex justify-content-between">
                            <span>Preço Base</span>
                            <strong>@((Model.TotalPrice - (Model.ExtraLuggage ? 30m : 0m) - (Model.MealIncluded ? 15m : 0m)).ToString("C2"))</strong>
                        </div>
                        @if (Model.ExtraLuggage)
                        {
                            <div class="d-flex justify-content-between">
                                <span>Bagagem Extra</span>
                                <strong>+30,00 €</strong>
                            </div>
                        }
                        @if (Model.MealIncluded)
                        {
                            <div class="d-flex justify-content-between">
                                <span>Refeição</span>
                                <strong>+15,00 €</strong>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span class="text-success">@Model.TotalPrice.ToString("C2")</span>
                        </div>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <h6 class="fw-bold">Passageiro</h6>
                        <p class="mb-0"><strong>@Model.Passenger?.FullName</strong></p>
                        <p class="mb-0"><small>@Model.Passenger?.Email</small></p>
                        <p class="mb-0"><small>Doc: @Model.Passenger?.DocumentNumber</small></p>
                    </div>

                    @if (isGuest && !isPaid)
                    {
                        <div class="card border-0 shadow-lg rounded-4 mt-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-1">Crie a sua conta</h5>
                                <p class="text-muted mb-2">
                                    Com conta pode gerir reservas, pagar e mais tarde descarregar o bilhete.
                                </p>
                                <a asp-controller="Account" asp-action="Register"
                                   asp-route-email="@Model.Passenger?.Email"
                                   asp-route-firstName="@Model.Passenger?.FirstName"
                                   asp-route-lastName="@Model.Passenger?.LastName"
                                   class="btn btn-primary btn-lg">
                                    Criar conta
                                </a>
                            </div>
                        </div>
                    }
                    else if (isGuest && isPaid)
                    {
                        var wa = Uri.EscapeDataString(
                        $"LisAeroGest — pagamento confirmado. Reserva #{ViewBag.TicketDisplayId}. Crie conta no site com o mesmo email para descarregar o bilhete.");

                        <div class="card border-0 shadow-lg rounded-4 mt-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-1 text-success">Pagamento Confirmado!</h5>
                                <p class="text-muted mb-2">
                                    O PDF do bilhete só fica disponível depois de criar conta com o mesmo email.
                                </p>
                                <div class="d-flex flex-wrap gap-3 mt-3">
                                    <a asp-controller="Account" asp-action="Register"
                                       asp-route-email="@Model.Passenger?.Email"
                                       asp-route-firstName="@Model.Passenger?.FirstName"
                                       asp-route-lastName="@Model.Passenger?.LastName"
                                       class="btn btn-primary btn-lg">
                                        Criar conta e ver o bilhete
                                    </a>
                                    <a class="btn btn-success btn-lg" href="https://wa.me/?text=@wa" target="_blank">
                                        WhatsApp
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else if (!isGuest && isPaid)
                    {
                        <div class="card border-0 shadow-sm rounded-4 mt-4">
                            <div class="card-body p-4 text-center">
                                <h5 class="fw-bold">Pagamento Confirmado!</h5>
                                <p class="text-muted">O bilhete está na sua conta.</p>
                                <div class="d-flex flex-wrap justify-content-center gap-3">
                                    <a asp-controller="Shop" asp-action="MyTickets" class="btn btn-primary">
                                        Os meus bilhetes
                                    </a>
                                    <a asp-controller="Shop" asp-action="DownloadTicketPdf"
                                       asp-route-ticketId="@Model.Ticket?.Id"
                                       class="btn btn-outline-primary">
                                        Descarregar PDF
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="text-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Voltar à Página Inicial
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @if (!isPaid)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const timerElement = document.getElementById('countdownTimer');
                if (!timerElement) return;
                let totalSeconds = 30 * 60;
                function updateTimer() {
                    if (totalSeconds <= 0) {
                        timerElement.textContent = '00:00';
                        return;
                    }
                    const minutes = Math.floor(totalSeconds / 60);
                    const seconds = totalSeconds % 60;
                    timerElement.textContent =
                        String(minutes).padStart(2, '0') + ':' +
                        String(seconds).padStart(2, '0');
                    totalSeconds--;
                }
                updateTimer();
                setInterval(updateTimer, 1000);
            });
        </script>
    }
}