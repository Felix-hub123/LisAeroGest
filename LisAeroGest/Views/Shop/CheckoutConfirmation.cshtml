@model LisAeroGest.Models.CheckoutConfirmationViewModel
@{
    ViewData["Title"] = "Reserva Confirmada!";
    var isGuest = ViewBag.IsGuest ?? false;
    var isPaid = Model.Ticket?.Status == "Paid";
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkoutConfirmation.css" asp-append-version="true" />
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card checkout-card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- ═══ HEADER ═══ -->
                <div class="checkout-header text-white text-center py-4">
                    <div class="display-1">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-0">
                        @if (isPaid)
                        {
                            <span>Pagamento Confirmado!</span>
                        }
                        else
                        {
                            <span>Reserva Confirmada!</span>
                        }
                    </h2>
                    <p class="mb-0 opacity-75">
                        @if (isPaid)
                        {
                            <span>O pagamento foi aceite</span>
                        }
                        else
                        {
                            <span>O lugar ficou reservado durante 30 minutos</span>
                        }
                    </p>
                </div>

                <!-- ═══ BODY ═══ -->
                <div class="card-body p-4">

                    <!-- Nº Reserva -->
                    <div class="text-center mb-4">
                        <small class="text-muted d-block">Número da reserva</small>
                        <div class="checkout-ticket-id">@ViewBag.TicketDisplayId</div>
                        <span class="badge @(isPaid ? "bg-success" : "bg-warning text-dark") mt-1">
                            @Model.Ticket?.Status
                        </span>

                        @if (!isPaid)
                        {
                            <br />
                            <small class="text-muted">
                                A reserva expira em 30 minutos.
                                <span class="fw-bold text-lime" id="countdownTimer">29:59</span>
                            </small>
                        }
                        else if (isGuest)
                        {
                            <br />
                            <small class="text-muted">
                                O PDF do bilhete fica disponível depois de criar conta.
                            </small>
                        }
                        else
                        {
                            <br />
                            <small class="text-lime">
                                Pagamento confirmado. O bilhete está na sua conta.
                            </small>
                        }
                    </div>

                    <!-- Voo + Lugar -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="checkout-info-box">
                                <small class="text-muted d-block">Voo</small>
                                <strong class="text-white">@Model.Flight?.FlightNumber</strong>
                                <br />
                                <small class="text-white-50">
                                    @Model.Flight?.OriginAirport?.IATACode → @Model.Flight?.DestinationAirport?.IATACode
                                </small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="checkout-info-box">
                                <small class="text-muted d-block">Lugar</small>
                                <strong class="text-white">@Model.Seat?.Code</strong>
                                <br />
                                <small class="text-white-50">@Model.Seat?.SeatClass</small>
                            </div>
                        </div>
                    </div>

                    <!-- Partida + Chegada -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="checkout-info-box">
                                <small class="text-muted d-block">Partida</small>
                                <strong class="text-white">
                                    @Model.Flight?.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                                </strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="checkout-info-box">
                                <small class="text-muted d-block">Chegada</small>
                                <strong class="text-white">
                                    @Model.Flight?.ArrivalTime.ToString("dd/MM/yyyy HH:mm")
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- Preços -->
                    <div class="checkout-info-box mb-4">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Preço Base</span>
                            <strong class="text-white">
                                @((Model.TotalPrice - (Model.ExtraLuggage ? 30m : 0m) - (Model.MealIncluded ? 15m : 0m)).ToString("C2"))
                            </strong>
                        </div>
                        @if (Model.ExtraLuggage)
                        {
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Bagagem Extra</span>
                                <strong class="text-white">+30,00 €</strong>
                            </div>
                        }
                        @if (Model.MealIncluded)
                        {
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Refeição</span>
                                <strong class="text-white">+15,00 €</strong>
                            </div>
                        }
                        <hr class="border-secondary" />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span class="text-white">Total</span>
                            <span class="text-lime">@Model.TotalPrice.ToString("C2")</span>
                        </div>
                    </div>

                    <!-- Passageiro -->
                    <div class="checkout-info-box mb-4">
                        <h6 class="fw-bold text-lime">
                            <i class="bi bi-person-fill me-1"></i>Passageiro
                        </h6>
                        <p class="mb-0 text-white"><strong>@Model.Passenger?.FullName</strong></p>
                        <p class="mb-0"><small class="text-muted">@Model.Passenger?.Email</small></p>
                        <p class="mb-0"><small class="text-muted">Doc: @Model.Passenger?.DocumentNumber</small></p>
                    </div>

                    @* ═══ CTA: Guest + Não Pago ═══ *@
                    @if (isGuest && !isPaid)
                    {
                        <div class="checkout-cta-card">
                            <h5 class="fw-bold mb-1 text-white">Crie a sua conta</h5>
                            <p class="text-muted mb-3">
                                Com conta pode gerir reservas, pagar e mais tarde descarregar o bilhete.
                            </p>
                            <a asp-controller="Account" asp-action="Register"
                               asp-route-email="@Model.Passenger?.Email"
                               asp-route-firstName="@Model.Passenger?.FirstName"
                               asp-route-lastName="@Model.Passenger?.LastName"
                               class="btn btn-lime btn-lg">
                                <i class="bi bi-person-plus me-1"></i>Criar conta
                            </a>
                        </div>
                    }
                    @* ═══ CTA: Guest + Pago ═══ *@
                    else if (isGuest && isPaid)
                    {
                        <div class="checkout-cta-card">
                            <h5 class="fw-bold mb-1 text-lime">
                                <i class="bi bi-check-circle-fill me-1"></i>Pagamento Confirmado!
                            </h5>
                            <p class="text-muted mb-3">
                                Crie conta com o mesmo email para aceder ao bilhete, descarregá-lo em PDF
                                e receber notificações do voo.
                            </p>
                            <a asp-controller="Account" asp-action="Register"
                               asp-route-email="@Model.Passenger?.Email"
                               asp-route-firstName="@Model.Passenger?.FirstName"
                               asp-route-lastName="@Model.Passenger?.LastName"
                               class="btn btn-lime btn-lg">
                                <i class="bi bi-person-plus me-1"></i>Criar conta e ver o bilhete
                            </a>
                        </div>
                    }
                    @* ═══ CTA: Logado + Pago ═══ *@
                    else if (!isGuest && isPaid)
                    {
                        <div class="checkout-cta-card text-center">
                            <h5 class="fw-bold text-lime">
                                <i class="bi bi-check-circle-fill me-1"></i>Pagamento Confirmado!
                            </h5>
                            <p class="text-muted">O bilhete está na sua conta.</p>
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <a asp-controller="Shop" asp-action="MyTickets" class="btn btn-lime">
                                    <i class="bi bi-ticket-perforated me-1"></i>Os meus bilhetes
                                </a>
                                <a asp-controller="Shop" asp-action="DownloadTicketPdf"
                                   asp-route-ticketId="@Model.Ticket?.Id"
                                   class="btn btn-outline-lime">
                                    <i class="bi bi-download me-1"></i>Descarregar PDF
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Voltar -->
                    <div class="text-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Voltar à Página Inicial
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isPaid)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const timerElement = document.getElementById('countdownTimer');
                if (!timerElement) return;
                let totalSeconds = 30 * 60;
                function updateTimer() {
                    if (totalSeconds <= 0) {
                        timerElement.textContent = '00:00';
                        return;
                    }
                    const minutes = Math.floor(totalSeconds / 60);
                    const seconds = totalSeconds % 60;
                    timerElement.textContent =
                        String(minutes).padStart(2, '0') + ':' +
                        String(seconds).padStart(2, '0');
                    totalSeconds--;
                }
                updateTimer();
                setInterval(updateTimer, 1000);
            });
        </script>
    }
}