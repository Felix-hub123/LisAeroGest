@model LisAeroGest.Models.GuestPaymentViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Finalizar Pagamento";
    var remainingSeconds = 0;
    if (Model.ExpiresAt.HasValue)
    {
        remainingSeconds = Math.Max(0, (int)(Model.ExpiresAt.Value - DateTime.UtcNow).TotalSeconds);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/guestPayment.css" asp-append-version="true" />
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="gp-card card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- ═══ HEADER ═══ -->
                <div class="gp-header p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h3 class="fw-bold mb-0 text-white">
                                <i class="bi bi-credit-card me-2"></i>Finalizar Pagamento
                            </h3>
                            <small class="gp-header-sub">
                                <i class="bi bi-shield-lock me-1"></i>
                                Pagamento processado via PayPal Sandbox — ambiente de testes.
                            </small>
                        </div>
                        <div class="text-end">
                            <small class="gp-timer-label d-block">Reserva expira em</small>
                            <span class="gp-timer fw-bold" id="countdownTimer">
                                @TimeSpan.FromSeconds(remainingSeconds).ToString(@"mm\:ss")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ═══ BODY ═══ -->
                <div class="card-body p-4">

                    @if (remainingSeconds < 300 && remainingSeconds > 0)
                    {
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Atenção!</strong>
                                <span class="d-block small">
                                    A reserva expira em menos de 5 minutos. Conclui o pagamento rapidamente.
                                </span>
                            </div>
                        </div>
                    }
                    else if (Model.ExpiresAt.HasValue && remainingSeconds <= 0)
                    {
                        <div class="alert alert-danger d-flex align-items-center flex-wrap gap-2" role="alert">
                            <i class="bi bi-x-circle-fill fs-4 me-3"></i>
                            <div class="flex-grow-1">
                                <strong>Reserva Expirada!</strong>
                                <span class="d-block small">Por favor, faça uma nova reserva.</span>
                            </div>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-danger">
                                <i class="bi bi-search me-1"></i>Voltar à Pesquisa
                            </a>
                        </div>
                    }

                    <!-- ═══ RESUMO ═══ -->
                    <h5 class="gp-section-title mb-3">
                        <i class="bi bi-receipt text-lime me-2"></i>Resumo da reserva
                    </h5>

                    <ul class="gp-summary-list list-unstyled mb-4">
                        <li class="gp-summary-item">
                            <span class="gp-summary-label">Passageiro</span>
                            <strong class="text-white">@Model.PassengerName</strong>
                        </li>
                        <li class="gp-summary-item">
                            <span class="gp-summary-label">Voo</span>
                            <strong class="text-white">@Model.FlightNumber</strong>
                        </li>
                        <li class="gp-summary-item">
                            <span class="gp-summary-label">Rota</span>
                            <strong class="text-white">@Model.OriginCode → @Model.DestinationCode</strong>
                        </li>
                        <li class="gp-summary-item">
                            <span class="gp-summary-label">Lugar</span>
                            <strong class="text-white">@Model.SeatCode</strong>
                        </li>
                        <li class="gp-summary-item">
                            <span class="gp-summary-label">Bagagem Extra</span>
                            <strong class="@(Model.ExtraLuggage ? "text-lime" : "text-muted")">
                                @(Model.ExtraLuggage ? "Sim" : "Não")
                            </strong>
                        </li>
                        <li class="gp-summary-item">
                            <span class="gp-summary-label">Refeição</span>
                            <strong class="@(Model.MealIncluded ? "text-lime" : "text-muted")">
                                @(Model.MealIncluded ? "Sim" : "Não")
                            </strong>
                        </li>
                        <li class="gp-summary-item gp-summary-total">
                            <span class="fw-bold text-white">Total a pagar</span>
                            <strong class="text-lime fs-4">@Model.TotalPrice.ToString("C")</strong>
                        </li>
                    </ul>

                    <!-- ═══ AÇÕES (se tiver token) ═══ -->
                    @if (!string.IsNullOrEmpty(Model.DownloadToken))
                    {
                        var pdfUrl = Url.Action("GuestTicketPdf", "Shop", new { ticketId = Model.TicketId, token = Model.DownloadToken });
                        var payUrl = Url.Action("GuestPayment", "Shop", new { ticketId = Model.TicketId }, Context.Request.Scheme);
                        var wa = Uri.EscapeDataString(
                        $"LisAeroGest reserva #{Model.TicketId}\nVoo {Model.FlightNumber} {Model.OriginCode}-{Model.DestinationCode}\nLugar {Model.SeatCode}\nPagar: {payUrl}\nDocumento: {Context.Request.Scheme}://{Context.Request.Host}{pdfUrl}");

                        <div class="alert alert-warning d-flex align-items-center">
                            <i class="bi bi-info-circle-fill fs-5 me-2"></i>
                            <span>
                                Isto é uma <strong>reserva</strong>, não um bilhete. Pague para confirmar.
                            </span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <a class="btn btn-outline-lime" href="@pdfUrl">
                                <i class="bi bi-file-earmark-pdf me-1"></i>Descarregar reserva (PDF)
                            </a>
                            <a class="btn btn-success" href="https://wa.me/?text=@wa" target="_blank">
                                <i class="bi bi-whatsapp me-1"></i>Enviar no WhatsApp
                            </a>
                        </div>
                    }

                    <!-- ═══ PAYPAL ═══ -->
                    <div id="paypal-error" class="alert alert-danger d-none"></div>

                    @if (!Model.ExpiresAt.HasValue || remainingSeconds > 0)
                    {
                        <div class="gp-paypal-wrapper">
                            <div id="paypal-button-container"></div>
                        </div>
                    }

                    <!-- ═══ VOLTAR ═══ -->
                    <div class="text-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="gp-back-link">
                            <i class="bi bi-arrow-left me-1"></i>Voltar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@Configuration["PayPal:ClientId"]&currency=EUR"></script>
    <script>
        const ticketId = @Model.TicketId;
        const errorBox = document.getElementById('paypal-error');

        function showError(message) {
            errorBox.textContent = message;
            errorBox.classList.remove('d-none');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const timerElement = document.getElementById('countdownTimer');
            if (!timerElement) return;

            let totalSeconds = @remainingSeconds;

            function updateTimer() {
                if (totalSeconds <= 0) {
                    timerElement.textContent = '00:00';
                    timerElement.classList.add('text-danger');
                    window.location.reload();
                    return;
                }
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                timerElement.textContent =
                    String(minutes).padStart(2, '0') + ':' +
                    String(seconds).padStart(2, '0');

                if (totalSeconds < 300) {
                    timerElement.classList.add('text-warning');
                }
                totalSeconds--;
            }
            updateTimer();
            setInterval(updateTimer, 1000);
        });

        paypal.Buttons({
            style: { layout: 'vertical', color: 'blue', shape: 'rect', label: 'paypal' },
            createOrder: function () {
                errorBox.classList.add('d-none');
                return fetch('/Shop/CreatePayPalOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId: ticketId })
                })
                .then(res => res.json().then(data => ({ ok: res.ok, data })))
                .then(({ ok, data }) => {
                    if (!ok) {
                        showError(data.message || 'Erro ao iniciar o pagamento.');
                        throw new Error(data.message);
                    }
                    return data.orderId;
                });
            },
            onApprove: function (data) {
                return fetch('/Shop/CapturePayPalOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId: ticketId, orderId: data.orderID })
                })
                .then(res => res.json().then(result => ({ ok: res.ok, result })))
                .then(({ ok, result }) => {
                    if (ok && result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    } else {
                        showError(result.message || 'Não foi possível confirmar o pagamento.');
                    }
                });
            },
            onError: function (err) {
                showError('Ocorreu um erro ao comunicar com o PayPal. Tenta novamente.');
                console.error(err);
            }
        }).render('#paypal-button-container');
    </script>
}