@model LisAeroGest.Data.Entities.Ticket
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Finalizar Pagamento";
    var timeSinceCreation = DateTime.UtcNow - Model.PurchaseDate;
    var remainingSeconds = Math.Max(0, 1800 - (int)timeSinceCreation.TotalSeconds);
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="fw-bold mb-0"><i class="bi bi-credit-card me-2"></i>Finalizar Pagamento</h3>
                            <small class="opacity-75">Pagamento processado via PayPal Sandbox — ambiente de testes.</small>
                        </div>
                     
                        <div class="text-end">
                            <small class="d-block opacity-75">Reserva expira em</small>
                            <span class="fw-bold text-white" id="countdownTimer">@TimeSpan.FromSeconds(remainingSeconds).ToString(@"mm\:ss")</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                   
                    @if (remainingSeconds < 300 && remainingSeconds > 0)
                    {
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Atenção!</strong>
                                <span class="d-block small">
                                    A reserva expira em menos de 5 minutos. Conclui o pagamento rapidamente.
                                </span>
                            </div>
                        </div>
                    }
                    else if (remainingSeconds <= 0)
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-x-circle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Reserva Expirada!</strong>
                                <span class="d-block small">
                                    A reserva expirou. Por favor, faça uma nova reserva.
                                </span>
                            </div>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-danger ms-auto">
                                Voltar à Pesquisa
                            </a>
                        </div>
                    }

                    <h5 class="fw-bold mb-3">Resumo da reserva</h5>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Voo</span>
                            <strong>@ViewBag.FlightNumber</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Lugar</span>
                            <strong>@Model.Seat?.Code</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Bagagem Extra</span>
                            <strong>@(Model.ExtraLuggage ? "✅ Sim" : "❌ Não")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Refeição</span>
                            <strong>@(Model.MealIncluded ? "✅ Sim" : "❌ Não")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="fw-bold">Total a pagar</span>
                            <strong class="text-success fs-5">@ViewBag.TotalPrice.ToString("C")</strong>
                        </li>
                    </ul>

                    <div id="paypal-error" class="alert alert-danger d-none"></div>

                    <div id="paypal-button-container"></div>

                    <div class="text-center mt-3">
                        <a asp-action="SelectSeat" asp-route-flightId="@Model.FlightId" class="text-muted small">
                            <i class="bi bi-arrow-left me-1"></i>Voltar
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@Configuration["PayPal:ClientId"]&currency=EUR">
    </script>
    <script>
        const ticketId = @ViewBag.TicketId;
        const errorBox = document.getElementById('paypal-error');

        function showError(message) {
            errorBox.textContent = message;
            errorBox.classList.remove('d-none');
        }

        document.addEventListener('DOMContentLoaded', function() {
            const timerElement = document.getElementById('countdownTimer');
            if (!timerElement) return;

            let totalSeconds = @remainingSeconds;

            function updateTimer() {
                if (totalSeconds <= 0) {
                    timerElement.textContent = '00:00';
                    timerElement.classList.add('text-danger');
                
                    window.location.reload();
                    return;
                }

                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                timerElement.textContent =
                    String(minutes).padStart(2, '0') + ':' +
                    String(seconds).padStart(2, '0');

                if (totalSeconds < 300) {
                    timerElement.classList.add('text-warning');
                }

                totalSeconds--;
            }

            updateTimer();
            setInterval(updateTimer, 1000);
        });

        paypal.Buttons({
            style: { layout: 'vertical', color: 'blue', shape: 'rect', label: 'paypal' },

            createOrder: function () {
                errorBox.classList.add('d-none');
                return fetch('/Shop/CreatePayPalOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId: ticketId })
                })
                .then(res => res.json().then(data => ({ ok: res.ok, data })))
                .then(({ ok, data }) => {
                    if (!ok) { showError(data.message || 'Erro ao iniciar o pagamento.'); throw new Error(data.message); }
                    return data.orderId;
                });
            },

            onApprove: function (data) {
                return fetch('/Shop/CapturePayPalOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId: ticketId, orderId: data.orderID })
                })
                .then(res => res.json().then(result => ({ ok: res.ok, result })))
                .then(({ ok, result }) => {
                    if (ok && result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    } else {
                        showError(result.message || 'Não foi possível confirmar o pagamento.');
                    }
                });
            },

            onError: function (err) {
                showError('Ocorreu um erro ao comunicar com o PayPal. Tenta novamente.');
                console.error(err);
            }
        }).render('#paypal-button-container');
    </script>
}