@model LisAeroGest.Models.PaymentViewModel
@inject IConfiguration Configuration
@using System.Globalization

@{
    ViewData["Title"] = "Finalizar Pagamento";

    var culture =
        new CultureInfo("pt-PT");
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/guestPayment.css"
          asp-append-version="true" />

}


<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">


            <div class="gp-card
                        card
                        border-0
                        shadow-lg
                        rounded-4
                        overflow-hidden">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <div class="gp-header p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                flex-wrap
                                gap-3">


                        <div>

                            <h3 class="fw-bold mb-0 text-white">

                                <i class="bi
                                          bi-credit-card
                                          me-2">
                                </i>

                                Finalizar Pagamento

                            </h3>


                            <small class="gp-header-sub">

                                <i class="bi
                                          bi-shield-lock
                                          me-1">
                                </i>

                                Pagamento seguro via PayPal Sandbox

                            </small>

                        </div>


                        <div class="text-end">

                            <small class="gp-timer-label d-block">

                                Total da compra

                            </small>


                            <span class="gp-timer fw-bold">

                                @Model.TotalPrice.ToString(
                                "C",
                                                                culture)

                            </span>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BODY -->
                <!-- ================================================= -->

                <div class="card-body p-4">


                    <h5 class="gp-section-title mb-3">

                        <i class="bi
                                  bi-receipt
                                  text-lime
                                  me-2">
                        </i>

                        Resumo da compra

                    </h5>


                    @if (Model.Tickets == null ||
                                        !Model.Tickets.Any())
                                        {

                    <div class="alert alert-warning">

                        <i class="bi
                                      bi-cart-x
                                      me-2">
                        </i>

                        Não existem bilhetes para pagamento.

                    </div>


                    <div class="text-center mt-4">

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            <i class="bi
                                          bi-search
                                          me-1">
                            </i>

                            Pesquisar voos

                        </a>

                    </div>

                                        }
                                        else
                    {

                        <!-- ================================================= -->
                        <!-- TABELA -->
                        <!-- ================================================= -->

                        <div class="gp-table-wrapper">

                            <div class="table-responsive">

                                <table class="table
                                                  gp-table
                                                  align-middle
                                                  mb-0">


                                    <thead>

                                        <tr>

                                            <th>
                                                Voo
                                            </th>

                                            <th>
                                                Rota
                                            </th>

                                            <th>
                                                Lugar
                                            </th>

                                            <th>
                                                Extras
                                            </th>

                                            <th class="text-end">
                                                Preço
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        @foreach (var ticket in Model.Tickets)
                                        {

                                            <tr>

                                                <!-- VOO -->

                                                <td>

                                                    <span class="gp-flight-number">

                                                        <i class="bi
                                                                          bi-airplane-fill
                                                                          me-1">
                                                        </i>

                                                        @(ticket.Flight?.FlightNumber
                                                                                                        ?? "-")

                                                    </span>

                                                </td>


                                                <!-- ROTA -->

                                                <td>

                                                    <span class="gp-route">

                                                        <strong>

                                                            @(ticket.Flight?
                                                                                                                .OriginAirport?
                                                                                                                .IATACode
                                                                                                                ?? "-")

                                                        </strong>


                                                        <i class="bi
                                                                          bi-arrow-right
                                                                          text-lime
                                                                          mx-1">
                                                        </i>


                                                        <strong>

                                                            @(ticket.Flight?
                                                                                                                .DestinationAirport?
                                                                                                                .IATACode
                                                                                                                ?? "-")

                                                        </strong>

                                                    </span>

                                                </td>


                                                <!-- LUGAR -->

                                                <td>

                                                    <span class="gp-seat">

                                                        @(ticket.Seat?.Code
                                                                                                        ?? "-")

                                            </span>

                                                </td>


                                                <!-- EXTRAS -->

                                                <td>

                                                    <div class="gp-extras">


                                                @if (ticket.ExtraLuggage)
                                                        {

                                                            <span class="gp-badge
                                                                                     gp-badge-luggage">

                                                                <i class="bi
                                                                                      bi-suitcase2
                                                                                      me-1">
                                                                </i>

                                                                Bagagem

                                                            </span>

                                                        }


                                                        @if (ticket.MealIncluded)
                                                        {

                                                            <span class="gp-badge
                                                                                     gp-badge-meal">

                                                                <i class="bi
                                                                                      bi-egg-fried
                                                                                      me-1">
                                                                </i>

                                                                Refeição

                                                            </span>

                                                        }


                                                        @if (!ticket.ExtraLuggage &&
                                                                                                        !ticket.MealIncluded)
                                                        {

                                                            <span class="text-muted small">

                                                                —

                                                            </span>

                                                        }

                                                    </div>

                                                </td>


                                                <!-- PREÇO -->

                                                <td class="text-end
                                                                   text-white
                                                                   fw-semibold">

                                                    @ticket.TotalPrice.ToString(
                                                    "C",
                                                                                        culture)

                                        </td>

                                    </tr>

                                                                        }

                                    </tbody>


                                    <tfoot>

                                        <tr class="gp-total-row">

                                            <th colspan="4"
                                                class="text-white">

                                                Total a pagar

                                            </th>


                                            <th class="text-end
                                                           text-lime
                                                           fs-5">

                                                @Model.TotalPrice.ToString(
                                                "C",
                                                                                        culture)

                                        </th>

                                    </tr>

                                </tfoot>


                            </table>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- INFO -->
                    <!-- ================================================= -->

                    <div class="alert
                                    alert-info
                                    d-flex
                                    align-items-center
                                    mt-4">

                        <i class="bi
                                      bi-info-circle-fill
                                      fs-5
                                      me-3">
                        </i>


                        <div>

                            Está prestes a pagar

                            <strong>
                                @Model.Tickets.Count
                            </strong>

                            @(Model.Tickets.Count == 1
                                                        ? "bilhete"
                                                        : "bilhetes").

                        </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- ERRO PAYPAL -->
                        <!-- ================================================= -->

                        <div id="paypal-error"
                             class="alert
                                        alert-danger
                                        d-none
                                        mt-3">
                        </div>


                        <!-- ================================================= -->
                        <!-- PAYPAL -->
                        <!-- ================================================= -->

                        <div class="gp-paypal-wrapper mt-4">

                            <div id="paypal-button-container">
                            </div>

                        </div>

                                        }


                    <!-- ================================================= -->
                    <!-- VOLTAR -->
                    <!-- ================================================= -->

                    <div class="text-center mt-4">

                        <a asp-controller="Shop"
                           asp-action="Cart"
                           class="gp-back-link">

                            <i class="bi
                                      bi-arrow-left
                                      me-1">
                            </i>

                            Voltar ao carrinho

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @if (Model.Tickets != null &&
             Model.Tickets.Any())
    {

        <script src="https://www.paypal.com/sdk/js?client-id=@Configuration["PayPal:ClientId"]&currency=EUR">
        </script>


        <script>

            const errorBox =
                document.getElementById(
                    'paypal-error');


            function showError(message) {

                errorBox.textContent =
                    message;

                errorBox.classList.remove(
                    'd-none');

            }


            paypal.Buttons({

                style: {

                    layout: 'vertical',

                    color: 'blue',

                    shape: 'rect',

                    label: 'paypal'

                },


                // =============================================
                // CRIAR ORDEM DO CARRINHO
                // =============================================

                createOrder: function () {

                    errorBox.classList.add(
                        'd-none');


                    return fetch(
                        '/Shop/CreateCartPayPalOrder',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            }
                        })
                        .then(response =>
                            response.json()
                                .then(data => ({
                                    ok:
                                        response.ok,

                                    data:
                                        data
                                }))
                        )
                        .then(result => {

                            if (!result.ok) {

                                showError(
                                    result.data.message
                                    ||
                                    'Erro ao iniciar o pagamento.');

                                throw new Error(
                                    result.data.message);

                            }

                            return result.data.orderId;

                        });

                },


                // =============================================
                // CAPTURAR PAGAMENTO
                // =============================================

                onApprove: function (data) {

                    return fetch(
                        '/Shop/CaptureCartPayPalOrder',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body: JSON.stringify({

                                orderId:
                                    data.orderID

                            })
                        })
                        .then(response =>
                            response.json()
                                .then(result => ({
                                    ok:
                                        response.ok,

                                    result:
                                        result
                                }))
                        )
                        .then(response => {

                            if (
                                response.ok &&
                                response.result.redirectUrl
                            ) {

                                window.location.href =
                                    response.result.redirectUrl;

                                return;

                            }


                            showError(
                                response.result.message
                                ||
                                'Não foi possível confirmar o pagamento.');

                        });

                },


                // =============================================
                // ERRO
                // =============================================

                onError: function (error) {

                    showError(
                        'Ocorreu um erro ao comunicar com o PayPal. Tente novamente.');

                    console.error(error);

                }


            }).render(
                '#paypal-button-container');

        </script>

    }

}