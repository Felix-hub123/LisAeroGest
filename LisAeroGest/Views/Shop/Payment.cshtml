@model LisAeroGest.Models.GuestPaymentViewModel
@inject IConfiguration Configuration
@using System.Globalization
@{
    ViewData["Title"] = "Finalizar Pagamento";
    var culture = new CultureInfo("pt-PT");

    var remainingSeconds = 0;
    if (Model.ExpiresAt.HasValue)
    {
        remainingSeconds = Math.Max(0, (int)(Model.ExpiresAt.Value - DateTime.UtcNow).TotalSeconds);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/guestPayment.css" asp-append-version="true" />
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="gp-card card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- ═══ HEADER ═══ -->
                <div class="gp-header p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h3 class="fw-bold mb-0 text-white">
                                <i class="bi bi-credit-card me-2"></i>Finalizar Pagamento
                            </h3>
                            <small class="gp-header-sub">
                                <i class="bi bi-shield-lock me-1"></i>
                                Pagamento via PayPal Sandbox — ambiente de testes.
                            </small>
                        </div>
                        @if (Model.ExpiresAt.HasValue)
                        {
                            <div class="text-end">
                                <small class="gp-timer-label d-block">Reserva expira em</small>
                                <span class="gp-timer fw-bold" id="countdownTimer">
                                    @TimeSpan.FromSeconds(remainingSeconds).ToString(@"mm\:ss")
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- ═══ BODY ═══ -->
                <div class="card-body p-4">

                    @if (remainingSeconds < 300 && remainingSeconds > 0)
                    {
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Atenção!</strong>
                                <span class="d-block small">A reserva expira em menos de 5 minutos.</span>
                            </div>
                        </div>
                    }
                    else if (Model.ExpiresAt.HasValue && remainingSeconds <= 0)
                    {
                        <div class="alert alert-danger d-flex align-items-center flex-wrap gap-2" role="alert">
                            <i class="bi bi-x-circle-fill fs-4 me-3"></i>
                            <div class="flex-grow-1">
                                <strong>Reserva expirada.</strong>
                                <span class="d-block small">Faça uma nova reserva.</span>
                            </div>
                            <a asp-action="Index" class="btn btn-danger">
                                <i class="bi bi-search me-1"></i>Voltar à pesquisa
                            </a>
                        </div>
                    }

                    <!-- ═══ RESUMO ═══ -->
                    <h5 class="gp-section-title mb-3">
                        <i class="bi bi-receipt text-lime me-2"></i>Resumo da compra
                    </h5>

                    <p class="gp-passenger mb-3">
                        <i class="bi bi-person-circle text-lime me-2"></i>
                        <strong>@Model.PassengerName</strong>
                    </p>

                    <div class="gp-table-wrapper">
                        <table class="table gp-table mb-0">
                            <thead>
                                <tr>
                                    <th>Voo</th>
                                    <th>Rota</th>
                                    <th>Lugar</th>
                                    <th>Extras</th>
                                    <th class="text-end">Preço</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span class="gp-flight-number">
                                            <i class="bi bi-airplane-fill me-1"></i>@Model.FlightNumber
                                        </span>
                                    </td>
                                    <td>
                                        <span class="gp-route">
                                            <strong>@Model.OriginCode</strong>
                                            <i class="bi bi-arrow-right text-lime mx-1"></i>
                                            <strong>@Model.DestinationCode</strong>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="gp-seat">@Model.SeatCode</span>
                                    </td>
                                    <td>
                                        <div class="gp-extras">
                                            @if (Model.ExtraLuggage)
                                            {
                                                <span class="gp-badge gp-badge-luggage">
                                                    <i class="bi bi-suitcase2 me-1"></i>Bagagem
                                                </span>
                                            }
                                            @if (Model.MealIncluded)
                                            {
                                                <span class="gp-badge gp-badge-meal">
                                                    <i class="bi bi-egg-fried me-1"></i>Refeição
                                                </span>
                                            }
                                            @if (!Model.ExtraLuggage && !Model.MealIncluded)
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end text-white fw-semibold">
                                        @Model.TotalPrice.ToString("C", culture)
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="gp-total-row">
                                    <th colspan="4" class="text-white">Total a pagar</th>
                                    <th class="text-end text-lime fs-5">
                                        @Model.TotalPrice.ToString("C", culture)
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- ═══ PAYPAL ═══ -->
                    <div id="paypal-error" class="alert alert-danger d-none mt-3"></div>

                    @if (!Model.ExpiresAt.HasValue || remainingSeconds > 0)
                    {
                        <div class="gp-paypal-wrapper mt-4">
                            <div id="paypal-button-container"></div>
                        </div>
                    }

                    <!-- ═══ VOLTAR ═══ -->
                    <div class="text-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="gp-back-link">
                            <i class="bi bi-arrow-left me-1"></i>Voltar ao início
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@Configuration["PayPal:ClientId"]&currency=EUR"></script>
    <script>
        const errorBox = document.getElementById('paypal-error');
        const ticketId = @Model.TicketId;

        function showError(message) {
            errorBox.textContent = message;
            errorBox.classList.remove('d-none');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const timerElement = document.getElementById('countdownTimer');
            if (!timerElement) return;

            let totalSeconds = @remainingSeconds;

            function updateTimer() {
                if (totalSeconds <= 0) {
                    timerElement.textContent = '00:00';
                    window.location.reload();
                    return;
                }
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                timerElement.textContent =
                    String(minutes).padStart(2, '0') + ':' +
                    String(seconds).padStart(2, '0');
                if (totalSeconds < 300) timerElement.classList.add('text-warning');
                totalSeconds--;
            }
            updateTimer();
            setInterval(updateTimer, 1000);
        });

        paypal.Buttons({
            style: { layout: 'vertical', color: 'blue', shape: 'rect', label: 'paypal' },
            createOrder: function () {
                errorBox.classList.add('d-none');
                return fetch('/Shop/CreatePayPalOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId: ticketId })
                })
                .then(res => res.json().then(data => ({ ok: res.ok, data })))
                .then(({ ok, data }) => {
                    if (!ok) {
                        showError(data.message || 'Erro ao iniciar o pagamento.');
                        throw new Error(data.message);
                    }
                    return data.orderId;
                });
            },
            onApprove: function (data) {
                return fetch('/Shop/CapturePayPalOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId: ticketId, orderId: data.orderID })
                })
                .then(res => res.json().then(result => ({ ok: res.ok, result })))
                .then(({ ok, result }) => {
                    if (ok && result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    } else {
                        showError(result.message || 'Não foi possível confirmar o pagamento.');
                    }
                });
            },
            onError: function (err) {
                showError('Ocorreu um erro ao comunicar com o PayPal. Tente novamente.');
                console.error(err);
            }
        }).render('#paypal-button-container');
    </script>
}