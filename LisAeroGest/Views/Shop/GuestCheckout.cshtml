@model LisAeroGest.Models.GuestCheckoutViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dados do passageiro";
    var culture = new CultureInfo("pt-PT");
}

<div class="container py-4 mb-5">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Pesquisar voos</a></li>
            <li class="breadcrumb-item">
                <a asp-action="SelectSeat" asp-route-flightId="@Model.FlightId">Lugar</a>
            </li>
            <li class="breadcrumb-item active">Os seus dados</li>
        </ol>
    </nav>

    <h1 class="h3 fw-bold mb-1">Reserve como visitante</h1>
    <p class="text-muted mb-4">
        Preencha os dados do passageiro para continuar para o pagamento.
        Não é obrigatório criar conta.
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="ProcessGuestCheckout" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FlightId" />
                        <input type="hidden" asp-for="SeatId" />
                        <input type="hidden" asp-for="ExtraLuggage" />
                        <input type="hidden" asp-for="MealIncluded" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">Nome</label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">Apelido</label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="DocumentNumber" class="form-label fw-semibold">N.º de documento</label>
                                <input asp-for="DocumentNumber" class="form-control" />
                                <span asp-validation-for="DocumentNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="WantToCreateAccount" class="form-check-input" />
                                    <label asp-for="WantToCreateAccount" class="form-check-label">
                                        Quero criar conta depois do pagamento
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <a asp-action="SelectSeat" asp-route-flightId="@Model.FlightId"
                               class="btn btn-outline-secondary">Voltar</a>
                            <button type="submit" class="btn btn-primary fw-bold">
                                Continuar para pagamento
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-dark text-white rounded-top-4 p-3">
                    <strong>Resumo</strong>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <small class="text-muted d-block">Voo</small>
                        <strong>@Model.FlightNumber</strong>
                        <div>@Model.OriginCode → @Model.DestinationCode</div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Lugar</small>
                        <strong>@Model.SeatCode</strong>
                    </div>
                    @if (Model.ExtraLuggage)
                    {
                        <div class="small mb-1">Bagagem extra incluída</div>
                    }
                    @if (Model.MealIncluded)
                    {
                        <div class="small mb-1">Refeição incluída</div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span>Voo</span>
                        <span>@Model.FlightPrice.ToString("C", culture)</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Lugar</span>
                        <span>@Model.SeatPrice.ToString("C", culture)</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>Total</strong>
                        <strong class="fs-4 text-success">@Model.TotalPrice.ToString("C", culture)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}