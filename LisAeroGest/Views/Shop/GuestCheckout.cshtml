@model LisAeroGest.Models.GuestCheckoutViewModel

@{
    ViewData["Title"] = "Dados do Passageiro";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-person-lines-fill me-2"></i>Dados para a Reserva</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">
                        Está a efetuar a reserva como convidado. Preencha os dados abaixo para associarmos o bilhete à sua identificação.
                    </p>

                    <form asp-action="ProcessGuestCheckout" method="post">
                        @Html.AntiForgeryToken()

                        <!-- IDs do Voo e Lugar preservados em campos escondidos -->
                        <input type="hidden" asp-for="FlightId" />
                        <input type="hidden" asp-for="SeatId" />
                        <input type="hidden" asp-for="ExtraLuggage" />
                        <input type="hidden" asp-for="MealIncluded" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Ex: João" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Ex: Silva" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-bold"></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="exemplo@email.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DocumentNumber" class="form-label fw-bold"></label>
                                <input asp-for="DocumentNumber" class="form-control" placeholder="NIF, Passaporte ou Cartão de Cidadão" />
                                <span asp-validation-for="DocumentNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="SelectSeat" asp-route-flightId="@Model.FlightId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                Continuar para Reserva <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
