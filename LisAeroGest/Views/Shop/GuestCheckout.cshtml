@model LisAeroGest.Models.GuestCheckoutViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dados do passageiro";
    var culture = new CultureInfo("pt-PT");
}

@section Styles {
    <link rel="stylesheet" href="~/css/guestCheckout.css" asp-append-version="true" />
}

<div class="container py-4 mb-5">

    <!-- ═══ BREADCRUMB ═══ -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Pesquisar voos</a></li>
            <li class="breadcrumb-item">
                <a asp-action="SelectSeat" asp-route-flightId="@Model.FlightId">Lugar</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Os seus dados</li>
        </ol>
    </nav>

    <!-- ═══ HEADER ═══ -->
    <h1 class="gc-title mb-1">
        <i class="bi bi-person-vcard text-lime me-2"></i>Reserve como visitante
    </h1>
    <p class="text-muted mb-4">
        Preencha os dados do passageiro para continuar para o pagamento.
        Não é obrigatório criar conta.
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="row g-4">

        <!-- ═══ FORMULÁRIO ═══ -->
        <div class="col-lg-7">
            <div class="gc-card card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="ProcessGuestCheckout" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FlightId" />
                        @foreach (var id in Model.SeatIds)
                        {
                            <input type="hidden" name="SeatIds" value="@id" />
                        }
                        <input type="hidden" asp-for="ExtraLuggage" />
                        <input type="hidden" asp-for="MealIncluded" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">Nome</label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">Apelido</label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="DocumentNumber" class="form-label fw-semibold">N.º de documento</label>
                                <input asp-for="DocumentNumber" class="form-control" />
                                <span asp-validation-for="DocumentNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Telemóvel (WhatsApp)</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="937262437" autocomplete="tel" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                <div class="form-text">Usamos este número para enviar a confirmação no WhatsApp.</div>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="WantToCreateAccount" class="form-check-input" />
                                    <label asp-for="WantToCreateAccount" class="form-check-label">
                                        Quero criar conta depois do pagamento
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4 flex-wrap">
                            <a asp-action="SelectSeat" asp-route-flightId="@Model.FlightId"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Voltar
                            </a>
                            <button type="submit" class="btn btn-lime fw-bold ms-auto">
                                <i class="bi bi-credit-card me-1"></i>Continuar para pagamento
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ═══ RESUMO ═══ -->
        <div class="col-lg-5">
            <div class="gc-card card border-0 shadow-sm rounded-4">
                <div class="gc-summary-header card-header rounded-top-4 p-3">
                    <strong class="text-white">
                        <i class="bi bi-receipt me-2 text-lime"></i>Resumo
                    </strong>
                </div>
                <div class="card-body p-4">

                    <div class="gc-info-box mb-3">
                        <small class="text-muted d-block">Voo</small>
                        <strong class="text-white">@Model.FlightNumber</strong>
                        <div class="text-muted small">
                            @Model.OriginCode → @Model.DestinationCode
                        </div>
                    </div>

                    <div class="gc-info-box mb-3">
                        <small class="text-muted d-block">Lugar</small>
                        <strong class="text-white">@Model.SeatCode</strong>
                    </div>

                    @if (Model.ExtraLuggage)
                    {
                        <div class="gc-extra-item">
                            <i class="bi bi-suitcase2 me-2"></i>Bagagem extra incluída
                        </div>
                    }
                    @if (Model.MealIncluded)
                    {
                        <div class="gc-extra-item">
                            <i class="bi bi-egg-fried me-2"></i>Refeição incluída
                        </div>
                    }

                    <hr class="border-secondary" />

                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Voo</span>
                        <span class="text-white">@Model.FlightPrice.ToString("C", culture)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Lugar</span>
                        <span class="text-white">@Model.SeatPrice.ToString("C", culture)</span>
                    </div>

                    <hr class="border-secondary" />

                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="text-white">Total</strong>
                        <strong class="fs-4 text-lime">@Model.TotalPrice.ToString("C", culture)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}