@model LisAeroGest.Data.Entities.Flight
@using LisAeroGest.Data.Entities

@{
    ViewData["Title"] = $"Eliminar Voo {Model.FlightNumber}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 border-top border-danger border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="card-title text-danger mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminação
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Atenção!</strong> Tem a certeza que pretende eliminar o voo abaixo? Esta ação não pode ser desfeita.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-5 fw-bold text-muted">Número do Voo</dt>
                        <dd class="col-sm-7 font-monospace fw-bold">@Model.FlightNumber</dd>

                        <dt class="col-sm-5 fw-bold text-muted">Origem</dt>
                        <dd class="col-sm-7">@(Model.OriginAirport?.Name ?? "N/A")</dd>

                        <dt class="col-sm-5 fw-bold text-muted">Destino</dt>
                        <dd class="col-sm-7">@(Model.DestinationAirport?.Name ?? "N/A")</dd>

                        <dt class="col-sm-5 fw-bold text-muted">Partida</dt>
                        <dd class="col-sm-7">@Model.DepartureTime.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-5 fw-bold text-muted">Estado</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-secondary">@Model.Status</span>
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-1"></i>Eliminar Voo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>