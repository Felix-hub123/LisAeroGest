@using LisAeroGest.Data.Interfaces
@model LisAeroGest.Models.AirportViewModel
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Editar Aeroporto";
}

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Aeroportos</a></li>
        <li class="breadcrumb-item active">Editar Aeroporto</li>
    </ol>
</nav>

<div class="container-fluid mt-2">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Editar Aeroporto
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageId" />

                        <!-- Nome (Readonly) -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control bg-light" id="AirportName" readonly />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- País -->
                        <div class="mb-3">
                            <label asp-for="Country" class="form-label fw-semibold"></label>
                            <select asp-for="Country" asp-items="Model.Countries" class="form-select" id="CountrySelect">
                            </select>
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>

                        <!-- Cidade -->
                        <div class="mb-3">
                            <label asp-for="City" class="form-label fw-semibold"></label>
                            <select asp-for="City" asp-items="Model.Cities" class="form-select" id="CitySelect">
                            </select>
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <!-- Código IATA (Readonly) -->
                        <div class="mb-3">
                            <label asp-for="IATACode" class="form-label fw-semibold"></label>
                            <input asp-for="IATACode" class="form-control text-uppercase bg-light" id="IATACode" readonly />
                            <span asp-validation-for="IATACode" class="text-danger"></span>
                        </div>

                        <!-- Taxa Aeroportuária (€) -->
                        <div class="mb-3">
                            <label asp-for="DefaultFee" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DefaultFee" class="form-control" type="number" step="0.01" />
                                <span class="input-group-text">€</span>
                            </div>
                            <span asp-validation-for="DefaultFee" class="text-danger"></span>
                        </div>

                        <!-- Imagem -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block">Imagem Atual</label>
                            <img src="@ImageHelper.GetImageUrl(Model.ImageId, "airports")" alt="@Model.Name" class="rounded mb-2 shadow-sm" style="width:120px; height:80px; object-fit:cover;" />

                            <label asp-for="ImageFile" class="form-label fw-semibold mt-2 d-block">Alterar Imagem</label>
                            <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Voltar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-1"></i>Atualizar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $("#CountrySelect").change(function () {
                var selectedCountry = $(this).val();
                var $citySelect = $("#CitySelect");

                $citySelect.empty();
                $citySelect.append('<option value="">-- A carregar cidades... --</option>');

                if (selectedCountry) {
                    $.getJSON('@Url.Action("GetCitiesByCountry", "Airports")', { country: selectedCountry }, function (data) {
                        $citySelect.empty();
                        $citySelect.append('<option value="">-- Selecione uma Cidade --</option>');

                        $.each(data, function (index, item) {
                            $citySelect.append($('<option/>', {
                                value: item.value,
                                text: item.text,
                                'data-airport': item.airport,
                                'data-iata': item.iata
                            }));
                        });
                    });
                }
            });

            $("#CitySelect").change(function () {
                var $selectedOption = $(this).find(':selected');
                var airportName = $selectedOption.data('airport');
                var iataCode = $selectedOption.data('iata');

                if (airportName && iataCode) {
                    $("#AirportName").val(airportName);
                    $("#IATACode").val(iataCode.toUpperCase());
                }
            });
        });
    </script>
}