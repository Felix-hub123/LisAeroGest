@using LisAeroGest.Data.Interfaces
@model LisAeroGest.Models.AirportViewModel
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Editar Aeroporto";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Airports" asp-action="Index">Aeroportos</a></li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>
</nav>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <!-- Cabeçalho & Botão Voltar -->
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3" title="Voltar à lista">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-pencil-fill text-warning me-2"></i>Editar Aeroporto
                </h2>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ImageId" type="hidden" />

                        <!-- Dados Imutáveis do Aeroporto (Bloqueados) -->
                        <div class="p-3 bg-light rounded border mb-4">
                            <h6 class="text-muted fw-bold mb-3">
                                <i class="bi bi-lock-fill me-1"></i>Identificação do Aeroporto (Imutável)
                            </h6>
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label class="form-label fw-semibold">Nome do Aeroporto</label>
                                    <input type="text" class="form-control" value="@Model.Name" disabled />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">Código IATA</label>
                                    <input type="text" class="form-control text-uppercase" value="@Model.IATACode" disabled />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-0">
                                    <label class="form-label fw-semibold">País</label>
                                    <input type="text" class="form-control" value="@Model.Country" disabled />
                                </div>
                                <div class="col-md-6 mb-0">
                                    <label class="form-label fw-semibold">Cidade</label>
                                    <input type="text" class="form-control" value="@Model.City" disabled />
                                </div>
                            </div>
                        </div>

                        <!-- Campo Operacional Editável: Taxa Base -->
                        <div class="mb-4">
                            <label asp-for="DefaultFee" class="form-label fw-semibold">Taxa Base Operacional (€)</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input asp-for="DefaultFee" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="DefaultFee" class="text-danger small"></span>
                        </div>

                        <!-- Alteração da Fotografia -->
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                <i class="bi bi-image me-1"></i>Alterar Foto do Aeroporto
                            </label>
                            <input asp-for="ImageFile" class="form-control" type="file"
                                   accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>

                            <div class="mt-3 text-center text-md-start">
                                <img id="imagePreview"
                                     src="@ImageHelper.GetImageUrl(Model.ImageId, "airports")"
                                     alt="Foto Atual"
                                     class="rounded border shadow-sm"
                                     style="height: 120px; width: 200px; object-fit: cover;" />
                            </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="d-flex gap-2 pt-2 border-top">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-2"></i>Guardar Alterações
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                                <i class="bi bi-x-lg me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => document.getElementById('imagePreview').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}