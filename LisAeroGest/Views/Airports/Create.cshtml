@model LisAeroGest.Models.AirportViewModel

@{
    ViewData["Title"] = "Criar Aeroporto";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Aeroportos</a></li>
        <li class="breadcrumb-item active">Novo Aeroporto</li>
    </ol>
</nav>

<div class="container-fluid mt-2">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-geo-alt-fill me-2"></i>Novo Aeroporto
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Nome (Gerado Automaticamente) -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control bg-light" placeholder="Selecione primeiro uma Cidade..." id="AirportName" readonly />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- País -->
                        <div class="mb-3">
                            <label asp-for="Country" class="form-label fw-semibold"></label>
                            <select asp-for="Country" asp-items="Model.Countries" class="form-select" id="CountrySelect">
                            </select>
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>

                        <!-- Cidade (Bloqueada até escolher País) -->
                        <div class="mb-3">
                            <label asp-for="City" class="form-label fw-semibold"></label>
                            <select asp-for="City" asp-items="Model.Cities" class="form-select" id="CitySelect" disabled>
                                <option value="">-- Selecione primeiro um País --</option>
                            </select>
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <!-- Código IATA (Gerado Automaticamente) -->
                        <div class="mb-3">
                            <label asp-for="IATACode" class="form-label fw-semibold"></label>
                            <input asp-for="IATACode" class="form-control text-uppercase bg-light" placeholder="IATA" id="IATACode" readonly />
                            <span asp-validation-for="IATACode" class="text-danger"></span>
                        </div>

                        <!-- Taxa Aeroportuária (€) -->
                        <div class="mb-3">
                            <label asp-for="DefaultFee" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DefaultFee" class="form-control" type="number" step="0.01" value="0" />
                                <span class="input-group-text">€</span>
                            </div>
                            <span asp-validation-for="DefaultFee" class="text-danger"></span>
                        </div>

                        <!-- Imagem -->
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                            <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Voltar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // 1. Ao alterar o País
            $("#CountrySelect").change(function () {
                var selectedCountry = $(this).val();
                var $citySelect = $("#CitySelect");

                $citySelect.empty();
                $("#AirportName").val('');
                $("#IATACode").val('');

                if (selectedCountry) {
                    $citySelect.prop('disabled', false);
                    $citySelect.append('<option value="">-- A carregar cidades... --</option>');

                    $.getJSON('@Url.Action("GetCitiesByCountry", "Airports")', { country: selectedCountry }, function (data) {
                        $citySelect.empty();
                        $citySelect.append('<option value="">-- Selecione uma Cidade --</option>');

                        $.each(data, function (index, item) {
                            $citySelect.append($('<option/>', {
                                value: item.value,
                                text: item.text,
                                'data-airport': item.airport,
                                'data-iata': item.iata
                            }));
                        });
                    });
                } else {
                    $citySelect.prop('disabled', true);
                    $citySelect.append('<option value="">-- Selecione primeiro um País --</option>');
                }
            });

            // 2. Ao alterar a Cidade
            $("#CitySelect").change(function () {
                var $selectedOption = $(this).find(':selected');
                var airportName = $selectedOption.data('airport');
                var iataCode = $selectedOption.data('iata');

                if (airportName && iataCode) {
                    $("#AirportName").val(airportName);
                    $("#IATACode").val(iataCode.toUpperCase());
                } else {
                    $("#AirportName").val('');
                    $("#IATACode").val('');
                }
            });
        });
    </script>
}