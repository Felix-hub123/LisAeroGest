@using LisAeroGest.Data.Interfaces
@model LisAeroGest.Data.Entities.Airport
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Detalhes do Aeroporto";
}

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Aeroportos</a></li>
        <li class="breadcrumb-item active">Detalhes</li>
    </ol>
</nav>

<div class="container-fluid mt-2">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>Detalhes do Aeroporto
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="@ImageHelper.GetImageUrl(Model.ImageId, "airports")"
                             alt="@Model.Name"
                             class="rounded shadow-sm img-fluid"
                             style="max-height: 220px; width: 100%; object-fit: cover;" />
                        <h3 class="mt-3 fw-bold">@Model.Name</h3>
                        <span class="badge bg-primary fs-5">IATA: @Model.IATACode</span>
                    </div>

                    <dl class="row fs-5">
                        <dt class="col-sm-4 text-muted">Cidade</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.City</dd>

                        <dt class="col-sm-4 text-muted">País</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Country</dd>

                        <dt class="col-sm-4 text-muted">Taxa Padrão</dt>
                        <dd class="col-sm-8 text-success fw-bold">@Model.DefaultFee.ToString("C2")</dd>
                    </dl>

                    <hr />

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Voltar
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>