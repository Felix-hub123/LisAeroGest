@using LisAeroGest.Data.Interfaces
@model LisAeroGest.Data.Entities.Airport
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Eliminar Aeroporto";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Airport" asp-action="Index">Aeroportos</a></li>
        <li class="breadcrumb-item active">Eliminar</li>
    </ol>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-trash-fill me-2"></i>Eliminar Aeroporto
                </h2>
            </div>

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminação
                    </h4>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Esta operação não pode ser revertida.
                    </div>

                    <div class="text-center mb-4">
                        <img src="@ImageHelper.GetImageUrl(Model.ImageId, "airports")"
                             alt="@Model.Name"
                             class="rounded shadow-sm"
                             style="height:100px; object-fit:cover;" />
                    </div>

                    <table class="table table-borderless">
                        <tr>
                            <th class="text-muted" style="width:35%">Nome</th>
                            <td class="fw-semibold">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Código IATA</th>
                            <td>
                                <span class="badge bg-primary">@Model.IATACode</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Cidade</th>
                            <td>@Model.City</td>
                        </tr>
                        <tr>
                            <th class="text-muted">País</th>
                            <td>@Model.Country</td>
                        </tr>
                    </table>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2"></i>Confirmar Eliminação
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>