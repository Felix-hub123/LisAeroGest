@using LisAeroGest.Data.Interfaces
@model LisAeroGest.Data.Entities.Airport
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Detalhes do Aeroporto";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Airport" asp-action="Index">Aeroportos</a></li>
        <li class="breadcrumb-item active">Detalhes</li>
    </ol>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-info-circle-fill text-info me-2"></i>Detalhes do Aeroporto
                </h2>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="@ImageHelper.GetImageUrl(Model.ImageId, "airports")"
                             alt="@Model.Name"
                             class="rounded shadow-sm"
                             style="height:120px; object-fit:cover;" />
                    </div>

                    <table class="table table-borderless">
                        <tr>
                            <th class="text-muted" style="width:35%">Nome</th>
                            <td class="fw-semibold">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Código IATA</th>
                            <td>
                                <span class="badge bg-primary fs-6">@Model.IATACode</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Cidade</th>
                            <td>@Model.City</td>
                        </tr>
                        <tr>
                            <th class="text-muted">País</th>
                            <td>@Model.Country</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Taxa Aeroportuária</th>
                            <td>@Model.DefaultFee.ToString("F2") €</td>
                        </tr>
                    </table>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil me-2"></i>Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-2"></i>Eliminar
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                            <i class="bi bi-arrow-left me-2"></i>Voltar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
