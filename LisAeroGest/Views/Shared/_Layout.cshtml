<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LisAeroGest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adminDashboard.css" />
    <link rel="stylesheet" href="~/css/flightboard.css" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-airplane-fill me-1"></i>LisAeroGest
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house me-1"></i>Início
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Shop" asp-action="Index">
                                    <i class="bi bi-search me-1"></i>Pesquisar voos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Flights" asp-action="PublicIndex">
                                    <i class="bi bi-airplane me-1"></i>Voos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Airline" asp-action="PublicIndex">
                                    <i class="bi bi-building me-1"></i>Companhias
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                        <i class="bi bi-gear me-1"></i>Gestão
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Airport" asp-action="Index">Aeroportos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Airline" asp-action="Index">Companhias</a></li>
                                        <li><a class="dropdown-item" asp-controller="Gate" asp-action="Index">Gates</a></li>
                                        <li><a class="dropdown-item" asp-controller="Aircraft" asp-action="Index">Aeronaves</a></li>
                                        <li><a class="dropdown-item" asp-controller="Flight" asp-action="Index">Voos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Forum" asp-action="Index">Fórum</a></li>
                                        <li><a class="dropdown-item" asp-controller="CheckIn" asp-action="EmployeeCheckIn">Check-in presencial</a></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Notification" asp-action="Index">
                                                Notificações
                                                <span id="notifBadgeAdmin" class="badge bg-danger d-none">0</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Employee"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                        <i class="bi bi-clipboard me-1"></i>Operacional
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Flight" asp-action="Index">Voos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Gate" asp-action="Index">Gates</a></li>
                                        <li><a class="dropdown-item" asp-controller="Forum" asp-action="Index">Fórum</a></li>
                                        <li><a class="dropdown-item" asp-controller="CheckIn" asp-action="EmployeeCheckIn">Check-in presencial</a></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Notification" asp-action="Index">
                                                Notificações
                                                <span id="notifBadgeEmployee" class="badge bg-danger d-none">0</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Passenger"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                        <i class="bi bi-ticket me-1"></i>Passageiro
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Shop" asp-action="Index">Comprar bilhetes</a></li>
                                        <li><a class="dropdown-item" asp-controller="Shop" asp-action="MyTickets">Os meus bilhetes</a></li>
                                        <li><a class="dropdown-item" asp-controller="CheckIn" asp-action="Index">Check-in online</a></li>
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-3 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between gap-2 small">
            <span>&copy; @DateTime.Now.Year LisAeroGest</span>
            <span>
                <a asp-controller="Home" asp-action="NewRoute" class="text-white-50 text-decoration-none me-3">Nova rota</a>
                <a asp-controller="Home" asp-action="Loyalty" class="text-white-50 text-decoration-none me-3">LisAeroPoints</a>
                <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none me-3">Privacidade</a>
                <a asp-controller="Home" asp-action="Help" class="text-white-50 text-decoration-none">Ajuda</a>
            </span>
        </div>
    </footer>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="globalToast" class="toast" role="alert">
            <div class="toast-header">
                <strong class="me-auto">LisAeroGest</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@(TempData["Success"] ?? TempData["Error"] ?? TempData["Info"])</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const body = document.querySelector("#globalToast .toast-body");
            if (body && body.textContent.trim().length > 0) {
                bootstrap.Toast.getOrCreateInstance(document.getElementById("globalToast")).show();
            }
            if (typeof AOS !== "undefined") AOS.init();
        });

        async function loadNotifCount(id) {
            try {
                const r = await fetch("/Notification/GetUnreadCount");
                const d = await r.json();
                const b = document.getElementById(id);
                if (b && d.count > 0) {
                    b.textContent = d.count;
                    b.classList.remove("d-none");
                }
            } catch (e) { }
        }
        loadNotifCount("notifBadgeAdmin");
        loadNotifCount("notifBadgeEmployee");
        setInterval(function () {
            loadNotifCount("notifBadgeAdmin");
            loadNotifCount("notifBadgeEmployee");
        }, 30000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>