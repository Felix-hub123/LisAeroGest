<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LisAeroGest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adminDashboard.css" />
    <link rel="stylesheet" href="~/css/flightboard.css" />
    <link rel="stylesheet" href="~/css/flightCalendar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkoutConfirmation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/guestCheckout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/passengerDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 dark-theme">
    <header>
        <nav class="navbar navbar-expand-lg lis-navbar sticky-top">
            <div class="container-fluid">

                <!-- ═══ LOGO ═══ -->
                @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                {
                    <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-airplane-fill"></i>LisAeroGest
                    </a>
                }
                else
                {
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-airplane-fill"></i>LisAeroGest
                    </a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">

                    <!-- ═══ LINKS DE NAVEGAÇÃO ═══ -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- 🔓 VISITANTE (não autenticado) — só Início e Pesquisar -->
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house me-1"></i>Início
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Shop" asp-action="Index">
                                    <i class="bi bi-search me-1"></i>Pesquisar voos
                                </a>
                            </li>
                        }

                        <!-- 🔐 ADMIN -->
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear me-1"></i>Gestão
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Airport" asp-action="Index">Aeroportos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Airline" asp-action="Index">Companhias</a></li>
                                    <li><a class="dropdown-item" asp-controller="Aircraft" asp-action="Index">Aeronaves</a></li>
                                    <li><a class="dropdown-item" asp-controller="Flight" asp-action="Index">Voos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Gate" asp-action="Board">Painel de Gates</a></li>
                                    <li><a class="dropdown-item" asp-controller="Gate" asp-action="Index">Gates</a></li>
                                    <li><a class="dropdown-item" asp-controller="Forum" asp-action="Index">Fórum</a></li>
                                    <li><a class="dropdown-item" asp-controller="CheckIn" asp-action="EmployeeCheckIn">Check-in presencial</a></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Notification" asp-action="Index">
                                            Notificações
                                            <span id="notifBadgeAdmin" class="badge bg-danger ms-2 d-none">0</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- 🔐 FUNCIONÁRIO -->
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Employee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-clipboard me-1"></i>Operacional
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Flight" asp-action="Index">Voos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Gate" asp-action="Board">Painel de Gates</a></li>
                                    <li><a class="dropdown-item" asp-controller="Forum" asp-action="Index">Fórum</a></li>
                                    <li><a class="dropdown-item" asp-controller="CheckIn" asp-action="EmployeeCheckIn">Check-in presencial</a></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Notification" asp-action="Index">
                                            Notificações
                                            <span id="notifBadgeEmployee" class="badge bg-danger ms-2 d-none">0</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- 🔐 PASSAGEIRO -->
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Passenger"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Shop" asp-action="Index">
                                    <i class="bi bi-search me-1"></i>Pesquisar voos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Shop" asp-action="MyTickets">
                                    <i class="bi bi-ticket-perforated me-1"></i>Os meus bilhetes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CheckIn" asp-action="Index">
                                    <i class="bi bi-clipboard-check me-1"></i>Check-in
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- ═══ LOGIN / REGISTO / PERFIL / LOGOUT (partial) ═══ -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER MODERNO -->
    <footer class="lis-footer">
        <div class="container">
            <div class="row g-4">
                <!-- Coluna 1: Marca -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-airplane-fill me-2"></i>LisAeroGest
                    </h5>
                    <p class="small mb-0">
                        Plataforma de Gestão Aeroportuária do Aeroporto de Lisboa.
                        Pesquise voos, reserve bilhetes e acompanhe as operações.
                    </p>
                    <div class="footer-social mt-3">
                        <a href="#" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="col-lg-2 col-md-6">
                    <h6>Informações</h6>
                    <a asp-controller="Home" asp-action="Help">Como chegar</a>
                    <a asp-controller="Home" asp-action="Help">Estacionamento</a>
                    <a asp-controller="Home" asp-action="Help">Segurança</a>
                    <a asp-controller="Home" asp-action="Help">Acessibilidade</a>
                    <a asp-controller="Home" asp-action="Help">Perguntas frequentes</a>
                </div>

                <!-- Coluna 3: Serviços -->
                <div class="col-lg-3 col-md-6">
                    <h6>Serviços</h6>
                    <a asp-controller="Shop" asp-action="Index">Pesquisar voos</a>
                    <a asp-controller="Flights" asp-action="PublicIndex">Estado dos voos</a>
                    <a asp-controller="CheckIn" asp-action="Index">Check-in online</a>
                    <a asp-controller="Airline" asp-action="PublicIndex">Companhias aéreas</a>
                    <a asp-controller="Home" asp-action="Help">Ajuda</a>
                </div>

                <!-- Coluna 4: Contactos -->
                <div class="col-lg-3 col-md-6">
                    <h6>Contactos</h6>
                    <a asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-telephone me-1"></i>+351 21 841 73 00
                    </a>
                    <a asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-envelope me-1"></i>info@lisaerogest.pt
                    </a>
                    <a asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-geo-alt me-1"></i>Aeroporto de Lisboa
                    </a>
                    <a asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-geo me-1"></i>1700-008 Lisboa
                    </a>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        &copy; @DateTime.Now.Year LisAeroGest · Todos os direitos reservados
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <a asp-controller="Home" asp-action="Privacy" class="d-inline">Privacidade</a>
                        <span class="mx-2">·</span>
                        <a asp-controller="Home" asp-action="Terms" class="d-inline">Termos de utilização</a>
                        <span class="mx-2">·</span>
                        <a asp-controller="Home" asp-action="Contact" class="d-inline">Cookies</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="globalToast" class="toast" role="alert">
            <div class="toast-header">
                <strong class="me-auto">LisAeroGest</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@(TempData["Success"] ?? TempData["Error"] ?? TempData["Info"])</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const body = document.querySelector("#globalToast .toast-body");
            if (body && body.textContent.trim().length > 0) {
                bootstrap.Toast.getOrCreateInstance(document.getElementById("globalToast")).show();
            }
            if (typeof AOS !== "undefined") AOS.init();
        });

        async function loadNotifCount(id) {
            try {
                const r = await fetch("/Notification/GetUnreadCount");
                const d = await r.json();
                const b = document.getElementById(id);
                if (b && d.count > 0) {
                    b.textContent = d.count;
                    b.classList.remove("d-none");
                }
            } catch (e) { }
        }
        loadNotifCount("notifBadgeAdmin");
        loadNotifCount("notifBadgeEmployee");
        setInterval(function () {
            loadNotifCount("notifBadgeAdmin");
            loadNotifCount("notifBadgeEmployee");
        }, 30000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>