@model IEnumerable<LisAeroGest.Data.Entities.Flight>
@{
    var type = ViewData["Type"]?.ToString() ?? "Departures";
    var isDepartures = type == "Departures";
    var converter = ViewData["Converter"] as LisAeroGest.Helpers.IConverterHelper;
}

<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr>
            <th style="width: 50px;">⭐</th>
            <th>Voo</th>
            <th>Companhia</th>
            <th>Destino</th>
            <th>@(isDepartures ? "Partida" : "Chegada")</th>
            <th>Gate</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var flight in Model)
            {
                var statusText = converter?.GetFlightStatusText(flight.Status) ?? flight.Status;
                var badgeClass = converter?.GetFlightBadgeClass(flight.Status) ?? "bg-secondary";
                var rowClass = converter?.GetFlightRowClass(flight.Status) ?? "";

                <tr class="@rowClass">
                    <td>
                        <button class="btn btn-sm btn-outline-secondary favorite-btn"
                                data-flight-id="@flight.Id"
                                onclick="FlightCards.toggleFavorite('@flight.Id')">
                            <i class="bi bi-star"></i>
                        </button>
                    </td>
                    <td><strong>@flight.FlightNumber</strong></td>
                    <td>@(flight.Airline?.Name ?? "—")</td>
                    <td>
                        @(flight.DestinationAirport?.City ?? "—")
                        <small class="text-muted">(@(flight.DestinationAirport?.IATACode ?? "—"))</small>
                    </td>
                    <td>@(isDepartures? flight.DepartureTime.ToString("HH:mm") : flight.ArrivalTime.ToString("HH:mm"))</td>
                    <td>@(flight.Gate?.GateNumber ?? "—")</td>
                    <td>
                        <span class="badge @badgeClass">
                            @statusText
                        </span>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center py-4 text-muted">
                    <i class="bi bi-airplane fs-3 d-block mb-2"></i>
                    Sem voos registados para hoje.
                </td>
            </tr>
        }
    </tbody>
</table>