@model LisAeroGest.Models.FlightCommunicationHistoryViewModel

@{
    ViewData["Title"] = "Histórico de Comunicações";
}


<div class="container-fluid py-4">

    <!-- ======================================================= -->
    <!-- CABEÇALHO -->
    <!-- ======================================================= -->

    <div class="d-flex flex-column flex-lg-row
                justify-content-between align-items-lg-center
                gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-chat-square-text me-2"></i>
                Histórico de Comunicações
            </h2>

            <p class="text-muted mb-0">
                Consulte as comunicações operacionais enviadas
                aos passageiros.
            </p>
        </div>

        <a asp-controller="Dashboard"
           asp-action="AdminDashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar ao Dashboard
        </a>

    </div>


    <!-- ======================================================= -->
    <!-- ESTATÍSTICAS -->
    <!-- ======================================================= -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center gap-3">

                        <div class="fs-2 text-primary">
                            <i class="bi bi-megaphone"></i>
                        </div>

                        <div>
                            <div class="text-muted small">
                                Comunicações
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.TotalCommunications
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center gap-3">

                        <div class="fs-2 text-success">
                            <i class="bi bi-people"></i>
                        </div>

                        <div>
                            <div class="text-muted small">
                                Destinatários
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.TotalRecipients
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center gap-3">

                        <div class="fs-2 text-warning">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <div>
                            <div class="text-muted small">
                                Enviadas hoje
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.CommunicationsToday
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ======================================================= -->
    <!-- FILTROS -->
    <!-- ======================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form method="get"
                  asp-controller="FlightCommunications"
                  asp-action="Index">

                <div class="row g-3 align-items-end">

                    <!-- PESQUISA -->

                    <div class="col-12 col-lg-3">

                        <label class="form-label fw-semibold">
                            Pesquisar
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Mensagem, voo ou funcionário..." />

                    </div>


                    <!-- TIPO -->

                    <div class="col-12 col-md-6 col-lg-2">

                        <label class="form-label fw-semibold">
                            Tipo
                        </label>

                        <select name="type"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @if (Model.Type == "Info")
                            {
                                <option value="Info" selected>
                                    Informação
                                </option>
                            }
                            else
                            {
                                <option value="Info">
                                    Informação
                                </option>
                            }

                            @if (Model.Type == "Gate")
                            {
                                <option value="Gate" selected>
                                    Porta
                                </option>
                            }
                            else
                            {
                                <option value="Gate">
                                    Porta
                                </option>
                            }

                            @if (Model.Type == "Boarding")
                            {
                                <option value="Boarding" selected>
                                    Embarque
                                </option>
                            }
                            else
                            {
                                <option value="Boarding">
                                    Embarque
                                </option>
                            }

                            @if (Model.Type == "Delay")
                            {
                                <option value="Delay" selected>
                                    Atraso
                                </option>
                            }
                            else
                            {
                                <option value="Delay">
                                    Atraso
                                </option>
                            }

                        </select>

                    </div>


                    <!-- VOO -->

                    <div class="col-12 col-md-6 col-lg-2">

                        <label class="form-label fw-semibold">
                            Número do voo
                        </label>

                        <input type="text"
                               name="flightNumber"
                               value="@Model.FlightNumber"
                               class="form-control"
                               placeholder="Ex.: TP4653" />

                    </div>


                    <!-- ORDENAÇÃO -->

                    <div class="col-12 col-md-6 col-lg-3">

                        <label class="form-label fw-semibold">
                            Ordenar por
                        </label>

                        <select asp-for="SortOrder"
                                class="form-select">

                            <option value="date_desc">
                                Data — mais recente
                            </option>

                            <option value="date_asc">
                                Data — mais antiga
                            </option>

                            <option value="flight_asc">
                                Voo — A-Z
                            </option>

                            <option value="flight_desc">
                                Voo — Z-A
                            </option>

                            <option value="employee_asc">
                                Funcionário — A-Z
                            </option>

                            <option value="recipients_desc">
                                Destinatários — maior primeiro
                            </option>

                            <option value="recipients_asc">
                                Destinatários — menor primeiro
                            </option>

                        </select>

                    </div>


                    <!-- BOTÃO -->

                    <div class="col-12 col-md-6 col-lg-2">

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>
                                Aplicar

                            </button>

                        </div>

                    </div>

                </div>

            </form>


            <!-- LIMPAR FILTROS -->
            @if (!string.IsNullOrWhiteSpace(Model.Search)
                        || !string.IsNullOrWhiteSpace(Model.Type)
                        || !string.IsNullOrWhiteSpace(Model.FlightNumber)
                        || Model.SortOrder != "date_desc")
            {
                <div class="mt-3">

                    <a asp-controller="FlightCommunications"
                       asp-action="Index"
                       class="text-decoration-none">

                        <i class="bi bi-x-circle me-1"></i>
                        Limpar filtros e ordenação

                    </a>

                </div>
            }

        </div>

    </div>


    <!-- ======================================================= -->
    <!-- HISTÓRICO -->
    <!-- ======================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-column flex-md-row
                        justify-content-between
                        align-items-md-center gap-2">

                <div>
                    <h5 class="fw-bold mb-1">
                        Registos
                    </h5>

                    @if (Model.TotalCommunications > 0)
                    {
                        <small class="text-muted">
                            A mostrar
                            <strong>@Model.FirstItem</strong>
                            –
                            <strong>@Model.LastItem</strong>
                            de
                            <strong>@Model.TotalCommunications</strong>
                            comunicações
                        </small>
                    }
                </div>


                @if (Model.TotalCommunications > 0)
                {
                    <span class="badge bg-light text-dark border">
                        Página @Model.Page de @Model.TotalPages
                    </span>
                }

            </div>

        </div>


        <!-- SEM RESULTADOS -->
        @if (Model.Communications.Count == 0)
        {
            <div class="card-body text-center py-5">

                <div class="display-6 text-muted mb-3">
                    <i class="bi bi-chat-square"></i>
                </div>

                <h5>
                    Nenhuma comunicação encontrada
                </h5>

                <p class="text-muted mb-0">
                    Não existem comunicações correspondentes
                    aos filtros selecionados.
                </p>

            </div>
        }
        else
        {
            <!-- ================================================= -->
            <!-- TABELA -->
            <!-- ================================================= -->

            <div class="table-responsive">

                <table class="table table-hover
                                  align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Voo</th>
                            <th>Tipo</th>
                            <th>Mensagem</th>
                            <th>Funcionário</th>

                            <th class="text-center">
                                Destinatários
                            </th>

                            <th>Data / Hora</th>

                            <th class="text-end">
                                Ações
                            </th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.Communications)
                        {
                            <tr>

                                <!-- VOO -->

                                <td>
                                    <span class="fw-bold">
                                        @item.FlightNumber
                                    </span>
                                </td>


                                <!-- TIPO -->

                                <td>

                                    @switch (item.Type)
                                    {
                                        case "Gate":

                                            <span class="badge bg-primary">
                                                Porta
                                            </span>

                                            break;


                                        case "Boarding":

                                            <span class="badge bg-success">
                                                Embarque
                                            </span>

                                            break;


                                        case "Delay":

                                            <span class="badge bg-warning text-dark">
                                                Atraso
                                            </span>

                                            break;


                                        default:

                                            <span class="badge bg-secondary">
                                                Informação
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- MENSAGEM -->

                                <td style="min-width: 250px;
                                                   max-width: 420px;">

                                    <div class="text-truncate"
                                         style="max-width: 420px;"
                                         title="@item.Message">

                                        @item.Message

                                    </div>

                                </td>


                                <!-- FUNCIONÁRIO -->

                                <td>
                                    @item.EmployeeName
                                </td>


                                <!-- DESTINATÁRIOS -->

                                <td class="text-center">

                                    <span class="badge
                                                         bg-light
                                                         text-dark
                                                         border">

                                        <i class="bi bi-people me-1"></i>

                                        @item.RecipientsCount

                                    </span>

                                </td>


                                <!-- DATA -->

                                <td class="text-nowrap">

                                    <div>
                                        @item.CreatedAt.ToString("dd/MM/yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @item.CreatedAt.ToString("HH:mm")
                                    </small>

                                </td>


                                <!-- AÇÕES -->

                                <td class="text-end">

                                    <a asp-controller="FlightCommunications"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm
                                                      btn-outline-primary">

                                        <i class="bi bi-eye me-1"></i>
                                        Detalhes

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ================================================= -->
            <!-- PAGINAÇÃO -->
            <!-- ================================================= -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">

                    <div class="d-flex flex-column flex-md-row
                                        justify-content-between
                                        align-items-md-center gap-3">

                        <small class="text-muted">

                            Página
                            <strong>@Model.Page</strong>
                            de
                            <strong>@Model.TotalPages</strong>

                        </small>


                        <nav aria-label="Paginação das comunicações">

                            <ul class="pagination pagination-sm mb-0">


                                <!-- ANTERIOR -->

                                <li class="page-item
                                                   @(!Model.HasPreviousPage
                                                                                   ? "disabled"
                                                                                   : "")">

                            <a class="page-link"
                               asp-controller="FlightCommunications"
                               asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-type="@Model.Type"
                               asp-route-flightNumber="@Model.FlightNumber"
                               asp-route-sortOrder="@Model.SortOrder">

                                        <i class="bi bi-chevron-left"></i>
                                        Anterior

                                    </a>

                                </li>


                                <!-- PRIMEIRA PÁGINA -->
                        @if (Model.Page > 3)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-controller="FlightCommunications"
                                           asp-action="Index"
                                           asp-route-page="1"
                                           asp-route-search="@Model.Search"
                                           asp-route-type="@Model.Type"
                                           asp-route-flightNumber="@Model.FlightNumber"
                                           asp-route-sortOrder="@Model.SortOrder">

                                            1

                                        </a>

                                    </li>


                                    @if (Model.Page > 4)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">
                                                ...
                                            </span>
                                        </li>
                                    }
                                }


                                <!-- PÁGINAS PRÓXIMAS -->
                                @for (
                                                        var i = Math.Max(1, Model.Page - 2);
                                                        i <= Math.Min(
                                                        Model.TotalPages,
                                                        Model.Page + 2);
                                                        i++)
                                {
                                    <li class="page-item
                                                           @(i == Model.Page
                                                                                           ? "active"
                                                                                           : "")">

                            <a class="page-link"
                               asp-controller="FlightCommunications"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@Model.Search"
                               asp-route-type="@Model.Type"
                               asp-route-flightNumber="@Model.FlightNumber"
                               asp-route-sortOrder="@Model.SortOrder">

                                            @i

                                        </a>

                                    </li>
                                                }


                                <!-- ÚLTIMA PÁGINA -->
                                @if (Model.Page < Model.TotalPages - 2)
                                {
                                    @if (Model.Page < Model.TotalPages - 3)
                                    {
                                        <li class="page-item disabled">

                                            <span class="page-link">
                                                ...
                                            </span>

                                        </li>
                                    }

                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-controller="FlightCommunications"
                                           asp-action="Index"
                                           asp-route-page="@Model.TotalPages"
                                           asp-route-search="@Model.Search"
                                           asp-route-type="@Model.Type"
                                           asp-route-flightNumber="@Model.FlightNumber"
                                           asp-route-sortOrder="@Model.SortOrder">

                                            @Model.TotalPages

                                        </a>

                                    </li>
                                }


                            <!-- SEGUINTE -->

                            <li class="page-item
                                    @(!Model.HasNextPage
                                      ? "disabled"
                                         : "")">

                            <a class="page-link"
                               asp-controller="FlightCommunications"
                               asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-type="@Model.Type"
                               asp-route-flightNumber="@Model.FlightNumber"
                               asp-route-sortOrder="@Model.SortOrder">

                                        Seguinte
                                        <i class="bi bi-chevron-right"></i>

                                    </a>

                                </li>

                            </ul>

                        </nav>

                    </div>

                </div>
            }
        }

    </div>

</div>