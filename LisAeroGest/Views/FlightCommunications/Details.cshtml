@model LisAeroGest.Models.FlightCommunicationDetailsViewModel

@{
    ViewData["Title"] = "Detalhes da Comunicação";
}

<div class="container-fluid py-4">

    <!-- Cabeçalho -->
    <div class="d-flex flex-column flex-lg-row
                justify-content-between align-items-lg-center
                gap-3 mb-4">

        <div>
            <div class="text-muted small mb-1">
                AUDITORIA DE COMUNICAÇÕES
            </div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-megaphone me-2 text-primary"></i>
                Detalhes da Comunicação
            </h2>

            <p class="text-muted mb-0">
                Informação completa da comunicação enviada
                aos passageiros.
            </p>
        </div>

        <a asp-controller="FlightCommunications"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar ao Histórico
        </a>

    </div>


    <div class="row g-4">

        <!-- =====================================================
             CONTEÚDO PRINCIPAL
        ====================================================== -->
        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header border-0 py-3">

                    <div class="d-flex justify-content-between
                                align-items-center flex-wrap gap-2">

                        <div>
                            <span class="text-muted small">
                                COMUNICAÇÃO #@Model.Id
                            </span>

                            <h4 class="fw-bold mb-0 mt-1">
                                Voo @Model.FlightNumber
                            </h4>
                        </div>


                        <div>

                            @switch (Model.Type)
                            {
                                case "Gate":

                                    <span class="badge bg-primary fs-6">
                                        <i class="bi bi-door-open me-1"></i>
                                        Porta
                                    </span>

                                    break;


                                case "Boarding":

                                    <span class="badge bg-success fs-6">
                                        <i class="bi bi-person-walking me-1"></i>
                                        Embarque
                                    </span>

                                    break;


                                case "Delay":

                                    <span class="badge bg-warning text-dark fs-6">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Atraso
                                    </span>

                                    break;


                                default:

                                    <span class="badge bg-secondary fs-6">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Informação
                                    </span>

                                    break;
                            }

                        </div>

                    </div>

                </div>


                <div class="card-body">

                    <div class="mb-4">

                        <div class="text-muted small
                                    text-uppercase mb-2">

                            Mensagem enviada
                        </div>

                        <div class="p-4 rounded border">

                            <i class="bi bi-quote
                                      fs-3 text-primary"></i>

                            <p class="fs-5 mb-0"
                               style="white-space: pre-wrap;">
                                @Model.Message
                            </p>

                        </div>

                    </div>


                    <hr />


                    <div class="row g-4 mt-1">

                        <!-- Funcionário -->
                        <div class="col-12 col-md-6">

                            <div class="d-flex gap-3">

                                <div class="fs-3 text-primary">
                                    <i class="bi bi-person-badge"></i>
                                </div>

                                <div>

                                    <small class="text-muted">
                                        Enviado por
                                    </small>

                                    <div class="fw-bold">
                                        @Model.EmployeeName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        Model.EmployeeEmail))
                                    {
                                        <div class="text-muted small">
                                            @Model.EmployeeEmail
                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- Data -->
                        <div class="col-12 col-md-6">

                            <div class="d-flex gap-3">

                                <div class="fs-3 text-warning">
                                    <i class="bi bi-calendar-event"></i>
                                </div>

                                <div>

                                    <small class="text-muted">
                                        Data e hora
                                    </small>

                                    <div class="fw-bold">
                                        @Model.CreatedAt.ToString(
                                            "dd/MM/yyyy")
                                    </div>

                                    <div class="text-muted small">
                                        @Model.CreatedAt.ToString(
                                            "HH:mm:ss")
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             RESUMO
        ====================================================== -->
        <div class="col-12 col-lg-4">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header border-0 py-3">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Resumo
                    </h5>

                </div>


                <div class="card-body">

                    <!-- Voo -->
                    <div class="d-flex justify-content-between
                                align-items-center py-3 border-bottom">

                        <span class="text-muted">
                            Voo
                        </span>

                        <span class="fw-bold">
                            @Model.FlightNumber
                        </span>

                    </div>


                    <!-- Destinatários -->
                    <div class="d-flex justify-content-between
                                align-items-center py-3 border-bottom">

                        <span class="text-muted">
                            Destinatários
                        </span>

                        <span class="badge bg-primary">

                            <i class="bi bi-people me-1"></i>
                            @Model.RecipientsCount

                        </span>

                    </div>


                    <!-- Tipo -->
                    <div class="d-flex justify-content-between
                                align-items-center py-3 border-bottom">

                        <span class="text-muted">
                            Tipo
                        </span>

                        <span class="fw-semibold">
                            @Model.Type
                        </span>

                    </div>


                    <!-- ID -->
                    <div class="d-flex justify-content-between
                                align-items-center py-3">

                        <span class="text-muted">
                            Registo
                        </span>

                        <span class="font-monospace">
                            #@Model.Id
                        </span>

                    </div>

                </div>

            </div>


            <!-- Auditoria -->
            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex gap-3">

                        <div class="text-success fs-4">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <div class="fw-bold mb-1">
                                Registo de auditoria
                            </div>

                            <small class="text-muted">
                                Esta comunicação foi registada
                                automaticamente quando o funcionário
                                efetuou o envio aos passageiros.
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>