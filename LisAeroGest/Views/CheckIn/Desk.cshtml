@{
    ViewData["Title"] = "Balcão de Check-In Presencial";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white p-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-person-workspace"></i> Balcão de Check-In Presencial</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <p class="text-muted mb-4">Insira os dados do passageiro para localizar a reserva no sistema.</p>

                    <form asp-action="DeskSearch" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <label class="form-label fw-bold">Critério de Pesquisa</label>
                            <input type="text" name="searchCriteria" class="form-control form-control-lg"
                                   placeholder="Nº do Bilhete, E-mail do Utilizador ou Documento..." required />
                        </div>
                        <div class="col-12 d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search"></i> Pesquisar Reserva
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>