@model LisAeroGest.Data.Entities.BoardingPass

@{
    ViewData["Title"] = "Cartão de Embarque";
}

<div class="container my-5">
    <!-- Botões de Ação no Topo -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a asp-controller="Shop" asp-action="MyTickets" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Os Meus Bilhetes
        </a>
        <button onclick="window.print()" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-printer me-2"></i> Imprimir / Salvar PDF
        </button>
    </div>

    <!-- Cartão de Embarque (Passe Digital) -->
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden print-card mx-auto" style="max-width: 850px;">
        <!-- Cabeçalho do Cartão -->
        <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-airplane-engines-fill text-warning fs-3"></i>
                <span class="fs-4 fw-bold text-uppercase tracking-wider">LisAeroGest</span>
            </div>
            <div class="text-end">
                <span class="badge bg-warning text-dark font-monospace fs-6 px-3 py-2">
                    BOARDING PASS
                </span>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-4 align-items-center">
                <!-- Informações Principais do Voo e Passageiro -->
                <div class="col-md-8 border-end-md">
                    <!-- Nome do Passageiro -->
                    <div class="mb-4">
                        <small class="text-muted text-uppercase fw-semibold d-block fs-7">Passageiro / Passenger</small>
                        <h3 class="fw-bold text-dark mb-0">@Model.Ticket?.Passenger?.User?.FullName</h3>
                    </div>

                    <!-- Origem e Destino (Rota) -->
                    <div class="row bg-light p-3 rounded-3 mb-4 text-center align-items-center g-2">
                        <div class="col-5">
                            <span class="display-6 fw-bold text-primary">@Model.Ticket?.Flight?.OriginAirport?.IATACode</span>
                            <small class="text-muted d-block text-truncate">@Model.Ticket?.Flight?.OriginAirport?.City</small>
                        </div>
                        <div class="col-2">
                            <i class="bi bi-arrow-right fs-3 text-secondary"></i>
                        </div>
                        <div class="col-5">
                            <span class="display-6 fw-bold text-primary">@Model.Ticket?.Flight?.DestinationAirport?.IATACode</span>
                            <small class="text-muted d-block text-truncate">@Model.Ticket?.Flight?.DestinationAirport?.City</small>
                        </div>
                    </div>

                    <!-- Detalhes do Embarque -->
                    <div class="row g-3">
                        <div class="col-4">
                            <small class="text-muted text-uppercase fw-semibold d-block fs-7">Voo / Flight</small>
                            <strong class="fs-5 text-dark">@Model.Ticket?.Flight?.FlightNumber</strong>
                        </div>
                        <div class="col-4">
                            <small class="text-muted text-uppercase fw-semibold d-block fs-7">Data / Date</small>
                            <strong class="fs-5 text-dark">@Model.Ticket?.Flight?.DepartureTime.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="col-4">
                            <small class="text-muted text-uppercase fw-semibold d-block fs-7">Hora / Time</small>
                            <strong class="fs-5 text-dark">@Model.Ticket?.Flight?.DepartureTime.ToString("HH:mm")</strong>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-3">
                        <div class="col-4">
                            <small class="text-muted text-uppercase fw-semibold d-block fs-7">Lugar / Seat</small>
                            <span class="badge bg-primary fs-5 px-3 py-1">@Model.Ticket?.Seat?.Code</span>
                        </div>
                        <div class="col-4">
                            <small class="text-muted text-uppercase fw-semibold d-block fs-7">Classe / Class</small>
                            <strong class="fs-6 text-dark">@Model.Ticket?.Seat?.SeatClass</strong>
                        </div>
                        <div class="col-4">
                            <small class="text-muted text-uppercase fw-semibold d-block fs-7">Embarque / Gate</small>
                            <strong class="fs-6 text-dark">@(Model.Gate ?? "TBA")</strong>
                        </div>
                    </div>
                </div>

                <!-- Coluna do Código QR e Acesso ao Porta-Avanço -->
                <div class="col-md-4 text-center ps-md-4">
                    <div class="p-3 bg-white border rounded-4 shadow-sm d-inline-block w-100">
                        <!-- Código QR Gerado -->
                        @if (!string.IsNullOrEmpty(Model.QRCodeBase64))
                        {
                            <img src="@Model.QRCodeBase64" alt="QR Code de Embarque" class="img-fluid rounded mb-2" style="max-width: 200px;" />
                        }
                        else
                        {
                            <!-- Fallback via API externa de QR caso não esteja no modelo em Base64 -->
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@(Uri.EscapeDataString($"TICKET:{Model.TicketId}|SEQ:{Model.SequenceNumber}|PASS:{Model.Ticket?.Passenger?.User?.FullName}"))"
                                 alt="QR Code"
                                 class="img-fluid rounded mb-2"
                                 style="max-width: 200px;" />
                        }
                        <small class="d-block font-monospace text-muted mt-2 fs-7">
                            SEQ #@Model.SequenceNumber.ToString("D3")
                        </small>
                    </div>

                    <div class="mt-4">
                        <small class="text-muted d-block mb-1">Emitido em</small>
                        <small class="fw-semibold text-dark">@Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rodapé do Cartão com Código de Barras Decorativo/Instruções -->
        <div class="card-footer bg-light p-3 text-center border-top">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i> Por favor, apresente este cartão de embarque e um documento de identificação no portão de embarque.
            </small>
        </div>
    </div>
</div>

<style>
    .fs-7 {
        font-size: 0.75rem;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    /* Estilos para impressão em papel / PDF */
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-card, .print-card * {
            visibility: visible;
        }

        .print-card {
            position: absolute;
            left: 0;
            top: 0;
            width: 100% !important;
            max-width: 100% !important;
            box-shadow: none !important;
            border: 1px solid #ccc !important;
        }

        .d-print-none {
            display: none !important;
        }
    }
</style>
