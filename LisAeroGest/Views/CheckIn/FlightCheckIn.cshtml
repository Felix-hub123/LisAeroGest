@model IEnumerable<LisAeroGest.Data.Entities.Ticket>
@{
    var flight = ViewBag.Flight as LisAeroGest.Data.Entities.Flight;
    ViewData["Title"] = $"Check-in — {flight?.FlightNumber}";
}

<h1 class="mb-4">
    <i class="bi bi bi-person-check me-2"></i>Check-in
    <small class="text-muted fs-5">@flight?.FlightNumber — @flight?.OriginAirport?.IATACode → @flight?.DestinationAirport?.IATACode</small>
</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Todos os passageiros já fizeram check-in neste voo.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Passageiro</th>
                    <th>Documento</th>
                    <th>Lugar</th>
                    <th>Bilhete</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model)
                {
                    <tr>
                        <td>@ticket.Passenger?.FullName</td>
                        <td>@ticket.Passenger?.DocumentType: @ticket.Passenger?.DocumentNumber</td>
                        <td>@ticket.Seat?.Code</td>
                        <td>€@ticket.TotalPrice.ToString("F2")</td>
                        <td>
                            <form asp-action="DoEmployeeCheckIn" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ticketId" value="@ticket.Id" />
                                <input type="hidden" name="flightId" value="@flight?.Id" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Check-in
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="EmployeeCheckIn" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
