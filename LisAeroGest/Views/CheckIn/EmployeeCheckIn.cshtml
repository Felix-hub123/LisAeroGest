@model IEnumerable<LisAeroGest.Data.Entities.Ticket>
@{
    ViewData["Title"] = "Resultados da Pesquisa";
}

<div class="container mt-4 mb-5">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="EmployeeCheckIn" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="fw-bold mb-0 text-white">
                <i class="bi bi-search text-lime me-2"></i>Resultados da Pesquisa
            </h2>
            <p class="text-muted mb-0 small">
                @ViewBag.ResultCount resultados para "<strong class="text-white">@ViewBag.SearchTerm</strong>"
            </p>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var ticket in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3">
                        <div class="row align-items-center g-2">
                            <div class="col-md-1">
                                <span class="badge bg-primary">#@ticket.Id</span>
                            </div>
                            <div class="col-md-3">
                                <strong class="text-white">@ticket.Passenger?.FirstName @ticket.Passenger?.LastName</strong>
                                <br />
                                <small class="text-muted">@ticket.Passenger?.DocumentType @ticket.Passenger?.DocumentNumber</small>
                            </div>
                            <div class="col-md-3">
                                <span class="badge bg-secondary">@ticket.Flight?.FlightNumber</span>
                                <br />
                                <small class="text-muted">
                                    @ticket.Flight?.OriginAirport?.IATACode → @ticket.Flight?.DestinationAirport?.IATACode
                                </small>
                            </div>
                            <div class="col-md-2">
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    @ticket.Flight?.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-1">
                                <span class="badge @(ticket.Status == "Paid" ? "bg-warning text-dark" : ticket.Status == "CheckedIn" ? "bg-success" : "bg-secondary")">
                                    @ticket.Status
                                </span>
                            </div>
                            <div class="col-md-2 text-end">
                                <form asp-action="ProcessCheckIn" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="@ticket.Id" />
                                    <button type="submit" class="btn btn-sm btn-lime"
                                            @(ticket.Status != "Paid" ? "disabled" : "")>
                                        <i class="bi bi-check-circle me-1"></i>Check-in
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>