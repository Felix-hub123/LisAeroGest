@model IEnumerable<LisAeroGest.Data.Entities.Ticket>

@{
    ViewData["Title"] = "Os Meus Bilhetes";
}

<div class="container my-5">
    <!-- Cabeçalho da Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-ticket-perforated me-2"></i>Os Meus Bilhetes & Viagens</h2>
            <p class="text-muted mb-0">Consulte as suas reservas ativas, faça o check-in online e aceda aos seus cartões de embarque.</p>
        </div>
        <a asp-action="Index" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Comprar Novo Voo
        </a>
    </div>

    <!-- Alertas de Sucesso / Erro -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <!-- Estado Vazio -->
        <div class="card text-center p-5 shadow-sm border-0 rounded-4">
            <div class="card-body">
                <i class="bi bi-journal-x text-muted display-1 mb-3"></i>
                <h4>Ainda não tem bilhetes comprados</h4>
                <p class="text-muted">Explore os destinos disponíveis e faça a sua primeira reserva no LisAeroGest.</p>
                <a asp-action="Index" class="btn btn-primary btn-lg mt-3 fw-bold">Procurar Voos</a>
            </div>
        </div>
    }
    else
    {
        <!-- Lista de Bilhetes -->
        <div class="row g-4">
            @foreach (var ticket in Model)
            {
                bool isPastFlight = ticket.Flight != null && ticket.Flight.DepartureTime < DateTime.Now;

                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-4 overflow-hidden @(isPastFlight ? "opacity-75" : "")">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-3">

                                <!-- Coluna 1: Identificador do Bilhete e Estado -->
                                <div class="col-md-3 border-end-md">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-dark px-3 py-2 fs-6">
                                            Bilhete #@ticket.Id
                                        </span>
                                        @if (ticket.HasCheckedIn)
                                        {
                                            <span class="badge bg-success px-2 py-1 fs-7">
                                                <i class="bi bi-check-circle-fill me-1"></i> Check-In Feito
                                            </span>
                                        }
                                        else if (isPastFlight)
                                        {
                                            <span class="badge bg-secondary px-2 py-1 fs-7">Concluído</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1 fs-7">
                                                <i class="bi bi-clock-history me-1"></i> Confirmado
                                            </span>
                                        }
                                    </div>
                                    <small class="text-muted d-block">
                                        Voo: <strong>@ticket.Flight?.FlightNumber</strong>
                                    </small>
                                    <small class="text-muted d-block">
                                        Comprado em: @ticket.PurchaseDate.ToString("dd/MM/yyyy")
                                    </small>
                                </div>

                                <!-- Coluna 2: Detalhes do Voo (Rota & Horário) -->
                                <div class="col-md-5">
                                    <div class="d-flex align-items-center justify-content-between text-center">
                                        <div>
                                            <h4 class="fw-bold mb-0">@ticket.Flight?.OriginAirport?.IATACode</h4>
                                            <small class="text-muted d-block">@ticket.Flight?.OriginAirport?.City</small>
                                        </div>

                                        <div class="flex-grow-1 px-3">
                                            <div class="position-relative d-flex align-items-center justify-content-center">
                                                <hr class="w-100 my-0 border-2" />
                                                <i class="bi bi-airplane-fill position-absolute text-primary bg-white px-2"></i>
                                            </div>
                                            <small class="text-muted d-block mt-1">@ticket.Flight?.DepartureTime.ToString("dd/MM/yyyy")</small>
                                        </div>

                                        <div>
                                            <h4 class="fw-bold mb-0">@ticket.Flight?.DestinationAirport?.IATACode</h4>
                                            <small class="text-muted d-block">@ticket.Flight?.DestinationAirport?.City</small>
                                        </div>
                                    </div>

                                    <!-- Detalhes do Lugar e Serviços Extra -->
                                    <div class="d-flex justify-content-center gap-3 mt-3 bg-light p-2 rounded-3 text-center fs-7">
                                        <div>
                                            <span class="text-muted">Lugar:</span>
                                            <strong class="text-dark">@ticket.Seat?.Code (@ticket.Seat?.SeatClass)</strong>
                                        </div>
                                        <div>
                                            <span class="text-muted">Bagagem Extra:</span>
                                            <strong class="text-dark">@(ticket.ExtraLuggage ? "Sim" : "Não")</strong>
                                        </div>
                                        <div>
                                            <span class="text-muted">Refeição:</span>
                                            <strong class="text-dark">@(ticket.MealIncluded ? "Sim" : "Não")</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- Coluna 3: Ações (Check-In / Cartão de Embarque) -->
                                <div class="col-md-4 text-center text-md-end border-start-md">
                                    <div class="mb-2">
                                        <small class="text-muted d-block">Partida</small>
                                        <span class="fs-4 fw-bold text-primary">
                                            @ticket.Flight?.DepartureTime.ToString("HH:mm")
                                        </span>
                                    </div>

                                    @if (ticket.HasCheckedIn)
                                    {
                                        <a asp-controller="CheckIn" asp-action="BoardingPass" asp-route-ticketId="@ticket.Id" class="btn btn-outline-primary btn-lg w-100 fw-bold shadow-sm">
                                            <i class="bi bi-qr-code-scan me-2"></i> Ver Cartão de Embarque
                                        </a>
                                    }
                                    else if (!isPastFlight)
                                    {
                                        <form asp-controller="CheckIn" asp-action="OnlineCheckIn" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ticketId" value="@ticket.Id" />
                                            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                                                <i class="bi bi-check2-circle me-2"></i> Fazer Check-In Online
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-lg w-100 fw-bold" disabled>
                                            Voo Realizado
                                        </button>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .fs-7 {
        font-size: 0.8rem;
    }
</style>
