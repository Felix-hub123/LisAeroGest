@model IEnumerable<LisAeroGest.Data.Entities.Ticket>
@{
    ViewData["Title"] = "Check-in Online";
}

<h1 class="mb-4"><i class="bi bi-check2-square me-2"></i>Check-in Online</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum bilhete disponível para check-in neste momento.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Voo</th>
                    <th>Rota</th>
                    <th>Partida</th>
                    <th>Lugar</th>
                    <th>Estado</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model)
                {
                    <tr>
                        <td>@ticket.Flight?.FlightNumber</td>
                        <td>@ticket.Flight?.OriginAirport?.IATACode → @ticket.Flight?.DestinationAirport?.IATACode</td>
                        <td>@ticket.Flight?.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(ticket.Seat?.Code ?? "Por atribuir")</td>
                        <td><span class="badge bg-success">Pago</span></td>
                        <td>

                            <a asp-controller="CheckIn"
                               asp-action="DirectCheckIn"
                               asp-route-ticketId="@ticket.Id"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-check-lg me-1"></i>Fazer Check-in
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}