@model IEnumerable<LisAeroGest.Data.Entities.Notification>

@{
    ViewData["Title"] = "Notificações";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-bell-fill text-primary me-2"></i>Notificações
            </h2>
            <span class="text-muted small">@Model.Count() notificações</span>
        </div>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-check-all me-1"></i>Marcar todas como lidas
                </button>
            </form>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-bell-slash fs-1 opacity-50 d-block"></i>
            <p class="mt-3">Não tem notificações.</p>
        </div>
    }
    else
    {
        var unreadCount = Model.Count(n => !n.IsRead);

        @if (unreadCount > 0)
        {
            <div class="alert alert-primary mb-3">
                <i class="bi bi-info-circle me-1"></i>
                Tem <strong>@unreadCount</strong> notificação(ns) por ler.
            </div>
        }

        <div class="list-group">
            @foreach (var notification in Model)
            {
                <div class="list-group-item list-group-item-action d-flex gap-3 py-3
                                     @(notification.IsRead ? "opacity-75" : "")"
                     style="border-radius: 8px; margin-bottom: 8px;">

                    <!-- Ícone -->
                    <div class="flex-shrink-0">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 42px; height: 42px; background: #e7f1ff;">
                            <i class="bi @notification.Icon @notification.ColorClass fs-5"></i>
                        </div>
                    </div>

                    <!-- Conteúdo -->
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1 @(notification.IsRead ? "" : "fw-bold")">
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-primary me-1"
                                              style="font-size: 0.6rem;">NOVO</span>
                                    }
                                    @notification.Title
                                </h6>
                                <p class="mb-1 small text-muted">@notification.Message</p>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <!-- Ações -->
                            <div class="d-flex gap-1 ms-3">
                                @if (!string.IsNullOrEmpty(notification.Link))
                                {
                                    <form asp-action="MarkAsRead" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@notification.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm"
                                                title="Ver e marcar como lida">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Eliminar notificação?')"
                                            title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>6