@model IEnumerable<LisAeroGest.Data.Entities.Gate>
@{
    ViewData["Title"] = "Gates";
}

<div class="container-fluid mt-4">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-door-open-fill text-primary me-2"></i>Gates de Embarque
            </h2>
            <span class="text-muted small">@Model.Count() gates registados</span>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Novo Gate
        </a>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabela -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Nenhum gate registado.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Gate</th>
                                <th>Terminal</th>
                                <th>Estado</th>
                                <th class="text-end pe-3">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gate in Model.OrderBy(g => g.Terminal).ThenBy(g => g.GateNumber))
                            {
                                var badgeClass = gate.Status switch
                                {
                                    "Available" => "bg-success",
                                    "Occupied" => "bg-danger",
                                    "Maintenance" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                                var statusText = gate.Status switch
                                {
                                    "Available" => "Disponível",
                                    "Occupied" => "Ocupado",
                                    "Maintenance" => "Em Manutenção",
                                    _ => gate.Status
                                };
                                <tr>
                                    <td class="ps-3 fw-bold">
                                        <span class="badge bg-dark fs-6">@gate.GateNumber</span>
                                    </td>
                                    <td>@gate.Terminal</td>
                                    <td>
                                        <span class="badge @badgeClass">@statusText</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@gate.Id"
                                           class="btn btn-sm btn-outline-info me-1">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@gate.Id"
                                           class="btn btn-sm btn-outline-warning me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@gate.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>