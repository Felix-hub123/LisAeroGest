@model LisAeroGest.Models.TicketsIndexViewModel
@{
    ViewData["Title"] = "Bilhetes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 fw-bold mb-0">
            <i class="bi bi-ticket-perforated me-2"></i>Bilhetes
        </h1>
        <span class="text-muted">@Model.TotalCount registos</span>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input asp-for="SearchTerm" class="form-control" placeholder="Voo, passageiro..." />
        </div>
        <div class="col-md-3">
            <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select">
                <option value="">Todos os estados</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </form>

    @if (!Model.Tickets.Any())
    {
        <p class="text-muted">Não existem bilhetes.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Voo</th>
                        <th>Passageiro</th>
                        <th>Lugar</th>
                        <th>Estado</th>
                        <th class="text-end">Preço</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Tickets)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>@(t.Flight?.FlightNumber ?? "—")</td>
                            <td>@(t.Passenger != null ? $"{t.Passenger.FirstName} {t.Passenger.LastName}" : "—")</td>
                            <td>@(t.Seat?.Code ?? "—")</td>
                            <td>@t.Status</td>
                            <td class="text-end">@t.TotalPrice.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>