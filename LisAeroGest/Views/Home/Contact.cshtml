@{
    ViewData["Title"] = "Contactos";
}

<div class="container mt-4">
    <h1 class="text-white"><i class="bi bi-envelope me-2 text-primary"></i>Contactos</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="text-white"><i class="bi bi-geo-alt me-2 text-primary"></i>Morada</h5>
                    <p class="text-white">
                        Aeroporto Humberto Delgado<br />
                        Alameda das Comunidades Portuguesas<br />
                        1700-111 Lisboa
                    </p>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="text-white"><i class="bi bi-telephone me-2 text-primary"></i>Telefone</h5>
                    <p class="text-white">+351 21 000 0000</p>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h5 class="text-white"><i class="bi bi-envelope me-2 text-primary"></i>Email</h5>
                    <p class="text-white">geral@lisaerogest.pt</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="text-white"><i class="bi bi-clock me-2 text-primary"></i>Horário de Atendimento</h5>
                    <p class="text-white"><strong>Segunda a Sexta:</strong> 08:00 - 20:00</p>
                    <p class="text-white"><strong>Sábado:</strong> 09:00 - 18:00</p>
                    <p class="text-white"><strong>Domingo:</strong> 10:00 - 16:00</p>
                    <hr />
                    <p class="text-muted small">O balcão de apoio ao cliente está localizado no Terminal 1, junto à zona de chegadas.</p>
                </div>
            </div>
        </div>
    </div>
</div>