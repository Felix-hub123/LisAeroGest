@{
    ViewData["Title"] = "Privacidade";
}

<div class="container mt-4">
    <h1 class="text-white"><i class="bi bi-shield-lock me-2 text-primary"></i>Política de Privacidade</h1>
    <hr />
    <div class="row">
        <div class="col-md-10">
            <h4 class="text-white">1. Dados recolhidos</h4>
            <p class="text-white">A LisAeroGest recolhe apenas os dados necessários para a gestão de reservas e bilhetes.</p>

            <h4 class="text-white">2. Utilização dos dados</h4>
            <p class="text-white">Os dados são utilizados exclusivamente para processar reservas, emitir bilhetes e comunicar alterações de voos.</p>

            <h4 class="text-white">3. Proteção de dados</h4>
            <p class="text-white">Implementamos medidas de segurança para proteger os seus dados pessoais.</p>

            <h4 class="text-white">4. Direitos do utilizador</h4>
            <p class="text-white">Pode solicitar a eliminação dos seus dados a qualquer momento através do contacto.</p>

            <p class="text-muted small mt-4">Última atualização: @DateTime.Now.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
</div>