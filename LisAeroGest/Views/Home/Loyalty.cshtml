@{
    ViewData["Title"] = "Programa LisAeroPoints";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isPassenger = User.IsInRole("Passenger");
    var isAdminOrEmployee = User.IsInRole("Admin") || User.IsInRole("Employee");
}

<div class="container mt-5 mb-5">

    <div class="p-4 p-md-5 rounded-4 shadow-sm lis-loyalty-box">

        <!-- ═══ CABEÇALHO ═══ -->
        <div class="text-center">
            <div class="loyalty-hero-icon">
                <i class="bi bi-gem"></i>
            </div>
            <h1 class="display-5 fw-bold text-white mb-2">LisAeroPoints</h1>
            <p class="lead text-muted">
                Programa de fidelidade da LisAeroGest. Acumule pontos em cada viagem
                e troque por descontos em reservas futuras.
            </p>
        </div>

        <hr class="my-5 border-secondary" />

        <!-- ═══ COMO FUNCIONA ═══ -->
        <h3 class="loyalty-section-title">
            <i class="bi bi-info-circle me-2"></i>Como funciona
        </h3>

        <div class="row g-3 mb-5">
            <div class="col-md-6">
                <div class="loyalty-step">
                    <div class="loyalty-step-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div>
                        <div class="loyalty-step-title">Ganhe pontos</div>
                        <div class="loyalty-step-desc">
                            Por cada <strong>1€</strong> gasto numa reserva paga,
                            recebe <strong class="text-lime">10 pontos</strong>.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="loyalty-step">
                    <div class="loyalty-step-icon">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                    <div>
                        <div class="loyalty-step-title">Troque por descontos</div>
                        <div class="loyalty-step-desc">
                            Use os pontos acumulados para reduzir o preço
                            das suas próximas reservas.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="loyalty-step">
                    <div class="loyalty-step-icon">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <div>
                        <div class="loyalty-step-title">Suba de nível</div>
                        <div class="loyalty-step-desc">
                            Desbloqueie <strong>Bronze, Prata, Ouro e Platina</strong>
                            com benefícios exclusivos.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="loyalty-step">
                    <div class="loyalty-step-icon">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                        <div class="loyalty-step-title">Aderência grátis</div>
                        <div class="loyalty-step-desc">
                            Basta <strong>criar conta de passageiro</strong> —
                            os pontos começam a acumular automaticamente.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-5 border-secondary" />

        <!-- ═══ NÍVEIS ═══ -->
        <h3 class="loyalty-section-title mb-4">
            <i class="bi bi-trophy me-2"></i>Níveis e benefícios
        </h3>

        <div class="row g-3 mb-5">

            <!-- BRONZE -->
            <div class="col-6 col-lg-3">
                <div class="loyalty-tier loyalty-tier-bronze">
                    <div class="loyalty-tier-icon">
                        <i class="bi bi-award"></i>
                    </div>
                    <div class="loyalty-tier-name">Bronze</div>
                    <div class="loyalty-tier-range">0 — 499 pts</div>
                    <ul class="loyalty-tier-perks">
                        <li><i class="bi bi-check-circle-fill"></i>Acumular pontos</li>
                        <li><i class="bi bi-check-circle-fill"></i>Ofertas por email</li>
                    </ul>
                </div>
            </div>

            <!-- PRATA -->
            <div class="col-6 col-lg-3">
                <div class="loyalty-tier loyalty-tier-prata">
                    <div class="loyalty-tier-icon">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div class="loyalty-tier-name">Prata</div>
                    <div class="loyalty-tier-range">500 — 1499 pts</div>
                    <ul class="loyalty-tier-perks">
                        <li><i class="bi bi-check-circle-fill"></i>Check-in prioritário</li>
                        <li><i class="bi bi-check-circle-fill"></i>5% desconto</li>
                    </ul>
                </div>
            </div>

            <!-- OURO -->
            <div class="col-6 col-lg-3">
                <div class="loyalty-tier loyalty-tier-ouro">
                    <div class="loyalty-tier-icon">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <div class="loyalty-tier-name">Ouro</div>
                    <div class="loyalty-tier-range">1500 — 2999 pts</div>
                    <ul class="loyalty-tier-perks">
                        <li><i class="bi bi-check-circle-fill"></i>Embarque prioritário</li>
                        <li><i class="bi bi-check-circle-fill"></i>10% desconto</li>
                    </ul>
                </div>
            </div>

            <!-- PLATINA -->
            <div class="col-6 col-lg-3">
                <div class="loyalty-tier loyalty-tier-platina">
                    <div class="loyalty-tier-icon">
                        <i class="bi bi-gem"></i>
                    </div>
                    <div class="loyalty-tier-name">Platina</div>
                    <div class="loyalty-tier-range">3000+ pts</div>
                    <ul class="loyalty-tier-perks">
                        <li><i class="bi bi-check-circle-fill"></i>Acesso à sala VIP</li>
                        <li><i class="bi bi-check-circle-fill"></i>15% desconto</li>
                    </ul>
                </div>
            </div>

        </div>

        <hr class="my-5 border-secondary" />

        <!-- ═══ CTA FINAL ═══ -->
        <div class="text-center">

            @if (!isAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-lime btn-lg">
                    <i class="bi bi-person-plus me-1"></i>Criar conta e aderir
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg ms-md-2">
                    <i class="bi bi-arrow-left me-1"></i>Voltar ao início
                </a>
            }
            else if (isPassenger)
            {
                <a asp-controller="Dashboard" asp-action="PassengerDashboard" class="btn btn-lime btn-lg">
                    <i class="bi bi-speedometer2 me-1"></i>Voltar ao Dashboard
                </a>
            }
            else if (isAdminOrEmployee)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-lime btn-lg">
                    <i class="bi bi-speedometer2 me-1"></i>Voltar ao Dashboard
                </a>
            }

        </div>

    </div>
</div>