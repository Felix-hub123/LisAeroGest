@{
    ViewData["Title"] = "Termos e Condições";
}

<div class="container mt-4">
    <h1 class="text-white"><i class="bi bi-file-text me-2 text-primary"></i>Termos e Condições</h1>
    <hr />
    <div class="row">
        <div class="col-md-10">
            <h4 class="text-white">1. Aceitação dos termos</h4>
            <p class="text-white">Ao utilizar a plataforma LisAeroGest, o utilizador aceita os presentes termos e condições.</p>

            <h4 class="text-white">2. Reservas e bilhetes</h4>
            <p class="text-white">Todas as reservas estão sujeitas à disponibilidade de lugares e à confirmação de pagamento.</p>

            <h4 class="text-white">3. Cancelamentos</h4>
            <p class="text-white">O cancelamento de bilhetes está sujeito à política de cada companhia aérea.</p>

            <h4 class="text-white">4. Alterações de voos</h4>
            <p class="text-white">A LisAeroGest não se responsabiliza por alterações de horários efetuadas pelas companhias aéreas.</p>

            <h4 class="text-white">5. Responsabilidade</h4>
            <p class="text-white">A LisAeroGest atua como intermediário entre o passageiro e as companhias aéreas.</p>

            <p class="text-muted small mt-4">Última atualização: @DateTime.Now.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
</div>
