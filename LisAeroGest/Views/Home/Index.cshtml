@model LisAeroGest.Models.HomeBoardViewModel
@{
    ViewData["Title"] = "Voos a partir de Lisboa";
}

<section class="hero-section hero-lisaerogest rounded-4 overflow-hidden mb-4">
    <div class="hero-overlay"></div>
    <div class="container position-relative py-5 text-white">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-white text-primary rounded-pill mb-3">Aeroporto de Lisboa · LIS</span>
                <h1 class="display-5 fw-bold mb-3">Escolha o dia. Nós mostramos o voo.</h1>
                <p class="lead opacity-75 mb-4">
                    Partidas reais a partir de Lisboa. Sem formulários longos — abra o calendário e reserve.
                </p>
                <a asp-controller="Shop" asp-action="Calendar" class="btn btn-light btn-lg fw-bold me-2">
                    Ver calendário de voos
                </a>
                <a class="btn btn-outline-light btn-lg" data-bs-toggle="collapse" href="#advancedSearch">
                    Pesquisa avançada
                </a>
            </div>
            <div class="col-lg-5 text-lg-end mt-4 mt-lg-0">
                <div class="fw-bold fs-2" id="clockTime">00:00:00</div>
                <div class="opacity-75" id="clockDate"></div>
            </div>
        </div>
    </div>
</section>

<div class="container mb-4">
    <div class="collapse" id="advancedSearch">
        <div class="card border-0 shadow rounded-4 p-3">
            <form method="get" action="/Shop/Index">
                <input type="hidden" name="origin" value="LIS" />
                <input type="hidden" name="tripType" value="oneway" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Destino</label>
                        <input name="destination" class="form-control" placeholder="Cidade ou IATA" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Data</label>
                        <input type="date" name="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-5">
                        <button class="btn btn-primary w-100">Pesquisar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="container mb-4">
    <div class="row g-3 text-center">
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-4 py-3">
                <div class="small text-muted">Voos ativos</div>
                <div class="fs-4 fw-bold text-primary">@Model.ActiveFlightsCount</div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-4 py-3">
                <div class="small text-muted">Partidas</div>
                <div class="fs-4 fw-bold text-primary">@Model.TotalPartidasFuturas</div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-4 py-3">
                <div class="small text-muted">Destinos</div>
                <div class="fs-4 fw-bold text-primary">@(Model.PopularDestinations?.Count ?? 0)</div>
            </div>
        </div>
    </div>
</div>

@if (Model.PopularDestinations?.Any() == true)
{
    <section class="container mb-5">
        <h2 class="h4 fw-bold mb-3">Para onde voar a partir de Lisboa</h2>
        <div class="row g-3">
            @foreach (var d in Model.PopularDestinations)
            {
                <div class="col-6 col-lg-3">
                    <a asp-controller="Shop" asp-action="Calendar"
                       class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none text-dark">
                        <div class="card-body">
                            <span class="badge bg-warning text-dark">@d.IATA</span>
                            <div class="fw-bold mt-2">@d.Cidade</div>
                            <small class="text-muted">@d.Pais</small>
                            @if (d.Weather?.Main != null)
                            {
                                <div class="small text-muted mt-1">
                                    @Math.Round(d.Weather.Main.Temp)°C
                                    @if (d.Weather.Weather?.FirstOrDefault()?.Description != null)
                                    {
                                        <span> · @d.Weather.Weather.First().Description</span>
                                    }
                                </div>
                            }
                            @if (d.IsAdverseWeather)
                            {
                                <span class="badge bg-warning text-dark mt-1">Atenção ao tempo</span>
                            }
                            @if (d.FromPrice > 0)
                            {
                                <div class="text-success fw-semibold mt-2">desde @d.FromPrice.Value.ToString("C")</div>
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

<section class="container mb-5">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <h6 class="fw-bold">Check-in online</h6>
                <p class="small text-muted">Entre 48h e 1h antes da partida.</p>
                <a asp-controller="CheckIn" asp-action="Index" class="btn btn-sm btn-outline-primary">Fazer check-in</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <h6 class="fw-bold">Painel do aeroporto</h6>
                <p class="small text-muted">Partidas e chegadas em tempo real.</p>
                <a asp-controller="Flights" asp-action="PublicIndex" class="btn btn-sm btn-outline-primary">Consultar</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                @if (Model.Weather?.Main != null)
                {
                    <h6 class="fw-bold">Lisboa agora</h6>
                    <div class="fs-3 fw-bold">@Math.Round(Model.Weather.Main.Temp)°C</div>
                    <div class="small text-muted text-capitalize">@Model.Weather.Weather?.FirstOrDefault()?.Description</div>
                }
            </div>
        </div>
    </div>
</section>

<section class="container mb-5">
    <h2 class="h4 fw-bold mb-3">Rotas a partir de Lisboa</h2>
    <div id="routesMap" class="rounded-4 shadow-sm" style="height: 360px;"></div>
</section>

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="container mb-5">
        <div class="cta-registo rounded-4 p-4 text-center text-white">
            <h5 class="fw-bold">Reserve em 3 cliques</h5>
            <p class="mb-3 opacity-75">Calendário → lugar → pagamento. Crie conta para guardar os bilhetes.</p>
            <a asp-controller="Shop" asp-action="Calendar" class="btn btn-light fw-bold me-2">Ver voos</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light">Criar conta</a>
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function updateClock() {
            const n = new Date();
            const t = document.getElementById("clockTime");
            const d = document.getElementById("clockDate");
            if (t) t.textContent = n.toLocaleTimeString("pt-PT");
            if (d) d.textContent = n.toLocaleDateString("pt-PT", { weekday: "long", day: "numeric", month: "long" });
        }
        updateClock();
        setInterval(updateClock, 1000);

        const markers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapMarkers ?? new List<LisAeroGest.Models.MapMarkerViewModel>()));
        const mapEl = document.getElementById("routesMap");
        if (mapEl && typeof L !== "undefined") {
            const map = L.map("routesMap").setView([38.77, -9.13], 4);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: "&copy; OpenStreetMap"
            }).addTo(map);
            (markers || []).forEach(function (m) {
                const lat = m.lat ?? m.Lat;
                const lng = m.lng ?? m.Lng;
                if (lat == null || lng == null) return;
                L.marker([lat, lng]).addTo(map)
                    .bindPopup((m.label || m.Label || "") + " (" + (m.iata || m.Iata || "") + ")");
            });
        }
    </script>
}