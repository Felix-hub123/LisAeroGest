@model LisAeroGest.Models.HomeBoardViewModel
@{
    ViewData["Title"] = "LisAeroGest — Voos e Bilhetes";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="lisaero-home">
    <section class="hero-section hero-lisaerogest rounded-4 overflow-hidden mb-3">
        <div class="hero-overlay"></div>
        <div class="container position-relative py-3">
            <div class="d-flex justify-content-between align-items-center text-white mb-2">
                <h1 class="h3 fw-bold mb-0">Encontre o seu próximo voo</h1>
                <div class="text-end small">
                    <div id="clockTime" class="fw-bold fs-5">00:00:00</div>
                    <div id="clockDate" class="opacity-75"></div>
                </div>
            </div>

            <div class="card border-0 shadow bg-white text-dark p-3 rounded-4">
                <form id="flightSearchForm" method="get" action="/Shop/Index">
                    <div class="mb-2">
                        <div class="btn-group btn-group-sm">
                            <input type="radio" class="btn-check" name="tripType" id="tripRound" value="round" checked>
                            <label class="btn btn-outline-primary" for="tripRound">Ida e volta</label>
                            <input type="radio" class="btn-check" name="tripType" id="tripOneWay" value="oneway">
                            <label class="btn btn-outline-primary" for="tripOneWay">Só ida</label>
                        </div>
                    </div>

                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <label for="origin" class="form-label small fw-semibold mb-1">De</label>
                            <select id="origin" name="origin" class="form-select" required>
                                <option value="LIS" selected>Lisboa (LIS)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4 position-relative">
                            <label for="destination" class="form-label small fw-semibold mb-1">Para</label>
                            <input type="text" id="destination" name="destination" class="form-control"
                                   placeholder="Cidade ou IATA" autocomplete="off" required />
                            <div id="airportSuggestions" class="list-group position-absolute w-100 shadow-sm"
                                 style="z-index: 30; display: none;"></div>
                        </div>
                        <div class="col-6 col-md-2">
                            <label for="departureDate" class="form-label small fw-semibold mb-1">Ida</label>
                            <input type="date" id="departureDate" name="date" class="form-control" min="@today" required />
                        </div>
                        <div class="col-6 col-md-3" id="returnDateWrapper">
                            <label for="returnDate" class="form-label small fw-semibold mb-1">Volta</label>
                            <input type="date" id="returnDate" name="returnDate" class="form-control" min="@today" />
                        </div>
                    </div>

                    <div class="row g-2 align-items-end mt-1">
                        <div class="col-6 col-md-2">
                            <label for="passengers" class="form-label small fw-semibold mb-1">Passageiros</label>
                            <select id="passengers" name="passengers" class="form-select">
                                @for (var i = 1; i <= 8; i++)
                                {
                                    <option value="@i" selected="@(i == 1)">@(i == 1 ? "1" : i.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label for="cabinClass" class="form-label small fw-semibold mb-1">Classe</label>
                            <select id="cabinClass" name="cabinClass" class="form-select">
                                <option value="Economy" selected>Económica</option>
                                <option value="Business">Executiva</option>
                                <option value="First">Primeira</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="form-check mt-md-4">
                                <input class="form-check-input" type="checkbox" id="directOnly" name="directOnly" value="true" />
                                <label class="form-check-label" for="directOnly">Só diretos</label>
                            </div>
                        </div>
                        <div class="col-12 col-md-5">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search me-1"></i>Pesquisar voos
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <section class="container-fluid px-3 px-md-4 mb-4">
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <a href="#flightSearchForm" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body py-3 px-3">
                        <div class="fw-semibold text-dark">Pesquisar voos</div>
                        <small class="text-muted">Compare e reserve</small>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Flights" asp-action="PublicIndex" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body py-3 px-3">
                        <div class="fw-semibold text-dark">Estado dos voos</div>
                        <small class="text-muted">Partidas e chegadas</small>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="CheckIn" asp-action="Index" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body py-3 px-3">
                        <div class="fw-semibold text-dark">Check-in</div>
                        <small class="text-muted">Online</small>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="card text-decoration-none border-0 shadow-sm h-100">
                        <div class="card-body py-3 px-3">
                            <div class="fw-semibold text-dark">As minhas viagens</div>
                            <small class="text-muted">Reservas</small>
                        </div>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="card text-decoration-none border-0 shadow-sm h-100">
                        <div class="card-body py-3 px-3">
                            <div class="fw-semibold text-dark">Gerir reserva</div>
                            <small class="text-muted">Iniciar sessão</small>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="container-fluid px-3 px-md-4 mb-4">
        <div class="row g-2 text-center">
            <div class="col-4">
                <div class="card border-0 shadow-sm rounded-3 py-2">
                    <div class="small text-muted">Voos ativos</div>
                    <div class="fw-bold text-primary">@Model.ActiveFlightsCount</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm rounded-3 py-2">
                    <div class="small text-muted">Partidas</div>
                    <div class="fw-bold text-primary">@Model.TotalPartidasFuturas</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm rounded-3 py-2">
                    <div class="small text-muted">Destinos</div>
                    <div class="fw-bold text-primary">@(Model.PopularDestinations?.Count ?? 0)</div>
                </div>
            </div>
        </div>
    </section>

    <div class="container-fluid px-3 px-md-4 mb-4">
        <div id="mainCarousel" class="carousel slide rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/carousel/lisbon.jpg" class="d-block w-100" alt="Lisboa" style="height: 240px; object-fit: cover;" />
                    <div class="carousel-caption"><h5>Aeroporto de Lisboa</h5></div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/carousel/flight.jpg" class="d-block w-100" alt="Reserva" style="height: 240px; object-fit: cover;" />
                    <div class="carousel-caption"><h5>Reserve o seu lugar</h5></div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/carousel/destination.jpg" class="d-block w-100" alt="Destinos" style="height: 240px; object-fit: cover;" />
                    <div class="carousel-caption"><h5>Novos destinos</h5></div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>

    @if (Model.PopularDestinations != null && Model.PopularDestinations.Any())
    {
        <section class="container-fluid px-3 px-md-4 mb-4">
            <h2 class="h5 fw-bold mb-3">Destinos populares a partir de Lisboa</h2>
            <div class="row g-3">
                @foreach (var destination in Model.PopularDestinations)
                {
                    <div class="col-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-3">
                                <span class="badge bg-warning text-dark">@destination.IATA</span>
                                <div class="fw-bold mt-1">@destination.Cidade</div>
                                <small class="text-muted d-block">@destination.Pais · @destination.Voos voos/sem.</small>
                                @if (destination.FromPrice.HasValue && destination.FromPrice.Value > 0)
                                {
                                    <div class="small text-success fw-semibold mt-1">
                                        A partir de @destination.FromPrice.Value.ToString("C")
                                    </div>
                                }
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm w-100 mt-2 destination-search-button"
                                        data-destination="@destination.Cidade"
                                        data-iata="@destination.IATA">
                                    Ver voos
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="container-fluid px-3 px-md-4 mb-4">
        <h2 class="h5 fw-bold mb-3">Novidades</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <h6 class="fw-bold">Nova rota: Lisboa – Rio</h6>
                        <p class="small text-muted mb-2">Operações previstas para outubro de 2026.</p>
                        <a asp-controller="Home" asp-action="NewRoute" class="btn btn-sm btn-outline-primary">Detalhes</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <h6 class="fw-bold">LisAeroPoints</h6>
                        <p class="small text-muted mb-2">Programa de fidelidade para passageiros.</p>
                        <a asp-controller="Home" asp-action="Loyalty" class="btn btn-sm btn-outline-primary">Saber mais</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <h6 class="fw-bold">Estado dos voos</h6>
                        <p class="small text-muted mb-2">Partidas e chegadas em Lisboa.</p>
                        <a asp-controller="Flights" asp-action="PublicIndex" class="btn btn-sm btn-outline-primary">Consultar</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="container-fluid px-3 px-md-4 mb-4">
        <div class="row g-3">
            @if (Model.Weather?.Main != null)
            {
                var weather = Model.Weather.Weather?.FirstOrDefault();
                var iconUrl = !string.IsNullOrEmpty(weather?.Icon)
                ? $"https://openweathermap.org/img/wn/{weather.Icon}@2x.png"
                : null;
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="small text-muted">Lisboa agora</div>
                                <div class="fs-2 fw-bold">@Math.Round(Model.Weather.Main.Temp)°C</div>
                                <div class="text-capitalize text-muted">@weather?.Description</div>
                            </div>
                            @if (iconUrl != null)
                            {
                                <img src="@iconUrl" width="64" height="64" alt="" />
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <div class="fw-semibold mb-2">Como chegar</div>
                        <div class="small mb-1"><strong>Metro</strong> — Linha Vermelha, Estação Aeroporto</div>
                        <div class="small mb-1"><strong>Autocarros</strong> — Ligações para Lisboa</div>
                        <div class="small"><strong>Táxi / TVDE</strong> — 24h no terminal</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <section class="container-fluid px-3 px-md-4 mb-4">
            <div class="cta-registo rounded-4 p-3 text-center text-white">
                <span class="me-2">Crie conta para guardar reservas e bilhetes.</span>
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-sm">Criar conta</a>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        function updateClock() {
            const now = new Date();
            const t = document.getElementById("clockTime");
            const d = document.getElementById("clockDate");
            if (t) t.textContent = now.toLocaleTimeString("pt-PT");
            if (d) d.textContent = now.toLocaleDateString("pt-PT", { weekday: "long", day: "numeric", month: "long" });
        }
        updateClock();
        setInterval(updateClock, 1000);

        document.addEventListener("DOMContentLoaded", function () {
            const departureInput = document.getElementById("departureDate");
            const returnInput = document.getElementById("returnDate");
            const returnWrapper = document.getElementById("returnDateWrapper");
            const tripOneWay = document.getElementById("tripOneWay");
            const tripRound = document.getElementById("tripRound");
            const destination = document.getElementById("destination");
            const form = document.getElementById("flightSearchForm");

            function toggleReturn() {
                const oneWay = tripOneWay && tripOneWay.checked;
                if (returnWrapper) returnWrapper.style.display = oneWay ? "none" : "";
                if (returnInput && oneWay) returnInput.value = "";
            }
            tripOneWay?.addEventListener("change", toggleReturn);
            tripRound?.addEventListener("change", toggleReturn);

            departureInput?.addEventListener("change", function () {
                if (this.value && returnInput) {
                    returnInput.min = this.value;
                    if (returnInput.value && returnInput.value < this.value) returnInput.value = "";
                }
            });

            document.querySelectorAll(".destination-search-button").forEach(function (button) {
                button.addEventListener("click", function () {
                    const dest = button.getAttribute("data-destination") || "";
                    const iata = button.getAttribute("data-iata") || "";
                    if (destination) destination.value = iata ? (dest + " (" + iata + ")") : dest;
                    if (departureInput && !departureInput.value) {
                        departureInput.value = new Date().toISOString().split("T")[0];
                    }
                    form?.submit();
                });
            });

            const box = document.getElementById("airportSuggestions");
            if (!destination || !box) return;
            let timer = null;
            destination.addEventListener("input", function () {
                const term = destination.value.trim();
                clearTimeout(timer);
                if (term.length < 2) { box.style.display = "none"; box.innerHTML = ""; return; }
                timer = setTimeout(async function () {
                    const response = await fetch("/Shop/SearchAirports?term=" + encodeURIComponent(term));
                    if (!response.ok) return;
                    const items = await response.json();
                    box.innerHTML = "";
                    const filtered = items.filter(function (item) {
                        const code = (item.iata || item.Iata || item.code || item.Code || "").toUpperCase();
                        const label = (item.label || item.Label || "").toUpperCase();
                        return code !== "LIS" && label.indexOf("(LIS)") === -1;
                    });
                    if (!filtered.length) { box.style.display = "none"; return; }
                    filtered.forEach(function (item) {
                        const label = item.label || item.Label || "";
                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "list-group-item list-group-item-action";
                        btn.textContent = label;
                        btn.addEventListener("click", function () {
                            destination.value = label;
                            box.style.display = "none";
                        });
                        box.appendChild(btn);
                    });
                    box.style.display = "block";
                }, 250);
            });
            document.addEventListener("click", function (e) {
                if (!box.contains(e.target) && e.target !== destination) box.style.display = "none";
            });
        });
    </script>
}