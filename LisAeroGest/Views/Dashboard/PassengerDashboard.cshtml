@model LisAeroGest.Models.PassengerDashboardViewModel
@{
    ViewData["Title"] = "O Meu Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/passengerDashboard.css" asp-append-version="true" />
}

<div class="container py-4 mb-5">

    <!-- ═══ CABEÇALHO ═══ -->
    <div class="pd-header">
        <div>
            <h1 class="pd-title">
                <i class="bi bi-person-circle me-2"></i>Olá, @Model.Passenger.FirstName!
            </h1>
            <p class="pd-subtitle">
                <i class="bi bi-person-vcard me-1"></i>
                @Model.Passenger.DocumentType · @Model.Passenger.DocumentNumber
                <span class="mx-2">·</span>
                <i class="bi bi-calendar-check me-1"></i>
                Membro desde @Model.Passenger.RegistrationDate.ToString("dd/MM/yyyy")
            </p>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-lime">
            <i class="bi bi-cart-plus me-1"></i>Comprar Bilhete
        </a>
    </div>

    <!-- ═══ ALERTA: RESERVAS PENDENTES ═══ -->
    @if (Model.PendingCount > 0)
    {
        var firstPending = Model.PendingReservations.First();
        <div class="pd-alert-pending">
            <div class="pd-alert-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="pd-alert-content">
                <div class="pd-alert-title">
                    Tem @Model.PendingCount reserva(s) pendente(s) de pagamento
                </div>
                <div class="pd-alert-desc">
                    Reserva #@firstPending.TicketId.ToString("D6") —
                    @firstPending.FlightNumber (@firstPending.OriginCode → @firstPending.DestinationCode)
                </div>
            </div>
            <a asp-controller="Shop" asp-action="Cart" class="btn btn-warning">
                <i class="bi bi-credit-card me-1"></i>Pagar Agora
            </a>
        </div>
    }

    <!-- ═══ KPIs ═══ -->
    <div class="pd-kpis">
        <div class="pd-kpi pd-kpi-blue">
            <i class="bi bi-airplane-engines"></i>
            <div class="pd-kpi-value">@Model.UpcomingCount</div>
            <div class="pd-kpi-label">Próximos Voos</div>
        </div>
        <div class="pd-kpi pd-kpi-orange">
            <i class="bi bi-clock-history"></i>
            <div class="pd-kpi-value">@Model.PendingCount</div>
            <div class="pd-kpi-label">Reservas Pendentes</div>
        </div>
        <div class="pd-kpi pd-kpi-purple">
            <i class="bi bi-check-circle"></i>
            <div class="pd-kpi-value">@Model.PastCount</div>
            <div class="pd-kpi-label">Voos Realizados</div>
        </div>
        <div class="pd-kpi pd-kpi-green">
            <i class="bi bi-cash-stack"></i>
            <div class="pd-kpi-value">@Model.TotalSpent.ToString("C0")</div>
            <div class="pd-kpi-label">Total Gasto</div>
        </div>
    </div>

    <!-- ═══ PRÓXIMO VOO (destaque) ═══ -->
    @if (Model.NextFlight != null)
    {
        var next = Model.NextFlight;
        <section class="pd-section">
            <div class="pd-section-header">
                <h2 class="pd-section-title">
                    <i class="bi bi-airplane-fill text-lime me-2"></i>Próximo Voo
                </h2>
            </div>

            <div class="pd-next-flight">
                <div class="pd-next-left">
                    <div class="pd-next-flight-num">
                        <span class="pd-badge-flight">@next.FlightNumber</span>
                        <span class="pd-airline">@next.AirlineName</span>
                    </div>
                    <div class="pd-next-route">
                        <span class="pd-code">@next.OriginCode</span>
                        <i class="bi bi-arrow-right pd-arrow"></i>
                        <span class="pd-code">@next.DestinationCode</span>
                    </div>
                    <div class="pd-next-cities">
                        @next.OriginCity → @next.DestinationCity
                    </div>
                </div>

                <div class="pd-next-info">
                    <div class="pd-info-item">
                        <i class="bi bi-calendar3"></i>
                        <div>
                            <small>Partida</small>
                            <strong>@next.DepartureTime.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(next.GateNumber))
                    {
                        <div class="pd-info-item">
                            <i class="bi bi-door-open"></i>
                            <div>
                                <small>Gate</small>
                                <strong>@next.GateNumber</strong>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(next.SeatNumber))
                    {
                        <div class="pd-info-item">
                            <i class="bi bi-grid-3x3-gap"></i>
                            <div>
                                <small>Lugar</small>
                                <strong>@next.SeatNumber</strong>
                            </div>
                        </div>
                    }
                </div>

                <div class="pd-next-actions">
                    <a asp-controller="Shop" asp-action="DownloadTicketPdf"
                       asp-route-ticketId="@next.TicketId"
                       class="btn btn-outline-lime">
                        <i class="bi bi-download me-1"></i>PDF
                    </a>
                    @if (next.CanCheckIn)
                    {
                        <a asp-controller="CheckIn" asp-action="Index"
                           class="btn btn-lime">
                            <i class="bi bi-check-circle me-1"></i>Check-in
                        </a>
                    }
                    @if (next.HasBoardingPass)
                    {
                        <a asp-controller="CheckIn" asp-action="ConfirmationByTicket"
                           asp-route-ticketId="@next.TicketId"
                           class="btn btn-lime">
                            <i class="bi bi-ticket-perforated me-1"></i>Cartão
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ═══ NOTIFICAÇÕES ═══ -->
    @if (Model.RecentNotifications.Any())
    {
        <section class="pd-section">
            <div class="pd-section-header">
                <h2 class="pd-section-title">
                    <i class="bi bi-bell-fill text-lime me-2"></i>Notificações Recentes
                    @if (Model.UnreadNotificationsCount > 0)
                    {
                        <span class="badge bg-danger ms-2">@Model.UnreadNotificationsCount</span>
                    }
                </h2>
                <a asp-controller="Notification" asp-action="Index" class="pd-link">
                    Ver todas <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="pd-notif-list">
                @foreach (var n in Model.RecentNotifications)
                {
                    <div class="pd-notif-item @(n.IsRead ? "" : "pd-notif-unread")">
                        <div class="pd-notif-icon">
                            <i class="bi @(string.IsNullOrEmpty(n.Icon) ? "bi-bell" : n.Icon) @(n.ColorClass ?? "text-primary")"></i>
                        </div>
                        <div class="pd-notif-body">
                            <div class="pd-notif-title">@n.Title</div>
                            <div class="pd-notif-desc">@n.Message</div>
                            <div class="pd-notif-time">
                                <i class="bi bi-clock me-1"></i>
                                @n.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ═══ LIS AERO POINTS ═══ -->
    <section class="pd-section">
        <div class="pd-loyalty">
            <div class="pd-loyalty-left">
                <div class="pd-loyalty-label">LisAeroPoints</div>
                <div class="pd-loyalty-points">
                    <span class="pd-points-value">@Model.LoyaltyPoints</span>
                    <span class="pd-points-unit">pontos</span>
                </div>
                <div class="pd-loyalty-tier">
                    Nível: <strong>@Model.LoyaltyTier</strong>
                </div>
                <div class="pd-loyalty-progress">
                    <div class="pd-progress-bar" style="width: @Model.LoyaltyProgressPercent%;"></div>
                </div>
                @if (Model.PointsToNextTier > 0)
                {
                    <div class="pd-loyalty-hint">
                        Faltam <strong>@Model.PointsToNextTier</strong> pontos para o próximo nível!
                    </div>
                }
                else
                {
                    <div class="pd-loyalty-hint">
                        🎉 Já está no nível máximo!
                    </div>
                }
            </div>
            <div class="pd-loyalty-right">
                <a asp-controller="Home" asp-action="Loyalty" class="btn btn-outline-lime">
                    <i class="bi bi-gift me-1"></i>Ver Benefícios
                </a>
            </div>
        </div>
    </section>

    <!-- ═══ PRÓXIMOS VOOS (lista) ═══ -->
    @if (Model.UpcomingTickets.Any())
    {
        <section class="pd-section">
            <div class="pd-section-header">
                <h2 class="pd-section-title">
                    <i class="bi bi-calendar-event text-lime me-2"></i>Todos os Próximos Voos
                </h2>
            </div>

            <div class="pd-flights-list">
                @foreach (var t in Model.UpcomingTickets)
                {
                    <div class="pd-flight-card">
                        <div class="pd-flight-info">
                            <span class="pd-badge-flight">@t.FlightNumber</span>
                            <span class="pd-airline">@t.AirlineName</span>
                            <div class="pd-flight-route">
                                <strong>@t.OriginCode</strong>
                                <i class="bi bi-arrow-right mx-2"></i>
                                <strong>@t.DestinationCode</strong>
                            </div>
                            <small class="text-muted">
                                @t.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                                @if (!string.IsNullOrEmpty(t.SeatNumber))
                                {
                                    <span class="ms-2">· Lugar @t.SeatNumber</span>
                                }
                            </small>
                        </div>
                        <div class="pd-flight-actions">
                            <a asp-controller="Shop" asp-action="DownloadTicketPdf"
                               asp-route-ticketId="@t.TicketId"
                               class="btn btn-sm btn-outline-lime">
                                <i class="bi bi-download"></i>
                            </a>
                            @if (t.CanCheckIn)
                            {
                                <a asp-controller="CheckIn" asp-action="Index"
                                   class="btn btn-sm btn-lime">
                                    <i class="bi bi-check-circle"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }
    else if (!Model.PendingReservations.Any())
    {
        <div class="pd-empty">
            <i class="bi bi-airplane-engines display-3 d-block mb-3"></i>
            <h4 class="text-white">Ainda não tem voos agendados</h4>
            <p class="text-muted">Pesquise voos e comece a sua próxima viagem!</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-lime">
                <i class="bi bi-search me-1"></i>Pesquisar Voos
            </a>
        </div>
    }

    <!-- ═══ HISTÓRICO ═══ -->
    @if (Model.PastTickets.Any())
    {
        <section class="pd-section">
            <div class="pd-section-header">
                <h2 class="pd-section-title">
                    <i class="bi bi-clock-history text-lime me-2"></i>Histórico de Voos
                </h2>
            </div>

            <div class="pd-history-list">
                @foreach (var t in Model.PastTickets.Take(5))
                {
                    <div class="pd-history-item">
                        <div>
                            <strong class="text-white">@t.FlightNumber</strong>
                            <span class="text-muted mx-2">·</span>
                            <span class="text-muted">@t.OriginCode → @t.DestinationCode</span>
                            <br />
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>
                                @t.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                        <span class="pd-status-badge @(t.TicketStatus == "CheckedIn" ? "pd-status-checked" : t.TicketStatus == "Cancelled" ? "pd-status-cancelled" : "pd-status-default")">
                            @t.TicketStatus
                        </span>
                    </div>
                }
            </div>
        </section>
    }

</div>