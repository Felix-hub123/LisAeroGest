@{
    ViewData["Title"] = "Dashboard — Administrador";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item active">Dashboard Administrativo</li>
    </ol>
</nav>

<div class="container-fluid mt-2">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard Administrativo
            </h2>
            <p class="text-muted mb-0">
                Bem-vindo, <strong>@User.Identity!.Name</strong> —
                <span class="badge bg-primary">Administrador</span>
            </p>
        </div>
        <div class="text-muted small d-flex align-items-center gap-3">
            <span>
                <span class="ripple"></span>
                <span class="ms-2">Actualizado há <span id="secondsAgo">0</span>s</span>
            </span>
            <span>
                <i class="bi bi-calendar3 me-1"></i>
                @DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"))
            </span>
        </div>
    </div>

    <!-- KPIs principais -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm kpi-tile kpi-blue h-100">
                <div class="card-body">
                    <i class="bi bi-airplane fs-2"></i>
                    <h3 class="fw-bold mb-0 mt-2 counter" data-target="@ViewBag.TotalFlights">0</h3>
                    <small>Total de Voos</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm kpi-tile kpi-green h-100">
                <div class="card-body">
                    <i class="bi bi-play-circle-fill fs-2"></i>
                    <h3 class="fw-bold mb-0 mt-2 counter" data-target="@ViewBag.ActiveFlights">0</h3>
                    <small>Voos Activos</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm kpi-tile kpi-purple h-100">
                <div class="card-body">
                    <i class="bi bi-ticket-perforated-fill fs-2"></i>
                    <h3 class="fw-bold mb-0 mt-2 counter" data-target="@ViewBag.TotalTickets">0</h3>
                    <small>Bilhetes Vendidos</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm kpi-tile kpi-orange h-100">
                <div class="card-body">
                    <i class="bi bi-cash-coin fs-2"></i>
                    <h3 class="fw-bold mb-0 mt-2">
                        @(((decimal)ViewBag.TotalRevenue).ToString("C0", new System.Globalization.CultureInfo("pt-PT")))
                    </h3>
                    <small>Receita Total</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm kpi-tile kpi-teal h-100">
                <div class="card-body">
                    <i class="bi bi-people-fill fs-2"></i>
                    <h3 class="fw-bold mb-0 mt-2">@ViewBag.OccupancyRate%</h3>
                    <small>Ocupação Média</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm kpi-tile kpi-red h-100">
                <div class="card-body">
                    <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                    <h3 class="fw-bold mb-0 mt-2">
                        @(((int)ViewBag.DelayedFlights + (int)ViewBag.CancelledFlights))
                    </h3>
                    <small>Perturbados</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Operações -->
    <h5 class="section-title">
        <i class="bi bi-grid-3x3-gap-fill me-1"></i>Operações
    </h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a asp-controller="CheckIn" asp-action="EmployeeCheckIn" class="menu-card h-100">
                <div class="menu-icon bg-success-subtle text-success">
                    <i class="bi bi-person-check"></i>
                </div>
                <div class="menu-info">
                    <strong>Check-in Presencial</strong>
                    <small>Balcão de check-in</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Home" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-primary-subtle text-primary">
                    <i class="bi bi-display"></i>
                </div>
                <div class="menu-info">
                    <strong>Painel de Voos</strong>
                    <small>Ecrã público</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Shop" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-info-subtle text-info">
                    <i class="bi bi-shop"></i>
                </div>
                <div class="menu-info">
                    <strong>Loja</strong>
                    <small>Bilhetes e vendas</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Forum" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-danger-subtle text-danger">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Fórum</strong>
                    <small>Discussão interna</small>
                </div>
            </a>
        </div>
    </div>

    <!-- Gestão do Sistema -->
    <h5 class="section-title">
        <i class="bi bi-gear-fill me-1"></i>Gestão do Sistema
    </h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a asp-controller="Airline" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-primary-subtle text-primary">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Companhias</strong>
                    <small>Gerir companhias</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Airports" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-success-subtle text-success">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Aeroportos</strong>
                    <small>Origens e destinos</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Gate" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-warning-subtle text-warning">
                    <i class="bi bi-door-open-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Gates</strong>
                    <small>Portões</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Aircraft" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-info-subtle text-info">
                    <i class="bi bi-airplane-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Aeronaves</strong>
                    <small>Frota</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Flight" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-primary-subtle text-primary">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div class="menu-info">
                    <strong>Voos</strong>
                    <small>Gerir voos</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="User" asp-action="Index" class="menu-card h-100">
                <div class="menu-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Utilizadores</strong>
                    <small>Todos os perfis</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="User" asp-action="Create" class="menu-card h-100">
                <div class="menu-icon bg-success-subtle text-success">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Criar Utilizador</strong>
                    <small>Adicionar staff</small>
                </div>
            </a>
        </div>
       
        <div class="col-6 col-md-3">
            <a asp-controller="Flight" asp-action="ExportXml" class="menu-card h-100">
                <div class="menu-icon bg-info-subtle text-info">
                    <i class="bi bi-file-earmark-xml-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Exportar XML</strong>
                    <small>Voos</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Flight" asp-action="ExportPdf" class="menu-card h-100">
                <div class="menu-icon bg-danger-subtle text-danger">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                </div>
                <div class="menu-info">
                    <strong>Exportar PDF</strong>
                    <small>Voos</small>
                </div>
            </a>
        </div>
    </div>

    <!-- Estatísticas -->
    <h5 class="section-title">
        <i class="bi bi-graph-up-arrow me-1"></i>Estatísticas
    </h5>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-airplane-engines me-2 text-primary"></i>Voos por Companhia
                    </h5>
                    <div class="chart-wrap">
                        <canvas id="chartAirlines"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-pie-chart-fill me-2 text-success"></i>Voos por Estado
                    </h5>
                    <div class="chart-wrap">
                        <canvas id="chartStatus"></canvas>
                    </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-cash-stack me-2 text-warning"></i>Receita por Mês
                            <small class="text-muted ms-2">(últimos 12 meses)</small>
                    </h5>
                        <div class="chart-wrap-sm">
                            <canvas id="chartRevenue"></canvas>
                        </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-trophy-fill me-2 text-warning"></i>Top 5 Rotas
                    </h5>
                    <ul class="list-group list-group-flush" id="topRoutesList"></ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-bar-chart-line-fill me-2 text-success"></i>Receita por Companhia Aérea
            </h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Companhia</th>
                            <th class="text-center">Bilhetes</th>
                            <th class="text-end">Receita</th>
                            <th>Quota de Mercado</th>
                        </tr>
                    </thead>
                    <tbody id="revenueByAirlineBody">
                        <!-- Preenchido via JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // ---- Contador "actualizado há Xs" ----
        var seconds = 0;
        setInterval(function () {
            seconds++;
            var el = document.getElementById("secondsAgo");
            if (el) el.textContent = seconds;
        }, 1000);

        // ---- Count-up KPIs ----
        document.querySelectorAll('.counter').forEach(function (counter) {
            var target = parseInt(counter.getAttribute('data-target')) || 0;
            var current = 0;
            var step = Math.max(1, Math.ceil(target / 30));
            var interval = setInterval(function () {
                current += step;
                if (current >= target) {
                    current = target;
                    clearInterval(interval);
                }
                counter.textContent = current.toLocaleString('pt-PT');
            }, 30);
        });

        // ---- Dados do servidor ----
        var airlinesData   = @Html.Raw(ViewBag.FlightsByAirline);
        var statusData     = @Html.Raw(ViewBag.FlightsByStatus);
        var revenueMonth   = @Html.Raw(ViewBag.RevenueByMonth);
        var topRoutes      = @Html.Raw(ViewBag.TopRoutes);
        var revenueAirline = @Html.Raw(ViewBag.RevenueByAirline);

        // ---- Gráfico 1: Voos por Companhia ----
        new Chart(document.getElementById('chartAirlines'), {
            type: 'bar',
            data: {
                labels: airlinesData.map(function (x) { return x.label; }),
                datasets: [{
                    label: 'Nº de Voos',
                    data: airlinesData.map(function (x) { return x.count; }),
                    backgroundColor: '#1F5C99',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // ---- Gráfico 2: Voos por Estado ----
        new Chart(document.getElementById('chartStatus'), {
            type: 'doughnut',
            data: {
                labels: statusData.map(function (x) { return x.label; }),
                datasets: [{
                    data: statusData.map(function (x) { return x.count; }),
                    backgroundColor: ['#0d3d6b','#1F5C99','#ffc107','#dc3545','#198754','#6c757d','#6f42c1']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // ---- Gráfico 3: Receita por Mês ----
        if (revenueMonth && revenueMonth.length > 0) {
            new Chart(document.getElementById('chartRevenue'), {
                type: 'line',
                data: {
                    labels: revenueMonth.map(function (x) {
                        var parts = x.label.split('-');
                        return parts[1] + '/' + parts[0].slice(2);
                    }),
                    datasets: [{
                        label: 'Receita (€)',
                        data: revenueMonth.map(function (x) { return x.total; }),
                        borderColor: '#fd7e14',
                        backgroundColor: 'rgba(253, 126, 20, 0.15)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 5,
                        pointBackgroundColor: '#fd7e14'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (v) {
                                    return v.toLocaleString('pt-PT') + '€';
                                }
                            }
                        }
                    }
                }
            });
        } else {
            document.getElementById('chartRevenue').parentElement.innerHTML =
                '<p class="text-muted text-center py-4">Sem dados de receita nos últimos 12 meses.</p>';
        }

        // ---- Tabela Top 5 Rotas ----
        var topRoutesList = document.getElementById('topRoutesList');
        if (topRoutes && topRoutes.length > 0) {
            topRoutes.forEach(function (r, i) {
                var li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center px-0';
                li.innerHTML =
                    '<div>' +
                      '<span class="badge bg-primary me-2">#' + (i + 1) + '</span>' +
                      '<strong>' + r.rota + '</strong><br />' +
                      '<small class="text-muted">' + r.origem + ' → ' + r.destino + '</small>' +
                    '</div>' +
                    '<span class="badge bg-success rounded-pill">' + r.voos + ' voos</span>';
                topRoutesList.appendChild(li);
            });
        } else {
            topRoutesList.innerHTML = '<li class="list-group-item text-muted text-center">Sem dados disponíveis.</li>';
        }

        // ---- Tabela Receita por Companhia ----
        var revenueBody = document.getElementById('revenueByAirlineBody');
        if (revenueAirline && revenueAirline.length > 0) {
            var totalGeral = revenueAirline.reduce(function (s, x) { return s + x.receita; }, 0);
            revenueAirline.forEach(function (r, i) {
                var quota = totalGeral > 0 ? ((r.receita / totalGeral) * 100).toFixed(1) : 0;
                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td>' + (i + 1) + '</td>' +
                    '<td><strong>' + r.companhia + '</strong></td>' +
                    '<td class="text-center"><span class="badge bg-info">' + r.bilhetes + '</span></td>' +
                    '<td class="text-end fw-bold">' +
                        r.receita.toLocaleString('pt-PT', { style: 'currency', currency: 'EUR' }) +
                    '</td>' +
                    '<td>' +
                        '<div class="progress" style="height: 8px;">' +
                          '<div class="progress-bar bg-success" style="width: ' + quota + '%"></div>' +
                        '</div>' +
                        '<small class="text-muted">' + quota + '%</small>' +
                    '</td>';
                revenueBody.appendChild(tr);
            });
        } else {
            revenueBody.innerHTML =
                '<tr><td colspan="5" class="text-muted text-center">Sem dados de receita disponíveis.</td></tr>';
        }
    </script>
}