@model LisAeroGest.Models.AdminDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Administrativo";
    var culture = new System.Globalization.CultureInfo("pt-PT");
}

<link rel="stylesheet" href="~/css/adminDashboard.css" asp-append-version="true" />

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item active">Dashboard Administrativo</li>
    </ol>
</nav>

<div class="container-fluid mt-2 mb-5">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-white">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard Administrativo
            </h2>
            <p class="text-muted mb-0">
                Visão geral da operação e da gestão do aeroporto —
                <strong class="text-white">@Model.AdminName</strong>
                <span class="badge bg-primary ms-1">Administrador</span>
            </p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="toggleAllGroups()">
                <i class="bi bi-arrows-collapse me-1" id="toggleAllIcon"></i>
                <span id="toggleAllText">Colapsar Tudo</span>
            </button>
            <div class="text-muted small">
                <i class="bi bi-calendar3 me-1"></i>
                Última atualização: @Model.LastUpdated.ToString("dd/MM/yyyy — HH:mm")
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (Model.Alerts.Any())
    {
        <div class="row g-3 mb-4">
            @foreach (var alert in Model.Alerts)
            {
                var alertClass = alert.Severity switch
                {
                    "danger" => "alert-danger",
                    "warning" => "alert-warning",
                    _ => "alert-info"
                };
                <div class="col-md-6">
                    <div class="alert @alertClass d-flex align-items-start mb-0 shadow-sm">
                        <i class="bi @alert.Icon fs-4 me-3"></i>
                        <div class="flex-grow-1">
                            <strong>@alert.Title</strong>
                            <p class="mb-0 small">@alert.Message</p>
                        </div>
                        @if (!string.IsNullOrEmpty(alert.Link))
                        {
                            <a href="@alert.Link" class="btn btn-sm btn-outline-dark ms-2">Ver</a>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- KPIs -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center cursor-pointer"
             data-bs-toggle="collapse" data-bs-target="#groupKPIs" aria-expanded="true">
            <h5 class="mb-0 fw-bold text-primary">
                <i class="bi bi-graph-up me-2"></i>Resumo de Indicadores (KPIs)
            </h5>
            <i class="bi bi-chevron-up collapse-icon"></i>
        </div>
        <div id="groupKPIs" class="collapse show">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm kpi-tile kpi-blue h-100">
                            <div class="card-body text-center">
                                <i class="bi bi-airplane-fill fs-2"></i>
                                <h3 class="fw-bold mb-0 mt-2 counter" data-target="@Model.TotalFlights">0</h3>
                                <small>Total de Voos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm kpi-tile kpi-green h-100">
                            <div class="card-body text-center">
                                <i class="bi bi-play-circle-fill fs-2"></i>
                                <h3 class="fw-bold mb-0 mt-2 counter" data-target="@Model.ActiveFlights">0</h3>
                                <small>Em Operação</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm kpi-tile kpi-orange h-100">
                            <div class="card-body text-center">
                                <i class="bi bi-clock-history fs-2"></i>
                                <h3 class="fw-bold mb-0 mt-2 counter" data-target="@Model.DelayedFlights">0</h3>
                                <small>Atrasados</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm kpi-tile kpi-red h-100">
                            <div class="card-body text-center">
                                <i class="bi bi-x-circle-fill fs-2"></i>
                                <h3 class="fw-bold mb-0 mt-2 counter" data-target="@Model.CancelledFlights">0</h3>
                                <small>Cancelados</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm kpi-tile kpi-purple h-100">
                            <div class="card-body text-center">
                                <i class="bi bi-ticket-perforated-fill fs-2"></i>
                                <h3 class="fw-bold mb-0 mt-2 counter" data-target="@Model.TotalTickets">0</h3>
                                <small>Bilhetes Vendidos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm kpi-tile kpi-teal h-100">
                            <div class="card-body text-center">
                                <i class="bi bi-cash-coin fs-2"></i>
                                <h3 class="fw-bold mb-0 mt-2" style="font-size:1.15rem;">
                                    @Model.TotalRevenue.ToString("C0", culture)
                                </h3>
                                <small>Receita Total</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="card border-0 bg-light h-100">
                            <div class="card-body d-flex align-items-center gap-3">
                                <i class="bi bi-people-fill fs-2 text-primary"></i>
                                <div>
                                    <div class="fw-bold fs-5 text-white">@Model.OccupancyRate%</div>
                                    <small class="text-muted">Taxa média de ocupação (@Model.OccupiedSeats / @Model.TotalSeats lugares)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gestão do Sistema -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center cursor-pointer"
             data-bs-toggle="collapse" data-bs-target="#groupManagement" aria-expanded="true">
            <h5 class="mb-0 fw-bold text-success">
                <i class="bi bi-gear-fill me-2"></i>Gestão do Sistema
            </h5>
            <i class="bi bi-chevron-up collapse-icon"></i>
        </div>
        <div id="groupManagement" class="collapse show">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <a asp-controller="Flights" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-primary-subtle text-primary"><i class="bi bi-calendar3"></i></div>
                            <div class="menu-info"><strong>Voos</strong><small>Gerir voos</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Airline" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-success-subtle text-success"><i class="bi bi-building"></i></div>
                            <div class="menu-info"><strong>Companhias</strong><small>Companhias aéreas</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Aircraft" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-info-subtle text-info"><i class="bi bi-airplane-fill"></i></div>
                            <div class="menu-info"><strong>Aeronaves</strong><small>Frota</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Gate" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-warning-subtle text-warning"><i class="bi bi-door-open-fill"></i></div>
                            <div class="menu-info"><strong>Gates</strong><small>Portões de embarque</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Airports" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-success-subtle text-success"><i class="bi bi-geo-alt-fill"></i></div>
                            <div class="menu-info"><strong>Aeroportos</strong><small>Origens e destinos</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="User" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-secondary-subtle text-secondary"><i class="bi bi-people-fill"></i></div>
                            <div class="menu-info"><strong>Utilizadores</strong><small>Gestão de contas</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Tickets" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-info-subtle text-info"><i class="bi bi-ticket-perforated"></i></div>
                            <div class="menu-info"><strong>Bilhetes</strong><small>Reservas e vendas</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Forum" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-info-subtle text-info"><i class="bi bi-chat-dots-fill"></i></div>
                            <div class="menu-info"><strong>Fórum</strong><small>Discussões internas</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Forum" asp-action="PendingComments" class="menu-card h-100">
                            <div class="menu-icon bg-warning-subtle text-warning"><i class="bi bi-hourglass-split"></i></div>
                            <div class="menu-info"><strong>Moderação</strong><small>Comentários pendentes</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Notification" asp-action="Index" class="menu-card h-100">
                            <div class="menu-icon bg-danger-subtle text-danger"><i class="bi bi-bell-fill"></i></div>
                            <div class="menu-info"><strong>Notificações</strong><small>Alertas do sistema</small></div>
                        </a>
                    </div>
                </div>

                <hr class="my-3" />

                <h6 class="text-muted text-uppercase small mb-3">Relatórios e Exportação</h6>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <a asp-controller="Flights" asp-action="ExportPdf" class="menu-card h-100">
                            <div class="menu-icon bg-danger-subtle text-danger"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                            <div class="menu-info"><strong>Exportar PDF</strong><small>Lista de voos</small></div>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Flights" asp-action="ExportXml" class="menu-card h-100">
                            <div class="menu-icon bg-info-subtle text-info"><i class="bi bi-file-earmark-xml-fill"></i></div>
                            <div class="menu-info"><strong>Exportar XML</strong><small>Voos e bilhetes</small></div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center cursor-pointer"
             data-bs-toggle="collapse" data-bs-target="#groupCharts" aria-expanded="true">
            <h5 class="mb-0 fw-bold text-warning">
                <i class="bi bi-bar-chart-line-fill me-2"></i>Estatísticas de Desempenho
            </h5>
            <i class="bi bi-chevron-up collapse-icon"></i>
        </div>
        <div id="groupCharts" class="collapse show">
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title text-white"><i class="bi bi-airplane-engines me-2 text-primary"></i>Voos por Companhia</h5>
                                <div class="chart-wrap"><canvas id="chartAirlines"></canvas></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title text-white"><i class="bi bi-pie-chart-fill me-2 text-success"></i>Voos por Estado</h5>
                                <div class="chart-wrap"><canvas id="chartStatus"></canvas></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title text-white">
                                    <i class="bi bi-cash-stack me-2 text-warning"></i>Receita por Mês
                                    <small class="text-muted">(últimos 12 meses)</small>
                                </h5>
                                <div class="chart-wrap-sm"><canvas id="chartRevenue"></canvas></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title text-white"><i class="bi bi-trophy-fill me-2 text-warning"></i>Top 5 Rotas</h5>
                                <ul class="list-group list-group-flush" id="topRoutesList"></ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title text-white"><i class="bi bi-bar-chart-line-fill me-2 text-success"></i>Receita por Companhia Aérea</h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Companhia</th>
                                        <th class="text-center">Bilhetes</th>
                                        <th class="text-end">Receita</th>
                                        <th>Quota de Mercado</th>
                                    </tr>
                                </thead>
                                <tbody id="revenueByAirlineBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allExpanded = true;
        function toggleAllGroups() {
            allExpanded = !allExpanded;
            document.querySelectorAll('.collapse').forEach(el => {
                const inst = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
                allExpanded ? inst.show() : inst.hide();
            });
            document.getElementById('toggleAllText').textContent = allExpanded ? "Colapsar Tudo" : "Expandir Tudo";
            document.getElementById('toggleAllIcon').className = allExpanded
                ? "bi bi-arrows-collapse me-1" : "bi bi-arrows-expand me-1";
        }

        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(header => {
            const target = document.querySelector(header.getAttribute('data-bs-target'));
            if (!target) return;
            target.addEventListener('hide.bs.collapse', () => {
                const icon = header.querySelector('.collapse-icon');
                if (icon) icon.className = "bi bi-chevron-down collapse-icon";
            });
            target.addEventListener('show.bs.collapse', () => {
                const icon = header.querySelector('.collapse-icon');
                if (icon) icon.className = "bi bi-chevron-up collapse-icon";
            });
        });

        document.querySelectorAll('.counter').forEach(function (counter) {
            var target = parseInt(counter.getAttribute('data-target')) || 0;
            var current = 0;
            var step = Math.max(1, Math.ceil(target / 30));
            var interval = setInterval(function () {
                current += step;
                if (current >= target) { current = target; clearInterval(interval); }
                counter.textContent = current.toLocaleString('pt-PT');
            }, 30);
        });

        var airlinesData   = @Html.Raw(JsonSerializer.Serialize(Model.FlightsByAirline.Select(x => new { label = x.Label, count = x.Count })));
        var statusData     = @Html.Raw(JsonSerializer.Serialize(Model.FlightsByStatus.Select(x => new { label = x.Label, count = x.Count })));
        var revenueMonth   = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByMonth.Select(x => new { label = x.Label, total = x.Total })));
        var topRoutes      = @Html.Raw(JsonSerializer.Serialize(Model.TopRoutes.Select(x => new { route = x.Route, origin = x.Origin, destination = x.Destination, flightCount = x.FlightCount })));
        var revenueAirline = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByAirline.Select(x => new { airline = x.Airline, tickets = x.Tickets, revenue = x.Revenue })));

        new Chart(document.getElementById('chartAirlines'), {
            type: 'bar',
            data: {
                labels: airlinesData.map(x => x.label),
                datasets: [{
                    label: 'Nº de Voos',
                    data: airlinesData.map(x => x.count),
                    backgroundColor: '#1F5C99',
                    borderRadius: 6
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById('chartStatus'), {
            type: 'doughnut',
            data: {
                labels: statusData.map(x => x.label),
                datasets: [{
                    data: statusData.map(x => x.count),
                    backgroundColor: ['#0d3d6b','#1F5C99','#ffc107','#dc3545','#198754','#6c757d','#6f42c1']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        if (revenueMonth && revenueMonth.length > 0) {
            new Chart(document.getElementById('chartRevenue'), {
                type: 'line',
                data: {
                    labels: revenueMonth.map(x => {
                        var parts = x.label.split('-');
                        return parts[1] + '/' + parts[0].slice(2);
                    }),
                    datasets: [{
                        label: 'Receita (€)',
                        data: revenueMonth.map(x => x.total),
                        borderColor: '#fd7e14',
                        backgroundColor: 'rgba(253, 126, 20, 0.15)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 5,
                        pointBackgroundColor: '#fd7e14'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: function (v) { return v.toLocaleString('pt-PT') + ' €'; } }
                        }
                    }
                }
            });
        } else {
            document.getElementById('chartRevenue').parentElement.innerHTML =
                '<p class="text-muted text-center py-5">Sem dados de receita nos últimos 12 meses.</p>';
        }

        var topList = document.getElementById('topRoutesList');
        if (topRoutes && topRoutes.length > 0) {
            topRoutes.forEach(function (r, i) {
                var li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center px-0';
                li.innerHTML =
                    '<div><span class="badge bg-primary me-2">' + (i + 1) + '</span>' +
                    '<strong>' + r.route + '</strong><br><small class="text-muted">' + r.origin + ' → ' + r.destination + '</small></div>' +
                    '<span class="badge bg-secondary rounded-pill">' + r.flightCount + ' voos</span>';
                topList.appendChild(li);
            });
        } else {
            topList.innerHTML = '<li class="list-group-item text-muted text-center">Sem dados de rotas.</li>';
        }

        var revenueBody = document.getElementById('revenueByAirlineBody');
        if (revenueAirline && revenueAirline.length > 0) {
            var totalGeral = revenueAirline.reduce(function (s, x) { return s + x.revenue; }, 0);
            revenueAirline.forEach(function (r, i) {
                var quota = totalGeral > 0 ? ((r.revenue / totalGeral) * 100).toFixed(1) : 0;
                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td>' + (i + 1) + '</td>' +
                    '<td><strong class="text-white">' + r.airline + '</strong></td>' +
                    '<td class="text-center"><span class="badge bg-info">' + r.tickets + '</span></td>' +
                    '<td class="text-end fw-bold">' +
                        r.revenue.toLocaleString('pt-PT', { style: 'currency', currency: 'EUR' }) +
                    '</td>' +
                    '<td>' +
                        '<div class="progress" style="height: 8px;">' +
                          '<div class="progress-bar bg-success" style="width: ' + quota + '%"></div>' +
                        '</div>' +
                        '<small class="text-muted">' + quota + '%</small>' +
                    '</td>';
                revenueBody.appendChild(tr);
            });
        } else {
            revenueBody.innerHTML = '<tr><td colspan="5" class="text-muted text-center">Sem dados de receita disponíveis.</td></tr>';
        }
    </script>
}