@model LisAeroGest.Models.EmployeeDashboardViewModel
@using LisAeroGest.Helpers
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Operacional";
}

<link rel="stylesheet" href="~/css/adminDashboard.css" asp-append-version="true" />

<div class="container-fluid mt-4 mb-5">

    <!-- ═══ CABEÇALHO ═══ -->
    <div class="ed-header mb-4">
        <div>
            <h2 class="ed-title">
                <i class="bi bi-person-badge text-lime me-2"></i>Dashboard Operacional
            </h2>
            <p class="ed-subtitle">
                Operador: <strong class="text-white">@Model.EmployeeName</strong>
                <span class="ed-badge-role">Operações</span>
            </p>
        </div>
        <div class="ed-updated">
            <i class="bi bi-clock me-1"></i>
            @Model.LastUpdated.ToString("dd/MM/yyyy — HH:mm")
        </div>
    </div>

    <!-- ═══ ACESSO RÁPIDO ═══ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a asp-controller="CheckIn" asp-action="EmployeeCheckIn" class="ed-quicklink ed-quicklink-green">
                <div class="ed-quicklink-content">
                    <div>
                        <h6 class="ed-quicklink-title">Balcão Check-in</h6>
                        <small class="ed-quicklink-desc">Processar passageiros</small>
                    </div>
                    <i class="bi bi-person-check ed-quicklink-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Gate" asp-action="Index" class="ed-quicklink ed-quicklink-orange">
                <div class="ed-quicklink-content">
                    <div>
                        <h6 class="ed-quicklink-title">Gestão de Gates</h6>
                        <small class="ed-quicklink-desc">Atribuir / Alterar</small>
                    </div>
                    <i class="bi bi-door-open ed-quicklink-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Flights" asp-action="Index" class="ed-quicklink ed-quicklink-blue">
                <div class="ed-quicklink-content">
                    <div>
                        <h6 class="ed-quicklink-title">Lista de Voos</h6>
                        <small class="ed-quicklink-desc">Consultar / Atualizar</small>
                    </div>
                    <i class="bi bi-airplane ed-quicklink-icon"></i>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Forum" asp-action="Index" class="ed-quicklink ed-quicklink-purple">
                <div class="ed-quicklink-content">
                    <div>
                        <h6 class="ed-quicklink-title">Fórum Interno</h6>
                        <small class="ed-quicklink-desc">Avisos da equipa</small>
                    </div>
                    <i class="bi bi-chat-dots ed-quicklink-icon"></i>
                </div>
            </a>
        </div>
    </div>

    <!-- ═══ KPIs ═══ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="ed-kpi ed-kpi-blue">
                <span class="ed-kpi-label">Voos de Hoje</span>
                <h2 class="ed-kpi-value">@Model.TodayFlights</h2>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="ed-kpi ed-kpi-green">
                <span class="ed-kpi-label">Próxima Hora</span>
                <h2 class="ed-kpi-value">@Model.UpcomingFlights</h2>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="ed-kpi ed-kpi-orange">
                <span class="ed-kpi-label">Atrasados</span>
                <h2 class="ed-kpi-value">@Model.DelayedToday</h2>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="ed-kpi ed-kpi-red">
                <span class="ed-kpi-label">Cancelados</span>
                <h2 class="ed-kpi-value">@Model.CancelledToday</h2>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="ed-kpi ed-kpi-cyan">
                <span class="ed-kpi-label">Check-ins Pendentes</span>
                <h2 class="ed-kpi-value">@Model.PendingCheckIns</h2>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="ed-kpi ed-kpi-lime">
                <span class="ed-kpi-label">A Embarcar</span>
                <h2 class="ed-kpi-value">@Model.BoardingNow</h2>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- ═══ LISTA DE VOOS DE HOJE ═══ -->
        <div class="col-lg-8">
            <div class="ed-card h-100">
                <div class="ed-card-header">
                    <h6 class="ed-card-title">
                        <i class="bi bi-list-ul text-lime me-2"></i>Voos de Hoje
                    </h6>
                </div>
                <div class="ed-card-body p-0">
                    @if (Model.TodayFlightList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table ed-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Voo</th>
                                        <th>Companhia</th>
                                        <th>Rota</th>
                                        <th>Hora</th>
                                        <th>Gate</th>
                                        <th>Estado</th>
                                        <th class="text-center">Pax</th>
                                        <th class="text-center">Check-in</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in Model.TodayFlightList)
                                    {
                                        <tr class="@FlightStatusHelper.GetRowClass(f.Status)">
                                            <td><strong class="text-white">@f.FlightNumber</strong></td>
                                            <td class="text-muted">@f.AirlineName</td>
                                            <td>
                                                <span class="ed-badge-code">@f.OriginCode</span>
                                                <i class="bi bi-arrow-right mx-1 small text-lime"></i>
                                                <span class="ed-badge-code">@f.DestinationCode</span>
                                            </td>
                                            <td>
                                                @if (f.DelayedDepartureTime.HasValue && f.Status == "Delayed")
                                                {
                                                    <span class="text-decoration-line-through text-muted small">
                                                        @f.DepartureTime.ToString("HH:mm")
                                                    </span>
                                                    <br />
                                                    <strong class="text-warning">
                                                        @f.DelayedDepartureTime.Value.ToString("HH:mm")
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <span class="text-white">@f.DepartureTime.ToString("HH:mm")</span>
                                                }
                                            </td>
                                            <td class="text-white">@(f.GateNumber ?? "—")</td>
                                            <td>
                                                <span class="badge @FlightStatusHelper.GetBadgeClass(f.Status)">
                                                    @FlightStatusHelper.GetStatusText(f.Status)
                                                </span>
                                            </td>
                                            <td class="text-center text-white">@f.PassengerCount</td>
                                            <td class="text-center">
                                                @if (f.PendingCheckInCount > 0)
                                                {
                                                    <span class="badge bg-warning text-dark">@f.PendingCheckInCount</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="ed-empty">
                            <i class="bi bi-calendar-x"></i>
                            <p class="mb-0">Não existem voos programados para hoje.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ═══ GRÁFICO + NOTIFICAÇÕES ═══ -->
        <div class="col-lg-4">

            <!-- Gráfico -->
            <div class="ed-card mb-3">
                <div class="ed-card-body">
                    <h6 class="ed-card-title mb-3">Distribuição por Estado</h6>
                    <div class="ed-chart-wrapper">
                        <canvas id="chartStatus"></canvas>
                    </div>
                </div>
            </div>

            <!-- Notificações -->
            <div class="ed-card">
                <div class="ed-card-header ed-card-header-flex">
                    <h6 class="ed-card-title mb-0">
                        <i class="bi bi-bell-fill text-warning me-2"></i>Alertas do Turno
                        @if (Model.UnreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-1">@Model.UnreadCount novos</span>
                        }
                    </h6>
                    <a asp-controller="Notification" asp-action="Index" class="btn btn-sm btn-outline-lime">
                        Ver todas
                    </a>
                </div>
                <div class="ed-card-body p-0">
                    @if (Model.RecentNotifications.Any())
                    {
                        <div class="ed-notif-list">
                            @foreach (var notification in Model.RecentNotifications)
                            {
                                <div class="ed-notif-item @(notification.IsRead ? "opacity-75" : "")">
                                    <div class="ed-notif-icon">
                                        <i class="bi @notification.Icon @notification.ColorClass"></i>
                                    </div>
                                    <div class="ed-notif-body">
                                        <div class="ed-notif-header">
                                            <h6 class="ed-notif-title @(notification.IsRead ? "" : "fw-bold")">
                                                @if (!notification.IsRead)
                                                {
                                                    <span class="badge bg-primary me-1">NOVO</span>
                                                }
                                                @notification.Title
                                            </h6>
                                            <span class="ed-notif-time">
                                                @notification.CreatedAt.ToString("HH:mm")
                                            </span>
                                        </div>
                                        <p class="ed-notif-message">@notification.Message</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ed-empty">
                            <i class="bi bi-check-circle text-success"></i>
                            <p class="mb-0">Sem alertas pendentes para o seu turno.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var statusData = @Html.Raw(JsonSerializer.Serialize(
                    Model.FlightsByStatus.Select(x => new { label = x.Label, count = x.Count })
            ));

    new Chart(document.getElementById('chartStatus'), {
        type: 'doughnut',
        data: {
            labels: statusData.map(x => x.label),
            datasets: [{
                data: statusData.map(x => x.count),
                backgroundColor: ['#60a5fa', '#0dcaf0', '#86efac', '#c084fc', '#fde047', '#fca5a5'],
                borderColor: '#111827',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#e2e8f0',
                        padding: 12,
                        font: { size: 11 }
                    }
                }
            }
        }
    });
</script>
}