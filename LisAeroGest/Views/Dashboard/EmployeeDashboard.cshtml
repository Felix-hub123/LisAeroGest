@model LisAeroGest.Models.EmployeeDashboardViewModel
@using LisAeroGest.Helpers
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Operacional";
}

<link rel="stylesheet" href="~/css/adminDashboard.css" asp-append-version="true" />

<div class="container-fluid mt-4 mb-5">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-person-badge text-primary me-2"></i>Dashboard Operacional
            </h2>
            <p class="text-muted mb-0">
                Operador: <strong>@Model.EmployeeName</strong>
                <span class="badge bg-primary ms-2">Operações</span>
            </p>
        </div>
        <div class="text-end text-muted small">
            <i class="bi bi-clock me-1"></i>
            @Model.LastUpdated.ToString("dd/MM/yyyy — HH:mm")
        </div>
    </div>

    <!-- Acesso Rápido -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a asp-controller="CheckIn" asp-action="EmployeeCheckIn"
               class="card text-decoration-none shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="fw-bold mb-1">Balcão Check-in</h6>
                        <small class="opacity-75">Processar passageiros</small>
                    </div>
                    <i class="bi bi-person-check fs-1"></i>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Gate" asp-action="Index"
               class="card text-decoration-none shadow-sm border-0 bg-warning text-dark h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="fw-bold mb-1">Gestão de Gates</h6>
                        <small class="opacity-75">Atribuir / Alterar</small>
                    </div>
                    <i class="bi bi-door-open fs-1"></i>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Flights" asp-action="Index"
               class="card text-decoration-none shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="fw-bold mb-1">Lista de Voos</h6>
                        <small class="opacity-75">Consultar / Atualizar</small>
                    </div>
                    <i class="bi bi-airplane fs-1"></i>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Forum" asp-action="Index"
               class="card text-decoration-none shadow-sm border-0 bg-dark text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="fw-bold mb-1">Fórum Interno</h6>
                        <small class="opacity-75">Avisos da equipa</small>
                    </div>
                    <i class="bi bi-chat-dots fs-1"></i>
                </div>
            </a>
        </div>
    </div>

    <!-- KPIs do dia -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-bold text-uppercase">Voos de Hoje</span>
                    <h2 class="fw-bold my-1 text-primary">@Model.TodayFlights</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-bold text-uppercase">Próxima Hora</span>
                    <h2 class="fw-bold my-1 text-success">@Model.UpcomingFlights</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-bold text-uppercase">Atrasados</span>
                    <h2 class="fw-bold my-1 text-warning">@Model.DelayedToday</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-bold text-uppercase">Cancelados</span>
                    <h2 class="fw-bold my-1 text-danger">@Model.CancelledToday</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-bold text-uppercase">Check-ins Pendentes</span>
                    <h2 class="fw-bold my-1 text-info">@Model.PendingCheckIns</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-bold text-uppercase">A Embarcar</span>
                    <h2 class="fw-bold my-1 text-secondary">@Model.BoardingNow</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Lista de voos de hoje -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-list-ul me-2 text-primary"></i>Voos de Hoje
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.TodayFlightList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Voo</th>
                                        <th>Companhia</th>
                                        <th>Rota</th>
                                        <th>Hora</th>
                                        <th>Gate</th>
                                        <th>Estado</th>
                                        <th class="text-center">Pax</th>
                                        <th class="text-center">Check-in</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in Model.TodayFlightList)
                                    {
                                        <tr class="@FlightStatusHelper.GetRowClass(f.Status)">
                                            <td><strong>@f.FlightNumber</strong></td>
                                            <td>@f.AirlineName</td>
                                            <td>
                                                <span class="badge bg-secondary">@f.OriginCode</span>
                                                <i class="bi bi-arrow-right mx-1 small"></i>
                                                <span class="badge bg-secondary">@f.DestinationCode</span>
                                            </td>
                                            <td>
                                                @if (f.DelayedDepartureTime.HasValue && f.Status == "Delayed")
                                                {
                                                    <span class="text-decoration-line-through text-muted small">
                                                        @f.DepartureTime.ToString("HH:mm")
                                                    </span>
                                                    <br />
                                                    <strong class="text-warning">
                                                        @f.DelayedDepartureTime.Value.ToString("HH:mm")
                                                    </strong>
                                                }
                                                else
                                                {
                                                    @f.DepartureTime.ToString("HH:mm")
                                                }
                                            </td>
                                            <td>@(f.GateNumber ?? "—")</td>
                                            <td>
                                                <span class="badge @FlightStatusHelper.GetBadgeClass(f.Status)">
                                                    @FlightStatusHelper.GetStatusText(f.Status)
                                                </span>
                                            </td>
                                            <td class="text-center">@f.PassengerCount</td>
                                            <td class="text-center">
                                                @if (f.PendingCheckInCount > 0)
                                                {
                                                    <span class="badge bg-warning text-dark">@f.PendingCheckInCount</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                            Não existem voos programados para hoje.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Gráfico + Notificações -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <h6 class="fw-bold card-title mb-3">Distribuição por Estado</h6>
                    <div style="max-height: 220px;" class="d-flex justify-content-center">
                        <canvas id="chartStatus"></canvas>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-bell-fill text-warning me-2"></i>Alertas do Turno
                        @if (Model.UnreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-1">@Model.UnreadCount novos</span>
                        }
                    </h6>
                    <a asp-controller="Notification" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        Ver todas
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentNotifications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.RecentNotifications)
                            {
                                <div class="list-group-item d-flex gap-3 py-3 align-items-start @(notification.IsRead ? "bg-light opacity-75" : "")">
                                    <div class="flex-shrink-0">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center mt-1"
                                             style="width: 36px; height: 36px; background: #f8f9fa;">
                                            <i class="bi @notification.Icon @notification.ColorClass fs-5"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="mb-1 @(notification.IsRead ? "" : "fw-bold") small">
                                                @if (!notification.IsRead)
                                                {
                                                    <span class="badge bg-primary me-1">NOVO</span>
                                                }
                                                @notification.Title
                                            </h6>
                                            <span class="text-muted" style="font-size: 0.7rem;">
                                                @notification.CreatedAt.ToString("HH:mm")
                                            </span>
                                        </div>
                                        <p class="mb-0 small text-secondary">@notification.Message</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle text-success fs-1 d-block mb-2"></i>
                            Sem alertas pendentes para o seu turno.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var statusData = @Html.Raw(JsonSerializer.Serialize(
                    Model.FlightsByStatus.Select(x => new { label = x.Label, count = x.Count })
            ));

    new Chart(document.getElementById('chartStatus'), {
        type: 'doughnut',
        data: {
            labels: statusData.map(x => x.label),
            datasets: [{
                data: statusData.map(x => x.count),
                backgroundColor: ['#0d6efd', '#0dcaf0', '#198754', '#6c757d', '#ffc107', '#dc3545']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}