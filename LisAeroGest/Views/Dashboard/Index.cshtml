@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill text-warning" style="font-size: 4rem;"></i>
                    </div>

                    <h2 class="fw-bold mb-3 text-white">Acesso Restrito</h2>
                    <p class="text-muted mb-4">
                        Faça login para aceder ao dashboard.
                    </p>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sessão
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>