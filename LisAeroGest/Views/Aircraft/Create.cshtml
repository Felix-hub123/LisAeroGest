@using LisAeroGest.Data.Interfaces
@inject IImageHelper ImageHelper
@model LisAeroGest.Models.AircraftViewModel

@{
    ViewData["Title"] = "Nova Aeronave";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Aircraft" asp-action="Index">Aeronaves</a></li>
        <li class="breadcrumb-item active">Nova</li>
    </ol>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <!-- Cabeçalho & Botão Voltar -->
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3" title="Voltar à lista">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-airplane-fill text-info me-2"></i>Nova Aeronave
                </h2>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Fabricante (Dropdown) e Modelo (Dropdown Encadeado) -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Brand" class="form-label fw-semibold">Fabricante / Marca</label>
                                <select asp-for="Brand" asp-items="Model.Brands" id="brandSelect" class="form-select">
                                    <option value="">-- Selecione o Fabricante --</option>
                                </select>
                                <span asp-validation-for="Brand" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Model" class="form-label fw-semibold">Modelo</label>
                                <select asp-for="Model" asp-items="Model.Models" id="modelSelect" class="form-select">
                                    <option value="">-- Selecione o Modelo --</option>
                                </select>
                                <span asp-validation-for="Model" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Configuração de Lugares -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EconomySeats" class="form-label fw-semibold">Lugares Económicos</label>
                                <input asp-for="EconomySeats" class="form-control" type="number" min="0" max="800" placeholder="Ex: 150" />
                                <span asp-validation-for="EconomySeats" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BusinessSeats" class="form-label fw-semibold">Lugares Executivos</label>
                                <input asp-for="BusinessSeats" class="form-control" type="number" min="0" max="200" placeholder="Ex: 20" />
                                <span asp-validation-for="BusinessSeats" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Disponibilidade Operacional -->
                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" role="switch" id="isAvailableSwitch" checked />
                            <label class="form-check-label fw-semibold" for="isAvailableSwitch">
                                Disponível para operar voos
                            </label>
                        </div>

                        <!-- Upload de Imagem e Pré-visualização -->
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                <i class="bi bi-image me-1"></i>Fotografia da Aeronave
                            </label>
                            <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>

                            <div class="mt-3 text-center text-md-start">
                                <img id="imagePreview"
                                     src="@ImageHelper.GetImageUrl(Guid.Empty, "aircraft")"
                                     alt="Pré-visualização da Imagem"
                                     class="rounded border shadow-sm"
                                     style="height: 140px; width: 220px; object-fit: cover;" />
                            </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="d-flex gap-2 pt-2 border-top">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Registar Aeronave
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                                <i class="bi bi-x-lg me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Carregamento dinâmico dos modelos via AJAX com base na marca selecionada
        document.getElementById('brandSelect').addEventListener('change', function () {
            var selectedBrand = this.value;
            var modelSelect = document.getElementById('modelSelect');

            // Limpa o dropdown de modelos
            modelSelect.innerHTML = '<option value="">-- Selecione o Modelo --</option>';

            if (selectedBrand) {
                fetch(`@Url.Action("GetModelsByBrand", "Aircraft")?brand=${encodeURIComponent(selectedBrand)}`)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(function (item) {
                            var option = document.createElement('option');
                            option.value = item.value;
                            option.text = item.text;
                            if (item.selected) {
                                option.selected = true;
                            }
                            modelSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Erro ao carregar os modelos:', error));
            }
        });

        // Função para pré-visualização dinâmica da imagem enviada
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagePreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}