@using LisAeroGest.Data.Interfaces
@model LisAeroGest.Data.Entities.Aircraft
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Eliminar Aeronave";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Aircraft" asp-action="Index">Aeronaves</a></li>
        <li class="breadcrumb-item active">Eliminar</li>
    </ol>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <!-- Alerta -->
            <div class="alert alert-danger d-flex align-items-center gap-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <div>
                    <strong>Atenção!</strong> Esta ação não pode ser revertida.
                </div>
            </div>

            <!-- Card de confirmação -->
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-trash-fill me-2"></i>Confirmar Eliminação
                    </h4>
                </div>

                <div class="card-body">
                    <div class="text-center mb-4">
                        <img src="@ImageHelper.GetImageUrl(Model.ImageId, "aircraft")"
                             alt="@Model.Brand @Model.Model"
                             class="rounded shadow-sm mb-3"
                             style="height:140px; width:220px; object-fit:cover;" />
                        <h5>@Model.Brand @Model.Model</h5>
                        <p class="text-muted mb-0">
                            <span class="badge bg-secondary">@Model.TotalCapacity lugares</span>
                            @if (Model.IsAvailable)
                            {
                                <span class="badge bg-success ms-1">Disponível</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-1">Indisponível</span>
                            }
                        </p>
                    </div>

                    <p class="text-center">
                        Tem a certeza que deseja eliminar esta aeronave da frota?
                    </p>

                    <!-- Detalhes -->
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Marca</span>
                            <strong>@Model.Brand</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Modelo</span>
                            <strong>@Model.Model</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Lugares Económicos</span>
                            <strong>@Model.EconomySeats</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Lugares Executivos</span>
                            <strong>@Model.BusinessSeats</strong>
                        </li>
                    </ul>
                </div>

                <div class="card-footer bg-white d-flex gap-2">
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>Sim, eliminar
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>