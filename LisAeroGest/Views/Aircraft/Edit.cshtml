@using LisAeroGest.Data.Interfaces
@inject IImageHelper ImageHelper
@model LisAeroGest.Models.AircraftViewModel

@{
    ViewData["Title"] = "Editar Aeronave";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Aircraft" asp-action="Index">Aeronaves</a></li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>
</nav>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <!-- Cabeçalho & Botão Voltar -->
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3" title="Voltar à lista">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-pencil-fill text-warning me-2"></i>Editar Aeronave
                </h2>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Fabricante e Modelo (Imutáveis - Apenas Leitura) -->
                        <div class="p-3 bg-light rounded border mb-4">
                            <h6 class="text-muted fw-bold mb-3">
                                <i class="bi bi-lock-fill me-1"></i>Identificação da Aeronave (Imutável)
                            </h6>
                            <div class="row">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label class="form-label fw-semibold">Fabricante / Marca</label>
                                    <input type="text" class="form-control" value="@Model.Brand" disabled />
                                </div>
                                <div class="col-md-6 mb-0">
                                    <label class="form-label fw-semibold">Modelo</label>
                                    <input type="text" class="form-control" value="@Model.Model" disabled />
                                </div>
                            </div>
                        </div>

                        <!-- Configuração de Lugares -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EconomySeats" class="form-label fw-semibold">Lugares Económicos</label>
                                <input asp-for="EconomySeats" class="form-control" type="number" min="0" max="800" />
                                <span asp-validation-for="EconomySeats" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BusinessSeats" class="form-label fw-semibold">Lugares Executivos</label>
                                <input asp-for="BusinessSeats" class="form-control" type="number" min="0" max="200" />
                                <span asp-validation-for="BusinessSeats" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Disponibilidade Operacional -->
                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" role="switch" id="isAvailableSwitch" />
                            <label class="form-check-label fw-semibold" for="isAvailableSwitch">
                                Disponível para operar voos
                            </label>
                        </div>

                        <!-- Upload de Imagem e Pré-visualização -->
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                <i class="bi bi-image me-1"></i>Alterar Fotografia
                            </label>
                            <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>

                            <div class="mt-3 text-center text-md-start">
                                <img id="imagePreview"
                                     src="@ImageHelper.GetImageUrl(Model.ImageId, "aircraft")"
                                     alt="Fotografia Atual"
                                     class="rounded border shadow-sm"
                                     style="height: 140px; width: 220px; object-fit: cover;" />
                            </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="d-flex gap-2 pt-2 border-top">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-2"></i>Guardar Alterações
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                                <i class="bi bi-x-lg me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Pré-visualização dinâmica da imagem enviada
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagePreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
