@using LisAeroGest.Data.Interfaces
@model IEnumerable<LisAeroGest.Data.Entities.Aircraft>
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Aeronaves — Frota";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item active">Aeronaves</li>
    </ol>
</nav>

<div class="container-fluid mt-2">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-airplane-fill text-info me-2"></i>Aeronaves
            </h2>
            <span class="text-muted small">@Model.Count() aeronaves na frota</span>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Nova Aeronave
        </a>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabela -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-airplane fs-1 d-block mb-2"></i>
                    Nenhuma aeronave registada na frota.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Foto</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th class="text-center">Económica</th>
                                <th class="text-center">Executiva</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end pe-3">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aircraft in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <img src="@ImageHelper.GetImageUrl(aircraft.ImageId, "aircraft")"
                                             alt="@aircraft.Brand @aircraft.Model"
                                             class="rounded"
                                             style="width:60px; height:40px; object-fit:cover;" />
                                    </td>
                                    <td class="fw-semibold">@aircraft.Brand</td>
                                    <td>@aircraft.Model</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@aircraft.EconomySeats</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark">@aircraft.BusinessSeats</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">@aircraft.TotalCapacity</span>
                                    </td>
                                    <td class="text-center">
                                        @if (aircraft.IsAvailable)
                                        {
                                            <span class="badge bg-success">Disponível</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Indisponível</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@aircraft.Id"
                                           class="btn btn-sm btn-outline-info me-1" title="Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@aircraft.Id"
                                           class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@aircraft.Id"
                                           class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>