@using LisAeroGest.Data.Interfaces
@model IEnumerable<LisAeroGest.Data.Entities.Aircraft>
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Aeronaves — Frota";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item active">Aeronaves</li>
    </ol>
</nav>

<div class="container-fluid mt-2 mb-5">

    <!-- Cabeçalho Principal -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-airplane-fill text-info me-2"></i>Aeronaves
            </h2>
            <span class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>Total de <strong>@Model.Count()</strong> aeronaves registadas na frota
            </span>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Nova Aeronave
        </a>
    </div>

    <!-- Alertas de Feedback -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabela da Frota -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-airplane text-secondary display-4 d-block mb-3"></i>
                    <h5 class="fw-bold">Nenhuma aeronave registada</h5>
                    <p class="small text-muted mb-3">Comece adicionando a primeira aeronave à frota do sistema.</p>
                    <a asp-action="Create" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>Registar Aeronave
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3" style="width: 80px;">Foto</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th class="text-center">Económica</th>
                                <th class="text-center">Executiva</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end pe-3" style="width: 140px;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aircraft in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <img src="@ImageHelper.GetImageUrl(aircraft.ImageId, "aircraft")"
                                             alt="@aircraft.Brand @aircraft.Model"
                                             class="rounded border shadow-sm"
                                             style="width: 60px; height: 40px; object-fit: cover;" />
                                    </td>
                                    <td class="fw-bold text-dark">@aircraft.Brand</td>
                                    <td>@aircraft.Model</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                            <i class="bi bi-person-seat me-1"></i>@aircraft.EconomySeats
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1">
                                            <i class="bi bi-star-fill me-1"></i>@aircraft.BusinessSeats
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1 fw-bold">
                                            @aircraft.TotalCapacity
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (aircraft.IsAvailable)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Disponível
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 rounded-pill">
                                                <i class="bi bi-x-circle-fill me-1"></i>Indisponível
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@aircraft.Id"
                                               class="btn btn-outline-info" title="Ver Detalhes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@aircraft.Id"
                                               class="btn btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@aircraft.Id"
                                               class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>