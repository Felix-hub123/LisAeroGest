@using LisAeroGest.Data.Interfaces
@model LisAeroGest.Models.AirlineViewModel
@inject IImageHelper ImageHelper

@{
    ViewData["Title"] = "Editar Companhia Aérea";
}

<!-- Navigation Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Airline" asp-action="Index">Companhias</a></li>
        <li class="breadcrumb-item active" aria-current="page">Editar</li>
    </ol>
</nav>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <!-- Title & Back Action -->
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3" title="Voltar à lista">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-pencil-fill text-warning me-2"></i>Editar Companhia Aérea
                </h2>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Ocultos para garantir a passagem de dados no ModelState -->
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ImageId" type="hidden" />
                        <input asp-for="Name" type="hidden" />
                        <input asp-for="IATACode" type="hidden" />
                        <input asp-for="Country" type="hidden" />

                        <!-- Identificação Imutável -->
                        <div class="p-3 bg-light rounded border mb-4">
                            <h6 class="text-muted fw-bold mb-3">
                                <i class="bi bi-lock-fill me-1"></i>Identificação da Companhia (Imutável)
                            </h6>
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label asp-for="Name" class="form-label fw-semibold">Nome</label>
                                    <input asp-for="Name" class="form-control" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="IATACode" class="form-label fw-semibold">Código IATA</label>
                                    <input asp-for="IATACode" class="form-control text-uppercase" readonly />
                                </div>
                            </div>
                            <div class="mb-0">
                                <label asp-for="Country" class="form-label fw-semibold">País</label>
                                <input asp-for="Country" class="form-control" readonly />
                            </div>
                        </div>

                        <!-- Gestão do Logótipo -->
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                <i class="bi bi-image me-1"></i>Alterar Logótipo / Imagem
                            </label>
                            <input asp-for="ImageFile" class="form-control" type="file"
                                   accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>

                            <div class="mt-3 text-center text-md-start">
                                <img id="imagePreview"
                                     src="@ImageHelper.GetImageUrl(Model.ImageId, "airlines")"
                                     alt="Logótipo Atual"
                                     class="rounded border shadow-sm"
                                     style="height: 100px; width: 160px; object-fit: cover;" />
                            </div>
                        </div>

                        <!-- Submissão -->
                        <div class="d-flex gap-2 pt-2 border-top">
                            <button type="submit" id="btnSave" class="btn btn-warning">
                                <i class="bi bi-check-lg me-2"></i>Guardar Alterações
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                                <i class="bi bi-x-lg me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => document.getElementById('imagePreview').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}