@model LisAeroGest.Models.AirlineViewModel

@{
    ViewData["Title"] = "Nova Companhia Aérea";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Airline" asp-action="Index">Companhias</a></li>
        <li class="breadcrumb-item active">Nova</li>
    </ol>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-briefcase-fill text-primary me-2"></i>Nova Companhia Aérea
                </h2>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- 1. Seleção do País -->
                        <div class="mb-3">
                            <label asp-for="Country" class="form-label fw-semibold">País</label>
                            <select id="countrySelect" asp-for="Country" class="form-select"
                                    asp-items="@(ViewBag.Countries as IEnumerable<SelectListItem>)"
                                    onchange="onCountryChange(this.value)">
                            </select>
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- 2. Seleção da Companhia Aérea (Bloqueado até selecionar País) -->
                            <div class="col-md-8 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">Companhia Aérea</label>
                                <select id="airlineSelect" asp-for="Name" class="form-select" disabled onchange="onAirlineChange()">
                                    <option value="">-- Selecione primeiro o País --</option>
                                </select>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- 3. Código IATA (Preenchimento Automático) -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="IATACode" class="form-label fw-semibold">Código IATA</label>
                                <input id="iataInput" asp-for="IATACode" class="form-control text-uppercase" readonly placeholder="Ex: TP" />
                                <span asp-validation-for="IATACode" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Upload do Logótipo -->
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold">Ficheiro do Logótipo</label>
                            <input asp-for="ImageFile" class="form-control" type="file"
                                   accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>

                            <div class="mt-2">
                                <img id="imagePreview" src="/images/airlines/noimage.png"
                                     class="rounded border" style="height:80px; object-fit:cover;" />
                            </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Criar Companhia
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function onCountryChange(country) {
            const airlineSelect = document.getElementById('airlineSelect');
            const iataInput = document.getElementById('iataInput');

            
            airlineSelect.innerHTML = '<option value="">-- Selecione a Companhia --</option>';
            iataInput.value = '';

            if (!country) {
                airlineSelect.disabled = true;
                return;
            }

            // Pedido via fetch para obter as companhias do país selecionado
            fetch(`/Airline/GetAirlinesByCountry?country=${encodeURIComponent(country)}`)
                .then(response => response.json())
                .then(data => {
                    data.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.name;
                        opt.textContent = item.name;
                        opt.dataset.iata = item.iata;
                        airlineSelect.appendChild(opt);
                    });
                    airlineSelect.disabled = false;
                })
                .catch(err => console.error('Erro ao carregar companhias:', err));
        }

        function onAirlineChange() {
            const select = document.getElementById('airlineSelect');
            const selectedOption = select.options[select.selectedIndex];

            
            document.getElementById('iataInput').value = selectedOption.dataset.iata || '';
        }

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => document.getElementById('imagePreview').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}