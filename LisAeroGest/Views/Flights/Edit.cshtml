@model LisAeroGest.Models.FlightViewModel

@{
    ViewData["Title"] = "Editar Voo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-pencil-square me-2"></i>Editar Voo @Model.FlightNumber</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="FlightNumber" class="form-label fw-bold">Número do Voo</label>
                    <input asp-for="FlightNumber" class="form-control" />
                    <span asp-validation-for="FlightNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AirlineId" class="form-label fw-bold">Companhia Aérea</label>
                    <select asp-for="AirlineId" asp-items="Model.Airlines" class="form-select"></select>
                    <span asp-validation-for="AirlineId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AircraftId" class="form-label fw-bold">Aeronave</label>
                    <select asp-for="AircraftId" asp-items="Model.Aircrafts" class="form-select"></select>
                    <span asp-validation-for="AircraftId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="OriginAirportId" class="form-label fw-bold">Aeroporto de Origem</label>
                    <select asp-for="OriginAirportId" asp-items="Model.Airports" id="OriginAirportId" class="form-select"></select>
                    <span asp-validation-for="OriginAirportId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DestinationAirportId" class="form-label fw-bold">Aeroporto de Destino</label>
                    <select asp-for="DestinationAirportId" asp-items="Model.Airports" id="DestinationAirportId" class="form-select"></select>
                    <span asp-validation-for="DestinationAirportId" id="destError" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DepartureTime" class="form-label fw-bold">Data/Hora Partida</label>
                    <input asp-for="DepartureTime" id="DepartureTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="DepartureTime" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ArrivalTime" class="form-label fw-bold">Data/Hora Chegada</label>
                    <input asp-for="ArrivalTime" id="ArrivalTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ArrivalTime" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="GateId" class="form-label fw-bold">Portão (Gate)</label>
                    <select asp-for="GateId" asp-items="Model.Gates" class="form-select"></select>
                    <span asp-validation-for="GateId" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div id="flightDurationAlert" class="alert alert-info d-none mb-0 py-2">
                        <i class="bi bi-clock me-2"></i>Duração estimada: <strong id="durationText">--</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="BasePrice" class="form-label fw-bold">Preço Base (€)</label>
                    <input asp-for="BasePrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="BasePrice" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-bold">Estado Operacional</label>
                    <select asp-for="Status" asp-items="Model.Statuses" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Atualizar Voo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const depInput = document.getElementById('DepartureTime');
        const arrInput = document.getElementById('ArrivalTime');
        const durationAlert = document.getElementById('flightDurationAlert');
        const durationText = document.getElementById('durationText');

        function calculateDuration() {
            if (depInput.value && arrInput.value) {
                const dep = new Date(depInput.value);
                const arr = new Date(arrInput.value);
                const diffMs = arr - dep;

                if (diffMs > 0) {
                    const diffMins = Math.floor(diffMs / 60000);
                    const hours = Math.floor(diffMins / 60);
                    const mins = diffMins % 60;

                    durationText.textContent = `${hours}h ${mins}m`;
                    durationAlert.classList.remove('d-none');
                }
            }
        }

        depInput?.addEventListener('change', calculateDuration);
        arrInput?.addEventListener('change', calculateDuration);
        document.addEventListener("DOMContentLoaded", calculateDuration);
    </script>
}