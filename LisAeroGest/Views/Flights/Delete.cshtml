@model LisAeroGest.Data.Entities.Flight
@inject LisAeroGest.Helpers.IConverterHelper ConverterHelper

@{
    ViewData["Title"] = "Eliminar Voo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-trash-fill me-2"></i>Eliminar Voo
                </h2>
            </div>

            <!-- Alerta de aviso -->
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Atenção!</strong> Esta operação é irreversível.
                    Não é possível eliminar voos com bilhetes vendidos.
                </div>
            </div>

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-airplane me-2"></i>
                        Voo <strong>@Model.FlightNumber</strong> —
                        @Model.OriginAirport?.IATACode → @Model.DestinationAirport?.IATACode
                    </h5>
                </div>
                <div class="card-body p-4">
                    <table class="table table-borderless">
                        <tr>
                            <th class="text-muted" style="width:35%">Número do Voo</th>
                            <td>
                                <span class="badge bg-dark fs-6">@Model.FlightNumber</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Companhia</th>
                            <td class="fw-semibold">@Model.Airline?.Name</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Origem</th>
                            <td>
                                @Model.OriginAirport?.City
                                <span class="badge bg-primary ms-1">@Model.OriginAirport?.IATACode</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Destino</th>
                            <td>
                                @Model.DestinationAirport?.City
                                <span class="badge bg-primary ms-1">@Model.DestinationAirport?.IATACode</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Partida</th>
                            <td>@Model.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Chegada</th>
                            <td>@Model.ArrivalTime.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Estado</th>
                            <td>
                                <span class="badge @ConverterHelper.GetFlightBadgeClass(Model.Status)">
                                    @ConverterHelper.GetFlightStatusText(Model.Status)
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Gate</th>
                            <td>@(Model.Gate?.GateNumber ?? "—")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Preço Base</th>
                            <td class="fw-semibold">@Model.BasePrice.ToString("F2") €</td>
                        </tr>
                    </table>

                    <!-- Caixa de confirmação por digitação -->
                    <div class="mb-4 p-3 bg-light rounded border">
                        <label class="form-label fw-semibold text-danger">
                            <i class="bi bi-keyboard me-1"></i>
                            Para confirmar, escreva o número do voo
                            <strong>@Model.FlightNumber</strong> abaixo:
                        </label>
                        <input type="text" id="confirmInput" class="form-control"
                               placeholder="Ex: @Model.FlightNumber" autocomplete="off" />
                        <div id="confirmFeedback" class="form-text text-danger mt-1" style="display:none;">
                            O número do voo não corresponde.
                        </div>
                    </div>

                    <form id="deleteForm" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" id="btnDelete" class="btn btn-danger" disabled>
                                <i class="bi bi-trash me-2"></i>Confirmar Eliminação
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x me-1"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const flightNumber = '@Model.FlightNumber';
        const confirmInput = document.getElementById('confirmInput');
        const btnDelete = document.getElementById('btnDelete');
        const confirmFeedback = document.getElementById('confirmFeedback');

        confirmInput.addEventListener('input', function () {
            const value = this.value.trim().toUpperCase();
            const isCorrect = value === flightNumber.toUpperCase();

            btnDelete.disabled = !isCorrect;

            if (this.value.length > 0 && !isCorrect) {
                confirmFeedback.style.display = 'block';
                confirmInput.classList.add('is-invalid');
                confirmInput.classList.remove('is-valid');
            } else if (isCorrect) {
                confirmFeedback.style.display = 'none';
                confirmInput.classList.remove('is-invalid');
                confirmInput.classList.add('is-valid');
            } else {
                confirmFeedback.style.display = 'none';
                confirmInput.classList.remove('is-invalid', 'is-valid');
            }
        });

        document.getElementById('deleteForm').addEventListener('submit', function (e) {
            const confirmed = confirm(
                `Tem a certeza absoluta que pretende eliminar o voo ${flightNumber}?\n\nEsta operação é irreversível.`
            );
            if (!confirmed) {
                e.preventDefault();
            }
        });
    </script>
}