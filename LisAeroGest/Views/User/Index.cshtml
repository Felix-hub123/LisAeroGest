@model IEnumerable<LisAeroGest.Data.Entities.UserWithRole>
@{
    ViewData["Title"] = "Gerir Utilizadores";
}

<h1 class="mb-4"><i class="bi bi-people me-2"></i>Utilizadores</h1>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-primary">
            <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>Role</th>
                <th>Confirmado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.User?.FullName</td>
                    <td>@item.User?.Email</td>
                    <td>
                        <form asp-action="ChangeRole" method="post" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@item.User?.Id" />
                            <select name="newRole" class="form-select form-select-sm" style="width: auto;">
                                <option value="Admin" selected="@(item.Role == "Admin")">Admin</option>
                                <option value="Employee" selected="@(item.Role == "Employee")">Employee</option>
                                <option value="Passenger" selected="@(item.Role == "Passenger")">Passenger</option>
                            </select>
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </form>
                    </td>
                    <td>
                        @if (item.User?.EmailConfirmed == true)
                        {
                            <span class="badge bg-success">Sim</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Não</span>
                        }
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Eliminar este utilizador?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@item.User?.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>