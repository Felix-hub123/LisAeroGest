@{
    ViewData["Title"] = "Acesso Negado — LisAeroGest";
}

<div class="auth-bg" style="background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-7 col-xl-5">
                <div class="card denied-card">
                    <div class="denied-header">
                        <div class="shield-icon-wrap pulse-shield">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <h1>403 — Acesso Negado</h1>
                        <p>Esta área é restrita</p>
                        <div class="auth-wave">
                            <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
                                <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z" fill="white" />
                            </svg>
                        </div>
                    </div>

                    <div class="card-body denied-body">
                        <i class="bi bi-exclamation-octagon-fill text-danger shake-once"
                           style="font-size: 3.5rem;"></i>

                        <h4 class="mt-3 mb-2">Não tem permissão para aceder aqui</h4>

                        <p class="denied-message">
                            A sua conta <strong>"@(User.Identity?.Name ?? "Anónimo")"</strong>
                            @(User.IsInRole("Passenger") ? " (Passageiro)" :
                                                        User.IsInRole("Employee") ? " (Funcionário)" :
                                                        User.IsInRole("Admin") ? " (Administrador)" : "")
                            não tem os privilégios necessários para esta página.
                        </p>

                        <p class="denied-detail">
                            <i class="bi bi-info-circle me-1"></i>
                            Se acredita que isto é um erro, contacte o administrador do sistema.
                        </p>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-grad btn-action">
                                <i class="bi bi-house-fill me-2"></i>Voltar ao Início
                            </a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-action">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sair e entrar com outra conta
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-danger btn-action">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sessão
                                </a>
                            }
                        </div>

                        <hr class="my-4" />

                        <div class="text-start small">
                            <p class="mb-1 text-muted">
                                <i class="bi bi-clock me-1"></i>
                                @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            </p>
                            <p class="mb-0 text-muted">
                                <i class="bi bi-link-45deg me-1"></i>
                                <code class="small">@Context.Request.Path</code>
                            </p>
                        </div>
                    </div>

                    <div class="card-footer bg-white text-center py-3 border-0">
                        <span class="text-muted small">&copy; @DateTime.Now.Year LisAeroGest · CINEL</span>
                    </div>
                </div>

                <p class="text-center text-muted small mt-3 mb-0">
                    <i class="bi bi-shield-check me-1"></i>
                    Tentativas de acesso são registadas para segurança.
                </p>
            </div>
        </div>
    </div>
</div>