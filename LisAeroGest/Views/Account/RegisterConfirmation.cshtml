@{
    Layout = "_AuthLayout";

    ViewData["Title"] = "Registo Concluído — LisAeroGest";

    var mensagem =
        ViewBag.Message as string
        ?? "Enviámos um email de confirmação para a sua caixa de correio.";

    var email =
        ViewBag.Email as string
        ?? "";
}

<div class="auth-bg">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-12 col-md-9 col-lg-7 col-xl-5">

                <div class="card success-card">

                    <!-- ================================================= -->
                    <!-- CABEÇALHO -->
                    <!-- ================================================= -->

                    <div class="success-header">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="auth-back-btn"
                           title="Voltar ao início">

                            <i class="bi bi-arrow-left"></i>

                        </a>


                        <div class="success-checkmark pulse-success">

                            <i class="bi bi-envelope-check-fill"></i>

                        </div>


                        <h1>
                            Registo Concluído
                        </h1>

                        <p>
                            Só falta confirmar o seu email
                        </p>


                        <div class="auth-wave">

                            <svg viewBox="0 0 1440 60"
                                 preserveAspectRatio="none">

                                <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z"
                                      fill="#111827" />

                            </svg>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- CONTEÚDO -->
                    <!-- ================================================= -->

                    <div class="card-body success-body">

                        <i class="bi bi-envelope-paper-heart
                                  success-icon-big
                                  bounce-in">
                        </i>


                        <h4 class="mt-3 mb-2">

                            Verifique o seu email!

                        </h4>


                        <p class="success-message">

                            @mensagem

                        </p>


                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <div class="alert
                                            alert-light
                                            border
                                            rounded-3
                                            my-3">

                                <div class="small text-muted mb-1">

                                    Email de confirmação enviado para

                                </div>

                                <div class="fw-bold">

                                    <i class="bi bi-envelope me-2"></i>

                                    @email

                                </div>

                            </div>
                        }


                        <p class="success-detail">

                            <i class="bi bi-info-circle me-1"></i>

                            Após confirmar o email,
                            poderá iniciar sessão na plataforma
                            e comprar bilhetes,
                            fazer check-in
                            e gerir as suas viagens.

                        </p>


                        <!-- ================================================= -->
                        <!-- PASSOS -->
                        <!-- ================================================= -->

                        <div class="timeline-steps text-start my-4">

                            <!-- PASSO 1 -->

                            <div class="step done">

                                <div class="step-icon">

                                    <i class="bi bi-check-lg"></i>

                                </div>


                                <div class="step-content">

                                    <strong>
                                        Conta criada
                                    </strong>

                                    <small class="d-block text-muted">

                                        Os seus dados foram guardados
                                        com sucesso

                                    </small>

                                </div>

                            </div>


                            <!-- PASSO 2 -->

                            <div class="step current">

                                <div class="step-icon">

                                    <i class="bi bi-envelope"></i>

                                </div>


                                <div class="step-content">

                                    <strong>
                                        Confirme o email
                                    </strong>

                                    <small class="d-block text-muted">

                                        Abra a mensagem enviada pelo
                                        LisAeroGest e clique no link
                                        de confirmação

                                    </small>

                                </div>

                            </div>


                            <!-- PASSO 3 -->

                            <div class="step">

                                <div class="step-icon">

                                    <i class="bi bi-airplane"></i>

                                </div>


                                <div class="step-content">

                                    <strong>
                                        Pronto a voar!
                                    </strong>

                                    <small class="d-block text-muted">

                                        Depois da confirmação,
                                        faça login e utilize a plataforma

                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- AVISO -->
                        <!-- ================================================= -->

                        <div class="alert
                                    alert-warning
                                    text-start
                                    rounded-3">

                            <div class="d-flex gap-2">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <div>

                                    <strong>
                                        Confirmação obrigatória
                                    </strong>

                                    <div class="small mt-1">

                                        Só poderá iniciar sessão
                                        depois de confirmar
                                        o endereço de email.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BOTÕES -->
                        <!-- ================================================= -->

                        <div class="d-grid
                                    gap-2
                                    d-md-flex
                                    justify-content-md-center
                                    mt-4">

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn
                                      btn-primary-grad
                                      btn-action">

                                <i class="bi
                                          bi-box-arrow-in-right
                                          me-2">
                                </i>

                                Ir para o Login

                            </a>


                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn
                                      btn-outline-success
                                      btn-action">

                                <i class="bi
                                          bi-house
                                          me-2">
                                </i>

                                Voltar ao Início

                            </a>

                        </div>


                        <hr class="my-4" />


                        <!-- ================================================= -->
                        <!-- INFORMAÇÃO -->
                        <!-- ================================================= -->

                        <div class="text-start small">

                            <p class="mb-2 text-muted">

                                <i class="bi bi-clock me-1"></i>

                                @DateTime.Now.ToString(
                                "dd/MM/yyyy HH:mm:ss")

                            </p>


                            <p class="mb-2 text-muted">

                                <i class="bi
                                          bi-question-circle
                                          me-1">
                                </i>

                                Não recebeu o email?

                                Verifique a pasta de
                                <strong>spam</strong>
                                ou correio não solicitado.

                            </p>


                            <p class="mb-0 text-success">

                                <i class="bi
                                          bi-shield-check
                                          me-1">
                                </i>

                                Confirme o email antes
                                de iniciar sessão.

                            </p>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- FOOTER -->
                    <!-- ================================================= -->

                    <div class="card-footer
                                text-center
                                py-3
                                border-0">

                        <span class="text-muted small">

                            &copy; @DateTime.Now.Year
                            LisAeroGest · CINEL

                        </span>

                    </div>

                </div>


                <p class="text-center
                          text-muted
                          small
                          mt-3
                          mb-0">

                    <i class="bi
                              bi-heart-fill
                              text-danger
                              me-1">
                    </i>

                    Obrigado por se juntar
                    à família LisAeroGest!

                </p>

            </div>

        </div>

    </div>
</div>