@model LisAeroGest.Models.EditProfileViewModel
@{
    ViewData["Title"] = "Editar Perfil — LisAeroGest";
}

<div class="auth-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-7 col-xl-5">
                <div class="card auth-card">
                    <div class="auth-header">
                        <a asp-controller="Home" asp-action="Index" class="auth-back-btn" title="Voltar ao início">
                            <i class="bi bi-arrow-left"></i>
                        </a>

                        <i class="bi bi-person-circle floating-plane"></i>
                        <div class="auth-logo">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <h1>Editar Perfil</h1>
                        <p>Atualize os seus dados pessoais</p>
                        <div class="auth-wave">
                            <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
                                <path d="M0,32 C360,80 720,0 1080,32 C1260,48 1380,32 1440,32 L1440,60 L0,60 Z" fill="#111827" />
                            </svg>
                        </div>
                    </div>

                    <div class="card-body auth-body">
                        <form asp-action="EditProfile" method="post" enctype="multipart/form-data" class="auth-form" id="editProfileForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ImageId" />
                            <input type="hidden" asp-for="ImageUrl" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                            <!-- ── Avatar / Imagem ─────────────────────── -->
                            <div class="text-center mb-4">
                                <div class="profile-avatar-wrapper">
                                    <img id="avatarPreview"
                                         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/users/noimage.png" : Model.ImageUrl)"
                                         alt="Foto de perfil"
                                         class="profile-avatar"
                                         onerror="this.src='/images/users/noimage.png'" />

                                    <label for="ImageFile" class="profile-avatar-btn" title="Alterar foto">
                                        <i class="bi bi-camera"></i>
                                    </label>

                                    <input asp-for="ImageFile"
                                           type="file"
                                           accept="image/*"
                                           class="d-none"
                                           id="ImageFile"
                                           onchange="previewImage(this)" />
                                </div>
                                <small class="text-muted d-block mt-2">Clique no ícone para alterar a foto</small>
                            </div>

                            <!-- ── Nome / Apelido ──────────────────────── -->
                            <div class="row g-2">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                                        <input asp-for="FirstName" class="form-control" placeholder="Ex.: Maria" />
                                    </div>
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                                        <input asp-for="LastName" class="form-control" placeholder="Ex.: Silva" />
                                    </div>
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- ── Email (readonly) ────────────────────── -->
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" readonly />
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>O email não pode ser alterado.
                                </small>
                            </div>

                            <!-- ── Telefone ────────────────────────────── -->
                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="+351 912 345 678" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <!-- ── Botões ──────────────────────────────── -->
                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary btn-auth" id="submitBtn">
                                    <span class="btn-text">
                                        <i class="bi bi-check-lg me-2"></i>Guardar Alterações
                                    </span>
                                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-center py-3 border-0">
                        <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Voltar ao Início
                        </a>
                    </div>
                </div>

                <p class="text-center text-muted small mt-3 mb-0">
                    &copy; @DateTime.Now.Year LisAeroGest · CINEL
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        (function () {
            var form = document.getElementById('editProfileForm');
            var btn = document.getElementById('submitBtn');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.querySelector('.btn-text').classList.add('d-none');
                    btn.querySelector('.spinner-border').classList.remove('d-none');
                });
            }
        })();
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}