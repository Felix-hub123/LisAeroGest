@model LisAeroGest.Models.AircraftViewModel
@{
    ViewData["Title"] = "Editar Aeronave";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-controller="Aircraft" asp-action="Index">Aeronaves</a></li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <!-- Botão voltar -->
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-pencil-fill text-warning me-2"></i>Editar Aeronave
                </h2>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Marca e Modelo -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Brand" class="form-label fw-semibold"></label>
                                <input asp-for="Brand" class="form-control" />
                                <span asp-validation-for="Brand" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Model" class="form-label fw-semibold"></label>
                                <input asp-for="Model" class="form-control" />
                                <span asp-validation-for="Model" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Lugares -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EconomySeats" class="form-label fw-semibold"></label>
                                <input asp-for="EconomySeats" class="form-control" type="number" min="1" max="500" />
                                <span asp-validation-for="EconomySeats" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BusinessSeats" class="form-label fw-semibold"></label>
                                <input asp-for="BusinessSeats" class="form-control" type="number" min="0" max="100" />
                                <span asp-validation-for="BusinessSeats" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Disponível -->
                        <div class="form-check mb-4">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label fw-semibold">
                                Disponível para operar voos
                            </label>
                        </div>

                        <!-- Imagem -->
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                <i class="bi bi-image me-1"></i>Alterar Fotografia
                            </label>
                            <input asp-for="ImageFile" class="form-control" type="file"
                                   accept="image/*" onchange="previewImage(this)" />
                            <div class="mt-3">
                                <img id="imagePreview"
                                     src="@(Model.ImageId == Guid.Empty ? "/images/aircraft/noimage.png" : $"https://lisaerogest.blob.core.windows.net/aircraft/{Model.ImageId}")"
                                     class="rounded shadow-sm"
                                     style="height:120px; width:200px; object-fit:cover;" />
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg me-2"></i>Guardar Alterações
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                                <i class="bi bi-x-lg me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagePreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
