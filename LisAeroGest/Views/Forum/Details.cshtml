@model LisAeroGest.Data.Entities.ForumTopic
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Fórum</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">
                @if (Model.IsClosed)
                {
                    <span class="badge bg-secondary me-1">Fechado</span>
                }
                @Model.Title
            </h5>
            <small class="text-muted">
                @Model.Category &middot; @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </small>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div>
                @if (!Model.IsClosed)
                {
                    <form asp-action="Close" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-lock me-1"></i>Fechar</button>
                    </form>
                }
                <form asp-action="Delete" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Eliminar tópico?')">
                        <i class="bi bi-trash me-1"></i>Eliminar
                    </button>
                </form>
            </div>
        }
    </div>
    <div class="card-body">
        <p>@Model.Content</p>
    </div>
</div>

<h5 class="mb-3">Comentários (@Model.Comments.Count)</h5>

@if (!Model.Comments.Any())
{
    <div class="alert alert-light">Nenhum comentário ainda.</div>
}
else
{
    @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
    {
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center
                                        justify-content-center"
                             style="width:32px; height:32px; font-size:0.8rem;">
                            @(comment.CreatedBy?.FirstName?.Substring(0, 1).ToUpper() ?? "?")
                        </div>
                        <span class="fw-semibold small">
                            @(comment.CreatedBy?.FullName ?? "Utilizador desconhecido")
                        </span>
                    </div>
                    <small class="text-muted">
                        <i class="bi bi-clock me-1"></i>
                        @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
                <p class="mb-0 ms-5">@comment.Content</p>
            </div>
        </div>
    }
}

@if (!Model.IsClosed)
{
    <form asp-action="AddComment" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="topicId" value="@Model.Id" />
        <div class="input-group">
            <textarea name="content" class="form-control" rows="2" placeholder="Escreva um comentário..." required></textarea>
            <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Enviar</button>
        </div>
    </form>
}
else
{
    <div class="alert alert-secondary mt-3">Este tópico está fechado a novos comentários.</div>
}
