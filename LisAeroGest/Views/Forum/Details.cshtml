@model LisAeroGest.Data.Entities.ForumTopic
@{
    ViewData["Title"] = Model.Title;
    var approvedCount = Model.Comments?.Count(c => c.IsApproved) ?? 0;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Fórum</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center bg-light">
        <div>
            <h5 class="mb-0">
                @if (Model.IsClosed)
                {
                    <span class="badge bg-secondary me-1"><i class="bi bi-lock-fill me-1"></i>Fechado</span>
                }
                @Model.Title
            </h5>
            <small class="text-muted">
                Por <strong>@(Model.CreatedBy?.FullName ?? "N/A")</strong> &middot; @Model.Category &middot; @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </small>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-1">
                @if (!Model.IsClosed)
                {
                    <form asp-action="Close" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="bi bi-lock me-1"></i>Fechar
                        </button>
                    </form>
                }
                <form asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Tem a certeza que pretende eliminar este tópico?')">
                        <i class="bi bi-trash me-1"></i>Eliminar
                    </button>
                </form>
            </div>
        }
    </div>
    <div class="card-body">
        <p class="mb-0" style="white-space: pre-line;">@Model.Content</p>
    </div>
</div>

<h5 class="mb-3"><i class="bi bi-chat-left-text me-2"></i>Comentários (@approvedCount)</h5>

@if (Model.Comments == null || !Model.Comments.Any())
{
    <div class="alert alert-light border">Nenhum comentário visível de momento.</div>
}
else
{
    @foreach (var comment in Model.Comments)
    {
        var authorName = comment.CreatedBy?.FullName ?? "Utilizador desconhecido";
        var initial = !string.IsNullOrEmpty(comment.CreatedBy?.FirstName)
            ? comment.CreatedBy.FirstName.Substring(0, 1).ToUpper()
            : "?";

        <div class="card mb-2 @(!comment.IsApproved ? "border-warning bg-light" : "")">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle @(!comment.IsApproved ? "bg-warning text-dark" : "bg-primary text-white") d-flex align-items-center justify-content-center fw-bold"
                             style="width:32px; height:32px; font-size:0.8rem;">
                            @initial
                        </div>
                        <span class="fw-semibold small">@authorName</span>

                        @if (!comment.IsApproved)
                        {
                            <span class="badge bg-warning text-dark ms-1">
                                <i class="bi bi-clock me-1"></i>Pendente de Moderação
                            </span>
                        }
                    </div>
                    <small class="text-muted">
                        <i class="bi bi-clock me-1"></i>@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>

                <p class="mb-2 ms-5 text-secondary" style="white-space: pre-line;">@comment.Content</p>

                @if (!comment.IsApproved && User.IsInRole("Admin"))
                {
                    <div class="ms-5 mb-1 text-end">
                        <form asp-action="ApproveComment" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="commentId" value="@comment.Id" />
                            <input type="hidden" name="topicId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-success">
                                <i class="bi bi-check-circle me-1"></i>Aprovar Comentário
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
}

@if (!Model.IsClosed)
{
    <form asp-action="AddComment" method="post" class="mt-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="topicId" value="@Model.Id" />
        <div class="input-group">
            <textarea name="content" class="form-control" rows="2" placeholder="Escreva um comentário..." required></textarea>
            <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Enviar</button>
        </div>
    </form>
}
else
{
    <div class="alert alert-secondary mt-4">
        <i class="bi bi-lock-fill me-1"></i> Este tópico está fechado a novos comentários.
    </div>
}