@model IEnumerable<LisAeroGest.Models.ForumPendingCommentViewModel>
@{
    ViewData["Title"] = "Comentários Pendentes";
}

<div class="container mt-4 mb-5">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
            <li class="breadcrumb-item"><a asp-controller="Forum" asp-action="Index">Fórum</a></li>
            <li class="breadcrumb-item active">Moderação</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-white">
                <i class="bi bi-hourglass-split text-warning me-2"></i>Comentários Pendentes
            </h2>
            <p class="text-muted mb-0">
                Moderação do fórum interno —
                <span class="badge bg-warning text-dark">@Model.Count() pendente(s)</span>
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar ao Fórum
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-check-circle text-success fs-1 d-block mb-2"></i>
            <p class="mb-0">Não existem comentários à espera de aprovação.</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var comment in Model)
            {
                <div class="list-group-item border rounded mb-3 shadow-sm">
                    <div class="d-flex gap-3">
                        <div class="flex-shrink-0">
                            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold"
                                 style="width: 42px; height: 42px;">
                                @comment.AuthorInitial
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                                <div>
                                    <span class="fw-semibold text-white">@comment.AuthorName</span>
                                    <span class="badge bg-warning text-dark ms-1">Pendente</span>
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-chat-dots me-1"></i>
                                        Tópico:
                                        <a asp-action="Details" asp-route-id="@comment.ForumTopicId"
                                           class="text-decoration-none">
                                            @comment.TopicTitle
                                        </a>
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <p class="mb-3 text-muted" style="white-space: pre-line;">@comment.Content</p>

                            <div class="d-flex gap-2 flex-wrap">
                                <form asp-action="ApproveComment" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="commentId" value="@comment.Id" />
                                    <input type="hidden" name="topicId" value="@comment.ForumTopicId" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check-circle me-1"></i>Aprovar
                                    </button>
                                </form>
                                <a asp-action="Details" asp-route-id="@comment.ForumTopicId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Ver tópico
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>