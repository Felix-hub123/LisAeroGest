@model IEnumerable<LisAeroGest.Data.Entities.ForumTopic>

@{
    ViewData["Title"] = "Fórum Interno";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-chat-dots-fill text-primary me-2"></i>Fórum Interno
            </h2>
            <span class="text-muted small">@Model.Count() tópicos</span>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Novo Tópico
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-chat-slash fs-1 opacity-50"></i>
            <p class="mt-3">Ainda não existem tópicos no fórum.</p>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var topic in Model)
            {
                <a asp-action="Details" asp-route-id="@topic.Id"
                   class="list-group-item list-group-item-action p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                @if (topic.IsClosed)
                                {
                                    <span class="badge bg-secondary">Fechado</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Aberto</span>
                                }
                                @if (!string.IsNullOrEmpty(topic.Category))
                                {
                                    <span class="badge bg-info text-dark">@topic.Category</span>
                                }
                                <h6 class="mb-0 fw-semibold">@topic.Title</h6>
                            </div>
                            <p class="text-muted small mb-1">
                                @topic.Content?.Substring(0, Math.Min(topic.Content.Length, 120))
                                @(topic.Content?.Length > 120 ? "..." : "")
                            </p>
                            <small class="text-muted">
                                <i class="bi bi-person me-1"></i>@topic.CreatedBy?.FullName
                                <i class="bi bi-clock ms-2 me-1"></i>
                                @topic.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                <i class="bi bi-chat ms-2 me-1"></i>
                                @(topic.Comments?.Count ?? 0) comentários
                            </small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            }
        </div>
    }
</div>